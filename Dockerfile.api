# API Dockerfile for Railway deployment
FROM node:20-alpine AS deps

RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/admin/package.json ./apps/admin/
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/
COPY packages/ui/package.json ./packages/ui/
COPY packages/cf-schema/package.json ./packages/cf-schema/
COPY packages/repo/package.json ./packages/repo/

RUN npm ci

FROM node:20-alpine AS builder

RUN apk add --no-cache openssl
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npx prisma generate --schema=packages/database/prisma/schema.prisma

ENV NODE_ENV=production
RUN npm run build -w @ebda/database && npm run build -w @ebda/shared && npm run build -w apps/api

FROM node:20-alpine

RUN apk add --no-cache openssl
WORKDIR /app

ENV NODE_ENV=production

# Which commit this image was built from, so /health can report it and a
# deploy can be verified as LIVE rather than merely green. Supplied as a
# build arg by whatever performs the build; absent when the builder does not
# know the commit, in which case /health reports null rather than guessing.
ARG GIT_COMMIT_SHA=""
ENV BUILD_COMMIT_SHA=$GIT_COMMIT_SHA

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 api

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/packages/database ./packages/database
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/package.json ./

USER api

EXPOSE 4000

ENV PORT=4000
ENV HOST=0.0.0.0

CMD ["sh", "-c", "npx prisma migrate deploy --schema=packages/database/prisma/schema.prisma && node apps/api/dist/index.js"]
