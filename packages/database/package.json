{
  "name": "@ebda/database",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "build": "prisma generate && node ../../scripts/ci/slim-prisma-client.mjs && tsc",
    "generate": "prisma generate && node ../../scripts/ci/slim-prisma-client.mjs",
    "gen:tenant-guard-schema": "node scripts/gen-tenant-guard-schema.mjs",
    "migrate": "prisma migrate dev",
    "push": "prisma db push",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:loadtest": "tsx prisma/seed-loadtest-stores.ts",
    "seed:loadtest:cleanup": "tsx prisma/seed-loadtest-stores.ts --cleanup",
    "clean": "rm -rf node_modules"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@ebda/shared": "*",
    "prisma": "^6.19.3",
    "tsx": "^4.6.2",
    "typescript": "^5.3.0",
    "vitest": "^4.0.0"
  }
}
