  productId2        String   @map("product_id_2")
  coOccurrenceCount Int      @default(0) @map("co_occurrence_count")
  lastCalculatedAt  DateTime @default(now()) @map("last_calculated_at")

  store    Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product1 Product @relation("FBTProduct1", fields: [productId1], references: [id], onDelete: Cascade)
  product2 Product @relation("FBTProduct2", fields: [productId2], references: [id], onDelete: Cascade)

  @@unique([storeId, productId1, productId2])
  @@index([storeId, productId1])
  @@index([storeId, productId2])
  @@index([coOccurrenceCount])
  @@index([productId1])
  @@index([productId2])
  @@map("frequently_bought_together")
}

// ==========================================
// AI Recommendations
// ==========================================
//
// Catalogue-wide AI cross-sell suggestions generated by the
// bulk-ai-recommendations Inngest sweep. Priority in the
// recommendation service: manual cross-sells > AI recs > FBT.
//
// score: 0.0–1.0 confidence from Gemini. Used for ordering.
// reason: one-sentence explanation from Gemini. Useful for admin
//         debugging and future "explain this recommendation" UX.
//
// Rows are fully replaced on every re-sweep (deleteMany + createMany)
// so stale picks never accumulate.
model AiRecommendation {
  id              String   @id @default(uuid())
  storeId         String   @map("store_id")
  sourceProductId String   @map("source_product_id")
  targetProductId String   @map("target_product_id")
  score           Float    @default(0.5)
  reason          String?  @db.Text
  generatedAt     DateTime @default(now()) @map("generated_at")

  store         Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sourceProduct Product @relation("AiRecSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProduct Product @relation("AiRecTarget", fields: [targetProductId], references: [id], onDelete: Cascade)

  @@unique([storeId, sourceProductId, targetProductId])
  @@index([storeId, generatedAt])
  @@index([sourceProductId])
  @@index([targetProductId])
  @@map("ai_recommendation")
}

// ==========================================
// Shipping Carrier Integrations
// ==========================================

model ShippingCarrierConfig {
  id              String   @id @default(uuid())
  storeId         String   @map("store_id")
  /// Catalog carrier code ('bosta' | 'shipblu' | 'mylerz' | 'aramex'), validated against
  /// packages/shared/src/providers/catalog.ts. ('manual' needs no row.)
  carrier         String
  /// AES-256-GCM ciphertext of {"sandbox": {field: value}, "live": {...}, "webhookSecret": "..."}
  /// keyed by the catalog's field keys (a flat legacy map is still read; see carrier-credentials.ts).
  credentials     String   @default("")
  enabled         Boolean  @default(false)
  isDefault       Boolean  @default(false) @map("is_default")
  settings        Json     @default("{}") // pickup address, default weight, etc.
  /// Active mode of the stored credentials (true = sandbox).
  testMode        Boolean  @default(false) @map("test_mode")
  /// Non-secret display data ({set,last4} / {set,value}) per mode and field.
  credentialHints Json     @default("{}") @map("credential_hints")
  /// Last Test connection {ok, code, mode, at, fingerprint}: the enable gate.
  connectionTest  Json?    @map("connection_test")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, carrier])
  @@index([storeId])
  @@map("shipping_carrier_configs")
}

model Shipment {
  id                   String    @id @default(uuid())
  storeId              String    @map("store_id")
  orderId              String    @unique @map("order_id")
  carrier              String
  trackingNumber       String?   @map("tracking_number")
  trackingUrl          String?   @map("tracking_url")
  labelUrl             String?   @map("label_url")
  status               String    @default("created")
  carrierShipmentId    String?   @map("carrier_shipment_id")
  pickupAddress        Json      @map("pickup_address")
  deliveryAddress      Json      @map("delivery_address")
  weight               Decimal?  @db.Decimal(8, 2)
  dimensions           Json?
  estimatedDeliveryAt  DateTime? @map("estimated_delivery_at")
  statusHistory        Json      @default("[]") @map("status_history")
  error                String?
  // SP7. COD the carrier must collect, in PIASTRES (0 = prepaid). Snapshot at booking time.
  codAmount            Int       @default(0) @map("cod_amount")
  // The carrier's own transaction / delivery id when it differs from `carrierShipmentId`.
  carrierTransactionId String?   @map("carrier_transaction_id")
  // Manual carrier: the name the merchant typed ("Sprint", "Egypt Post", ...).
  carrierName          String?   @map("carrier_name")
  // How many times booking with the carrier was tried (the Inngest retry counts here).
  createAttempts       Int       @default(0) @map("create_attempts")
  lastPolledAt         DateTime? @map("last_polled_at")
  // Customer Intelligence (CI-1, docs/plans/done/2026-10-28-customer-intelligence.md 1.1). The three
  // timestamps are the FIRST time the carrier reached that state and are never overwritten (they
  // guard the first-time-only shipment events); deliveryAttempts counts failed-attempt statuses.
  pickedUpAt           DateTime? @map("picked_up_at")
  deliveredAt          DateTime? @map("delivered_at")
  returnedAt           DateTime? @map("returned_at")
  deliveryAttempts     Int       @default(0) @map("delivery_attempts")
  // Why a COD parcel came back: what the carrier wrote (scrubbed, max 200 chars) and the closed code.
  returnReasonRaw      String?   @map("return_reason_raw")
  returnReasonCode     String?   @map("return_reason_code")
  areaKey              String?   @map("area_key")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  codRemittances CodRemittance[]
  pickups        ShipmentPickup[]

  @@index([storeId])
  @@index([trackingNumber])
  @@index([storeId, status])
  @@map("shipments")
}

// A courier pickup the merchant asked a carrier for (Bosta, Aramex, Mylerz; ShipBlu requests its
// own at booking). One ACTIVE (`requesting` | `requested`) pickup per shipment, enforced by the
// partial unique index `shipment_pickups_one_active`; a `failed` or `cancelled` one may be asked
// again. `idempotency_key` (per store) makes a double-submitted request one row and ONE carrier
// call. Dates/times are Africa/Cairo wall-clock as the merchant chose them. Shown on the order
// page's shipping card (admin `ShipmentPickupPanel`).
model ShipmentPickup {
  id               String    @id @default(uuid())
  storeId          String    @map("store_id")
  shipmentId       String    @map("shipment_id")
  carrier          String
  // requesting (claimed, carrier not answered yet) | requested | failed | cancelled
  status           String    @default("requesting")
  pickupDate       String    @map("pickup_date")
  windowFrom       String?   @map("window_from")
  windowTo         String?   @map("window_to")
  // A carrier-defined slot (Mylerz PickupTimeWindowId) and its label.
  windowId         String?   @map("window_id")
  windowLabel      String?   @map("window_label")
  // What cancel / lookup take (Bosta `_id`, Aramex GUID, Mylerz PickupOrderCode).
  carrierPickupId  String?   @map("carrier_pickup_id")
  // The human-facing number (Bosta PUID, Aramex pickup ID).
  carrierReference String?   @map("carrier_reference")
  // The slot the carrier assigned (Bosta `scheduledTimeSlot`).
  carrierTimeSlot  String?   @map("carrier_time_slot")
  address          Json
  idempotencyKey   String    @map("idempotency_key")
  error            String?
  requestedById    String?   @map("requested_by_id")
  cancelledAt      DateTime? @map("cancelled_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([storeId, idempotencyKey])
  @@index([storeId])
  @@index([shipmentId])
  @@map("shipment_pickups")
}

// SP7. One line of a carrier's COD settlement: money the carrier collected for a shipment
// and what it remitted after its own fees. Append-only facts in PIASTRES; the match against
// the shipment's expected COD is computed (see cod-reconciliation.service), never stored.
// A shipment can have several lines (partial remittances).
model CodRemittance {
  id             String   @id @default(uuid())
  storeId        String   @map("store_id")
  shipmentId     String?  @map("shipment_id")
  carrier        String
  trackingNumber String   @map("tracking_number")
  // Idempotency key of the line (the carrier's own reference, else a content hash), so
  // re-uploading the same statement changes nothing.
  lineRef        String   @map("line_ref")
  batchId        String?  @map("batch_id")
  grossAmount    Int      @map("gross_amount")
  feeAmount      Int      @default(0) @map("fee_amount")
  netAmount      Int      @map("net_amount")
  remittedAt     DateTime @map("remitted_at")
  source         String   @default("csv")
  createdAt      DateTime @default(now()) @map("created_at")

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@unique([storeId, carrier, lineRef])
  @@index([storeId, shipmentId])
  @@index([shipmentId])
  @@index([storeId, trackingNumber])
  @@map("cod_remittances")
}

