// ==========================================
// Storefront View Ingest — Product Daily Views
// ==========================================
//
// One aggregate row per (store, product, calendar day in KW time).
// Populated by the public ingest endpoint POST /api/v1/public/:storeId/views.
// The nightly analytics rollup reads these to populate FunnelSnapshot.productViews.
//
// Design: aggregate not event-source — one counter per day, not a row per hit.
// Keeps the table bounded (stores × products × days_retained rows max).
//
// RLS: SELECT, INSERT, UPDATE policies in migration 20260622100000_product_daily_views.

model ProductDailyView {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  productId String   @map("product_id")
  date      DateTime @db.Date
  count     Int      @default(0)

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId, date])
  @@index([storeId, date(sort: Desc)])
  @@index([productId, date(sort: Desc)])
  @@map("product_daily_views")
}

// ==========================================
// Barcode Scanning — Cycle-count Sessions
// ==========================================
//
// A CountSession is an open or closed inventory count/audit session.
// The admin opens a session, scans products and enters counted quantities
// (CountLine rows), then closes and optionally reconciles variances into
// a StockAdjustment (type=cycle_count). The reconcile path reuses the
// existing postAdjustment service so GL journal posting is automatic.
//
// RLS: same store_id pattern (see migration 20260615000000_barcode_scanning).

enum CountSessionStatus {
  open
  closed
  reconciled
}

model CountSession {
  id           String             @id @default(uuid())
  storeId      String             @map("store_id")
  status       CountSessionStatus @default(open)
  note         String?
  createdBy    String?            @map("created_by")
  closedAt     DateTime?          @map("closed_at")
  reconciledAt DateTime?          @map("reconciled_at")
  /// Linked StockAdjustment (type=cycle_count) created at reconcile time.
  adjustmentId String?            @unique @map("adjustment_id")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  store Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lines CountLine[]

  @@index([storeId, status])
  @@index([storeId, createdAt(sort: Desc)])
  @@map("count_sessions")
}

model CountLine {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  productId  String   @map("product_id")
  variantId  String?  @map("variant_id")
  /// Counted quantity entered by the operator during the scan.
  countedQty Int      @map("counted_qty")
  /// System quantity snapshotted at the time the line was submitted.
  systemQty  Int      @map("system_qty")
  /// Positive = more stock found; negative = stock missing.
  variance   Int
  scannedAt  DateTime @default(now()) @map("scanned_at")

  session CountSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  /// One count line per product/variant per session (last scan wins via upsert).
  @@unique([sessionId, productId, variantId])
  @@index([sessionId])
  @@map("count_lines")
}

/// Phase 7: FWB-driven WhatsApp template management.
/// One row per (storeId, sourceKey, language). Status updates land via
/// the WBS bridge callback at POST /api/v1/wa-bridge/templates/status.
/// The 6 canonical sourceKeys are defined in apps/api/src/lib/wa-templates/definitions.ts;
/// new sourceKeys can be added without a schema change.
model WhatsAppTemplate {
  id              String    @id @default(uuid())
  storeId         String    @map("store_id")
  sourceKey       String    @map("source_key") @db.VarChar(64)
  language        String    @db.VarChar(8)
  metaName        String    @map("meta_name") @db.VarChar(255)
  category        String    @db.VarChar(32)
  body            String    @db.Text
  status          String    @default("draft") @db.VarChar(32)
  rejectionReason String?   @map("rejection_reason") @db.Text
  metaTemplateId  String?   @map("meta_template_id") @db.VarChar(255)
  lastSyncedAt    DateTime? @map("last_synced_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, sourceKey, language])
  @@index([storeId, status])
  @@map("whatsapp_templates")
}

// ==========================================
// Bank Reconciliation (Enterprise)
// ==========================================

enum BankStatementStatus {
  pending
  reconciling
  reconciled
}

enum BankTransactionDirection {
  debit
  credit
}

enum BankMatchStatus {
  unmatched
  auto_matched
  manual_matched
  ignored
}

model BankStatement {
  id          String              @id @default(uuid())
  storeId     String              @map("store_id")
  glAccountId String              @map("gl_account_id")
  fileName    String              @map("file_name")
  importedAt  DateTime            @default(now()) @map("imported_at")
  periodStart DateTime?           @map("period_start")
  periodEnd   DateTime?           @map("period_end")
  status      BankStatementStatus @default(pending)
  createdAt   DateTime            @default(now()) @map("created_at")

  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  glAccount    Account           @relation("BankStatementAccount", fields: [glAccountId], references: [id], onDelete: Restrict)
  transactions BankTransaction[]

  @@index([storeId, status])
  @@index([storeId, importedAt(sort: Desc)])
  @@map("bank_statements")
}

model BankTransaction {
  id                    String                   @id @default(uuid())
  statementId           String                   @map("statement_id")
  storeId               String                   @map("store_id")
  date                  DateTime
  description           String
  amountFils            Int                      @map("amount_fils")
  direction             BankTransactionDirection
  externalRef           String?                  @map("external_ref")
  rowHash               String                   @map("row_hash") @db.VarChar(64)
  matchedJournalEntryId String?                  @map("matched_journal_entry_id")
  matchStatus           BankMatchStatus          @default(unmatched) @map("match_status")
  confidence            Int                      @default(0)
  createdAt             DateTime                 @default(now()) @map("created_at")

  statement           BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  store               Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  matchedJournalEntry JournalEntry? @relation("BankTxJournalMatch", fields: [matchedJournalEntryId], references: [id], onDelete: SetNull)

  @@unique([storeId, rowHash])
  @@index([statementId])
  @@index([storeId, matchStatus])
  @@index([storeId, date])
  @@map("bank_transactions")
}

// ==========================================
// Multi-Warehouse Inventory (Enterprise)
// 2026-06-15: feat/multi-warehouse
// ==========================================

model Warehouse {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  name      String
  nameAr    String?  @map("name_ar")
  code      String // Short code e.g. "MAIN", "KWT-2"
  isDefault Boolean  @default(false) @map("is_default")
  priority  Int      @default(0) // Higher = preferred in priority routing
  lat       Float? // Optional: enables proximity routing
  lng       Float? // Optional: enables proximity routing
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  warehouseStock WarehouseStock[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([storeId, isDefault])
  @@index([storeId, priority(sort: Desc)])
  @@map("warehouses")
}

// Per-warehouse stock level for a product (or a specific variant).
// variant_id = null means the base product (no variants), or
// the product-level aggregate for a product WITH variants.
model WarehouseStock {
  id          String   @id @default(uuid())
  warehouseId String   @map("warehouse_id")
  productId   String   @map("product_id")
  variantId   String?  @map("variant_id") // null = base-product stock
  quantity    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Store FK for RLS — denormalised from warehouse to avoid a subquery in every policy.
  storeId String @map("store_id")

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId, variantId])
  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
  @@index([storeId])
  @@map("warehouse_stock")
}
