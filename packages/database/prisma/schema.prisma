// ==========================================
// Loyalty Program
// ==========================================

model LoyaltyPoints {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  customerId    String   @map("customer_id")
  points        Int      @default(0) // Current point balance
  totalEarned   Int      @default(0) @map("total_earned") // Lifetime earned
  totalRedeemed Int      @default(0) @map("total_redeemed") // Lifetime redeemed
  tier          String   @default("bronze") // Valid values: "bronze" | "silver" | "gold" | "platinum". Not an enum to avoid migrations on tier changes.
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  store    Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer User  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([storeId, customerId])
  @@index([storeId])
  @@index([customerId])
  @@map("loyalty_points")
}

model LoyaltyTransaction {
  id          String                 @id @default(uuid())
  storeId     String                 @map("store_id")
  customerId  String                 @map("customer_id")
  orderId     String?                @map("order_id")
  type        LoyaltyTransactionType
  points      Int // Positive for earn, negative for redeem
  description String?
  expiresAt   DateTime?              @map("expires_at")
  createdAt   DateTime               @default(now()) @map("created_at")

  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // At-most-one-earn-per-order is enforced by a PARTIAL unique index created in
  // migration 20260711120000_loyalty_earn_unique.sql:
  //   CREATE UNIQUE INDEX ... ON loyalty_transactions (store_id, order_id)
  //   WHERE type = 'earn_purchase'
  // A plain @@unique([storeId, orderId, type]) is NOT safe here — orderId is
  // reused across other transaction types that legitimately repeat per order
  // (e.g. `adjust` rows written by both reverseEarnedPointsFromOrder and
  // reverseRedeemedPointsFromOrder can both exist for one refunded order).
  // Prisma's schema DSL has no way to express a partial/filtered unique index,
  // so this is a hand-written raw-SQL migration with no matching @@unique here.
  //
  // A second partial unique index, from migration
  // 20260903130000_loyalty_reversal_tag_unique, covers the two reversal tags:
  //   CREATE UNIQUE INDEX ... ON loyalty_transactions
  //     (store_id, order_id, description)
  //   WHERE type = 'adjust' AND order_id IS NOT NULL
  //     AND (description LIKE 'refund-revoke:%'
  //          OR description LIKE 'redeem-recredit:%')
  // It is what makes the check-then-write guards in reverseEarnedPointsFromOrder
  // and reverseRedeemedPointsFromOrder race-safe — their P2002 handlers only
  // fire because of it. The remaining `adjust` writer (admin manual awards,
  // whose operator-supplied descriptions may legitimately repeat for one order)
  // is deliberately outside the predicate.
  //
  // The earlier 20260903120000_loyalty_cycle_tag_unique scoped itself to
  // `%:%` cycle-numbered tags that the code never writes, so it matched nothing;
  // it is left applied-but-inert and dropped by 20260903130000. Do not edit an
  // applied migration in place — Prisma checksums them and migrations run on
  // API boot.
  @@index([storeId])
  @@index([customerId])
  @@index([orderId])
  @@index([storeId, customerId])
  @@map("loyalty_transactions")
}

enum LoyaltyTransactionType {
  earn_purchase // Points earned from purchase
  earn_signup // Bonus points for signing up
  earn_referral // Points for referring someone
  earn_review // Points for leaving a review
  earn_birthday // Birthday bonus points
  earn_manual // Manually added by admin
  redeem_discount // Points redeemed for discount
  redeem_product // Points redeemed for free product
  expire // Points expired
  adjust // Manual adjustment
  tier_changed // Customer tier flipped (bronze ↔ silver ↔ gold ↔ platinum) — 0-point bookkeeping row that records the transition. Audit-trail only.
}

// ==========================================
// Customer Wallet (store credit)
// ==========================================
// Design + invariants: docs/plans/done/2026-09-25-customer-wallet.md. Every write
// goes through WalletService.applyEntry, which locks the wallet row
// (SELECT ... FOR UPDATE), re-checks the idempotency key and the balance
// UNDER the lock, then appends a ledger row and updates the cached balance in
// the same transaction. Gated per store by the `customer_wallet` feature key
// (checkout spending additionally by `customer_wallet_checkout`).

/// Cached balance for one customer in one store. The ledger below is the
/// source of truth: `balance` always equals SUM(wallet_transactions.amount)
/// for the wallet, and a DB CHECK (balance >= 0) backstops the service guard.
model CustomerWallet {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  customerId String   @map("customer_id")
  /// Current balance in PIASTRES (1 EGP = 100 piastres). Never negative.
  balance    Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // NO ACTION, not Cascade like loyalty: a money ledger must not disappear
  // because a user row was hard-deleted on its own. The only user hard-delete
  // path (DELETE /admin/users/:id) already maps the resulting P2003 to a 409.
  // NO ACTION rather than RESTRICT because the check is deferred to the end of
  // the statement: deleting a STORE cascades to its customer users AND to
  // these wallets in one statement, and RESTRICT would fail that cascade
  // depending on the order Postgres visits the two paths.
  customer     User                @relation(fields: [customerId], references: [id], onDelete: NoAction)
  transactions WalletTransaction[]

  @@unique([storeId, customerId])
  // Store wallet page: customers holding a balance, largest first.
  @@index([storeId, balance])
  // FK-only index for the User delete RI check.
  @@index([customerId])
  @@map("customer_wallets")
}

/// Append-only ledger. Rows are inserted once and never updated, except
/// that erasure nulls `note` (the only free-text field).
model WalletTransaction {
  id             String                @id @default(uuid())
  storeId        String                @map("store_id")
  walletId       String                @map("wallet_id")
  customerId     String                @map("customer_id")
  /// Signed PIASTRES: positive adds to the balance, negative spends it. Never 0.
  amount         Int
  /// Wallet balance immediately after this entry. Never negative.
  balanceAfter   Int                   @map("balance_after")
  type           WalletTransactionType
  orderId        String?               @map("order_id")
  returnId       String?               @map("return_id")
  /// Caller-chosen key that makes the write idempotent (e.g.
  /// `return-credit:<returnId>`, `order-payment:<orderId>`). Unique per store.
  idempotencyKey String                @map("idempotency_key")
  /// Acting user for admin adjustments; null for system writes. Plain column
  /// (no FK) like OrderEvent.actorId — an audit value that must survive the
  /// actor's own deletion.
  actorId        String?               @map("actor_id")
  /// Admin-entered reason. Required for admin_adjust at the API; nulled on
  /// customer erasure.
  note           String?
  createdAt      DateTime              @default(now()) @map("created_at")

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  wallet   CustomerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  customer User           @relation(fields: [customerId], references: [id], onDelete: NoAction)
  order    Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  return   Return?        @relation(fields: [returnId], references: [id], onDelete: SetNull)

  @@unique([storeId, idempotencyKey])
  // Customer history, newest first (cursor pagination).
  @@index([storeId, customerId, createdAt])
  // FK-only indexes (RI checks on wallet/user/order/return deletes).
  @@index([walletId])
  @@index([customerId])
  @@index([orderId])
  @@index([returnId])
  @@map("wallet_transactions")
}

enum WalletTransactionType {
  credit // Generic credit (reserved; admin credits use admin_adjust)
  debit // Generic debit (reserved; admin debits use admin_adjust)
  refund_credit // Return completed with the store_credit refund method
  order_payment // Balance spent at checkout (negative)
  order_payment_reversal // Checkout spend put back on cancel / refund / payment failure
  admin_adjust // Merchant manual credit or debit (note required, audited)
  expire // Balance written off (e.g. forfeited on account erasure)
}

// ==========================================
// Newsletter Subscriptions
// ==========================================

model NewsletterSubscriber {
  id             String    @id @default(uuid())
  storeId        String    @map("store_id")
  email          String
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  /// Visitor language at signup ('en' or 'ar'). Lets admins segment
  /// future campaigns by audience language.
  language       String?
  /// Signup origin: 'footer' | 'popup' | 'manual'. Useful for analytics
  /// + identifying which surface drove the signup.
  source         String?
  isActive       Boolean   @default(true) @map("is_active")
  subscribedAt   DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  /// What the address agreed to. 'newsletter' = the newsletter (footer/popup/section/manual; also
  /// allows campaigns and cart reminders); 'cart_reminders' = ONLY the checkout box "email me about
  /// my cart" - campaigns never go to it (Ruling CART-CONSENT-1). Drives the email footer wording.
  consentScope   String    @default("newsletter") @map("consent_scope")
  consentAt      DateTime? @map("consent_at")

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaignRecipients CampaignRecipient[]

  @@unique([storeId, email])
  @@index([storeId])
  @@index([isActive])
  @@map("newsletter_subscribers")
}

// ==========================================
// Email campaigns (D2, 2026-09-25)
// ==========================================
//
// Gated by the per-store `email_campaigns` feature key, which is in the Growth +
// Business plan baselines (not Basic); a super-admin override still wins.
// Nothing here sends by itself: a row only reaches Resend after a merchant
// creates a campaign AND presses send (POST /stores/:id/campaigns/:id/send).
// Plan: docs/plans/done/2026-09-25-email-campaigns.md.

/// Where an SMS-marketing consent was given or withdrawn (issue 206).
enum SmsConsentSource {
  checkout
  account
  unsubscribe
}

/// Promotional-SMS (marketing) consent, one row per customer per store
/// (issue 206). Written by the checkout opt-in and the account page, withdrawn
/// by the account page and the signed unsubscribe link. The promotional-SMS
/// gate (`notification-dispatcher.service.ts`) sends only when a row for the
/// recipient's phone is `granted`. Transactional SMS never reads it.
model SmsMarketingConsent {
  id            String            @id @default(uuid())
  storeId       String            @map("store_id")
  /// `customerKeyOf` value: the registered user id, else the guest's
  /// lowercased email, else the guest's phone — the Customers-page key.
  customerKey   String            @map("customer_key")
  /// Set when `customerKey` is a registered shopper's user id.
  userId        String?           @map("user_id")
  /// The phone the consent covers, as entered.
  phone         String
  /// Digits-only canonical form of `phone` (`smsConsentPhoneKey`); the gate
  /// and the phone-wide withdrawal match on this.
  phoneKey      String            @map("phone_key")
  granted       Boolean           @default(false)
  grantedAt     DateTime?         @map("granted_at")
  grantedSource SmsConsentSource? @map("granted_source")
  revokedAt     DateTime?         @map("revoked_at")
  revokedSource SmsConsentSource? @map("revoked_source")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, customerKey])
  @@index([storeId, phoneKey])
  @@index([userId])
  @@map("sms_marketing_consents")
}

enum CampaignStatus {
  draft
  scheduled
  sending
  sent
  cancelled
  failed
}

enum CampaignRecipientStatus {
  queued
  sent
  failed
  /// Reserved for a provider bounce webhook. Nothing sets it yet — see
  /// Ruling EC-7 in docs/RULINGS.md.
  bounced
  unsubscribed
}

/// A merchant-composed marketing email. Rendered in the admin at
/// /stores/[id]/campaigns (list) and /stores/[id]/campaigns/[campaignId].
model Campaign {
  id             String         @id @default(uuid())
  storeId        String         @map("store_id")
  name           String
  subject        String
  subjectAr      String?        @map("subject_ar")
  /// Sanitized with sanitizeNewsletterHtml on write, and again at send.
  bodyHtml       String         @map("body_html")
  bodyHtmlAr     String?        @map("body_html_ar")
  /// 'subscriber' (each recipient's signup language, else the store default)
  /// | 'en' | 'ar'. Missing content in the chosen language falls back to the
  /// other one.
  localeStrategy String         @default("subscriber") @map("locale_strategy")
  /// Audience definition. Only `{"source":"newsletter"}` exists: active,
  /// consented newsletter subscribers of this store.
  audience       Json           @default("{\"source\":\"newsletter\"}")
  status         CampaignStatus @default(draft)
  scheduledAt    DateTime?      @map("scheduled_at")
  sentAt         DateTime?      @map("sent_at")
  recipientCount Int            @default(0) @map("recipient_count")
  sentCount      Int            @default(0) @map("sent_count")
  failedCount    Int            @default(0) @map("failed_count")
  /// Machine-readable reason when status = failed (e.g. DAILY_CAP_EXCEEDED).
  lastError      String?        @map("last_error")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  store      Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  @@index([storeId, createdAt])
  @@map("campaigns")
}

/// One address a campaign was (or will be) sent to. UNIQUE(campaignId, email)
/// is the idempotency key: a retried materialize step cannot add a second row,
/// and a retried send step skips any row that is no longer `queued`.
model CampaignRecipient {
  id                String                  @id @default(uuid())
  campaignId        String                  @map("campaign_id")
  storeId           String                  @map("store_id")
  /// Lowercased + trimmed.
  email             String
  subscriberId      String?                 @map("subscriber_id")
  customerId        String?                 @map("customer_id")
  /// 'en' | 'ar' — the language this recipient's email was rendered in.
  locale            String
  status            CampaignRecipientStatus @default(queued)
  providerMessageId String?                 @map("provider_message_id")
  error             String?
  sentAt            DateTime?               @map("sent_at")
  unsubscribedAt    DateTime?               @map("unsubscribed_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  campaign   Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  store      Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subscriber NewsletterSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  customer   Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([campaignId, email])
  @@index([campaignId, status])
  // The rolling-24h per-store send cap counts sent rows by sentAt.
  @@index([storeId, status, sentAt])
  // FK-only indexes so the subscriber / customer delete RI check does not
  // sequential-scan this table.
  @@index([subscriberId])
  @@index([customerId])
  @@map("campaign_recipients")
}

// ==========================================
// Reviews & Ratings
// ==========================================

model Review {
  id         String  @id @default(cuid())
  productId  String  @map("product_id")
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId    String  @map("store_id")
  store      Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId    String  @map("order_id")
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId String? @map("customer_id")
  customer   User?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // The review content itself
  rating           Int // 1-5
  title            String?
  body             String    @db.Text
  language         String    @default("en") // 'en' | 'ar'
  bodyTranslated   String?   @map("body_translated") @db.Text // AI translation of body
  bodyTranslatedAt DateTime? @map("body_translated_at")

  // Verification + moderation
  verifiedPurchase Boolean @default(true) @map("verified_purchase") // always true via this flow
  status           String  @default("pending") // 'pending' | 'published' | 'rejected' | 'spam'
  rejectionReason  String? @map("rejection_reason")
  spamScore        Float?  @map("spam_score") // 0-1, AI-flagged
  spamReasons      Json?   @map("spam_reasons")

  // Merchant response (optional)
  ownerResponse   String?   @map("owner_response") @db.Text
  ownerResponseAr String?   @map("owner_response_ar") @db.Text
  ownerResponseAt DateTime? @map("owner_response_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([orderId, productId]) // one review per buyer-product pair
  @@index([productId, status])
  @@index([storeId, status])
  @@index([customerId])
  @@map("reviews")
}

// ==========================================
// Background jobs
// ==========================================

// Bulk product import job — queued from POST /:storeId/bulk/import,
// processed asynchronously by the Inngest `bulk-import-products`
// function so the request returns immediately and the admin can
// poll for progress instead of waiting on a long synchronous loop.
model BulkImportJob {
  id             String           @id @default(uuid())
  storeId        String           @map("store_id")
  userId         String?          @map("user_id")
  status         BulkImportStatus @default(queued)
  // Raw CSV content. Stored as text rather than referencing R2 to
  // keep the import pipeline self-contained — admin uploads are
  // small (mid-tens of MB at most) and TOAST handles it.
  csvData        String           @map("csv_data") @db.Text
  updateExisting Boolean          @default(true) @map("update_existing")
  // Progress counters — written by the Inngest function as it
  // processes rows. Polling endpoint reads these to render a
  // progress bar and final summary.
  total          Int              @default(0)
  processed      Int              @default(0)
  created        Int              @default(0)
  updated        Int              @default(0)
  failed         Int              @default(0)
  errors         Json? // Array of { row, error } once finished
  errorMessage   String?          @map("error_message") // Top-level failure reason if status=failed
  startedAt      DateTime?        @map("started_at")
  completedAt    DateTime?        @map("completed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([status])
  @@map("bulk_import_jobs")
}

enum BulkImportStatus {
  queued
  running
  completed
  failed
}

// Catalogue-wide AI sweep — translation or SEO generation across
// every product/category in a store. Started from the AI Tools admin
// page, processed by an Inngest function, polled by the same page
// for progress + final summary. The smart-skip rules from per-form
// AI buttons apply: never overwrite a filled field, never call the
// model for an entity that's already complete.
model BulkAiJob {
  id              String          @id @default(uuid())
  storeId         String          @map("store_id")
  userId          String?         @map("user_id")
  kind            BulkAiJobKind
  status          BulkAiJobStatus @default(queued)
  // Direction is meaningful only for translate jobs. `to_ar` = fill
  // empty Arabic from English source. `to_en` = the reverse.
  direction       String?         @db.Text
  total           Int             @default(0)
  processed       Int             @default(0)
  filled          Int             @default(0)
  skipped         Int             @default(0)
  failed          Int             @default(0)
  // Capped list of recent failures for surfacing to the merchant —
  // [{entityId, entityName, error}, ...]. Hard-cap to 50 so the row
  // doesn't grow unbounded on a totally-failing run.
  errors          Json?
  // Capped list of products this job actually FILLED — [{id, name}, ...]. Lets
  // the merchant see exactly which products got AI-written content so they can
  // validate the output (the `filled` integer alone isn't actionable). Capped
  // (200) like `errors` so a huge sweep can't bloat the row.
  filledProducts  Json?           @map("filled_products")
  errorMessage    String?         @map("error_message") // Top-level failure reason if status=failed
  // Durable copy of the event's `force` flag — persisted by the Inngest
  // function itself (mark-running / load-items step) so it survives the
  // per-batch `errors` column overwrites and stays readable by the
  // queue-depth-watch reaper when it needs to re-enqueue a stuck job.
  force           Boolean         @default(false)
  // How many times queue-depth-watch has auto-resumed (re-enqueued) this
  // job after finding it stuck `running`. Capped by MAX_AUTO_RESUMES so a
  // job that keeps crashing at the same batch can't loop forever — once
  // the cap is hit the reaper falls back to marking it failed + alerting.
  autoResumeCount Int             @default(0) @map("auto_resume_count")
  startedAt       DateTime?       @map("started_at")
  completedAt     DateTime?       @map("completed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([status])
  @@map("bulk_ai_jobs")
}

enum BulkAiJobKind {
  translate
  seo
  faq_aeo
  howto_aeo
  meta_aeo
  recommendations
  // GEO sweep kinds
  llms_txt
  citation_copy
  brand_facts
  description_balance
  description_revert
  // Catalogue field sweeps (2026-07-03)
  product_faqs
  category_assign
  image_alt
  excerpt
  product_tags
}

enum BulkAiJobStatus {
  queued
  running
  completed
  failed
  cancelled
}

// Tracks every AI call made on behalf of a store so we can enforce
// per-store daily token budgets, audit usage, and bill (if/when we
// charge for it). `cachedHit=true` means the AI service returned a
// cached answer and didn't actually call the model — counted for
// observability but not against the token budget.
model AiUsage {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  feature      String // 'translate' | 'seo' | 'categorize'
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  cachedHit    Boolean  @default(false) @map("cached_hit")
  /// Which model produced this output. Part of the generation log (EU AI Act
  /// transparency) — unlike a label, this CANNOT be reconstructed after the
  /// fact, so it is recorded at write time. NULL = row predates provenance.
  model        String?
  /// Cost in MICROS of the store's billing currency (1_000_000 micros = 1 unit).
  /// Micros not piastres: per-call AI spend is routinely a fraction of a piastre, and
  /// integer piastres would round every single row to 0. NULL means "no rate was
  /// configured for this model", which is deliberately distinct from 0 — a
  /// cached hit genuinely costs nothing. See lib/ai-pricing.ts.
  costMicros   Int?     @map("cost_micros")
  /// What the generated output was attached to, e.g. 'product' + its id. Lets
  /// an audit answer "what did this system generate, and where did it go".
  subjectType  String?  @map("subject_type")
  subjectId    String?  @map("subject_id")
  createdAt    DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([feature])
  @@index([model, createdAt])
  // Platform-wide quota counts (lib/ai-quota.ts, the super-admin AI
  // dashboard): created_at range + cached_hit, across every store.
  // 20261001140000.
  @@index([createdAt, cachedHit])
  @@map("ai_usage")
}

// ==========================================
// AEO / GEO content — FAQ + HowTo
// ==========================================

model StoreFaq {
  id             String   @id @default(cuid())
  storeId        String   @map("store_id")
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  question       String   @map("question")
  questionAr     String?  @map("question_ar")
  answer         String   @map("answer") @db.Text
  answerAr       String?  @map("answer_ar") @db.Text
  // AI-draft state — smart-skip in the Gemini bulk sweep never overwrites
  // a manually-edited entry.
  aiDrafted      Boolean  @default(false) @map("ai_drafted")
  manuallyEdited Boolean  @default(false) @map("manually_edited")
  orderIndex     Int      @default(0) @map("order_index")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([storeId, isActive, orderIndex])
  @@map("store_faqs")
}

model StoreHowto {
  id             String   @id @default(cuid())
  storeId        String   @map("store_id")
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title          String   @map("title")
  titleAr        String?  @map("title_ar")
  description    String   @map("description") @db.Text
  descriptionAr  String?  @map("description_ar") @db.Text
  // HowTo.step is an array of HowToStep — stored as JSON.
  // Format: [{ name, text, image? }, ...]
  steps          Json     @map("steps")
  // Arabic steps — same shape as steps but bilingual text values.
  stepsAr        Json?    @map("steps_ar")
  aiDrafted      Boolean  @default(false) @map("ai_drafted")
  manuallyEdited Boolean  @default(false) @map("manually_edited")
  orderIndex     Int      @default(0) @map("order_index")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([storeId, isActive, orderIndex])
  @@map("store_howtos")
}

// Per-product FAQs (e.g. "Does this ring come in size 7?") — separate
// from store-level FAQs so Product schema can include them inline.
model ProductFaq {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  question       String
  questionAr     String?  @map("question_ar")
  answer         String   @db.Text
  answerAr       String?  @map("answer_ar") @db.Text
  aiDrafted      Boolean  @default(false) @map("ai_drafted")
  manuallyEdited Boolean  @default(false) @map("manually_edited")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_faqs")
}

// ==========================================
// Accounting (Batch 1 — foundations)
// ==========================================

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum JournalEntrySource {
  order
  refund
  purchase_order
  expense
  stock_adjustment
  manual
  period_close
  opening_balance
}

enum JournalEntryStatus {
  posted
  reversed
  draft
}

model Sequence {
  // Per-store, per-kind monotonically-increasing counter. Used for entryNumber,
  // poNumber, adjustmentNumber, expenseNumber. Atomic increment via FOR UPDATE.
  storeId   String   @map("store_id")
  kind      String // 'journal' | 'po' | 'adjustment' | 'expense'
  next      Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, kind])
  @@map("sequences")
}

model Account {
  id        String      @id @default(uuid())
  storeId   String      @map("store_id")
  code      String
  nameEn    String      @map("name_en")
  nameAr    String?     @map("name_ar")
  type      AccountType
  parentId  String?     @map("parent_id")
  isSystem  Boolean     @default(false) @map("is_system")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  store              Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent             Account?        @relation("AccountTree", fields: [parentId], references: [id])
  children           Account[]       @relation("AccountTree")
  lines              JournalLine[]
  expensesByCategory Expense[]       @relation("ExpenseCategoryAccount")
  expensesPaidFrom   Expense[]       @relation("ExpensePaidFromAccount")
  purchaseOrders     PurchaseOrder[] @relation("PoApAccount")
  bankStatements     BankStatement[] @relation("BankStatementAccount")

  @@unique([storeId, code])
  @@index([storeId, type])
  @@index([parentId])
  @@map("accounts")
}

model JournalEntry {
  id           String             @id @default(uuid())
  storeId      String             @map("store_id")
  entryNumber  String             @map("entry_number")
  postedAt     DateTime           @map("posted_at")
  source       JournalEntrySource
  sourceId     String?            @map("source_id")
  reversedById String?            @unique @map("reversed_by_id")
  memo         String?
  memoAr       String?            @map("memo_ar")
  status       JournalEntryStatus @default(posted)
  postedBy     String?            @map("posted_by")
  createdAt    DateTime           @default(now()) @map("created_at")

  store         Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  lines         JournalLine[]
  reversedBy    JournalEntry?     @relation("Reversal", fields: [reversedById], references: [id])
  reverses      JournalEntry?     @relation("Reversal")
  bankTxMatches BankTransaction[] @relation("BankTxJournalMatch")

  @@unique([storeId, entryNumber])
  @@index([storeId, postedAt(sort: Desc)])
  @@index([source, sourceId])
  @@index([storeId, status])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(uuid())
  entryId        String   @map("entry_id")
  accountId      String   @map("account_id")
  debit          Int      @default(0)
  credit         Int      @default(0)
  currency       String   @default("EGP")
  /// FX rate: 1 unit of `currency` = fxRate EGP.
  /// Stored as exact numeric(16,8) — no float drift.
  /// EGP lines: 1. Non-EGP: e.g. 0.30700000 for USD→EGP.
  fxRate         Decimal? @default(1) @map("fx_rate") @db.Decimal(16, 8)
  /// Original amount in minor units of `currency` before EGP conversion.
  /// For EGP lines this equals debit (or credit). For non-EGP lines this is
  /// the raw foreign amount; debit/credit hold the EGP-converted piastres.
  originalAmount Int?     @default(0) @map("original_amount")
  lineMemo       String?  @map("line_memo")
  lineMemoAr     String?  @map("line_memo_ar")
  refTable       String?  @map("ref_table")
  refId          String?  @map("ref_id")
  createdAt      DateTime @default(now()) @map("created_at")

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
  @@index([refTable, refId])
  @@map("journal_lines")
}

/**
 * FX Rate Registry — merchant-maintained log of exchange rates for a date.
 * Rate meaning: 1 unit of `currency` = `rate` EGP.
 * Example: { currency: 'USD', rate: 0.307, rateDate: '2026-06-15' }
 * means 1 USD was worth 0.307 EGP on that date.
 * There is no unique constraint on (storeId, currency, rateDate) by design —
 * merchants may record multiple rates for the same date (intraday corrections).
 * The most recently created row for a given date is the effective rate.
 * Feature gate: accounting.multi_currency (Enterprise).
 * RLS: standard store_id-scoped policy.
 */
model FxRateEntry {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  /// ISO-4217 currency code (e.g. 'USD', 'EUR'). Always uppercase.
  currency   String
  /// Rate: 1 unit of `currency` = rate EGP. numeric(16,8) — exact decimal.
  rate       Decimal  @db.Decimal(16, 8)
  /// Date the rate applies to. Stored as a date-only timestamp (UTC midnight).
  rateDate   DateTime @map("rate_date") @db.Date
  recordedBy String?  @map("recorded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, currency, rateDate(sort: Desc)])
  @@map("fx_rate_entries")
}

