// Ebda - Database Schema
// Prisma ORM
//
// NOTE: Prisma Migrate does not generate down (rollback) migrations by default.
// For critical schema changes (e.g. dropping columns, renaming tables, changing
// types), write a manual SQL down-migration in the corresponding migration
// directory (e.g. prisma/migrations/<name>/down.sql) so the change can be
// safely reverted in production if needed.

// Ebda (R-EBDA-001): the query compiler (wasm) runs the same client under Node
// (Express, vitest) and under workerd, so there is no native engine binary to
// ship. The client MUST be built with a driver adapter (`@prisma/adapter-pg`):
// see src/client.ts. `driverAdapters` and `queryCompiler` were previews before
// 6.16; on 6.19.3 they are deprecated no-ops (generate warns if listed), and
// `engineType = "client"` alone selects both. Proven in spikes/workers-api.
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// User & Authentication
// ==========================================

model User {
  id            String     @id @default(uuid())
  // Customer accounts are scoped to a single store. The same email can
  // register on Store A and Store B without colliding — Store A's
  // ahmad@x.com is a distinct account from Store B's ahmad@x.com.
  //
  // Admins leave this NULL because admin emails sit in one global
  // namespace (enforced by the partial unique `users_admin_email_key`).
  // NULL is NOT an access grant: store_admins still only see the stores
  // they own, gated by Store.ownerId + the `requireStoreAccess`
  // middleware on every admin route. A super_admin can never silently
  // become a customer of any store, and a store_admin can never read
  // another tenant's data.
  storeId       String?    @map("store_id")
  email         String
  passwordHash  String     @map("password_hash")
  firstName     String     @map("first_name")
  lastName      String     @map("last_name")
  phone         String?
  role          UserRole   @default(customer)
  status        UserStatus @default(active)
  emailVerified Boolean    @default(false) @map("email_verified")
  avatar        String?
  dateOfBirth   DateTime?  @map("date_of_birth") // For birthday bonus automation
  language      String     @default("en") // en, ar
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at") // Soft delete support

  // Ebda's own acquisition tracking (merchant accounts only): first-touch utm/fbclid, Meta
  // click/browser ids, consent and the signup request's ip/ua. NULL for customers, super-admins
  // and anyone who signed up without consenting. Shape: EbdaAcquisition in
  // apps/api/src/services/ebda-ads.service.ts. Additive column; see docs/ebda/ads-tracking.md.
  acquisition Json?

  // 2FA / MFA
  mfaEnabled     Boolean   @default(false) @map("mfa_enabled")
  mfaSecret      String?   @map("mfa_secret")
  mfaBackupCodes String[]  @default([]) @map("mfa_backup_codes")
  mfaEnrolledAt  DateTime? @map("mfa_enrolled_at")
  // session revocation
  tokenVersion   Int       @default(0) @map("token_version")

  // Relations
  authStore                Store?                  @relation("StoreCustomers", fields: [storeId], references: [id], onDelete: Cascade)
  stores                   Store[]
  merchantApiKeys          MerchantApiKey[]
  orders                   Order[]
  carts                    Cart[]
  addresses                Address[]
  refreshTokens            RefreshToken[]
  verificationTokens       VerificationToken[]
  auditLogs                AuditLog[]
  wishlists                Wishlist[]
  reviews                  Review[]
  returns                  Return[]
  loyaltyPoints            LoyaltyPoints[]
  loyaltyTransactions      LoyaltyTransaction[]
  customerWallets          CustomerWallet[]
  walletTransactions       WalletTransaction[]
  featureToggles           StoreFeature[]          @relation("FeatureToggledBy")
  pushSubscriptions        PushSubscription[]      @relation("UserPushSubscriptions")
  onesignalSubscriptions   OneSignalSubscription[] @relation("UserOneSignalSubscriptions")
  abandonedCarts           AbandonedCart[]         @relation("AbandonedCartCustomer")
  smsMarketingConsents     SmsMarketingConsent[]
  triggeredPaymentEvents   PaymentEvent[]
  triggeredAffiliateEvents AffiliateEvent[]        @relation("AffiliateEventTriggeredBy")
  triggeredOrderEvents     OrderEvent[]            @relation("OrderEventActor")
  staffMemberships         StoreStaff[]            @relation("StaffUser")
  legalAcceptances         LegalAcceptance[]
  passkeyCredentials       PasskeyCredential[]
  legalNoticeDeliveries    LegalNoticeDelivery[]
  wholesaleApplications    WholesaleApplication[]

  // Composite unique (storeId, email) — one customer account per email per
  // store. Admins (storeId NULL) are not subject to this constraint thanks
  // to Postgres treating NULLs as distinct, so we add a partial unique
  // index in the migration to keep admin emails globally unique.
  //
  // ⚠️ MIGRATION GUARD: the partial unique `users_admin_email_key`
  // (`UNIQUE ON users(email) WHERE store_id IS NULL`) is NOT
  // representable in Prisma's `@@unique` syntax, so `prisma migrate dev`
  // will offer to drop it on every diff against this schema. NEVER
  // accept that drop — duplicate global admin emails break login
  // (AuthService.login uses findFirst, gets non-deterministic row).
  // The reassert migration `20260430030000_reassert_admin_email_unique`
  // re-creates it idempotently on every `migrate deploy`.
  @@unique([storeId, email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
  // Order search (OrderService.orderSearchWhere) resolves customers by name /
  // email / phone through four pg_trgm GIN indexes —
  // `users_{first_name,last_name,email,phone}_trgm_idx`. Raw SQL only
  // (20261002090000_order_search_trgm_and_fk_indexes); a `migrate diff` will
  // offer to drop them. NEVER accept that drop.
  @@map("users")
}

enum UserRole {
  customer
  store_admin
  super_admin
  staff
}

enum UserStatus {
  active
  inactive
  suspended
}

model RefreshToken {
  id            String    @id @default(uuid())
  token         String    @unique
  userId        String    @map("user_id")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  // Reuse-detection fields. On rotate we keep the old row (with
  // replacedById set) instead of deleting it so a replay of the same
  // refresh token is recognisable as a stolen-token signal. See
  // AuthService.refreshTokens — any lookup hitting a row with
  // revokedAt!=NULL revokes every token for that user.
  replacedById  String?   @map("replaced_by_id")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String                @id @default(uuid())
  token     String                @unique
  userId    String                @map("user_id")
  type      VerificationTokenType @default(email)
  expiresAt DateTime              @map("expires_at")
  usedAt    DateTime?             @map("used_at")
  createdAt DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([type])
  @@map("verification_tokens")
}

enum VerificationTokenType {
  email
  password_reset
  two_factor
}

// ==========================================
// Store (Multi-tenant)
// ==========================================

model Store {
  id                     String      @id @default(uuid())
  name                   String
  nameAr                 String?     @map("name_ar")
  slug                   String      @unique
  // The VERIFIED custom domain: the only column host resolution, CORS and
  // storefrontOrigin read. A claim that is not yet verified lives in
  // `pendingDomain` (never served), so a squatter's unproven claim can never
  // route traffic or poison the credentialed-CORS allowlist. `domainStatus` is
  // the state of the latest claim ('pending' | 'active' | 'failed', CHECK-
  // constrained in SQL): pending -> active (provider verified) or failed; a
  // pending/failed claim is released after DOMAIN_CLAIM_TTL_HOURS.
  domain                 String?     @unique
  domainStatus           String?     @map("domain_status")
  pendingDomain          String?     @map("pending_domain")
  domainClaimedAt        DateTime?   @map("domain_claimed_at")
  domainVerifiedAt       DateTime?   @map("domain_verified_at")
  // Legacy frontend-hosting-provider column. Cloudflare-for-SaaS is the only
  // provider now (Vercel cancelled 2026-07) — kept as-is, no migration needed.
  domainProvider         String?     @map("domain_provider")
  // Resend email-sender state (platform-managed under a single Resend account)
  emailSenderLocalPart   String      @default("noreply") @map("email_sender_local_part")
  emailDomainId          String?     @map("email_domain_id")
  emailDomainStatus      String?     @map("email_domain_status")
  emailDomainVerifiedAt  DateTime?   @map("email_domain_verified_at")
  ownerId                String      @map("owner_id")
  status                 StoreStatus @default(active)
  /// Why billing suspended the store (unpaid | over_store_limit); NULL = not a
  /// billing suspension. Only these are lifted automatically (EBDA-FUNNEL-10).
  billingSuspendedReason String?     @map("billing_suspended_reason")
  billingSuspendedAt     DateTime?   @map("billing_suspended_at")
  plan                   StorePlan   @default(starter)
  logo                   String?
  logoAr                 String?     @map("logo_ar")
  favicon                String?
  // Hero customization
  heroTitle              String?     @map("hero_title")
  heroTitleAr            String?     @map("hero_title_ar")
  heroSubtitle           String?     @map("hero_subtitle")
  heroSubtitleAr         String?     @map("hero_subtitle_ar")
  heroCtaText            String?     @map("hero_cta_text")
  heroCtaTextAr          String?     @map("hero_cta_text_ar")
  heroCtaLink            String?     @map("hero_cta_link")
  heroImage              String?     @map("hero_image")
  // Cover image shown on the storefront's Best Sellers virtual
  // category tile. Optional — when null the storefront falls back to
  // the text-only treatment.
  bestSellersImage       String?     @map("best_sellers_image")
  // Per-store typography overrides — see TypographySettings type in
  // @ebda/shared. JSON because the shape will keep evolving (more
  // zones, line-height/letter-spacing, etc.) and we don't want a
  // column-add migration each time.
  typography             Json?       @map("typography")
  description            String?
  descriptionAr          String?     @map("description_ar")
  currency               String      @default("EGP")
  timezone               String      @default("Africa/Cairo")
  settings               Json        @default("{}")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")
  deletedAt              DateTime?   @map("deleted_at") // Soft delete support

  // Template & Theme
  template       StoreTemplate @default(qamar)
  look           String?       @map("look") // "<template>.<slug>" from the shared looks registry; NULL = template default
  isDemo         Boolean       @default(false) @map("is_demo")
  theme          Json          @default("{}") // StoreTheme JSON
  layoutSettings Json          @default("{}") @map("layout_settings") // StoreLayoutSettings JSON — empty object means "use packaged defaults" (the Demo Store flow)

  // Social Links
  socialLinks Json @default("{}") @map("social_links") // StoreSocialLinks JSON

  // Contact Information
  email         String?
  phone         String?
  phoneAr       String? @map("phone_ar")
  whatsapp      String?
  address       String?
  addressAr     String? @map("address_ar")
  businessHours String? @map("business_hours") // free-text, e.g. "Sat–Thu 9am–10pm"
  googleMapsUrl String? @map("google_maps_url") // full Maps URL for the store location

  // Announcement Bar
  announcementBar Json? @map("announcement_bar") // AnnouncementBar JSON

  // SEO
  metaTitle              String? @map("meta_title")
  metaTitleAr            String? @map("meta_title_ar")
  metaDescription        String? @map("meta_description")
  metaDescriptionAr      String? @map("meta_description_ar")
  // AEO — conversational answer-engine copy. Written by bulk-ai-meta-aeo
  // sweep. Storefront coalesces at render time: AEO > SEO > null.
  metaDescriptionAeo     String? @map("meta_description_aeo")
  metaDescriptionAeoAr   String? @map("meta_description_aeo_ar")
  ogImage                String? @map("og_image")
  twitterHandle          String? @map("twitter_handle")
  googleSiteVerification String? @map("google_site_verification")

  // Marketing Pixels & Analytics
  marketingPixels    Json    @default("{}") @map("marketing_pixels") // MarketingPixels JSON
  // Individual pixel IDs for quick access
  metaPixelId        String? @map("meta_pixel_id") // Facebook/Meta Pixel
  tiktokPixelId      String? @map("tiktok_pixel_id") // TikTok Pixel
  snapchatPixelId    String? @map("snapchat_pixel_id") // Snapchat Pixel
  googleAnalyticsId  String? @map("google_analytics_id") // GA4 Measurement ID
  googleTagManagerId String? @map("google_tag_manager_id") // GTM Container ID
  googleAdsId        String? @map("google_ads_id") // Google Ads Conversion ID
  twitterPixelId     String? @map("twitter_pixel_id") // Twitter/X Pixel
  pinterestTagId     String? @map("pinterest_tag_id") // Pinterest Tag

  // Tax Settings
  // `taxEnabled` is the merchant's WISH to collect VAT. Collection is effective
  // only while the store's `StoreTaxProfile` is `verified` (ruling TAX-2,
  // supersedes TAX-1's "taxEnabled alone"): `resolveActiveTaxRate` returns 0
  // otherwise, and the settings route refuses `taxEnabled: true` until then.
  taxEnabled         Boolean  @default(false) @map("tax_enabled")
  taxIncludedInPrice Boolean  @default(false) @map("tax_included_in_price") // Prices include tax
  defaultTaxRate     Decimal? @map("default_tax_rate") @db.Decimal(5, 2) // Default tax percentage

  // Loyalty Program Settings
  loyaltyEnabled  Boolean @default(false) @map("loyalty_enabled")
  loyaltySettings Json    @default("{}") @map("loyalty_settings") // LoyaltySettings JSON

  // PWA Settings
  pwaEnabled  Boolean @default(false) @map("pwa_enabled")
  // PWASettings JSON. Icon fields (all optional, all nullable-by-absence):
  // icon192/icon512/maskableIcon (original set) plus, since B5
  // (docs/superpowers/plans/2026-05-04-storefront-per-store-pwa-full-sizes.md):
  // iconSource (merchant-uploaded 512x512+ original), icon384, iconAppleTouch
  // (180x180), favicon32, favicon16 — all generated server-side by
  // PWAService.generatePwaIconSet and additive to this JSONB blob, no column
  // migration needed. See packages/database/prisma/migrations/
  // 20260925120000_store_pwa_settings_gin for the (JSON-shape-agnostic) index
  // this feature added instead.
  pwaSettings Json    @default("{}") @map("pwa_settings")

  // Blog (Bucket E1, 2026-05-17) — opt-in per store. When false the
  // /blog routes return 404 and BlogCarousel hides on the homepage.
  blogEnabled Boolean @default(false) @map("blog_enabled")

  // Store Locations / Branches — opt-in per store. When false the
  // /locations routes return 404 and the locations admin page is hidden.
  locationsEnabled Boolean @default(false) @map("locations_enabled")

  /// When the agent (MCP) write credential was last minted / revoked. The credential
  /// itself is `StoreCredential.agentApiKey` (R-EBDA-005).
  agentApiKeyRotatedAt DateTime? @map("agent_api_key_rotated_at")

  // GEO (Generative Engine Optimization) — LLM-search visibility fields.
  // Written by bulk-ai-geo Inngest sweep. Merchantscan edit via admin.
  /// LLMs.txt content for this store — served at /<slug>/llms.txt by the storefront.
  llmsTxt   String? @map("llms_txt")
  /// Structured brand facts: { foundedYear?, location?, categories[], certifications?, languages[], contact? }
  aboutJson Json?   @map("about_json")

  /// Merchant return window in days, powering `hasMerchantReturnPolicy` in the
  /// storefront's Product JSON-LD (AI shopping agents filter on it).
  ///
  /// NULL and 0 mean DIFFERENT things and must never be collapsed:
  ///   NULL = the merchant has not declared a policy  -> the block is omitted
  ///   0    = the merchant does not accept returns    -> published as such
  ///
  /// Deliberately has NO default. Publishing a return window a merchant never
  /// agreed to is a false public claim about their business.
  returnWindowDays Int?    @map("return_window_days")
  /// Who pays return shipping: 'merchant' (free returns) | 'customer'. NULL when unset.
  returnFeesPaidBy String? @map("return_fees_paid_by")

  // Accounting Settings (Batch 1)
  accountingEnabled    Boolean @default(true) @map("accounting_enabled")
  defaultTaxRateBps    Int     @default(0) @map("default_tax_rate_bps")
  fiscalYearStartMonth Int     @default(1) @map("fiscal_year_start_month")

  // Accounting Settings (Batch 2)
  expenseTwoStepApproval Boolean @default(false) @map("expense_two_step_approval")

  // Accounting Settings (Batch 3)
  aiFeaturesEnabled Boolean @default(true) @map("ai_features_enabled")
  aiBulkThrottleMs  Int     @default(2500) @map("ai_bulk_throttle_ms")

  // Accounting Settings (Batch 4 — Insights)
  aiNarrationEnabled Boolean @default(true) @map("ai_narration_enabled")
  insightsRollupCron String  @default("daily") @map("insights_rollup_cron")

  /// Customer Intelligence (CI-1, docs/plans/done/2026-10-28-customer-intelligence.md rule 3): the merchant's
  /// opt-in to cross-store signals. Default OFF; only the (later) onboarding/settings write path sets it.
  ciSharing          Boolean   @default(false) @map("ci_sharing")
  ciSharingChangedAt DateTime? @map("ci_sharing_changed_at")

  // Relations
  owner                      User                        @relation(fields: [ownerId], references: [id])
  /// Encrypted provider credentials, split out of the routing table (R-EBDA-005).
  credentials                StoreCredential?
  whatsappLink               StoreWhatsAppLink?
  whatsappConsents           StoreWhatsAppConsent[]
  // Customer accounts that authenticate against this store. Distinct from
  // `customers` (which is the per-store order-history record).
  customerUsers              User[]                      @relation("StoreCustomers")
  products                   Product[]
  categories                 Category[]
  orders                     Order[]
  carts                      Cart[]
  customers                  Customer[]
  customerGroups             CustomerGroup[]
  paymentConfigs             PaymentConfig[]
  coupons                    Coupon[]
  promotions                 Promotion[]
  bundles                    Bundle[]
  shippingZones              ShippingZone[]
  shippingAreaRates          ShippingAreaRate[]
  taxRates                   TaxRate[]
  taxProfile                 StoreTaxProfile?
  taxDocuments               StoreTaxDocument[]
  loyaltyPoints              LoyaltyPoints[]
  loyaltyTransactions        LoyaltyTransaction[]
  customerWallets            CustomerWallet[]
  walletTransactions         WalletTransaction[]
  wishlists                  Wishlist[]
  newsletters                NewsletterSubscriber[]
  campaigns                  Campaign[]
  webhookEndpoints           WebhookEndpoint[]
  webhookDeliveries          WebhookDelivery[]
  campaignRecipients         CampaignRecipient[]
  reviews                    Review[]
  returns                    Return[]
  inventoryHistory           InventoryHistory[]
  tags                       Tag[]
  auditLogs                  AuditLog[]
  features                   StoreFeature[]
  merchantApiKeys            MerchantApiKey[]
  smsMarketingConsents       SmsMarketingConsent[]
  notificationConfigs        NotificationConfig[]
  notificationEventConfigs   NotificationEventConfig[]
  pushSubscriptions          PushSubscription[]
  notificationLogs           NotificationLog[]
  abandonedCarts             AbandonedCart[]
  abandonedCartConfig        AbandonedCartConfig?
  productRelations           ProductRelation[]
  frequentlyBoughtTogether   FrequentlyBoughtTogether[]
  aiRecommendations          AiRecommendation[]
  shippingCarrierConfigs     ShippingCarrierConfig[]
  shipments                  Shipment[]
  shipmentPickups            ShipmentPickup[]
  providerActivationRequests ProviderActivationRequest[]
  trustRequests              TrustRequest[]
  codRemittances             CodRemittance[]
  pageRevisions              StorePageRevision[]
  productModels              ProductModel[]
  sizeCharts                 SizeChart[]
  goldRates                  GoldRate[]
  goldRatesCurrent           GoldRateCurrent[]
  goldRateSettings           GoldRateSettings?
  searchQueryDaily           SearchQueryDaily[]
  productEmbeddings          ProductEmbedding[]
  productEmbedFailures       ProductEmbedFailure[]
  productPriceTiers          ProductPriceTier[]
  wholesaleApplications      WholesaleApplication[]
  productModelBindings       ProductModelBinding[]
  affiliates                 Affiliate[]
  affiliateReferrals         AffiliateReferral[]
  affiliatePayouts           AffiliatePayout[]
  affiliateConfig            AffiliateConfig?
  affiliateEvents            AffiliateEvent[]
  pages                      StorePage[]
  bulkImportJobs             BulkImportJob[]
  catalogImportJobs          CatalogImportJob[]
  catalogImportFiles         CatalogImportFile[]
  catalogImportItems         CatalogImportItem[]
  aiUsage                    AiUsage[]
  bulkAiJobs                 BulkAiJob[]
  faqs                       StoreFaq[]
  howtos                     StoreHowto[]
  blogPosts                  BlogPost[]
  locations                  StoreLocation[]
  accounts                   Account[]
  journalEntries             JournalEntry[]
  sequences                  Sequence[]
  suppliers                  Supplier[]
  purchaseOrders             PurchaseOrder[]
  stockAdjustments           StockAdjustment[]
  reorderRules               ReorderRule[]
  backorderLines             BackorderLine[]
  expenses                   Expense[]
  fxRateEntries              FxRateEntry[]
  reorderSuggestions         ReorderSuggestion[]
  deadstockFlags             DeadStockFlag[]
  profitAnomalies            ProfitAnomaly[]
  customerCohortSnapshots    CustomerCohortSnapshot[]
  funnelSnapshots            FunnelSnapshot[]
  customerRfmSnapshots       CustomerRfmSnapshot[]
  productDailyViews          ProductDailyView[]
  qrScanDaily                QrScanDaily[]
  ciStoreGates               CiStoreGate[]
  ciHintLogs                 CiHintLog[]
  paymentEvents              PaymentEvent[]
  orderEvents                OrderEvent[]
  webhookEvents              WebhookEvent[]
  bankStatements             BankStatement[]
  bankTransactions           BankTransaction[]
  warehouses                 Warehouse[]
  warehouseStock             WarehouseStock[]
  countSessions              CountSession[]
  staffMembers               StoreStaff[]                @relation("StoreStaffMembers")
  slugRedirects              SlugRedirect[]
  answerEngineChecks         AnswerEngineCheck[]
  gscDailyMetrics            GscDailyMetric[]
  usageSnapshots             StoreUsageSnapshot[]
  subscription               StoreSubscription?
  billingEvents              BillingEvent[]
  manualPaymentClaims        ManualPaymentClaim[]
  instapayReceipts           InstapayReceipt[]
  billingReminders           BillingReminder[]
  lifecycleEmails            StoreLifecycleEmail[]
  staffInvites               StaffInvite[]

  @@index([ownerId])
  @@index([status])
  @@index([plan])
  @@index([createdAt])
  @@index([pendingDomain])
  @@map("stores")
  etaConnection EtaConnection?
  etaReceipts   EtaReceipt[]
}

/// Encrypted per-store provider credentials (R-EBDA-005, closes R-EBDA-002): moved out of
/// `stores` so the routing table holds no secret. Strict store RLS. One row per store, created
/// on first write (`credentials: { upsert: ... }`). Every value is AES-256-GCM ciphertext from
/// apps/api/src/services/encryption.service.ts; the client omits all three by default, so a
/// reader names the field it needs in a `select`.
/// Server-owned link state of Ebda Chat for a store (Store <-> WhatsApp contract 2026-10-24).
/// Written ONLY by WhatsAppLinkService (the `store.linked` / `store.unlinked` path), never by a
/// merchant-facing route or the merchant-writable `stores.settings` JSON, which is where a flag
/// would let a store owner switch the integration on. Read by lib/wa/link.ts together with the
/// plan entitlement.
model StoreWhatsAppLink {
  storeId     String    @id @map("store_id")
  linked      Boolean   @default(false)
  ownerUserId String?   @map("owner_user_id")
  linkedAt    DateTime? @map("linked_at")
  /// The messaging package's standing, from Ebda Chat's `whatsapp.entitlement_changed` (bought
  /// there, included by the plan, or assigned by an operator). `entitlementVersion` only goes up:
  /// an event that is not newer is ignored. Server-side only, like the link itself.
  entitlementVersion    Int       @default(0) @map("entitlement_version")
  entitlementPackageId  String?   @map("entitlement_package_id")
  entitlementAutomation Boolean   @default(false) @map("entitlement_automation")
  entitlementStatus     String?   @map("entitlement_status")
  entitlementValidUntil DateTime? @map("entitlement_valid_until")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_whatsapp_links")
}

/// A buyer's WhatsApp MARKETING consent for one store (Ruling WA-CONSENT-1: cart reminders are marketing,
/// PDPL needs prior consent). Keyed by `buyerKey` (the suite HMAC of the E.164 phone, NEVER the phone), so
/// it lines up with Ebda Chat's own keys and holds no raw number. Unticked by default; revocable.
/// Order, COD and shipping messages are transactional and do not read this.
model StoreWhatsAppConsent {
  storeId     String    @map("store_id")
  buyerKey    String    @map("buyer_key")
  granted     Boolean   @default(false)
  grantedAt   DateTime? @map("granted_at")
  /// 'checkout' | 'cart' | 'admin' | 'whatsapp' (a STOP the buyer sent); revoke also 'erasure' | 'profile' (phone changed)
  grantedSource String? @map("granted_source")
  /// The language of the label the buyer saw when ticking.
  locale      String?
  revokedAt   DateTime? @map("revoked_at")
  revokedSource String? @map("revoked_source")
  /// The account that last granted/withdrew this row (null for a STOP sent on WhatsApp). Lets export and
  /// erasure cover EVERY row an account ever created, also those of an earlier phone number.
  userId      String?   @map("user_id")
  /// Highest `whatsapp.opt_out_changed` version applied (monotonic; a stale or replayed event is ignored).
  optOutVersion Int     @default(0) @map("opt_out_version")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, buyerKey])
  @@index([storeId, userId])
  @@map("store_whatsapp_consents")
}

model StoreCredential {
  storeId         String   @id @map("store_id")
  /// Agent (MCP) write credential (was `stores.agent_api_key`).
  agentApiKey     String?  @map("agent_api_key")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_credentials")
}

// ==========================================
// Staff Accounts (store-scoped team members)
// ==========================================

/**
 * Links a `staff`-role user to a specific store.
 * A staff user can only access stores they are members of.
 * The owning store_admin (or super_admin) adds/removes rows here.
 */
model StoreStaff {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation("StoreStaffMembers", fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation("StaffUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId])
  @@map("store_staff")
}

/// A staff invitation sent to an address that already has an account (Ruling ID-13). `id` is the jti of the signed link:
/// the link is valid only while this row is `pending` and unexpired, and accepting it flips the row in the SAME transaction
/// that creates the StoreStaff row, so a link works once. Removing the member, re-inviting the address, or the owner revoking
/// the invite ends it. RLS: strict store policy. Moves to the StoreDO schema with the other store tables.
model StaffInvite {
  id         String    @id @default(uuid())
  storeId    String    @map("store_id")
  /// lower-cased address the link was sent to
  email      String
  /// staff (the only role an invitation can grant)
  role       String    @default("staff")
  /// pending | accepted | revoked | expired
  status     String    @default("pending")
  invitedBy  String?   @map("invited_by")
  acceptedBy String?   @map("accepted_by")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  decidedAt  DateTime? @map("decided_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([storeId, email])
  @@map("staff_invites")
}

// ==========================================
// Slug Redirects (renamed-handle 301s)
// ==========================================
//
// When a merchant renames a product/category/page/blog slug, the old
// slug should 301-redirect to the new one instead of 404ing. One row
// per (store, entityType, fromSlug) — toSlug is looked up and served
// as a redirect target by the storefront route handlers.

enum SlugEntityType {
  PRODUCT
  CATEGORY
  PAGE
  BLOG
}

model SlugRedirect {
  id         String         @id @default(cuid())
  storeId    String
  entityType SlugEntityType
  fromSlug   String
  toSlug     String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, entityType, fromSlug])
  @@index([storeId, entityType, toSlug])
}

// ==========================================
// Blog Posts (Bucket E1, 2026-05-17)
// ==========================================
//
// Per-store blog. Opt-in via `Store.blogEnabled`. Content is stored as
// plain text with `\n\n` paragraph separators — rendered server-side
// via `paragraph-render.ts` which escapes every text node, so no
// client-side sanitizer dep is required. Future rich-text content
// will land via a contentBlocks JSON column mirroring StorePage.
//
// `publishedAt` is set when isPublished flips to true; serves as the
// canonical date both for sorting and for the OG/Article published_time
// SEO field on the public detail page.
model BlogPost {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  slug        String
  title       String
  titleAr     String?   @map("title_ar")
  excerpt     String?
  excerptAr   String?   @map("excerpt_ar")
  content     String
  contentAr   String?   @map("content_ar")
  coverImage  String?   @map("cover_image")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId, isPublished, publishedAt])
  @@map("blog_posts")
}

// Per-store physical locations / branches. Opt-in via `Store.locationsEnabled`.
// When false the /locations route returns 404. Content is bilingual (EN/AR).
// Positions within a store are set by the `position` field (0-indexed).
model StoreLocation {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  name         String
  nameAr       String?  @map("name_ar")
  country      String // e.g. "Egypt" | "U.A.E."
  countryAr    String?  @map("country_ar")
  address      String
  addressAr    String?  @map("address_ar")
  phone        String? // tel: target, e.g. "+201012345678"
  whatsapp     String? // wa.me number, digits only or +<intl>
  mapsUrl      String?  @map("maps_url") // Google Maps "search" link (button target)
  mapsEmbedUrl String?  @map("maps_embed_url") // optional ...&output=embed iframe src
  hours        String?
  hoursAr      String?  @map("hours_ar")
  isPublished  Boolean  @default(true) @map("is_published")
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, isPublished, position])
  @@map("store_locations")
}

// ==========================================
// Store Pages CMS (about / privacy / terms / shipping / faq / custom)
// ==========================================
//
// Per-store editable long-form content. Each row is one page identified by
// a slug. Content is stored as a structured block array (JSONB) — one
// array per locale — and the API renders it to XSS-safe HTML for the
// storefront. The storefront uses pre-rendered HTML directly (no
// client-side renderer).
//
// Visibility model:
//   - row missing            → storefront falls back to legacy hardcoded copy
//   - row present, off       → storefront renders "Page unavailable" (NO fallback)
//   - row present, on, empty → storefront falls back to legacy hardcoded copy
//   - row present, on, full  → storefront renders the page
//
// The hard-off case means merchants can take a page completely offline
// without it silently reverting to the platform's default text.

model StorePage {
  id              String   @id @default(uuid())
  storeId         String   @map("store_id")
  slug            String // about | privacy | terms | shipping | faq | <custom>
  title           String?
  titleAr         String?  @map("title_ar")
  contentBlocks   Json?    @map("content_blocks") // Block[] (English) — see pages.service.ts
  contentBlocksAr Json?    @map("content_blocks_ar") // Block[] (Arabic)
  coverImage      String?  @map("cover_image") // optional R2 URL for header image
  isPublished     Boolean  @default(true) @map("is_published")
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("store_pages")
}

model Customer {
  id               String    @id @default(uuid())
  storeId          String    @map("store_id")
  /// Nullable: most GCC shoppers identify by phone only. A customer needs
  /// phone OR email, not both — the group-assignment bridge upserts on
  /// whichever is present. NULL emails are distinct under the unique index.
  email            String?
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  phone            String?
  notes            String?
  totalOrders      Int       @default(0) @map("total_orders")
  totalSpent       Int       @default(0) @map("total_spent")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  /// Sticky language for the WhatsApp bot — 'en' | 'ar' | null (not yet set).
  /// Persisted when the customer taps a language button in the bot flow.
  preferredLocale  String?   @map("preferred_locale")
  /// When the customer last picked a language. Used to decide whether to
  /// skip the language picker on return visits within 30 days.
  lastLocaleChoice DateTime? @map("last_locale_choice")

  /// Optional segment this customer belongs to. Drives group-scoped pricing
  /// and promotion/coupon targeting. SetNull on group delete — removing a
  /// group must never delete customers.
  groupId String? @map("group_id")

  /// B2B price identity (Ruling B2B-2c): the registered shopper (users.id) this CRM row belongs to. A wholesale price is
  /// granted ONLY through this link, never through an email / phone match. NULL = CRM or guest row (grants no price).
  /// Set only by wholesale approval or the merchant's group dropdown on a registered shopper's profile. The composite FK
  /// (store_id, user_id) -> users(store_id, id) ON DELETE SET NULL (user_id) and the partial unique index
  /// (store_id, user_id) WHERE user_id IS NOT NULL live in migration 20261028000300 (Prisma cannot express them).
  userId String? @map("user_id")

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses          CustomerAddress[]
  group              CustomerGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  campaignRecipients CampaignRecipient[]

  @@unique([storeId, email])
  // Phone is the primary shopper identity in the GCC — the group-assignment
  // bridge matches/upserts on it. NULL phones are distinct in Postgres, so
  // phone-less rows are unconstrained.
  @@unique([storeId, phone])
  @@index([storeId])
  @@index([email])
  @@index([createdAt])
  @@index([storeId, groupId])
  // FK-only index. `[storeId, groupId]` above serves merchant-facing "customers
  // in this group" reads, but the CustomerGroup delete RI trigger filters on
  // `group_id` ALONE — it cannot use a composite whose leading column is absent,
  // so without this it seq-scans `customers` while holding the delete's lock.
  @@index([groupId])
  @@map("customers")
}

/// Merchant-defined customer segment (e.g. "Wholesale", "VIP").
///
/// Exists to unblock group-scoped pricing and promotion/coupon targeting —
/// OSOSS gates both on customer groups and Ebda had no equivalent. Distinct
/// from `CustomerRfmSnapshot`, which is *computed* analytics: this is a
/// manual, merchant-controlled assignment.
///
/// `isDefault` marks the group new customers fall into. At most one per
/// store, enforced by a partial unique index in the migration (Prisma cannot
/// express a filtered unique index).
model CustomerGroup {
  id               String   @id @default(uuid())
  storeId          String   @map("store_id")
  name             String
  nameAr           String?  @map("name_ar")
  /// Inactive groups keep their members but are hidden from pickers and
  /// skipped by targeting rules.
  isActive         Boolean  @default(true) @map("is_active")
  isDefault        Boolean  @default(false) @map("is_default")
  /// B2B pricing (Ruling B2B-3): 'none' | 'percent_off'. percent_off applies `discountBps`
  /// to the base price when no tier matches. DB CHECK customer_groups_pricing_mode_chk.
  pricingMode      String   @default("none") @map("pricing_mode")
  /// Group percent off in basis points (1250 = 12.5%). DB CHECK 0..9000.
  discountBps      Int      @default(0) @map("discount_bps")
  /// Joining needs merchant approval (the wholesale application flow assigns the group).
  requiresApproval Boolean  @default(false) @map("requires_approval")
  /// Only wholesale groups unlock `Product.audience = 'wholesale_only'` and the application flow.
  isWholesale      Boolean  @default(false) @map("is_wholesale")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  store                 Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customers             Customer[]
  coupons               Coupon[]
  promotions            Promotion[]
  priceTiers            ProductPriceTier[]
  wholesaleApplications WholesaleApplication[]

  @@unique([storeId, name])
  @@index([storeId, isActive])
  @@map("customer_groups")
}

/// Saved delivery addresses for a customer. Created during the WhatsApp
/// native catalog bot checkout flow when the customer types a new address.
/// The first address is automatically set as default (isDefault=true).
model CustomerAddress {
  id             String   @id @default(uuid())
  customerId     String   @map("customer_id")
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label          String?
  street         String
  block          String?
  area           String
  governorate    String?
  buildingNumber String?  @map("building_number")
  notes          String?
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@map("customer_addresses")
}

enum StoreStatus {
  active
  inactive
  suspended
}

enum StorePlan {
  free
  starter
  professional
  enterprise
}

enum StoreTemplate {
  modern
  classic
  minimal
  bold
  elegant
  dahab
  qamar
  souq
  jasmine
  lamma
}

// ==========================================
// Products & Categories
// ==========================================

model Category {
  id                   String    @id @default(uuid())
  storeId              String    @map("store_id")
  name                 String
  nameAr               String?   @map("name_ar")
  slug                 String
  description          String?
  descriptionAr        String?   @map("description_ar")
  image                String?
  parentId             String?   @map("parent_id")
  position             Int       @default(0)
  isActive             Boolean   @default(true) @map("is_active")
  // Whether this category appears as a CARD in the homepage category strip.
  // Default true (visible). When false it's hidden from the homepage strip
  // ONLY — its collection page, nav, and product filters are unaffected.
  showOnHomeStrip      Boolean   @default(true) @map("show_on_home_strip")
  // SEO meta — set per-category in admin or via the AI bulk sweep.
  metaTitle            String?   @map("meta_title")
  metaTitleAr          String?   @map("meta_title_ar")
  metaDescription      String?   @map("meta_description")
  metaDescriptionAr    String?   @map("meta_description_ar")
  // AEO — conversational answer-engine copy. Written by bulk-ai-meta-aeo
  // sweep. Storefront coalesces at render time: AEO > SEO > null.
  metaDescriptionAeo   String?   @map("meta_description_aeo")
  metaDescriptionAeoAr String?   @map("meta_description_aeo_ar")
  // Size chart every product in this category inherits unless it has its own. null = none.
  sizeChartId          String?   @map("size_chart_id")
  catalogImportItems CatalogImportItem[]
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at") // Soft delete support

  // Relations
  store     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent    Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[]        @relation("CategoryHierarchy")
  products  ProductCategory[]
  sizeChart SizeChart?        @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([parentId])
  @@index([isActive])
  @@index([sizeChartId])
  @@map("categories")
}

model Product {
  id                   String        @id @default(uuid())
  storeId              String        @map("store_id")
  name                 String
  nameAr               String?       @map("name_ar")
  slug                 String
  description          String?
  descriptionAr        String?       @map("description_ar")
  // Extra words shoppers type for this product: Egyptian dialect, Franco-Arabic, English
  // ("جزمة, كوتشي, 3abaya, sneakers"). Comma-separated, merchant-editable, AI-filled when empty
  // (P1, AI_AUTOFILL_FIELDS). Searched through public.ebda_product_search_doc /
  // ebda_product_name_doc (expression trigram indexes, migration 20261019000100) — never shown on the storefront.
  // DB CHECK products_search_terms_len_chk: at most 500 characters (migration 20261019000200).
  searchTerms          String?       @map("search_terms")
  price                Int // Price in piastres (1 EGP = 100 piastres)
  /// B2B minimum order quantity across all variants of this product (null = none). DB CHECK null or >= 2.
  moq                  Int?
  /// 'public' | 'wholesale_only' (Ruling B2B-7). DB CHECK products_audience_chk.
  audience             String        @default("public")
  compareAtPrice       Int?          @map("compare_at_price")
  costPrice            Int?          @map("cost_price")
  sku                  String?
  barcode              String?
  inventory            Int           @default(0)
  lowStockThreshold    Int           @default(5) @map("low_stock_threshold")
  trackInventory       Boolean       @default(true) @map("track_inventory")
  // Gold-rate pricing (Phase B5, Rulings B5-12/B5-13). `price` stays the ONE price every reader uses; for a
  // gold-priced row only the repricer writes it (trigger ebda_gold_price_guard, migration 20261102000200).
  // 'fixed' | 'gold_rate' (DB CHECK). The spec below is integer-only: weight in MILLIGRAMS, making charge in
  // piastres (fixed) or piastres per gram (per_gram), margin in basis points. Never Float, never `facts`.
  pricingMode          String        @default("fixed") @map("pricing_mode")
  goldKarat            Int?          @map("gold_karat") @db.SmallInt
  goldWeightMg         Int?          @map("gold_weight_mg")
  makingChargeType     String?       @map("making_charge_type")
  makingChargeValue    Int?          @map("making_charge_value")
  goldMarginBps        Int           @default(0) @map("gold_margin_bps")
  /// The gold_rates row the current price was computed from (informational, no FK: history is append-only).
  goldRateId           String?       @map("gold_rate_id")
  weight               Float?
  dimensions           Json? // { length, width, height }
  status               ProductStatus @default(draft)
  featured             Boolean       @default(false)
  isNew                Boolean       @default(false) @map("is_new")
  // Merchant-set display position within the New Arrivals carousel.
  // 0 = unordered (falls back to createdAt desc). Set via the reorder admin page.
  newArrivalPosition   Int           @default(0) @map("new_arrival_position")
  // Manually curated by the store admin — drives the storefront's
  // "Best Sellers" carousel. Independent of actual order data so a merchant
  // can stage products at launch before any sales data exists.
  isBestSeller         Boolean       @default(false) @map("is_best_seller")
  // Merchant-set display position within the Best Sellers carousel.
  // 0 = unordered (falls back to createdAt desc). Set via the reorder admin page.
  bestSellerPosition   Int           @default(0) @map("best_seller_position")
  // Free-text promotional chip rendered on the product card (and PDP) in the
  // same visual language as the computed discount badge — the merchant types
  // it, the platform does not derive it. Bilingual pair, same convention as
  // name/nameAr and description/descriptionAr. NULL (the default for every
  // existing row) renders nothing at all: the feature is off until a merchant
  // types a label. VarChar(32) caps it at the DB layer — a badge is a few
  // words ("Offer" / "عرض"), never a sentence; the Zod layer trims and
  // enforces the same 32-character cap so an over-long label is rejected at
  // the edge instead of truncated silently.
  badgeLabel           String?       @map("badge_label") @db.VarChar(32)
  badgeLabelAr         String?       @map("badge_label_ar") @db.VarChar(32)
  viewCount            Int           @default(0) @map("view_count")
  // Ordered ProductFact[] (@ebda/shared productFactsSchema): spec rows shown as the PDP table, up to 2 card chips and compare rows. [] renders nothing.
  facts                Json          @default("[]")
  // Made-to-order business days added to the delivery estimate (PDP "delivers by" chip). null = ready to ship. CHECK 0..60.
  leadTimeDays         Int?          @map("lead_time_days")
  // PersonalisationConfig (@ebda/shared personalisationConfigSchema): the PDP text field the customer fills per line ("Name to embroider"). null / enabled:false = no field.
  personalisation      Json?
  // Own size chart for the PDP size guide; null = inherit the category's chart (if any).
  sizeChartId          String?       @map("size_chart_id")
  // Short 1-2 sentence blurb, distinct from the full `description`. Written
  // by the bulk-ai-excerpt sweep (or manually) — surfaced anywhere a compact
  // summary is useful (search results, share cards). Bilingual EN+AR.
  excerpt              String?
  excerptAr            String?       @map("excerpt_ar")
  metaTitle            String?       @map("meta_title")
  metaTitleAr          String?       @map("meta_title_ar")
  metaDescription      String?       @map("meta_description")
  metaDescriptionAr    String?       @map("meta_description_ar")
  // AEO — conversational answer-engine copy. Written by bulk-ai-meta-aeo
  // sweep. Storefront coalesces at render time: AEO > SEO > null.
  metaDescriptionAeo   String?       @map("meta_description_aeo")
  metaDescriptionAeoAr String?       @map("meta_description_aeo_ar")
  // GEO — LLM citation copy. Written by bulk-ai-citation-copy sweep.
  // Format: "Definitive first sentence. Key specs bullet block."
  citationCopy         String?       @map("citation_copy")
  citationCopyAr       String?       @map("citation_copy_ar")
  // Per-field AI provenance: { "<field>": "ai" | "human" }. Absent key =
  // never set. Drives the AI-first autofill override guarantee — the engine
  // never overwrites a field marked "human". See @ebda/shared
  // AI_AUTOFILL_FIELDS / fieldsNeedingRefresh.
  aiFieldSources       Json          @default("{}") @map("ai_field_sources")
  aiBalanceBackup      Json?         @default("{}") @map("ai_balance_backup")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  deletedAt            DateTime?     @map("deleted_at") // Soft delete support
  allowBackorder       Boolean       @default(false) @map("allow_backorder")
  lastCostUpdateAt     DateTime?     @map("last_cost_update_at")
  // Discount input columns — the admin enters a REGULAR (RRP) price plus a
  // discount, and the service derives price/compareAtPrice from them.
  // percentage: value is basis points (percent×100; e.g. 12.5% → 1250, range 0–10000).
  // fixed:      value is piastres (1 EGP = 100 piastres).
  // When null the product has no admin-authored discount (legacy or no discount).
  discountType         DiscountType? @map("discount_type")
  discountValue        Int?          @map("discount_value")

  // Variants
  hasVariants Boolean @default(false) @map("has_variants")

  // Relations
  store                Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  images               ProductImage[]
  categories           ProductCategory[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  tags                 ProductTag[]
  wishlists            WishlistItem[]
  reviews              Review[]
  returnItems          ReturnItem[]
  inventoryHistory     InventoryHistory[]
  options              ProductOption[]
  variants             ProductVariant[]
  relationsAsSource    ProductRelation[]          @relation("ProductRelationSource")
  relationsAsTarget    ProductRelation[]          @relation("ProductRelationTarget")
  fbtAsProduct1        FrequentlyBoughtTogether[] @relation("FBTProduct1")
  fbtAsProduct2        FrequentlyBoughtTogether[] @relation("FBTProduct2")
  aiRecsAsSource       AiRecommendation[]         @relation("AiRecSource")
  aiRecsAsTarget       AiRecommendation[]         @relation("AiRecTarget")
  faqs                 ProductFaq[]
  purchaseOrderItems   PurchaseOrderItem[]
  stockAdjustmentItems StockAdjustmentItem[]
  reorderRules         ReorderRule[]
  backorderLines       BackorderLine[]
  reorderSuggestions   ReorderSuggestion[]
  deadstockFlags       DeadStockFlag[]
  warehouseStock       WarehouseStock[]
  countLines           CountLine[]
  dailyViews           ProductDailyView[]
  bundleItems          BundleItem[]
  model3d              ProductModel?
  embedding            ProductEmbedding?
  embedFailure         ProductEmbedFailure?
  priceTiers           ProductPriceTier[]
  sizeChart            SizeChart?                 @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  catalogImportItems    CatalogImportItem[]

  @@unique([storeId, slug])
  @@unique([storeId, sku]) // Prevent duplicate SKUs within a store (null values are excluded)
  @@index([status])
  @@index([featured])
  @@index([price])
  @@index([createdAt])
  @@index([storeId, status]) // Composite: products by store and status
  // Composite for the storefront "best seller" strip — created in
  // 20260426010000_add_product_is_best_seller. Without this entry the
  // schema doesn't know about the index and `prisma migrate dev` will
  // try to drop it on every diff.
  @@index([storeId, isBestSeller])
  // Carousel position indexes — filtered on the flag so only flagged rows
  // participate (matches the partial indexes in migration 20260622150000).
  @@index([storeId, isNew, newArrivalPosition])
  @@index([storeId, isBestSeller, bestSellerPosition])
  // Storefront list query: store-scoped, soft-delete-aware, newest-first.
  // Created in 20260501030000_perf_indexes.
  @@index([storeId, deletedAt, createdAt(sort: Desc)])
  // Barcode lookup index — barcode scan resolves within a store scope.
  // Added 2026-06-15 for inventory.barcode Enterprise feature.
  // BARCODE-1: the partial unique `products_store_id_barcode_uniq` (store_id, barcode WHERE barcode IS NOT
  // NULL AND deleted_at IS NULL) lives in SQL only (migration 20261107000270_barcode_unique).
  @@index([storeId, barcode])
  @@index([sizeChartId])
  @@map("products")
}

enum ProductStatus {
  draft
  active
  archived
}

// Discount type for the admin-authored discount input (stored alongside
// discountValue on the Product model). The service derives price /
// compareAtPrice from these two columns at save time.
enum DiscountType {
  percentage // value is basis points (percent×100; 12.5% → 1250)
  fixed // value is piastres (1 EGP = 100 piastres)
}

// ==========================================
// Inventory Management
// ==========================================

model InventoryHistory {
  id            String              @id @default(uuid())
  productId     String              @map("product_id")
  storeId       String              @map("store_id")
  type          InventoryChangeType
  quantity      Int // Change amount (positive or negative)
  previousStock Int                 @map("previous_stock")
  newStock      Int                 @map("new_stock")
  reason        String?
  reference     String? // Order ID, adjustment ID, etc.
  createdBy     String?             @map("created_by") // User ID who made the change
  createdAt     DateTime            @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
  @@index([storeId, reference])
  @@map("inventory_history")
}

enum InventoryChangeType {
  manual_add // Manual stock increase
  manual_remove // Manual stock decrease
  sale // Sold via order
  return_stock // Returned to stock
  adjustment // Inventory count adjustment
  damage // Damaged goods
  transfer_in // Transferred from another location
  transfer_out // Transferred to another location
  initial // Initial stock setup
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductCategory {
  productId  String @map("product_id")
  categoryId String @map("category_id")
  position   Int    @default(0) @map("position")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, position])
  @@map("product_categories")
}

model Tag {
  id       String       @id @default(uuid())
  storeId  String       @map("store_id")
  name     String
  /// Arabic label (Phase B3 fix wave 1): `name` is the canonical / English label and the filter key
  /// (`?tag=<name>`); the Arabic storefront shows `nameAr` and falls back to `name` with a `lang`.
  nameAr   String?      @map("name_ar")
  products ProductTag[]

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, name])
  @@index([storeId])
  @@map("tags")
}

model ProductTag {
  productId String @map("product_id")
  tagId     String @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

// ==========================================
// Product Variants
// ==========================================

// Option types like "Size", "Color"
model ProductOption {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  name      String // e.g., "Size", "Color"
  nameAr    String?  @map("name_ar")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

// Option values like "Small", "Red"
model ProductOptionValue {
  id             String   @id @default(uuid())
  optionId       String   @map("option_id")
  value          String // e.g., "Small", "Red"
  valueAr        String?  @map("value_ar")
  // Storefront swatch: a hex dot and/or a fabric/photo thumbnail (image wins).
  swatchHex      String?  @map("swatch_hex")
  swatchImageUrl String?  @map("swatch_image_url")
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  option          ProductOption          @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants        ProductVariantOption[]
  model3dBindings ProductModelBinding[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

// A specific variant combining options (e.g., "Size: Large, Color: Red")
model ProductVariant {
  id                String   @id @default(uuid())
  productId         String   @map("product_id")
  title             String // Generated from option values: "Large / Red"
  titleAr           String?  @map("title_ar")
  sku               String?
  barcode           String?
  price             Int? // Override price (null = use product price)
  compareAtPrice    Int?     @map("compare_at_price")
  costPrice         Int?     @map("cost_price")
  inventory         Int      @default(0)
  weight            Float?
  imageUrl          String?  @map("image_url")
  position          Int      @default(0)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  allowBackorder    Boolean  @default(false) @map("allow_backorder")
  // Gold-rate pricing (Ruling B5-13): every column NULL = inherit the product's. Written only by the repricer.
  pricingMode       String?  @map("pricing_mode")
  goldKarat         Int?     @map("gold_karat") @db.SmallInt
  goldWeightMg      Int?     @map("gold_weight_mg")
  makingChargeType  String?  @map("making_charge_type")
  makingChargeValue Int?     @map("making_charge_value")
  goldMarginBps     Int?     @map("gold_margin_bps")
  goldRateId        String?  @map("gold_rate_id")

  product              Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  options              ProductVariantOption[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  stockAdjustmentItems StockAdjustmentItem[]
  reorderRules         ReorderRule[]
  backorderLines       BackorderLine[]
  reorderSuggestions   ReorderSuggestion[]
  deadstockFlags       DeadStockFlag[]
  warehouseStock       WarehouseStock[]
  countLines           CountLine[]
  bundleItems          BundleItem[]
  priceTiers           ProductPriceTier[]

  @@index([productId])
  @@index([sku])
  // Barcode lookup — scan resolves to a variant within a product.
  // BARCODE-1: the partial unique `product_variants_product_id_barcode_uniq` (product_id, barcode WHERE
  // barcode IS NOT NULL) lives in SQL only (migration 20261107000270_barcode_unique).
  @@index([productId, barcode])
  @@map("product_variants")
}

// Product 3D model (docs/plans/2026-10-07-product-3d-viewer.md). One per
// product. UI: admin product page "3D model" card + the storefront PDP viewer.
model ProductModel {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  productId    String   @unique @map("product_id")
  // Self-contained binary glTF in R2 (stores/<storeId>/models/...).
  modelUrl     String   @map("model_url")
  modelBytes   Int      @map("model_bytes")
  // Optional merchant-supplied USDZ for iOS Quick Look (else generated on device).
  usdzUrl      String?  @map("usdz_url")
  usdzBytes    Int?     @map("usdz_bytes")
  posterUrl    String?  @map("poster_url")
  altText      String?  @map("alt_text") @db.VarChar(250)
  altTextAr    String?  @map("alt_text_ar") @db.VarChar(250)
  arEnabled    Boolean  @default(true) @map("ar_enabled")
  // [{ index, name }] extracted at upload — drives the mapping UI.
  materials    Json     @default("[]")
  // KHR_materials_variants names.
  gltfVariants Json     @default("[]") @map("gltf_variants")
  // { vertices, meshes, materials, textures, extensionsUsed }
  stats        Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  store    Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product  Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  bindings ProductModelBinding[]

  @@index([storeId])
  @@map("product_models")
}

// Storefront search log (search program P0, Task 5): one counter row per store, Cairo day and
// NORMALISED term. Never linked to a user/session/IP/order; phone/email/order-number/id-shaped
// terms are dropped before insert (apps/api/src/services/search-log.service.ts); free text may
// still hold a typed name (Ruling SEARCH-T5-6). Viewer: admin /stores/[id]/insights/searches
// + the analytics "searches with no results" card. Retention 90 days (search-log-purge-daily).
// Store delete cascades.
model SearchQueryDaily {
  id              String   @id @default(uuid())
  storeId         String   @map("store_id")
  date            DateTime @db.Date
  term            String   @db.VarChar(100)
  searches        Int      @default(0)
  zeroResults     Int      @default(0) @map("zero_results")
  lastResultCount Int      @default(0) @map("last_result_count")
  // Day granularity on purpose (no exact search time): written by search-log.service only.
  // Deliberately NOT `@updatedAt`: that would stamp an exact time (Ruling SEARCH-T5-6). The raw
  // SQL upsert is the only writer and sets the Cairo day; a Prisma `update` would NOT touch it.
  updatedAt       DateTime @default(dbgenerated("CURRENT_DATE")) @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date, term])
  @@index([storeId, date(sort: Desc)])
  @@map("search_query_daily")
}

// Semantic search vector per product (search program P1). Written ONLY by raw SQL in
// product-index.service.ts (Prisma cannot read/write halfvec, so this model has no create/update
// through Prisma). CACHE CLASS: BOUNDED-stale content index (seconds to minutes after a write;
// Ruling SEARCH-11); never used for price/stock/status, which are read live from products.
// Viewer: the searches insights page header ("indexed N of M products", Task 12).
model ProductEmbedding {
  productId      String                        @id @map("product_id")
  storeId        String                        @map("store_id")
  model          String
  contentHash    String                        @map("content_hash")
  embedding      Unsupported("halfvec(1024)")
  /// bge-m3 vector of the AI search words alone; NULL when the product has none (SEARCH-T13-7).
  termsEmbedding Unsupported("halfvec(1024)")? @map("terms_embedding")
  /// md5 of the words text termsEmbedding was built from (its own staleness); NULL with it.
  termsHash      String?                       @map("terms_hash")
  embeddedAt     DateTime                      @default(now()) @map("embedded_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, embeddedAt])
  @@map("product_embeddings")
}

/// B2B quantity price break (Rulings B2B-3/4). One row = "from minQty units, the unit price is
/// priceMinor". variantId NULL = product-level; groupId NULL = every buyer (a PUBLIC tier).
/// Uniqueness (product, COALESCE(variant), COALESCE(group), min_qty) is a unique INDEX in the
/// migration (Prisma cannot express COALESCE); priceMinor <= the base price is enforced in the
/// service at write time and clamped by the resolver at read time. UI: admin product page tier
/// editor + customer-groups page.
model ProductPriceTier {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  productId  String   @map("product_id")
  variantId  String?  @map("variant_id")
  groupId    String?  @map("group_id")
  /// First quantity (inclusive) at which this price applies. DB CHECK >= 2.
  minQty     Int      @map("min_qty")
  /// Unit price in piastres. DB CHECK >= 0.
  priceMinor Int      @map("price_minor")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  store   Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  group   CustomerGroup?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([storeId, productId])
  @@index([variantId])
  @@index([groupId])
  // Leading indexes for the composite ownership FKs (product_variant_fkey, store_group_fkey).
  @@index([productId, variantId])
  @@index([storeId, groupId])
  @@map("product_price_tiers")
}

/// B2B wholesale account application: a signed-in shopper applies, the merchant approves (which
/// assigns the group) or rejects. Holds PII (business name, phone, commercial reg. no.), so it is
/// in the customer export + erasure paths. status: pending | approved | rejected | revoked.
/// At most ONE pending application per (store, user): partial unique index in the migration.
/// UI: admin wholesale-applications queue.
model WholesaleApplication {
  id              String    @id @default(uuid())
  storeId         String    @map("store_id")
  /// The AUTHENTICATED shopper (users.id) - never a typed phone/email (Ruling B2B-2).
  userId          String    @map("user_id")
  businessName    String    @map("business_name")
  commercialRegNo String?   @map("commercial_reg_no")
  phone           String
  notes           String?
  status          String    @default("pending")
  /// Group assigned on approval.
  groupId         String?   @map("group_id")
  decidedBy       String?   @map("decided_by")
  decidedAt       DateTime? @map("decided_at")
  decisionNote    String?   @map("decision_note")
  /// When the applicant accepted the data notice on the apply form (review M1).
  consentAt       DateTime? @map("consent_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  store Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  group CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([storeId, status, createdAt])
  @@index([userId])
  @@index([groupId])
  // Leading index for the composite ownership FK (store_group_fkey).
  @@index([storeId, groupId])
  @@map("wholesale_applications")
}

/// Embedding quarantine (Task 11 review I2): a product whose CURRENT text (md5 = contentHash) could
/// not be embedded. Skipped by the indexer until the text changes; deleted on a successful embed.
model ProductEmbedFailure {
  productId   String    @id @map("product_id")
  storeId     String    @map("store_id")
  contentHash String    @map("content_hash")
  errorKind   String    @map("error_kind")
  /// The embedding model that rejected it; a different current model re-admits the product.
  model       String
  /// true = failed retryably twice (temporary, see expiresAt); false = rejected non-retryably.
  retryable   Boolean   @default(false)
  /// NULL = until the text or model changes; otherwise re-admitted after this time (24 h).
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  failedAt    DateTime  @default(now()) @map("failed_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("product_embed_failures")
}

// Size chart (B0 Task 9): a merchant-authored measurements table shown in the PDP size guide
// and on /size-guide. UI: admin /stores/[id]/size-charts (editor), product FulfilmentCard and
// category form pickers; storefront SizeChartDialog + /size-guide. Shape: @ebda/shared sizeChartSchema.
model SizeChart {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  name      String   @default("")
  nameAr    String   @default("") @map("name_ar")
  // 'cm' | 'in' (CHECK constraint).
  unit      String   @default("cm")
  // [{ label, labelAr }], 2..10.
  columns   Json
  // string[][], 1..30 rows, one cell per column.
  rows      Json
  note      String   @default("")
  noteAr    String   @default("") @map("note_ar")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products   Product[]
  categories Category[]

  @@index([storeId])
  @@map("size_charts")
}

// Option value -> 3D finish (material colour/metal, or a glTF variant).
// UI: the mapping table in the admin "3D model" card.
model ProductModelBinding {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  modelId       String   @map("model_id")
  optionValueId String   @map("option_value_id")
  // 'material' | 'gltf_variant' (CHECK in the migration)
  kind          String
  target        String
  color         String?
  metalness     Float?
  roughness     Float?
  createdAt     DateTime @default(now()) @map("created_at")

  store       Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  model       ProductModel       @relation(fields: [modelId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([modelId, optionValueId, kind, target])
  @@index([storeId])
  @@index([optionValueId])
  @@map("product_model_bindings")
}

// Junction table linking variants to their option values
model ProductVariantOption {
  variantId String @map("variant_id")
  valueId   String @map("value_id")

  variant ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value   ProductOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([variantId, valueId])
  @@index([valueId])
  @@map("product_variant_options")
}

// ==========================================
// Cart
// ==========================================

model Cart {
  id                  String    @id @default(uuid())
  storeId             String    @map("store_id")
  customerId          String?   @map("customer_id")
  sessionId           String    @map("session_id")
  lastActivityAt      DateTime  @default(now()) @map("last_activity_at")
  /// Set ONLY when the shopper ticked the checkout box "email me about my cart" (consent), together
  /// with `guestEmailConsentAt`; the store's newsletter_subscribers row (scope cart_reminders) is
  /// upserted in the same action. Reaches guests; the reminder email is gated on the subscriber row.
  guestEmail          String?   @map("guest_email")
  guestEmailConsentAt DateTime? @map("guest_email_consent_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer      User?          @relation(fields: [customerId], references: [id])
  items         CartItem[]
  bundles       CartBundle[]
  abandonedCart AbandonedCart?

  @@unique([storeId, sessionId])
  @@index([customerId])
  @@index([sessionId])
  @@index([updatedAt])
  @@index([lastActivityAt])
  @@map("carts")
}

model CartItem {
  id              String    @id @default(uuid())
  cartId          String    @map("cart_id")
  productId       String    @map("product_id")
  variantId       String?   @map("variant_id")
  quantity        Int       @default(1)
  // Customer personalisation text (cleanNote: trimmed, control/bidi chars stripped, <=200). Part of the line identity.
  note            String?
  // Gold-rate pricing (Ruling B5-17): the unit price the shopper was shown when the line was added (server-read,
  // never client-supplied), and when. A gold line whose current price differs shows "السعر اتحدّث" until acknowledged.
  quotedUnitPrice Int?      @map("quoted_unit_price")
  quotedAt        DateTime? @map("quoted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  // Uniqueness is enforced by two PARTIAL unique EXPRESSION indexes, rebuilt in
  // migration 20261016000500_personalisation (originally 20260622000000_cart_item_null_variant_unique):
  //   cart_items_line_no_variant   (cart_id, product_id, COALESCE(note, ''))             WHERE variant_id IS NULL
  //   cart_items_line_with_variant (cart_id, product_id, variant_id, COALESCE(note, '')) WHERE variant_id IS NOT NULL
  // So a line is (cart, product, variant, note): "Sara" and "Omar" on the same item are two lines.
  // A combined @@unique here would generate a single index that Postgres treats as
  // non-enforcing when variant_id (or note) is NULL — hence the partials + COALESCE.
  // Prisma cannot express partial/expression indexes; no @@unique means Prisma
  // will not try to recreate the old combined index.
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

// ==========================================
// Bundles
// ==========================================

enum BundlePricingType {
  fixed_price // value = the bundle's price in piastres (e.g. 12000)
  percentage // value = basis points off the component sum (12.5% -> 1250)
  fixed // value = piastres off the component sum
}

model Bundle {
  id            String            @id @default(uuid())
  storeId       String            @map("store_id")
  name          String
  nameAr        String?           @map("name_ar")
  slug          String
  description   String?
  descriptionAr String?           @map("description_ar")
  image         String?
  pricingType   BundlePricingType @map("pricing_type")
  pricingValue  Int               @map("pricing_value")
  isActive      Boolean           @default(true) @map("is_active")
  startsAt      DateTime?         @map("starts_at")
  expiresAt     DateTime?         @map("expires_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  store Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items BundleItem[]
  carts CartBundle[]

  @@unique([storeId, slug])
  @@index([storeId, isActive])
  @@map("bundles")
}

model BundleItem {
  id        String  @id @default(uuid())
  bundleId  String  @map("bundle_id")
  productId String  @map("product_id")
  variantId String? @map("variant_id")
  quantity  Int

  bundle  Bundle          @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([bundleId, productId, variantId])
  @@index([bundleId])
  @@index([productId])
  @@index([variantId])
  @@map("bundle_items")
}

model CartBundle {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  bundleId  String   @map("bundle_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  bundle Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([cartId, bundleId])
  // FK-only index for the Bundle delete cascade (the unique above has
  // bundleId second, which the RI trigger cannot use). 20261001140000.
  @@index([bundleId])
  @@map("cart_bundles")
}

// ==========================================
// Orders
// ==========================================

model Order {
  id                          String             @id @default(uuid())
  storeId                     String             @map("store_id")
  customerId                  String?            @map("customer_id")
  orderNumber                 String             @unique @map("order_number")
  status                      OrderStatus        @default(pending)
  paymentStatus               OrderPaymentStatus @default(unpaid) @map("payment_status")
  subtotal                    Int
  tax                         Int                @default(0)
  // Did the store's listed prices ALREADY contain `tax` when this order was
  // placed? (ruling M3-7.)
  //   false (the default, and every order placed before this column existed)
  //     — EXCLUSIVE: `tax` sits on top of `subtotal` inside `total`.
  //   true — INCLUSIVE: `subtotal` is gross, `tax` is the portion extracted
  //     out of it, and `total` does NOT add it again.
  // Persisted per-order rather than re-read from `Store.taxIncludedInPrice`
  // because the merchant can flip that switch at any time: months later the
  // GL posting and the refund allocator must still read THIS order's money
  // the way it was charged. Every `order.tax` consumer honours it: the money
  // paths (services/accounting/posting/{order-posting,partial-return-allocation}.ts)
  // and every post-purchase display via `orderTaxPlacement` (@ebda/shared) —
  // invoice, confirmation email, admin + orders-app order cards, the account
  // order page — plus the XLSX export's "Tax Included In Price" column.
  taxIncludedInPrice          Boolean            @default(false) @map("tax_included_in_price")
  /// B2B: name of the customer group whose price applied, snapshotted so a renamed/deleted
  /// group does not rewrite history. NULL = retail (every order placed before B2B).
  priceGroupName              String?            @map("price_group_name")
  // Frozen at creation ONLY when VAT was collected under a VERIFIED tax profile
  // (ruling TAX-2): the seller's tax registration number and legal name as they
  // stood at the sale, and the summed rate in basis points (1400 = 14%). They
  // make the invoice a "tax invoice"; NULL = not a tax invoice (no VAT wording).
  // A later revoke/re-verification never rewrites a past order.
  sellerTaxRegistrationNumber String?            @map("seller_tax_registration_number")
  sellerTaxLegalName          String?            @map("seller_tax_legal_name")
  taxRateBps                  Int?               @map("tax_rate_bps")
  shipping                    Int                @default(0)
  discount                    Int                @default(0)
  // Cash-on-delivery fee frozen at creation (ruling MONEYB-3): quoted to the
  // shopper BEFORE the order is placed and already inside `total`. 0 = none
  // (non-COD orders, and COD orders placed before the column existed, whose fee
  // was folded into `total` after submit — see payments.metadata.codFee).
  codFee                      Int                @default(0) @map("cod_fee")
  // The VAT base this order was taxed on (ruling MONEYB-2): goods after the
  // invoice-shown discounts + shipping + COD fee (+ a payment link's extra
  // amount), excl. VAT. NULL = placed before the column existed (taxed on goods
  // only; `taxInvoiceInfo` rebuilds that legacy base).
  taxableAmount               Int?               @map("taxable_amount")
  total                       Int
  // Extra out-of-catalog amount used by merchant-initiated payment
  // links — a custom service fee, deposit, or quote that doesn't map
  // to a Product. Baked into `total` at order creation; rendered as
  // a synthetic line in admin order detail. extraAmountNote captures
  // what the charge is for ("Photography deposit", "Rush fee", etc.).
  extraAmount                 Int                @default(0) @map("extra_amount")
  extraAmountNote             String?            @map("extra_amount_note")
  currency                    String             @default("EGP")
  couponCode                  String?            @map("coupon_code")
  couponDiscount              Int                @default(0) @map("coupon_discount")
  promotionDiscount           Int                @default(0) @map("promotion_discount")
  appliedPromotionId          String?            @map("applied_promotion_id")
  bundleDiscount              Int                @default(0) @map("bundle_discount")
  // Loyalty redemption applied at checkout. loyaltyPointsRedeemed is the
  // number of points the customer spent on this order (NULL = none redeemed
  // / pre-feature order); loyaltyDiscount is the resulting discount amount in
  // PIASTRES that was folded into `discount` + `total`. Both are written
  // atomically with LoyaltyService.redeemPoints inside the order-create
  // transaction, and read by reverseRedeemedPointsFromOrder on refund/cancel.
  loyaltyPointsRedeemed       Int?               @map("loyalty_points_redeemed")
  loyaltyDiscount             Int                @default(0) @map("loyalty_discount")
  // Customer-wallet (store credit) portion of this order, in PIASTRES. `total`
  // keeps meaning "order value"; the amount any gateway / COD courier collects
  // is `total - walletAmount`. 0 for every order that did not use the wallet
  // (the default, and every order placed before the feature), so every
  // payment path reads the same number it always did. Written atomically with
  // the `order_payment` ledger row inside the order-create transaction; read
  // by the `order/refunded` fanout to put the wallet portion back.
  // CHECK (wallet_amount >= 0) in migration 20260925150000_customer_wallet.
  walletAmount                Int                @default(0) @map("wallet_amount")
  notes                       String?
  customerNotes               String?            @map("customer_notes")
  shippingAddress             Json               @map("shipping_address")
  billingAddress              Json               @map("billing_address")
  /// Customer Intelligence (CI-1): normalised destination `EG-<gov>-<district>` (no street/building)
  /// and the suite buyer key (HMAC of the E.164 phone); null when the order has no usable phone.
  areaKey                     String?            @map("area_key")
  buyerKey                    String?            @map("buyer_key")
  shippedAt                   DateTime?          @map("shipped_at")
  deliveredAt                 DateTime?          @map("delivered_at")
  reviewRequestSentAt         DateTime?          @map("review_request_sent_at")
  createdAt                   DateTime           @default(now()) @map("created_at")
  updatedAt                   DateTime           @updatedAt @map("updated_at")
  deletedAt                   DateTime?          @map("deleted_at") // Soft delete support

  // Buyer's UI locale at checkout time ('en' | 'ar'). Used to send
  // transactional emails in the customer's language regardless of the
  // store's defaultLanguage setting. NULL for pre-feature orders —
  // email service falls back to store.settings.defaultLanguage.
  locale String?

  // Customer SMS marketing consent captured at checkout, frozen on the order
  // as a record of what was ticked. The promotional-SMS gate does NOT read
  // it: consent lives per customer per store in `sms_marketing_consents`
  // (issue 206), which the order create path writes when this is true.
  // Transactional notifications are unaffected. Defaults to false — never
  // opt customers in silently.
  smsOptIn Boolean @default(false) @map("sms_opt_in")

  // InstaPay manual orders: the moment the awaiting-confirmation hold runs out.
  // Set when the order enters `awaiting_payment_confirmation`, read by the
  // expiry cron and by the confirm guard (a confirm after this instant is
  // refused). NULL for every other order.
  paymentConfirmationExpiresAt DateTime? @map("payment_confirmation_expires_at")

  // Webhook idempotency - prevents duplicate processing
  idempotencyKey     String?   @unique @map("idempotency_key")
  webhookProcessedAt DateTime? @map("webhook_processed_at")

  /// Checkout idempotency (audit M-012): sha256(sessionId|Idempotency-Key header) of the request that created this order, unique
  /// per store. A retry of the same request returns this order instead of creating a second one. NOT the webhook key above.
  checkoutIdempotencyKey String? @map("checkout_idempotency_key")
  /// sha256 of what the shopper asked for, stored with the key: a retry that changed the request is 409, not the first order.
  checkoutRequestHash    String? @map("checkout_request_hash")

  // LEGACY (retained, unused since 2026-07-18). Formerly the dedupe stamp for
  // the always-on "Payment pending — follow up" stuck-payment sweep, which was
  // removed as a redundant duplicate of the `payment_abandonment` "Checkout
  // abandoned" alert. Column kept to avoid a data-dropping migration; no code
  // reads or writes it. Safe to drop in a future cleanup migration.
  stuckPaymentAlertedAt DateTime? @map("stuck_payment_alerted_at")

  // order/created fanout dedupe. The order/created event can be enqueued by
  // BOTH the customer-return "confirm" path AND the payment webhook consumer
  // for the same paid order (and Inngest delivers at-least-once). The
  // order-created fn atomically claims this stamp (UPDATE ... WHERE NULL) and
  // skips the whole fanout if already claimed, so the "new order" email + admin
  // OneSignal push fire EXACTLY once per order regardless of how many times the
  // event is enqueued. NULL = not yet notified.
  orderCreatedNotifiedAt      DateTime? @map("order_created_notified_at")
  /// Stamped by the order/refunded fanout once ALL reversal steps have
  /// completed — deliberately regardless of whether any stock actually moved.
  /// A backorder-line cancel (restoreInventory:false) and an order whose
  /// products all have trackInventory=false both legitimately restore nothing
  /// and write no InventoryHistory row, so marker-absence cannot distinguish
  /// "the fanout never ran" from "it ran and correctly did nothing". This
  /// claim can. NULL past the staleness window is what
  /// refund-reversal-stuck-sweep recovers.
  refundReversedAt            DateTime? @map("refund_reversed_at")
  /// Stamped (and refundReversedAt re-nulled) at every WHOLE-order,
  /// stock-restoring `order/refunded` enqueue (OrderService.applyRefundEffects),
  /// whatever produced it — a cancel/refund status change, a manual-method full
  /// return on an order that stays `delivered`, a webhook refund. It is the
  /// immutable "a reversal was requested at" clock refund-reversal-stuck-sweep
  /// keys on: unlike updatedAt it is not bumped by an unrelated later edit, and
  /// unlike the status filter it also covers refunds that never change status.
  refundReversalRequestedAt   DateTime? @map("refund_reversal_requested_at")
  /// `order/status-changed` fanout bookkeeping (#558, #619). updateStatus
  /// stamps RequestedAt and re-nulls ClaimedAt at every transition; the fanout
  /// claims (ClaimedAt, only while the order is still AT the event's status)
  /// before any side effect, so a duplicate event for the same transition
  /// no-ops instead of re-sending emails/dispatches. order-status-fanout-
  /// stuck-sweep re-sends a transition whose fanout never claimed it.
  statusFanoutRequestedAt     DateTime? @map("status_fanout_requested_at")
  statusFanoutClaimedAt       DateTime? @map("status_fanout_claimed_at")
  /// WHICH transition was requested (issue 2070 / issue 2133). The sweep
  /// re-sends this status, never the order's current one, and only while the
  /// order is still at it.
  statusFanoutRequestedStatus String?   @map("status_fanout_requested_status")
  /// Stamped by the fanout after every side effect succeeded (issue 2071).
  /// Claimed-but-not-completed past the window = a fanout that failed after
  /// its claim, which the sweep reports.
  statusFanoutCompletedAt     DateTime? @map("status_fanout_completed_at")

  // Enterprise: payment-gateway abandonment capture. Set by the Inngest
  // payment-abandonment-sweep cron when the order has a Payment row with a
  // paymentUrl (customer reached the gateway) but paymentStatus is still
  // unpaid past the configured threshold. NULL = not a gateway abandoner
  // (or not yet evaluated). Used to power the retargeting UI under
  // /stores/:id/payment-abandonments (Enterprise-only, feature key:
  // payment_abandonment). See migration 20260622130000.
  paymentGatewayAbandonedAt DateTime? @map("payment_gateway_abandoned_at")

  source String? @default("web") // provenance: 'web' | 'agent' — audit only

  // Normalized client IP captured at order-creation time (never from client
  // input — the server's own view of the connection, mirroring the
  // `ipKeyGenerator(req.ip)` convention already used by every rate limiter in
  // `middleware/security.ts`). NULL for orders created before this column and
  // for non-HTTP paths with no request (admin manual orders, scripts). Used
  // ONLY by the open-unpaid-hold cap (`lib/stock-hold-cap.ts`) to catch an
  // abuser who varies phone/email across a guest-checkout run — never shown
  // to a merchant or customer, never used for anything else.
  checkoutIp         String? @map("checkout_ip")
  // Server-owned admission for a new unpaid COD/InstaPay hold. Never accepted from client input.
  manualHoldAdmitted Boolean @default(false) @map("manual_hold_admitted")

  // Relations
  store               Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer            User?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            Payment[]
  reviews             Review[]
  returns             Return[]
  loyaltyTransactions LoyaltyTransaction[]
  walletTransactions  WalletTransaction[]
  shipment            Shipment?
  affiliateReferrals  AffiliateReferral[]
  events              OrderEvent[]
  appliedPromotion    Promotion?           @relation("OrderAppliedPromotion", fields: [appliedPromotionId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([storeId, customerId]) // Composite: customer orders in a store
  @@index([storeId, status]) // Composite: orders by store and status
  // Admin orders list — newest first within a store. Created in
  // 20260501030000_perf_indexes.
  @@index([storeId, createdAt(sort: Desc)])
  // Payment-gateway abandoners list (Enterprise).
  // Added 20260622130000.
  @@index([storeId, paymentGatewayAbandonedAt])
  @@unique([storeId, checkoutIdempotencyKey], map: "orders_store_id_checkout_idempotency_key_key")
  // InstaPay expiry sweep: the awaiting orders whose hold has run out.
  @@index([paymentConfirmationExpiresAt])
  // Open-unpaid-hold admission uses separate contact (phone OR canonical
  // email) and IP counts inside the money transaction. Matching partial
  // expression indexes live in migration20261010000000_order_checkout_ip;
  // Prisma cannot declare partial/expression indexes in this model.
  // FK-only index for the Promotion delete RI trigger, which filters on
  // `applied_promotion_id` alone. `orders` is the largest table in the schema,
  // so the unindexed variant of this scan is the worst of the five.
  @@index([appliedPromotionId])
  // Order search (OrderService.orderSearchWhere): `orders_order_number_trgm_idx`,
  // a pg_trgm GIN on order_number, lives in raw SQL only
  // (20261002090000_order_search_trgm_and_fk_indexes) — not declared here.
  @@map("orders")
  ciHintLogs CiHintLog[]
}

/// Append-only audit trail for Order.status changes. Rows are written once and
/// never updated — the immutable trail the in-place Order.status mutation lacks.
/// Mirrors the PaymentEvent / AffiliateEvent pattern (TEXT ids via
/// @default(uuid()), denormalized store_id for store-scoped RLS + admin
/// queries without joining back through orders).
model OrderEvent {
  id         String   @id @default(uuid())
  /// Denormalized so we can scope by store (RLS + admin queries) without
  /// joining orders.
  storeId    String   @map("store_id")
  orderId    String   @map("order_id")
  /// Prior status. Null only if an event is ever written for an order with no
  /// prior status (not expected today — every transition has a from-status).
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  /// User who triggered the change (admin action). Null for system/cron
  /// transitions (e.g. auto-cancel-unpaid) where no user is in scope.
  actorId    String?  @map("actor_id")
  /// Free-form details preserved without column bloat. Always non-null.
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actor User? @relation("OrderEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([storeId])
  // FK-only index for the User delete RI trigger (actor is SetNull). Deactivating
  // a staff account otherwise seq-scans the whole append-only event trail.
  @@index([actorId])
  @@map("order_events")
}

enum OrderPaymentStatus {
  unpaid
  paid
  failed
  refunded
  disputed
}

enum OrderStatus {
  pending
  /// InstaPay manual transfer: stock is held, nothing ships and no revenue is
  /// booked until the merchant confirms the money arrived (or the hold expires).
  awaiting_payment_confirmation
  confirmed
  processing
  shipped
  delivered
  cancelled
  refunded
}

model OrderItem {
  id                String  @id @default(uuid())
  orderId           String  @map("order_id")
  productId         String  @map("product_id")
  variantId         String? @map("variant_id")
  productName       String  @map("product_name")
  variantName       String? @map("variant_name") // e.g., "Large / Red" — canonical (EN) title
  // Arabic twin of variantName (the variant's titleAr at sale time). The storefront and the
  // admin render it per locale with variantName as the fallback; fiscal documents and CSV
  // exports keep variantName exactly as before. Null for orders placed before it existed.
  variantNameAr     String? @map("variant_name_ar")
  // Snapshot of the cart line's personalisation note (e.g. the name to embroider).
  personalisation   String?
  sku               String?
  quantity          Int
  price             Int
  // Cost-of-goods snapshot at sale time. Stored in piastres, same scale as
  // `price`. Snapshotted because the product's cost may change later but
  // the order's profit must reflect what it cost on the day it shipped.
  // Nullable for orders placed before this column existed.
  costPrice         Int?    @map("cost_price")
  total             Int
  costPriceDeferred Boolean @default(false) @map("cost_price_deferred")

  // B2B price provenance (Ruling B2B-3/5), snapshotted so invoices, returns and analytics never
  // re-derive a price. NULL on orders placed before B2B reads as source 'base'.
  // priceSource: 'base' | 'tier' | 'group'. listPrice = the retail unit price at sale time.
  listPrice         Int?     @map("list_price")
  priceSource       String?  @map("price_source")
  priceTierMinQty   Int?     @map("price_tier_min_qty")
  /// True when the price came from the buyer's wholesale GROUP (group tier or group percent), false for a public break or
  /// base; NULL before the column existed. Labels and analytics only (final review minor 4).
  priceGroupApplied Boolean? @map("price_group_applied")
  /// The buyer's entitlement at sale time ({ rungs: [{minQty, priceMinor, variant, group}], groupPercentMinor }), for
  /// tier-aware partial returns (Task 8b, Rulings B2B-17 / B2B-18).
  tierLadder        Json?    @map("tier_ladder")
  /// Gold-rate pricing (Ruling B5-17): how this line's price was made (karat, weight, rate id and value, making charge,
  /// margin, step, unit price; @ebda/shared goldLineSnapshotSchema). Refunds read `price`; this is for display and audit.
  goldSnapshot      Json?    @map("gold_snapshot")

  // Scan-to-pick fulfilment state. pickedQty tracks how many units of this
  // line have been physically scanned/picked. Default 0 so existing rows are
  // unaffected. pickedAt is set when pickedQty reaches quantity.
  pickedQty Int       @default(0) @map("picked_qty")
  pickedAt  DateTime? @map("picked_at")

  // Bundle tagging — deliberately a snapshot, not a join, exactly like
  // productName and costPrice above: a six-month-old invoice must still
  // read "Ramadan Box" after the bundle is renamed or deleted. bundleId
  // identifies which bundle a line came from; bundleGroupId ties together
  // every OrderItem produced by the same add-to-cart of that bundle (a
  // bundle expands into one OrderItem per component). All four are NULL
  // for orders that don't involve a bundle.
  bundleId      String? @map("bundle_id")
  bundleGroupId String? @map("bundle_group_id")
  bundleName    String? @map("bundle_name")
  bundleNameAr  String? @map("bundle_name_ar")

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  returnItems    ReturnItem[]
  backorderLines BackorderLine[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([bundleGroupId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String        @map("order_id")
  provider       String // paymob, kashier, fawry, instapay, cod
  method         String? // card, meeza, wallet, valu, payatfawry, etc.
  status         PaymentStatus @default(pending)
  amount         Int
  currency       String        @default("EGP")
  transactionId  String?       @map("transaction_id")
  invoiceId      String?       @map("invoice_id")
  paymentUrl     String?       @map("payment_url")
  refundId       String?       @map("refund_id")
  refundedAmount Int           @default(0) @map("refunded_amount")
  failureReason  String?       @map("failure_reason")
  paidAt         DateTime?     @map("paid_at")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events PaymentEvent[]

  @@index([orderId])
  @@index([transactionId])
  @@index([invoiceId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

/// Append-only log of every state transition + webhook receipt for a
/// Payment row. Closes the audit gap left by the in-place updates on
/// `payments.status`. Written from `payment-event.service.ts` at every
/// Payment mutation site + every provider webhook handler — never
/// updated, never deleted (rollups + retention are done separately).
///
/// Query examples:
///   - Lifecycle of a single payment:
///       SELECT * FROM payment_events WHERE payment_id = $1 ORDER BY occurred_at;
///   - All webhook-driven completes today:
///       SELECT * FROM payment_events
///       WHERE event_type='webhook' AND to_status='completed' AND occurred_at >= now()::date;
///   - Reconciliation gap (Tap settled vs we received):
///       compare `provider_payload->>'settlement_id'` to your bank statement
model PaymentEvent {
  id                String         @id @default(uuid())
  paymentId         String         @map("payment_id")
  /// Denormalized so we can scope by store without joining payments → orders.
  storeId           String         @map("store_id")
  /// Denormalized for convenience in audit queries.
  orderId           String         @map("order_id")
  /// 'created' | 'status_change' | 'webhook' | 'refund' | 'admin_action' | 'reconciliation'
  /// Free-form to avoid migration churn when we add a new event type.
  eventType         String         @map("event_type")
  /// Null on the very first event ('created').
  fromStatus        PaymentStatus? @map("from_status")
  /// Null when an event was informational (e.g. webhook received but no
  /// state change — duplicate, signature replay, etc.).
  toStatus          PaymentStatus? @map("to_status")
  /// Provider name when the event is webhook-driven: 'paymob' | 'kashier' | 'fawry'.
  provider          String?
  /// Raw provider POST body when event_type='webhook'. Lets us replay
  /// a dispute 6+ months later even if metadata on Payment has been
  /// overwritten by a later event.
  providerPayload   Json?          @map("provider_payload")
  /// Free-form details: idempotency key, signature hash, refund reason,
  /// admin notes, reconciliation diff — whatever the writer wants
  /// preserved without bloating the columns. Always non-null (default {}).
  details           Json           @default("{}")
  /// User who triggered the event (admin refund, customer cancel, etc.).
  /// Null for webhook + system events.
  triggeredByUserId String?        @map("triggered_by_user_id")
  /// Time the event actually occurred (provider timestamp if known,
  /// else server clock). Indexed for time-range queries.
  occurredAt        DateTime       @default(now()) @map("occurred_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  triggeredBy User?   @relation(fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  @@index([paymentId, occurredAt])
  @@index([storeId, occurredAt(sort: Desc)])
  @@index([orderId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([provider, occurredAt])
  @@index([triggeredByUserId])
  @@map("payment_events")
}

/// Transactional inbox for inbound payment-provider webhooks.
///
/// Why this exists: PaymentService.handleWebhook does a long chain of DB
/// mutations (payment.update + recordPaymentEvent + applyRefundEffects +
/// order.update) inside a tenant-scoped interactive $transaction. Running that
/// INLINE in the webhook request held connections on the shared basePrisma pool
/// that also serves auth/login — a provider webhook storm could starve auth
/// (P2024). See feedback-db-pool-starvation-webhook-storm-starves-auth.md.
///
/// The webhook route now: verify signature presence -> idempotency check ->
/// persist a row here (durable) -> inngest.send -> 200. The
/// payment-webhook-process Inngest function consumes it and runs the heavy
/// mutation OFF the request path. This row is the durable record so nothing is
/// lost if Inngest is briefly unavailable (the route also falls back to inline
/// processing on a send failure).
///
/// NOT an RLS-scoped table: it is written/read cross-tenant (the route resolves
/// storeId BY querying payments, and the consumer must read this row BEFORE it
/// can enter tenant context). Writes/reads use withRlsBypass, exactly like the
/// existing checkIdempotency / resolveStoreIdFromWebhookPayload helpers.
model WebhookEvent {
  id String @id @default(uuid())

  /// 'paymob' | 'kashier' | 'fawry'
  provider String

  /// Same idempotency key the route derives from the provider transaction id
  /// (generateIdempotencyKey). UNIQUE so a duplicate provider delivery upserts
  /// onto the same inbox row instead of creating a second one.
  idempotencyKey String @unique @map("idempotency_key")

  /// Resolved upfront from the matching Payment row. Null for the platform-only
  /// path (no per-store payment matched) — the consumer then uses withRlsBypass.
  storeId String? @map("store_id")

  /// Parsed JSON payload (for business logic / debugging).
  payload Json

  /// Exact raw bytes of the request body. handleWebhook re-verifies the HMAC
  /// signature against THIS in the consumer, so the cryptographic check is
  /// preserved off the request path.
  rawBody String @map("raw_body")

  /// The signature header the provider sent. Re-checked by handleWebhook.
  signature String

  /// received | processing | processed | failed
  status String @default("received")

  /// Increments each time the consumer attempts processing (Inngest retries).
  attempts Int @default(0)

  /// Last error string when status='failed' / a retry threw. Null otherwise.
  lastError String? @map("last_error")

  /// Result of a successful process, for audit / replay diagnostics.
  resultOrderId String? @map("result_order_id")
  resultStatus  String? @map("result_status")

  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  /// Optional back-relation; storeId is nullable (platform path).
  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@index([provider, receivedAt])
  @@index([storeId, receivedAt(sort: Desc)])
  @@map("webhook_events")
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  cancelled
  expired
  refunded
  partially_refunded
  disputed
  cod_pending
}

// ==========================================
// Returns & Exchanges
// ==========================================

model Return {
  id           String       @id @default(uuid())
  storeId      String       @map("store_id")
  orderId      String       @map("order_id")
  customerId   String       @map("customer_id")
  returnNumber String       @unique @map("return_number")
  type         ReturnType   @default(return)
  status       ReturnStatus @default(pending)
  reason       String
  reasonDetail String?      @map("reason_detail")

  // Refund info
  refundAmount Int       @default(0) @map("refund_amount")
  refundMethod String?   @map("refund_method") // original, store_credit, bank_transfer
  refundedAt   DateTime? @map("refunded_at")

  // Partial-return reversal recovery (issues 2246 / 2267): stamped when the
  // item-level order/refunded is requested (same tx as completion) and when
  // the fanout has applied it; refund-reversal-stuck-sweep re-sends the gap.
  reversalRequestedAt DateTime? @map("reversal_requested_at")
  reversalAppliedAt   DateTime? @map("reversal_applied_at")

  // Shipping
  trackingNumber String?   @map("tracking_number")
  shippedAt      DateTime? @map("shipped_at")
  receivedAt     DateTime? @map("received_at")

  // Admin
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  rejectedBy      String?   @map("rejected_by")
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason")

  adminNotes    String? @map("admin_notes")
  customerNotes String? @map("customer_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order              Order               @relation(fields: [orderId], references: [id])
  customer           User                @relation(fields: [customerId], references: [id])
  items              ReturnItem[]
  walletTransactions WalletTransaction[]

  @@index([storeId])
  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("returns")
}

model ReturnItem {
  id          String  @id @default(uuid())
  returnId    String  @map("return_id")
  orderItemId String  @map("order_item_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  quantity    Int
  reason      String?
  condition   String? // new, opened, damaged

  /// B2B Task 8b: signed piastres this item's refund was reduced by (kept units repriced below their tier). Snapshot.
  tierAdjustment           Int     @default(0) @map("tier_adjustment")
  adjustmentOverridden     Boolean @default(false) @map("adjustment_overridden")
  adjustmentOverrideReason String? @map("adjustment_override_reason")
  adjustmentOverrideBy     String? @map("adjustment_override_by")
  /// Ruling B2B-20: signed change this return made to its product's carried-forward shortfall (what the floor at 0 could not
  /// collect): + carried, - consumed or waived. On the product's first item of the return; the sum over completed returns is
  /// the carry the next return collects first.
  tierCarry                Int     @default(0) @map("tier_carry")

  return    Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
  @@index([orderItemId])
  @@map("return_items")
}

enum ReturnType {
  return
  exchange
  refund
}

enum ReturnStatus {
  pending
  approved
  rejected
  shipped
  received
  inspecting
  completed
  cancelled
}

// ==========================================
// Payment Provider Configuration
// Managed by Super Admin per Store
// ==========================================

model PaymentConfig {
  id            String  @id @default(uuid())
  storeId       String? @map("store_id") // null = global default
  /// Catalog provider code ('paymob', 'kashier', 'fawry', 'cod', 'instapay', ...), validated against
  /// packages/shared/src/providers/catalog.ts (was the closed enum PaymentProvider until 2026-10-07).
  provider      String
  isEnabled     Boolean @default(false) @map("is_enabled")
  isDefault     Boolean @default(false) @map("is_default")
  displayName   String? @map("display_name")
  displayNameAr String? @map("display_name_ar")

  // Encrypted credentials (stored encrypted)
  apiKey        String? @map("api_key")
  secretKey     String? @map("secret_key")
  merchantId    String? @map("merchant_id")
  webhookSecret String? @map("webhook_secret")

  // Non-secret display fingerprints (#2010): the last 4 characters of the
  // PLAINTEXT, captured at save time next to the encrypted value, so the admin
  // can see WHICH key is saved (`****abcd`) without any read path decrypting.
  // Null on rows saved before this column existed — shown as `****` with a
  // "re-save to show" hint until the key is saved again.
  apiKeyLast4     String? @map("api_key_last4")
  merchantIdLast4 String? @map("merchant_id_last4")

  // Catalog credentials (2026-10-07, expand step). `credentials` is the AES-256-GCM ciphertext of
  // {"sandbox": {field: value}, "live": {field: value}} keyed by the catalog's field keys; the four
  // legacy columns above are read only when it is NULL and are dropped by the contract migration.
  // `credentialHints` is non-secret display data ({set,last4} / {set,value}); `connectionTest` is
  // the last Test connection result and its credential fingerprint (the enable gate).
  credentials     String?
  credentialHints Json    @default("{}") @map("credential_hints")
  connectionTest  Json?   @map("connection_test")

  // Provider-specific settings
  testMode            Boolean  @default(true) @map("test_mode")
  supportedMethods    String[] @default([]) @map("supported_methods") // card, meeza, wallet, valu, instapay, ...
  supportedCurrencies String[] @default(["EGP"]) @map("supported_currencies")

  // Non-secret, provider-specific settings (InstaPay handle / phone / expiry,
  // COD percentage). Never credentials: those stay in the encrypted columns.
  settings Json @default("{}")

  // Fees configuration
  fixedFee      Int     @default(0) @map("fixed_fee") // in piastres
  percentageFee Decimal @default(0) @map("percentage_fee") @db.Decimal(5, 2) // e.g., 2.5 for 2.5%

  // Status
  lastHealthCheck DateTime?            @map("last_health_check")
  healthStatus    ProviderHealthStatus @default(unknown) @map("health_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@index([storeId])
  @@index([provider])
  @@index([isEnabled])
  @@map("payment_configs")
}

/// UNUSED since 20261007210000_payment_provider_codes (payment_configs.provider is TEXT now). Kept
/// until the contract migration so a rollback can cast the column back; do not reference it.
enum PaymentProvider {
  cod
  instapay
  paymob
  kashier
  fawry
}

enum ProviderHealthStatus {
  healthy
  degraded
  down
  unknown
}

// ==========================================
// System Settings (Super Admin)
// ==========================================

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String   @default("general")
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("system_settings")
}

// ==========================================
// Legal: policy acceptance + material-change notices (Ruling LEGAL-4)
// Versions live in code (packages/shared/src/legal LEGAL_POLICIES); these tables record
// what each user accepted and which versions were announced.
// ==========================================

/// One row per user per accepted document version. Append-only for ebda_app (UPDATE/DELETE
/// revoked in the migration). source: 'signup' (click-wrap) | 'notice_ack' (dashboard "Got it").
model LegalAcceptance {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  docKey     String   @map("doc_key")
  version    String
  acceptedAt DateTime @default(now()) @map("accepted_at")
  ip         String?
  userAgent  String?  @map("user_agent")
  source     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, docKey, version])
  @@map("legal_acceptances")
}

/// A WebAuthn credential (passkey). User-keyed under strict RLS, PUBLIC key only (Ruling PASSKEY-1).
/// `rpId` is the host it was minted for; sign-in refuses a credential whose rpId is not the request host.
/// `credentialId` / `publicKey` are base64url.
model PasskeyCredential {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  credentialId String    @unique @map("credential_id")
  publicKey    String    @map("public_key")
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceType   String    @map("device_type") // singleDevice | multiDevice
  backedUp     Boolean   @default(false) @map("backed_up")
  rpId         String    @map("rp_id")
  name         String
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

/// One row per announced (material) version: written by the super-admin "Send notice".
/// Platform-global (no user data): the banner reads it for every merchant.
model LegalNoticeSend {
  id             String   @id @default(uuid())
  docKey         String   @map("doc_key")
  version        String
  sentAt         DateTime @default(now()) @map("sent_at")
  /// The super_admin who pressed "Send notice" (not a FK: the record outlives the account).
  sentBy         String   @map("sent_by")
  /// Set by the fan-out once recipients are materialized.
  recipientCount Int?     @map("recipient_count")

  @@unique([docKey, version])
  @@map("legal_notice_sends")
}

/// The email fan-out ledger: one row per recipient per announced version. A row leaves
/// 'queued' (-> 'sending') BEFORE the mail is sent, so a retry never mails twice.
/// status: queued | sending | sent | failed
model LegalNoticeDelivery {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  docKey    String   @map("doc_key")
  version   String
  status    String   @default("queued")
  error     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, docKey, version])
  @@index([docKey, version, status])
  @@map("legal_notice_deliveries")
}

// ==========================================
// Feature Toggles (Per-Store)
// ==========================================

model StoreFeature {
  id         String    @id @default(uuid())
  storeId    String    @map("store_id")
  featureKey String    @map("feature_key")
  enabled    Boolean   @default(false)
  enabledAt  DateTime? @map("enabled_at")
  enabledBy  String?   @map("enabled_by")
  /// Ruling SF-EXPIRY-1: an override past this instant is ignored (the feature falls back to the plan baseline). NULL = never expires.
  expiresAt  DateTime? @map("expires_at")
  /// Why the override exists (free text for the super-admin: a comp, a sold add-on, a support grant).
  reason     String?
  updatedAt  DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User? @relation("FeatureToggledBy", fields: [enabledBy], references: [id], onDelete: SetNull)

  @@unique([storeId, featureKey])
  @@index([storeId])
  @@index([enabledBy])
  @@map("store_features")
}

