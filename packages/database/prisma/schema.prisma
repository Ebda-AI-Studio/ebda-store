model NewsletterSubscriber {
  id             String    @id @default(uuid())
  storeId        String    @map("store_id")
  email          String
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  /// Visitor language at signup ('en' or 'ar'). Lets admins segment
  /// future campaigns by audience language.
  language       String?
  /// Signup origin: 'footer' | 'popup' | 'manual'. Useful for analytics
  /// + identifying which surface drove the signup.
  source         String?
  isActive       Boolean   @default(true) @map("is_active")
  subscribedAt   DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, email])
  @@index([storeId])
  @@index([isActive])
  @@map("newsletter_subscribers")
}

// ==========================================
// Reviews & Ratings
// ==========================================

model Review {
  id         String  @id @default(cuid())
  productId  String  @map("product_id")
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId    String  @map("store_id")
  store      Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId    String  @map("order_id")
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId String? @map("customer_id")
  customer   User?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // The review content itself
  rating           Int // 1-5
  title            String?
  body             String    @db.Text
  language         String    @default("en") // 'en' | 'ar'
  bodyTranslated   String?   @map("body_translated") @db.Text // AI translation of body
  bodyTranslatedAt DateTime? @map("body_translated_at")

  // Verification + moderation
  verifiedPurchase Boolean @default(true) @map("verified_purchase") // always true via this flow
  status           String  @default("pending") // 'pending' | 'published' | 'rejected' | 'spam'
  rejectionReason  String? @map("rejection_reason")
  spamScore        Float?  @map("spam_score") // 0-1, AI-flagged
  spamReasons      Json?   @map("spam_reasons")

  // Merchant response (optional)
  ownerResponse   String?   @map("owner_response") @db.Text
  ownerResponseAr String?   @map("owner_response_ar") @db.Text
  ownerResponseAt DateTime? @map("owner_response_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([orderId, productId]) // one review per buyer-product pair
  @@index([productId, status])
  @@index([storeId, status])
  @@map("reviews")
}

// ==========================================
// Background jobs
// ==========================================

// Bulk product import job — queued from POST /:storeId/bulk/import,
// processed asynchronously by the Inngest `bulk-import-products`
// function so the request returns immediately and the admin can
// poll for progress instead of waiting on a long synchronous loop.
model BulkImportJob {
  id             String           @id @default(uuid())
  storeId        String           @map("store_id")
  userId         String?          @map("user_id")
  status         BulkImportStatus @default(queued)
  // Raw CSV content. Stored as text rather than referencing R2 to
  // keep the import pipeline self-contained — admin uploads are
  // small (mid-tens of MB at most) and TOAST handles it.
  csvData        String           @map("csv_data") @db.Text
  updateExisting Boolean          @default(true) @map("update_existing")
  // Progress counters — written by the Inngest function as it
  // processes rows. Polling endpoint reads these to render a
  // progress bar and final summary.
  total          Int              @default(0)
  processed      Int              @default(0)
  created        Int              @default(0)
  updated        Int              @default(0)
  failed         Int              @default(0)
  errors         Json? // Array of { row, error } once finished
  errorMessage   String?          @map("error_message") // Top-level failure reason if status=failed
  startedAt      DateTime?        @map("started_at")
  completedAt    DateTime?        @map("completed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([status])
  @@map("bulk_import_jobs")
}

enum BulkImportStatus {
  queued
  running
  completed
  failed
}

// Catalogue-wide AI sweep — translation or SEO generation across
// every product/category in a store. Started from the AI Tools admin
// page, processed by an Inngest function, polled by the same page
// for progress + final summary. The smart-skip rules from per-form
// AI buttons apply: never overwrite a filled field, never call the
// model for an entity that's already complete.
model BulkAiJob {
  id           String          @id @default(uuid())
  storeId      String          @map("store_id")
  userId       String?         @map("user_id")
  kind         BulkAiJobKind
  status       BulkAiJobStatus @default(queued)
  // Direction is meaningful only for translate jobs. `to_ar` = fill
  // empty Arabic from English source. `to_en` = the reverse.
  direction    String?         @db.Text
  total        Int             @default(0)
  processed    Int             @default(0)
  filled       Int             @default(0)
  skipped      Int             @default(0)
  failed       Int             @default(0)
  // Capped list of recent failures for surfacing to the merchant —
  // [{entityId, entityName, error}, ...]. Hard-cap to 50 so the row
  // doesn't grow unbounded on a totally-failing run.
  errors       Json?
  errorMessage String?         @map("error_message") // Top-level failure reason if status=failed
  startedAt    DateTime?       @map("started_at")
  completedAt  DateTime?       @map("completed_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([status])
  @@map("bulk_ai_jobs")
}

enum BulkAiJobKind {
  translate
  seo
  faq_aeo
  howto_aeo
  meta_aeo
  recommendations
  // GEO sweep kinds
  llms_txt
  citation_copy
  brand_facts
  description_balance
  description_revert
}

enum BulkAiJobStatus {
  queued
  running
  completed
  failed
  cancelled
}

// Tracks every AI call made on behalf of a store so we can enforce
// per-store daily token budgets, audit usage, and bill (if/when we
// charge for it). `cachedHit=true` means the AI service returned a
// cached answer and didn't actually call the model — counted for
// observability but not against the token budget.
model AiUsage {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  feature      String // 'translate' | 'seo' | 'categorize'
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  cachedHit    Boolean  @default(false) @map("cached_hit")
  createdAt    DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([feature])
  @@map("ai_usage")
}

// ==========================================
// AEO / GEO content — FAQ + HowTo
// ==========================================

model StoreFaq {
  id             String   @id @default(cuid())
  storeId        String   @map("store_id")
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  question       String   @map("question")
  questionAr     String?  @map("question_ar")
  answer         String   @map("answer") @db.Text
  answerAr       String?  @map("answer_ar") @db.Text
  // AI-draft state — smart-skip in the Gemini bulk sweep never overwrites
  // a manually-edited entry.
  aiDrafted      Boolean  @default(false) @map("ai_drafted")
  manuallyEdited Boolean  @default(false) @map("manually_edited")
  orderIndex     Int      @default(0) @map("order_index")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([storeId, isActive, orderIndex])
  @@map("store_faqs")
}

model StoreHowto {
  id             String   @id @default(cuid())
  storeId        String   @map("store_id")
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title          String   @map("title")
  titleAr        String?  @map("title_ar")
  description    String   @map("description") @db.Text
  descriptionAr  String?  @map("description_ar") @db.Text
  // HowTo.step is an array of HowToStep — stored as JSON.
  // Format: [{ name, text, image? }, ...]
  steps          Json     @map("steps")
  // Arabic steps — same shape as steps but bilingual text values.
  stepsAr        Json?    @map("steps_ar")
  aiDrafted      Boolean  @default(false) @map("ai_drafted")
  manuallyEdited Boolean  @default(false) @map("manually_edited")
  orderIndex     Int      @default(0) @map("order_index")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([storeId, isActive, orderIndex])
  @@map("store_howtos")
}

// Per-product FAQs (e.g. "Does this ring come in size 7?") — separate
// from store-level FAQs so Product schema can include them inline.
model ProductFaq {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  question       String
  questionAr     String?  @map("question_ar")
  answer         String   @db.Text
  answerAr       String?  @map("answer_ar") @db.Text
  aiDrafted      Boolean  @default(false) @map("ai_drafted")
  manuallyEdited Boolean  @default(false) @map("manually_edited")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_faqs")
}

// ==========================================
// Accounting (Batch 1 — foundations)
// ==========================================

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum JournalEntrySource {
  order
  refund
  purchase_order
  expense
  stock_adjustment
  manual
  period_close
  opening_balance
}

enum JournalEntryStatus {
  posted
  reversed
  draft
}

model Sequence {
  // Per-store, per-kind monotonically-increasing counter. Used for entryNumber,
  // poNumber, adjustmentNumber, expenseNumber. Atomic increment via FOR UPDATE.
  storeId   String   @map("store_id")
  kind      String // 'journal' | 'po' | 'adjustment' | 'expense'
  next      Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, kind])
  @@map("sequences")
}

model Account {
  id        String      @id @default(uuid())
  storeId   String      @map("store_id")
  code      String
  nameEn    String      @map("name_en")
  nameAr    String?     @map("name_ar")
  type      AccountType
  parentId  String?     @map("parent_id")
  isSystem  Boolean     @default(false) @map("is_system")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  store              Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent             Account?        @relation("AccountTree", fields: [parentId], references: [id])
  children           Account[]       @relation("AccountTree")
  lines              JournalLine[]
  expensesByCategory Expense[]       @relation("ExpenseCategoryAccount")
  expensesPaidFrom   Expense[]       @relation("ExpensePaidFromAccount")
  purchaseOrders     PurchaseOrder[] @relation("PoApAccount")
  bankStatements     BankStatement[] @relation("BankStatementAccount")

  @@unique([storeId, code])
  @@index([storeId, type])
  @@map("accounts")
}

model JournalEntry {
  id           String             @id @default(uuid())
  storeId      String             @map("store_id")
  entryNumber  String             @map("entry_number")
  postedAt     DateTime           @map("posted_at")
  source       JournalEntrySource
  sourceId     String?            @map("source_id")
  reversedById String?            @unique @map("reversed_by_id")
  memo         String?
  memoAr       String?            @map("memo_ar")
  status       JournalEntryStatus @default(posted)
  postedBy     String?            @map("posted_by")
  createdAt    DateTime           @default(now()) @map("created_at")

  store         Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  lines         JournalLine[]
  reversedBy    JournalEntry?     @relation("Reversal", fields: [reversedById], references: [id])
  reverses      JournalEntry?     @relation("Reversal")
  bankTxMatches BankTransaction[] @relation("BankTxJournalMatch")

  @@unique([storeId, entryNumber])
  @@index([storeId, postedAt(sort: Desc)])
  @@index([source, sourceId])
  @@index([storeId, status])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(uuid())
  entryId        String   @map("entry_id")
  accountId      String   @map("account_id")
  debit          Int      @default(0)
  credit         Int      @default(0)
  currency       String   @default("KWD")
  /// FX rate: 1 unit of `currency` = fxRate KWD.
  /// Stored as exact numeric(16,8) — no float drift.
  /// KWD lines: 1. Non-KWD: e.g. 0.30700000 for USD→KWD.
  fxRate         Decimal? @default(1) @map("fx_rate") @db.Decimal(16, 8)
  /// Original amount in minor units of `currency` before KWD conversion.
  /// For KWD lines this equals debit (or credit). For non-KWD lines this is
  /// the raw foreign amount; debit/credit hold the KWD-converted fils.
  originalAmount Int?     @default(0) @map("original_amount")
  lineMemo       String?  @map("line_memo")
  lineMemoAr     String?  @map("line_memo_ar")
  refTable       String?  @map("ref_table")
  refId          String?  @map("ref_id")
  createdAt      DateTime @default(now()) @map("created_at")

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
  @@index([refTable, refId])
  @@map("journal_lines")
}

/**
 * FX Rate Registry — merchant-maintained log of exchange rates for a date.
 * Rate meaning: 1 unit of `currency` = `rate` KWD.
 * Example: { currency: 'USD', rate: 0.307, rateDate: '2026-06-15' }
 * means 1 USD was worth 0.307 KWD on that date.
 * There is no unique constraint on (storeId, currency, rateDate) by design —
 * merchants may record multiple rates for the same date (intraday corrections).
 * The most recently created row for a given date is the effective rate.
 * Feature gate: accounting.multi_currency (Enterprise).
 * RLS: standard store_id-scoped policy.
 */
model FxRateEntry {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  /// ISO-4217 currency code (e.g. 'USD', 'EUR'). Always uppercase.
  currency   String
  /// Rate: 1 unit of `currency` = rate KWD. numeric(16,8) — exact decimal.
  rate       Decimal  @db.Decimal(16, 8)
  /// Date the rate applies to. Stored as a date-only timestamp (UTC midnight).
  rateDate   DateTime @map("rate_date") @db.Date
  recordedBy String?  @map("recorded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, currency, rateDate(sort: Desc)])
  @@map("fx_rate_entries")
}

