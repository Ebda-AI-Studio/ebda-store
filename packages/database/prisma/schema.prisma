// Force Website Builder - Database Schema
// Prisma ORM
//
// NOTE: Prisma Migrate does not generate down (rollback) migrations by default.
// For critical schema changes (e.g. dropping columns, renaming tables, changing
// types), write a manual SQL down-migration in the corresponding migration
// directory (e.g. prisma/migrations/<name>/down.sql) so the change can be
// safely reverted in production if needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// User & Authentication
// ==========================================

model User {
  id            String     @id @default(uuid())
  // Customer accounts are scoped to a single store. The same email can
  // register on Store A and Store B without colliding — Store A's
  // ahmad@x.com is a distinct account from Store B's ahmad@x.com.
  //
  // Admins leave this NULL because admin emails sit in one global
  // namespace (enforced by the partial unique `users_admin_email_key`).
  // NULL is NOT an access grant: store_admins still only see the stores
  // they own, gated by Store.ownerId + the `requireStoreAccess`
  // middleware on every admin route. A super_admin can never silently
  // become a customer of any store, and a store_admin can never read
  // another tenant's data.
  storeId       String?    @map("store_id")
  email         String
  passwordHash  String     @map("password_hash")
  firstName     String     @map("first_name")
  lastName      String     @map("last_name")
  phone         String?
  role          UserRole   @default(customer)
  status        UserStatus @default(active)
  emailVerified Boolean    @default(false) @map("email_verified")
  avatar        String?
  dateOfBirth   DateTime?  @map("date_of_birth") // For birthday bonus automation
  language      String     @default("en") // en, ar
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at") // Soft delete support

  // Relations
  authStore              Store?                  @relation("StoreCustomers", fields: [storeId], references: [id], onDelete: Cascade)
  stores                 Store[]
  orders                 Order[]
  carts                  Cart[]
  addresses              Address[]
  refreshTokens          RefreshToken[]
  verificationTokens     VerificationToken[]
  auditLogs              AuditLog[]
  wishlists              Wishlist[]
  reviews                Review[]
  returns                Return[]
  loyaltyPoints          LoyaltyPoints[]
  loyaltyTransactions    LoyaltyTransaction[]
  featureToggles         StoreFeature[]          @relation("FeatureToggledBy")
  pushSubscriptions      PushSubscription[]      @relation("UserPushSubscriptions")
  onesignalSubscriptions OneSignalSubscription[] @relation("UserOneSignalSubscriptions")
  abandonedCarts         AbandonedCart[]         @relation("AbandonedCartCustomer")

  // Composite unique (storeId, email) — one customer account per email per
  // store. Admins (storeId NULL) are not subject to this constraint thanks
  // to Postgres treating NULLs as distinct, so we add a partial unique
  // index in the migration to keep admin emails globally unique.
  //
  // ⚠️ MIGRATION GUARD: the partial unique `users_admin_email_key`
  // (`UNIQUE ON users(email) WHERE store_id IS NULL`) is NOT
  // representable in Prisma's `@@unique` syntax, so `prisma migrate dev`
  // will offer to drop it on every diff against this schema. NEVER
  // accept that drop — duplicate global admin emails break login
  // (AuthService.login uses findFirst, gets non-deterministic row).
  // The reassert migration `20260430030000_reassert_admin_email_unique`
  // re-creates it idempotently on every `migrate deploy`.
  @@unique([storeId, email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

enum UserRole {
  customer
  store_admin
  super_admin
}

enum UserStatus {
  active
  inactive
  suspended
}

model RefreshToken {
  id            String    @id @default(uuid())
  token         String    @unique
  userId        String    @map("user_id")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  // Reuse-detection fields. On rotate we keep the old row (with
  // replacedById set) instead of deleting it so a replay of the same
  // refresh token is recognisable as a stolen-token signal. See
  // AuthService.refreshTokens — any lookup hitting a row with
  // revokedAt!=NULL revokes every token for that user.
  replacedById  String?   @map("replaced_by_id")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String                @id @default(uuid())
  token     String                @unique
  userId    String                @map("user_id")
  type      VerificationTokenType @default(email)
  expiresAt DateTime              @map("expires_at")
  usedAt    DateTime?             @map("used_at")
  createdAt DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([type])
  @@map("verification_tokens")
}

enum VerificationTokenType {
  email
  password_reset
  two_factor
}

// ==========================================
// Store (Multi-tenant)
// ==========================================

model Store {
  id                    String      @id @default(uuid())
  name                  String
  nameAr                String?     @map("name_ar")
  slug                  String      @unique
  domain                String?     @unique
  // Resend email-sender state (platform-managed under a single Resend account)
  emailSenderLocalPart  String      @default("noreply") @map("email_sender_local_part")
  emailDomainId         String?     @map("email_domain_id")
  emailDomainStatus     String?     @map("email_domain_status")
  emailDomainVerifiedAt DateTime?   @map("email_domain_verified_at")
  ownerId               String      @map("owner_id")
  status                StoreStatus @default(active)
  plan                  StorePlan   @default(starter)
  logo                  String?
  logoAr                String?     @map("logo_ar")
  favicon               String?
  // Hero customization
  heroTitle             String?     @map("hero_title")
  heroTitleAr           String?     @map("hero_title_ar")
  heroSubtitle          String?     @map("hero_subtitle")
  heroSubtitleAr        String?     @map("hero_subtitle_ar")
  heroCtaText           String?     @map("hero_cta_text")
  heroCtaTextAr         String?     @map("hero_cta_text_ar")
  heroCtaLink           String?     @map("hero_cta_link")
  heroImage             String?     @map("hero_image")
  // Cover image shown on the storefront's Best Sellers virtual
  // category tile. Optional — when null the storefront falls back to
  // the text-only treatment.
  bestSellersImage      String?     @map("best_sellers_image")
  // Per-store typography overrides — see TypographySettings type in
  // @force/shared. JSON because the shape will keep evolving (more
  // zones, line-height/letter-spacing, etc.) and we don't want a
  // column-add migration each time.
  typography            Json?       @map("typography")
  description           String?
  descriptionAr         String?     @map("description_ar")
  currency              String      @default("KWD")
  timezone              String      @default("Asia/Kuwait")
  settings              Json        @default("{}")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  deletedAt             DateTime?   @map("deleted_at") // Soft delete support

  // Template & Theme
  template       StoreTemplate @default(modern)
  theme          Json          @default("{}") // StoreTheme JSON
  layoutSettings Json          @default("{}") @map("layout_settings") // StoreLayoutSettings JSON — empty object means "use packaged defaults" (the Pecannbee flow)

  // Social Links
  socialLinks Json @default("{}") @map("social_links") // StoreSocialLinks JSON

  // Contact Information
  email     String?
  phone     String?
  phoneAr   String? @map("phone_ar")
  whatsapp  String?
  address   String?
  addressAr String? @map("address_ar")

  // Announcement Bar
  announcementBar Json? @map("announcement_bar") // AnnouncementBar JSON

  // SEO
  metaTitle              String? @map("meta_title")
  metaTitleAr            String? @map("meta_title_ar")
  metaDescription        String? @map("meta_description")
  metaDescriptionAr      String? @map("meta_description_ar")
  ogImage                String? @map("og_image")
  twitterHandle          String? @map("twitter_handle")
  googleSiteVerification String? @map("google_site_verification")

  // Marketing Pixels & Analytics
  marketingPixels    Json    @default("{}") @map("marketing_pixels") // MarketingPixels JSON
  // Individual pixel IDs for quick access
  metaPixelId        String? @map("meta_pixel_id") // Facebook/Meta Pixel
  tiktokPixelId      String? @map("tiktok_pixel_id") // TikTok Pixel
  snapchatPixelId    String? @map("snapchat_pixel_id") // Snapchat Pixel
  googleAnalyticsId  String? @map("google_analytics_id") // GA4 Measurement ID
  googleTagManagerId String? @map("google_tag_manager_id") // GTM Container ID
  googleAdsId        String? @map("google_ads_id") // Google Ads Conversion ID
  twitterPixelId     String? @map("twitter_pixel_id") // Twitter/X Pixel
  pinterestTagId     String? @map("pinterest_tag_id") // Pinterest Tag

  // Tax Settings
  taxEnabled         Boolean  @default(false) @map("tax_enabled")
  taxIncludedInPrice Boolean  @default(false) @map("tax_included_in_price") // Prices include tax
  defaultTaxRate     Decimal? @map("default_tax_rate") @db.Decimal(5, 2) // Default tax percentage

  // Loyalty Program Settings
  loyaltyEnabled  Boolean @default(false) @map("loyalty_enabled")
  loyaltySettings Json    @default("{}") @map("loyalty_settings") // LoyaltySettings JSON

  // PWA Settings
  pwaEnabled  Boolean @default(false) @map("pwa_enabled")
  pwaSettings Json    @default("{}") @map("pwa_settings") // PWASettings JSON

  // Blog (Bucket E1, 2026-05-17) — opt-in per store. When false the
  // /blog routes return 404 and BlogCarousel hides on the homepage.
  blogEnabled Boolean @default(false) @map("blog_enabled")

  // Force WhatsApp Business Platform integration (opt-in per store)
  // wbsApiKey is encrypted via AES-GCM using apps/api/src/services/encryption.service.ts
  // wbsTemplates shape: { orderPaid?, orderShipped?, orderDelivered? }
  //   each entry: { name: string, languageCode: string, channels?: { whatsapp: boolean, email: boolean } }
  //   channels defaults: { whatsapp: true, email: true } when absent (backward-compatible)
  wbsEnabled                Boolean @default(false) @map("wbs_enabled")
  wbsClientId               String? @map("wbs_client_id")
  wbsApiKey                 String? @map("wbs_api_key")
  wbsTemplates              Json?   @map("wbs_templates")
  /// Phase 7 opt-in (2026-05-22): when true, generate templates with a
  /// HEADER IMAGE component pinned to Store.logo. Customer sees the store
  /// logo at the top of every order-update WhatsApp message. Defaults
  /// false because uploading + maintaining the Meta header_handle adds
  /// complexity per template re-submission.
  wbsTemplateUseLogoHeader  Boolean @default(false) @map("wbs_template_use_logo_header")
  /// Customer-DM ordering via WhatsApp (2026-05-23): when true, WBS
  /// state machine is enabled for this store — customers who DM the
  /// store's WhatsApp number can order directly. Stored here so FWB
  /// can gate the feature per-store and push the flag to WBS.
  /// Default OFF — merchant must opt in explicitly.
  waCustomerOrderingEnabled Boolean @default(false) @map("wa_customer_ordering_enabled")
  /// Phase 2 bot intelligence (2026-05-24): per-store WhatsApp bot copy overrides.
  /// Shape: Record<string, { en?: string; ar?: string }> keyed by state/purpose.
  /// e.g. { greeting: { en: "Hi!", ar: "مرحبا!" }, ask_category: { ar: "أي فئة؟" } }
  /// Absent keys fall back to canonical defaults in WBS botCopyDefaults.js.
  /// Supports {storeName}, {customerName}, {items}, {total}, {currency} placeholder vars.
  botCopy                   Json?   @map("bot_copy")

  // Accounting Settings (Batch 1)
  accountingEnabled    Boolean @default(true) @map("accounting_enabled")
  defaultTaxRateBps    Int     @default(0) @map("default_tax_rate_bps")
  fiscalYearStartMonth Int     @default(1) @map("fiscal_year_start_month")

  // Accounting Settings (Batch 2)
  expenseTwoStepApproval Boolean @default(false) @map("expense_two_step_approval")

  // Accounting Settings (Batch 3)
  aiFeaturesEnabled Boolean @default(true) @map("ai_features_enabled")
  aiBulkThrottleMs  Int     @default(2500) @map("ai_bulk_throttle_ms")

  // Accounting Settings (Batch 4 — Insights)
  aiNarrationEnabled Boolean @default(true) @map("ai_narration_enabled")
  insightsRollupCron String  @default("daily") @map("insights_rollup_cron")

  // Relations
  owner                    User                       @relation(fields: [ownerId], references: [id])
  // Customer accounts that authenticate against this store. Distinct from
  // `customers` (which is the per-store order-history record).
  customerUsers            User[]                     @relation("StoreCustomers")
  products                 Product[]
  categories               Category[]
  orders                   Order[]
  carts                    Cart[]
  customers                Customer[]
  paymentConfigs           PaymentConfig[]
  coupons                  Coupon[]
  shippingZones            ShippingZone[]
  taxRates                 TaxRate[]
  loyaltyPoints            LoyaltyPoints[]
  loyaltyTransactions      LoyaltyTransaction[]
  wishlists                Wishlist[]
  newsletters              NewsletterSubscriber[]
  reviews                  Review[]
  returns                  Return[]
  inventoryHistory         InventoryHistory[]
  tags                     Tag[]
  auditLogs                AuditLog[]
  features                 StoreFeature[]
  notificationConfigs      NotificationConfig[]
  notificationEventConfigs NotificationEventConfig[]
  pushSubscriptions        PushSubscription[]
  notificationLogs         NotificationLog[]
  abandonedCarts           AbandonedCart[]
  abandonedCartConfig      AbandonedCartConfig?
  productRelations         ProductRelation[]
  frequentlyBoughtTogether FrequentlyBoughtTogether[]
  aiRecommendations        AiRecommendation[]
  shippingCarrierConfigs   ShippingCarrierConfig[]
  shipments                Shipment[]
  affiliates               Affiliate[]
  affiliateReferrals       AffiliateReferral[]
  affiliatePayouts         AffiliatePayout[]
  affiliateConfig          AffiliateConfig?
  pages                    StorePage[]
  bulkImportJobs           BulkImportJob[]
  aiUsage                  AiUsage[]
  bulkAiJobs               BulkAiJob[]
  faqs                     StoreFaq[]
  howtos                   StoreHowto[]
  blogPosts                BlogPost[]
  accounts                 Account[]
  journalEntries           JournalEntry[]
  sequences                Sequence[]
  suppliers                Supplier[]
  purchaseOrders           PurchaseOrder[]
  stockAdjustments         StockAdjustment[]
  reorderRules             ReorderRule[]
  backorderLines           BackorderLine[]
  expenses                 Expense[]
  reorderSuggestions       ReorderSuggestion[]
  deadstockFlags           DeadStockFlag[]
  profitAnomalies          ProfitAnomaly[]
  customerCohortSnapshots  CustomerCohortSnapshot[]
  funnelSnapshots          FunnelSnapshot[]
  customerRfmSnapshots     CustomerRfmSnapshot[]
  whatsAppTemplates        WhatsAppTemplate[]

  @@index([ownerId])
  @@index([status])
  @@index([plan])
  @@index([createdAt])
  @@map("stores")
}

// ==========================================
// Blog Posts (Bucket E1, 2026-05-17)
// ==========================================
//
// Per-store blog. Opt-in via `Store.blogEnabled`. Content is stored as
// plain text with `\n\n` paragraph separators — rendered server-side
// via `paragraph-render.ts` which escapes every text node, so no
// client-side sanitizer dep is required. Future rich-text content
// will land via a contentBlocks JSON column mirroring StorePage.
//
// `publishedAt` is set when isPublished flips to true; serves as the
// canonical date both for sorting and for the OG/Article published_time
// SEO field on the public detail page.
model BlogPost {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  slug        String
  title       String
  titleAr     String?   @map("title_ar")
  excerpt     String?
  excerptAr   String?   @map("excerpt_ar")
  content     String
  contentAr   String?   @map("content_ar")
  coverImage  String?   @map("cover_image")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId, isPublished, publishedAt])
  @@map("blog_posts")
}

// ==========================================
// Store Pages CMS (about / privacy / terms / shipping / faq / custom)
// ==========================================
//
// Per-store editable long-form content. Each row is one page identified by
// a slug. Content is stored as a structured block array (JSONB) — one
// array per locale — and the API renders it to XSS-safe HTML for the
// storefront. The storefront uses pre-rendered HTML directly (no
// client-side renderer).
//
// Visibility model:
//   - row missing            → storefront falls back to legacy hardcoded copy
//   - row present, off       → storefront renders "Page unavailable" (NO fallback)
//   - row present, on, empty → storefront falls back to legacy hardcoded copy
//   - row present, on, full  → storefront renders the page
//
// The hard-off case means merchants can take a page completely offline
// without it silently reverting to the platform's default text.

model StorePage {
  id              String   @id @default(uuid())
  storeId         String   @map("store_id")
  slug            String // about | privacy | terms | shipping | faq | <custom>
  title           String?
  titleAr         String?  @map("title_ar")
  contentBlocks   Json?    @map("content_blocks") // Block[] (English) — see pages.service.ts
  contentBlocksAr Json?    @map("content_blocks_ar") // Block[] (Arabic)
  coverImage      String?  @map("cover_image") // optional R2 URL for header image
  isPublished     Boolean  @default(true) @map("is_published")
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("store_pages")
}

model Customer {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  email       String
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  phone       String?
  notes       String?
  totalOrders Int      @default(0) @map("total_orders")
  totalSpent  Int      @default(0) @map("total_spent")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, email])
  @@index([storeId])
  @@index([email])
  @@index([createdAt])
  @@map("customers")
}

enum StoreStatus {
  active
  inactive
  suspended
}

enum StorePlan {
  free
  starter
  professional
  enterprise
}

enum StoreTemplate {
  modern
  classic
  minimal
  bold
  elegant
}

// ==========================================
// Products & Categories
// ==========================================

model Category {
  id                String    @id @default(uuid())
  storeId           String    @map("store_id")
  name              String
  nameAr            String?   @map("name_ar")
  slug              String
  description       String?
  descriptionAr     String?   @map("description_ar")
  image             String?
  parentId          String?   @map("parent_id")
  position          Int       @default(0)
  isActive          Boolean   @default(true) @map("is_active")
  // SEO meta — set per-category in admin or via the AI bulk sweep.
  metaTitle         String?   @map("meta_title")
  metaTitleAr       String?   @map("meta_title_ar")
  metaDescription   String?   @map("meta_description")
  metaDescriptionAr String?   @map("meta_description_ar")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at") // Soft delete support

  // Relations
  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[]        @relation("CategoryHierarchy")
  products ProductCategory[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id                String        @id @default(uuid())
  storeId           String        @map("store_id")
  name              String
  nameAr            String?       @map("name_ar")
  slug              String
  description       String?
  descriptionAr     String?       @map("description_ar")
  price             Int // Price in fils (1 KWD = 1000 fils)
  compareAtPrice    Int?          @map("compare_at_price")
  costPrice         Int?          @map("cost_price")
  sku               String?
  barcode           String?
  inventory         Int           @default(0)
  lowStockThreshold Int           @default(5) @map("low_stock_threshold")
  trackInventory    Boolean       @default(true) @map("track_inventory")
  weight            Float?
  dimensions        Json? // { length, width, height }
  status            ProductStatus @default(draft)
  featured          Boolean       @default(false)
  isNew             Boolean       @default(false) @map("is_new")
  // Manually curated by the store admin — drives the storefront's
  // "Best Sellers" carousel. Independent of actual order data so a merchant
  // can stage products at launch before any sales data exists.
  isBestSeller      Boolean       @default(false) @map("is_best_seller")
  viewCount         Int           @default(0) @map("view_count")
  metaTitle         String?       @map("meta_title")
  metaTitleAr       String?       @map("meta_title_ar")
  metaDescription   String?       @map("meta_description")
  metaDescriptionAr String?       @map("meta_description_ar")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at") // Soft delete support
  allowBackorder    Boolean       @default(false) @map("allow_backorder")
  lastCostUpdateAt  DateTime?     @map("last_cost_update_at")

  // Variants
  hasVariants Boolean @default(false) @map("has_variants")

  // Relations
  store                Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  images               ProductImage[]
  categories           ProductCategory[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  tags                 ProductTag[]
  wishlists            WishlistItem[]
  reviews              Review[]
  returnItems          ReturnItem[]
  inventoryHistory     InventoryHistory[]
  options              ProductOption[]
  variants             ProductVariant[]
  relationsAsSource    ProductRelation[]          @relation("ProductRelationSource")
  relationsAsTarget    ProductRelation[]          @relation("ProductRelationTarget")
  fbtAsProduct1        FrequentlyBoughtTogether[] @relation("FBTProduct1")
  fbtAsProduct2        FrequentlyBoughtTogether[] @relation("FBTProduct2")
  aiRecsAsSource       AiRecommendation[]         @relation("AiRecSource")
  aiRecsAsTarget       AiRecommendation[]         @relation("AiRecTarget")
  faqs                 ProductFaq[]
  purchaseOrderItems   PurchaseOrderItem[]
  stockAdjustmentItems StockAdjustmentItem[]
  reorderRules         ReorderRule[]
  backorderLines       BackorderLine[]
  reorderSuggestions   ReorderSuggestion[]
  deadstockFlags       DeadStockFlag[]

  @@unique([storeId, slug])
  @@unique([storeId, sku]) // Prevent duplicate SKUs within a store (null values are excluded)
  @@index([storeId])
  @@index([status])
  @@index([featured])
  @@index([price])
  @@index([createdAt])
  @@index([storeId, status]) // Composite: products by store and status
  // Composite for the storefront "best seller" strip — created in
  // 20260426010000_add_product_is_best_seller. Without this entry the
  // schema doesn't know about the index and `prisma migrate dev` will
  // try to drop it on every diff.
  @@index([storeId, isBestSeller])
  // Storefront list query: store-scoped, soft-delete-aware, newest-first.
  // Created in 20260501030000_perf_indexes.
  @@index([storeId, deletedAt, createdAt(sort: Desc)])
  @@map("products")
}

enum ProductStatus {
  draft
  active
  archived
}

// ==========================================
// Inventory Management
// ==========================================

model InventoryHistory {
  id            String              @id @default(uuid())
  productId     String              @map("product_id")
  storeId       String              @map("store_id")
  type          InventoryChangeType
  quantity      Int // Change amount (positive or negative)
  previousStock Int                 @map("previous_stock")
  newStock      Int                 @map("new_stock")
  reason        String?
  reference     String? // Order ID, adjustment ID, etc.
  createdBy     String?             @map("created_by") // User ID who made the change
  createdAt     DateTime            @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([storeId])
  @@index([createdAt])
  @@map("inventory_history")
}

enum InventoryChangeType {
  manual_add // Manual stock increase
  manual_remove // Manual stock decrease
  sale // Sold via order
  return_stock // Returned to stock
  adjustment // Inventory count adjustment
  damage // Damaged goods
  transfer_in // Transferred from another location
  transfer_out // Transferred to another location
  initial // Initial stock setup
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductCategory {
  productId  String @map("product_id")
  categoryId String @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model Tag {
  id       String       @id @default(uuid())
  storeId  String       @map("store_id")
  name     String
  products ProductTag[]

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, name])
  @@index([storeId])
  @@map("tags")
}

model ProductTag {
  productId String @map("product_id")
  tagId     String @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

// ==========================================
// Product Variants
// ==========================================

// Option types like "Size", "Color"
model ProductOption {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  name      String // e.g., "Size", "Color"
  nameAr    String?  @map("name_ar")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

// Option values like "Small", "Red"
model ProductOptionValue {
  id        String   @id @default(uuid())
  optionId  String   @map("option_id")
  value     String // e.g., "Small", "Red"
  valueAr   String?  @map("value_ar")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  option   ProductOption          @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants ProductVariantOption[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

// A specific variant combining options (e.g., "Size: Large, Color: Red")
model ProductVariant {
  id             String   @id @default(uuid())
  productId      String   @map("product_id")
  title          String // Generated from option values: "Large / Red"
  titleAr        String?  @map("title_ar")
  sku            String?
  barcode        String?
  price          Int? // Override price (null = use product price)
  compareAtPrice Int?     @map("compare_at_price")
  costPrice      Int?     @map("cost_price")
  inventory      Int      @default(0)
  weight         Float?
  imageUrl       String?  @map("image_url")
  position       Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  allowBackorder Boolean  @default(false) @map("allow_backorder")

  product              Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  options              ProductVariantOption[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  stockAdjustmentItems StockAdjustmentItem[]
  reorderRules         ReorderRule[]
  backorderLines       BackorderLine[]
  reorderSuggestions   ReorderSuggestion[]
  deadstockFlags       DeadStockFlag[]

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

// Junction table linking variants to their option values
model ProductVariantOption {
  variantId String @map("variant_id")
  valueId   String @map("value_id")

  variant ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value   ProductOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([variantId, valueId])
  @@map("product_variant_options")
}

// ==========================================
// Cart
// ==========================================

model Cart {
  id             String   @id @default(uuid())
  storeId        String   @map("store_id")
  customerId     String?  @map("customer_id")
  sessionId      String   @map("session_id")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer      User?          @relation(fields: [customerId], references: [id])
  items         CartItem[]
  abandonedCart AbandonedCart?

  @@unique([storeId, sessionId])
  @@index([storeId])
  @@index([customerId])
  @@index([sessionId])
  @@index([updatedAt])
  @@index([lastActivityAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  variantId String?  @map("variant_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// ==========================================
// Orders
// ==========================================

model Order {
  id                  String             @id @default(uuid())
  storeId             String             @map("store_id")
  customerId          String?            @map("customer_id")
  orderNumber         String             @unique @map("order_number")
  status              OrderStatus        @default(pending)
  paymentStatus       OrderPaymentStatus @default(unpaid) @map("payment_status")
  subtotal            Int
  tax                 Int                @default(0)
  shipping            Int                @default(0)
  discount            Int                @default(0)
  total               Int
  // Extra out-of-catalog amount used by merchant-initiated payment
  // links — a custom service fee, deposit, or quote that doesn't map
  // to a Product. Baked into `total` at order creation; rendered as
  // a synthetic line in admin order detail. extraAmountNote captures
  // what the charge is for ("Photography deposit", "Rush fee", etc.).
  extraAmount         Int                @default(0) @map("extra_amount")
  extraAmountNote     String?            @map("extra_amount_note")
  currency            String             @default("KWD")
  couponCode          String?            @map("coupon_code")
  couponDiscount      Int                @default(0) @map("coupon_discount")
  notes               String?
  customerNotes       String?            @map("customer_notes")
  shippingAddress     Json               @map("shipping_address")
  billingAddress      Json               @map("billing_address")
  shippedAt           DateTime?          @map("shipped_at")
  deliveredAt         DateTime?          @map("delivered_at")
  reviewRequestSentAt DateTime?          @map("review_request_sent_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  deletedAt           DateTime?          @map("deleted_at") // Soft delete support

  // Buyer's UI locale at checkout time ('en' | 'ar'). Used to send
  // transactional emails in the customer's language regardless of the
  // store's defaultLanguage setting. NULL for pre-feature orders —
  // email service falls back to store.settings.defaultLanguage.
  locale String?

  // Webhook idempotency - prevents duplicate processing
  idempotencyKey     String?   @unique @map("idempotency_key")
  webhookProcessedAt DateTime? @map("webhook_processed_at")

  // Relations
  store               Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer            User?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            Payment[]
  reviews             Review[]
  returns             Return[]
  loyaltyTransactions LoyaltyTransaction[]
  shipment            Shipment?
  affiliateReferrals  AffiliateReferral[]

  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([storeId, customerId]) // Composite: customer orders in a store
  @@index([storeId, status]) // Composite: orders by store and status
  // Admin orders list — newest first within a store. Created in
  // 20260501030000_perf_indexes.
  @@index([storeId, createdAt(sort: Desc)])
  @@map("orders")
}

enum OrderPaymentStatus {
  unpaid
  paid
  failed
  refunded
  disputed
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  refunded
}

model OrderItem {
  id                String  @id @default(uuid())
  orderId           String  @map("order_id")
  productId         String  @map("product_id")
  variantId         String? @map("variant_id")
  productName       String  @map("product_name")
  variantName       String? @map("variant_name") // e.g., "Large / Red"
  sku               String?
  quantity          Int
  price             Int
  // Cost-of-goods snapshot at sale time. Stored in fils, same scale as
  // `price`. Snapshotted because the product's cost may change later but
  // the order's profit must reflect what it cost on the day it shipped.
  // Nullable for orders placed before this column existed.
  costPrice         Int?    @map("cost_price")
  total             Int
  costPriceDeferred Boolean @default(false) @map("cost_price_deferred")

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  returnItems    ReturnItem[]
  backorderLines BackorderLine[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String        @map("order_id")
  provider       String        @default("tap") // tap, myfatoorah, hesabe, upayments
  method         String? // knet, visa, mastercard, apple_pay, etc.
  status         PaymentStatus @default(pending)
  amount         Int
  currency       String        @default("KWD")
  transactionId  String?       @map("transaction_id")
  invoiceId      String?       @map("invoice_id")
  paymentUrl     String?       @map("payment_url")
  refundId       String?       @map("refund_id")
  refundedAmount Int           @default(0) @map("refunded_amount")
  failureReason  String?       @map("failure_reason")
  paidAt         DateTime?     @map("paid_at")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionId])
  @@index([invoiceId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  cancelled
  expired
  refunded
  partially_refunded
  disputed
  cod_pending
}

// ==========================================
// Returns & Exchanges
// ==========================================

model Return {
  id           String       @id @default(uuid())
  storeId      String       @map("store_id")
  orderId      String       @map("order_id")
  customerId   String       @map("customer_id")
  returnNumber String       @unique @map("return_number")
  type         ReturnType   @default(return)
  status       ReturnStatus @default(pending)
  reason       String
  reasonDetail String?      @map("reason_detail")

  // Refund info
  refundAmount Int       @default(0) @map("refund_amount")
  refundMethod String?   @map("refund_method") // original, store_credit, bank_transfer
  refundedAt   DateTime? @map("refunded_at")

  // Shipping
  trackingNumber String?   @map("tracking_number")
  shippedAt      DateTime? @map("shipped_at")
  receivedAt     DateTime? @map("received_at")

  // Admin
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  rejectedBy      String?   @map("rejected_by")
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason")

  adminNotes    String? @map("admin_notes")
  customerNotes String? @map("customer_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store    Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order    Order        @relation(fields: [orderId], references: [id])
  customer User         @relation(fields: [customerId], references: [id])
  items    ReturnItem[]

  @@index([storeId])
  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("returns")
}

model ReturnItem {
  id          String  @id @default(uuid())
  returnId    String  @map("return_id")
  orderItemId String  @map("order_item_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  quantity    Int
  reason      String?
  condition   String? // new, opened, damaged

  return    Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
  @@map("return_items")
}

enum ReturnType {
  return
  exchange
  refund
}

enum ReturnStatus {
  pending
  approved
  rejected
  shipped
  received
  inspecting
  completed
  cancelled
}

// ==========================================
// Payment Provider Configuration
// Managed by Super Admin per Store
// ==========================================

model PaymentConfig {
  id            String          @id @default(uuid())
  storeId       String?         @map("store_id") // null = global default
  provider      PaymentProvider
  isEnabled     Boolean         @default(false) @map("is_enabled")
  isDefault     Boolean         @default(false) @map("is_default")
  displayName   String?         @map("display_name")
  displayNameAr String?         @map("display_name_ar")

  // Encrypted credentials (stored encrypted)
  apiKey        String? @map("api_key")
  secretKey     String? @map("secret_key")
  merchantId    String? @map("merchant_id")
  webhookSecret String? @map("webhook_secret")

  // Provider-specific settings
  testMode            Boolean  @default(true) @map("test_mode")
  supportedMethods    String[] @default([]) @map("supported_methods") // knet, visa, apple_pay, etc.
  supportedCurrencies String[] @default(["KWD"]) @map("supported_currencies")

  // Fees configuration
  fixedFee      Int     @default(0) @map("fixed_fee") // in fils
  percentageFee Decimal @default(0) @map("percentage_fee") @db.Decimal(5, 2) // e.g., 2.5 for 2.5%

  // Status
  lastHealthCheck DateTime?            @map("last_health_check")
  healthStatus    ProviderHealthStatus @default(unknown) @map("health_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@index([storeId])
  @@index([provider])
  @@index([isEnabled])
  @@map("payment_configs")
}

enum PaymentProvider {
  tap
  myfatoorah
  hesabe
  upayments
  cod
}

enum ProviderHealthStatus {
  healthy
  degraded
  down
  unknown
}

// ==========================================
// System Settings (Super Admin)
// ==========================================

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String   @default("general")
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("system_settings")
}

// ==========================================
// Feature Toggles (Per-Store)
// ==========================================

model StoreFeature {
  id         String    @id @default(uuid())
  storeId    String    @map("store_id")
  featureKey String    @map("feature_key")
  enabled    Boolean   @default(false)
  enabledAt  DateTime? @map("enabled_at")
  enabledBy  String?   @map("enabled_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User? @relation("FeatureToggledBy", fields: [enabledBy], references: [id], onDelete: SetNull)

  @@unique([storeId, featureKey])
  @@index([storeId])
  @@map("store_features")
}

// ==========================================
// Communication Hub
// ==========================================

model NotificationConfig {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  channel     String // 'whatsapp' | 'sms' | 'push'
  provider    String // 'meta' | 'unifonic' | 'firebase'
  credentials String   @default("") // Encrypted JSON string
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, channel])
  @@index([storeId])
  @@map("notification_configs")
}

model NotificationEventConfig {
  id       String  @id @default(uuid())
  storeId  String  @map("store_id")
  event    String // 'order_confirmed' | 'payment_success' | etc.
  whatsapp Boolean @default(true)
  sms      Boolean @default(true)
  push     Boolean @default(true)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, event])
  @@index([storeId])
  @@map("notification_event_configs")
}

model PushSubscription {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  customerId String?  @map("customer_id")
  endpoint   String
  p256dh     String
  auth       String
  deviceInfo String?  @map("device_info")
  createdAt  DateTime @default(now()) @map("created_at")

  store    Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer User? @relation("UserPushSubscriptions", fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([storeId, endpoint])
  @@index([storeId])
  @@index([customerId])
  @@map("push_subscriptions")
}

model OneSignalSubscription {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  playerId    String   @map("player_id") // OneSignal player / subscription ID
  deviceLabel String?  @map("device_label") // e.g. "Chrome on Mac" — for the user devices page
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation("UserOneSignalSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, playerId])
  @@index([userId])
  @@map("onesignal_subscriptions")
}

model NotificationLog {
  id                 String   @id @default(uuid())
  storeId            String   @map("store_id")
  channel            String
  event              String
  recipientPhoneHash String?  @map("recipient_phone_hash")
  recipientEmailHash String?  @map("recipient_email_hash")
  status             String   @default("queued")
  providerMessageId  String?  @map("provider_message_id")
  idempotencyKey     String?  @unique @map("idempotency_key")
  error              String?
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, channel])
  @@index([storeId, event])
  @@index([status])
  @@map("notification_logs")
}

// ==========================================
// Abandoned Cart Recovery
// ==========================================

model AbandonedCart {
  id               String    @id @default(uuid())
  storeId          String    @map("store_id")
  cartId           String    @unique @map("cart_id")
  customerId       String?   @map("customer_id")
  sessionId        String?   @map("session_id")
  customerEmail    String?   @map("customer_email")
  customerPhone    String?   @map("customer_phone")
  cartTotal        Decimal   @map("cart_total") @db.Decimal(12, 3)
  cartItemCount    Int       @map("cart_item_count")
  cartItems        Json      @map("cart_items")
  status           String    @default("pending")
  step1SentAt      DateTime? @map("step1_sent_at")
  step2SentAt      DateTime? @map("step2_sent_at")
  step3SentAt      DateTime? @map("step3_sent_at")
  recoveredAt      DateTime? @map("recovered_at")
  recoveredOrderId String?   @map("recovered_order_id")
  couponId         String?   @map("coupon_id")
  nextStepAt       DateTime? @map("next_step_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  store    Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cart     Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  customer User?   @relation("AbandonedCartCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@unique([storeId, cartId])
  @@index([storeId])
  @@index([storeId, status])
  @@index([nextStepAt])
  @@map("abandoned_carts")
}

model AbandonedCartConfig {
  id                    String   @id @default(uuid())
  storeId               String   @unique @map("store_id")
  step1Enabled          Boolean  @default(true) @map("step1_enabled")
  step1DelayMinutes     Int      @default(60) @map("step1_delay_minutes")
  step2Enabled          Boolean  @default(true) @map("step2_enabled")
  step2DelayMinutes     Int      @default(240) @map("step2_delay_minutes")
  step3Enabled          Boolean  @default(true) @map("step3_enabled")
  step3DelayMinutes     Int      @default(1440) @map("step3_delay_minutes")
  autoCouponEnabled     Boolean  @default(true) @map("auto_coupon_enabled")
  couponDiscountPercent Int      @default(10) @map("coupon_discount_percent")
  couponMaxDiscount     Decimal? @map("coupon_max_discount") @db.Decimal(12, 3)
  couponExpiryHours     Int      @default(48) @map("coupon_expiry_hours")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("abandoned_cart_configs")
}

// ==========================================
// Upsell / Cross-sell
// ==========================================

model ProductRelation {
  id              String   @id @default(uuid())
  storeId         String   @map("store_id")
  sourceProductId String   @map("source_product_id")
  targetProductId String   @map("target_product_id")
  type            String
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  store         Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sourceProduct Product @relation("ProductRelationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProduct Product @relation("ProductRelationTarget", fields: [targetProductId], references: [id], onDelete: Cascade)

  @@unique([storeId, sourceProductId, targetProductId, type])
  @@index([storeId, sourceProductId])
  @@index([storeId, targetProductId])
  @@map("product_relations")
}

model FrequentlyBoughtTogether {
  id                String   @id @default(uuid())
  storeId           String   @map("store_id")
  productId1        String   @map("product_id_1")
  productId2        String   @map("product_id_2")
  coOccurrenceCount Int      @default(0) @map("co_occurrence_count")
  lastCalculatedAt  DateTime @default(now()) @map("last_calculated_at")

  store    Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product1 Product @relation("FBTProduct1", fields: [productId1], references: [id], onDelete: Cascade)
  product2 Product @relation("FBTProduct2", fields: [productId2], references: [id], onDelete: Cascade)

  @@unique([storeId, productId1, productId2])
  @@index([storeId, productId1])
  @@index([storeId, productId2])
  @@index([coOccurrenceCount])
  @@map("frequently_bought_together")
}

// ==========================================
// AI Recommendations
// ==========================================
//
// Catalogue-wide AI cross-sell suggestions generated by the
// bulk-ai-recommendations Inngest sweep. Priority in the
// recommendation service: manual cross-sells > AI recs > FBT.
//
// score: 0.0–1.0 confidence from Gemini. Used for ordering.
// reason: one-sentence explanation from Gemini. Useful for admin
//         debugging and future "explain this recommendation" UX.
//
// Rows are fully replaced on every re-sweep (deleteMany + createMany)
// so stale picks never accumulate.
model AiRecommendation {
  id              String   @id @default(uuid())
  storeId         String   @map("store_id")
  sourceProductId String   @map("source_product_id")
  targetProductId String   @map("target_product_id")
  score           Float    @default(0.5)
  reason          String?  @db.Text
  generatedAt     DateTime @default(now()) @map("generated_at")

  store         Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sourceProduct Product @relation("AiRecSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProduct Product @relation("AiRecTarget", fields: [targetProductId], references: [id], onDelete: Cascade)

  @@unique([storeId, sourceProductId, targetProductId])
  @@index([storeId, sourceProductId])
  @@index([storeId, generatedAt])
  @@map("ai_recommendation")
}

