  wishlistId String   @map("wishlist_id")
  productId  String   @map("product_id")
  addedAt    DateTime @default(now()) @map("added_at")

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ==========================================
// Coupons & Discounts
// ==========================================

model Coupon {
  id               String       @id @default(uuid())
  storeId          String       @map("store_id")
  code             String
  name             String
  nameAr           String?      @map("name_ar")
  description      String?
  descriptionAr    String?      @map("description_ar")
  type             CouponType   @default(percentage)
  value            Int          // percentage (0-100) or fixed amount in fils
  minOrderAmount   Int?         @map("min_order_amount")
  maxDiscount      Int?         @map("max_discount") // Max discount for percentage coupons
  usageLimit       Int?         @map("usage_limit")
  usageCount       Int          @default(0) @map("usage_count")
  usageLimitPerUser Int?        @map("usage_limit_per_user")
  isActive         Boolean      @default(true) @map("is_active")
  startsAt         DateTime?    @map("starts_at")
  expiresAt        DateTime?    @map("expires_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  store         Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  abandonedCarts AbandonedCart[]

  @@unique([storeId, code])
  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

enum CouponType {
  percentage
  fixed
  free_shipping
}

// ==========================================
// Shipping Zones
// ==========================================

model ShippingZone {
  id                     String   @id @default(uuid())
  storeId                String   @map("store_id")
  name                   String
  nameAr                 String?  @map("name_ar")
  areas                  Json     @default("[]") // Array of area/city names
  areasAr                Json     @default("[]") @map("areas_ar") // Arabic area names
  deliveryFee            Int      @default(0) @map("delivery_fee") // In fils (1 KWD = 1000 fils)
  freeShippingThreshold  Int?     @map("free_shipping_threshold") // Order amount for free shipping
  estimatedDays          Int?     @map("estimated_days") // Estimated delivery days
  estimatedDaysMin       Int?     @map("estimated_days_min") // Min delivery days
  estimatedDaysMax       Int?     @map("estimated_days_max") // Max delivery days
  position               Int      @default(0) // Sort order
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([isActive])
  @@map("shipping_zones")
}

// ==========================================
// Tax Rates
// ==========================================

model TaxRate {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  name          String   // e.g., "VAT", "Sales Tax", "GST"
  nameAr        String?  @map("name_ar")
  rate          Decimal  @db.Decimal(5, 2) // Tax percentage (e.g., 5.00 for 5%)
  country       String?  // ISO country code (null = all countries)
  state         String?  // State/region (null = all states)
  priority      Int      @default(0) // Higher priority rates override lower
  isCompound    Boolean  @default(false) @map("is_compound") // Apply on top of other taxes
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([country, state])
  @@map("tax_rates")
}

// ==========================================
// Loyalty Program
// ==========================================

model LoyaltyPoints {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  customerId    String   @map("customer_id")
  points        Int      @default(0) // Current point balance
  totalEarned   Int      @default(0) @map("total_earned") // Lifetime earned
  totalRedeemed Int      @default(0) @map("total_redeemed") // Lifetime redeemed
  tier          String   @default("bronze") // Valid values: "bronze" | "silver" | "gold" | "platinum". Not an enum to avoid migrations on tier changes.
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  store    Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer User  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([storeId, customerId])
  @@index([storeId])
  @@index([customerId])
  @@map("loyalty_points")
}

model LoyaltyTransaction {
  id            String              @id @default(uuid())
  storeId       String              @map("store_id")
  customerId    String              @map("customer_id")
  orderId       String?             @map("order_id")
  type          LoyaltyTransactionType
  points        Int                 // Positive for earn, negative for redeem
  description   String?
  expiresAt     DateTime?           @map("expires_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([customerId])
  @@index([orderId])
  @@index([storeId, customerId])
  @@map("loyalty_transactions")
}

enum LoyaltyTransactionType {
  earn_purchase    // Points earned from purchase
  earn_signup      // Bonus points for signing up
  earn_referral    // Points for referring someone
  earn_review      // Points for leaving a review
  earn_birthday    // Birthday bonus points
  earn_manual      // Manually added by admin
  redeem_discount  // Points redeemed for discount
  redeem_product   // Points redeemed for free product
  expire           // Points expired
  adjust           // Manual adjustment
}

// ==========================================
// Newsletter Subscriptions
// ==========================================

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  email        String
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  isActive     Boolean  @default(true) @map("is_active")
  subscribedAt DateTime @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, email])
  @@index([storeId])
  @@index([isActive])
  @@map("newsletter_subscribers")
}

// ==========================================
// Reviews & Ratings
// ==========================================

model Review {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  productId    String   @map("product_id")
  customerId   String?  @map("customer_id")
  orderId      String?  @map("order_id")
  rating       Int      // 1-5
  title        String?
  comment      String?
  isVerified   Boolean  @default(false) @map("is_verified") // Verified purchase
  isApproved   Boolean  @default(false) @map("is_approved")
  helpfulCount Int      @default(0) @map("helpful_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer User?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([storeId])
  @@index([customerId])
  @@index([rating])
  @@index([storeId, productId])  // Composite: reviews by store and product
  @@map("reviews")
}
