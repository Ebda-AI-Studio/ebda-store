  status      String    @default("pending")
  paidAt      DateTime? @map("paid_at")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([affiliateId])
  @@index([status])
  @@map("affiliate_payouts")
}

model AffiliateConfig {
  id                    String   @id @default(uuid())
  storeId               String   @unique @map("store_id")
  defaultCommissionRate Decimal  @default(10) @map("default_commission_rate") @db.Decimal(5, 2)
  cookieDurationDays    Int      @default(30) @map("cookie_duration_days")
  minPayoutAmount       Decimal  @default(5000) @map("min_payout_amount") @db.Decimal(12, 3)
  autoApprove           Boolean  @default(false) @map("auto_approve")
  publicSignupEnabled   Boolean  @default(true) @map("public_signup_enabled")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("affiliate_configs")
}

// Append-only audit trail for every Affiliate status change and
// financial event. Mirrors the PaymentEvent pattern — never updated,
// never deleted. storeId is denormalized so admin queries can be
// scoped to a store without joining affiliates.
model AffiliateEvent {
  id                String   @id @default(uuid())
  affiliateId       String   @map("affiliate_id")
  storeId           String   @map("store_id")
  eventType         String   @map("event_type") // approve | reject | suspend | commission_recorded | payout_initiated | payout_completed | created
  fromStatus        String?  @map("from_status")
  toStatus          String?  @map("to_status")
  triggeredByUserId String?  @map("triggered_by_user_id")
  details           Json     @default("{}") @map("details")
  occurredAt        DateTime @default(now()) @map("occurred_at")
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  triggeredByUser User?     @relation("AffiliateEventTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  @@index([affiliateId, occurredAt])
  @@index([storeId, occurredAt(sort: Desc)])
  @@index([eventType])
  @@map("affiliate_events")
}

// ==========================================
// Audit Logging
// ==========================================

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  userId       String?  @map("user_id")
  storeId      String?  @map("store_id")
  resourceType String   @map("resource_type")
