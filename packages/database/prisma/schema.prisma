// Force Website Builder - Database Schema
// Prisma ORM
//
// NOTE: Prisma Migrate does not generate down (rollback) migrations by default.
// For critical schema changes (e.g. dropping columns, renaming tables, changing
// types), write a manual SQL down-migration in the corresponding migration
// directory (e.g. prisma/migrations/<name>/down.sql) so the change can be
// safely reverted in production if needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// User & Authentication
// ==========================================

model User {
  id            String     @id @default(uuid())
  // Customer accounts are scoped to a single store. The same email can
  // register on Store A and Store B without colliding — Store A's
  // ahmad@x.com is a distinct account from Store B's ahmad@x.com.
  //
  // Admins leave this NULL because admin emails sit in one global
  // namespace (enforced by the partial unique `users_admin_email_key`).
  // NULL is NOT an access grant: store_admins still only see the stores
  // they own, gated by Store.ownerId + the `requireStoreAccess`
  // middleware on every admin route. A super_admin can never silently
  // become a customer of any store, and a store_admin can never read
  // another tenant's data.
  storeId       String?    @map("store_id")
  email         String
  passwordHash  String     @map("password_hash")
  firstName     String     @map("first_name")
  lastName      String     @map("last_name")
  phone         String?
  role          UserRole   @default(customer)
  status        UserStatus @default(active)
  emailVerified Boolean    @default(false) @map("email_verified")
  avatar        String?
  dateOfBirth   DateTime?  @map("date_of_birth") // For birthday bonus automation
  language      String     @default("en") // en, ar
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at") // Soft delete support

  // 2FA / MFA
  mfaEnabled     Boolean   @default(false) @map("mfa_enabled")
  mfaSecret      String?   @map("mfa_secret")
  mfaBackupCodes String[]  @default([]) @map("mfa_backup_codes")
  mfaEnrolledAt  DateTime? @map("mfa_enrolled_at")
  // session revocation
  tokenVersion   Int       @default(0) @map("token_version")

  // Relations
  authStore                Store?                  @relation("StoreCustomers", fields: [storeId], references: [id], onDelete: Cascade)
  stores                   Store[]
  orders                   Order[]
  carts                    Cart[]
  addresses                Address[]
  refreshTokens            RefreshToken[]
  verificationTokens       VerificationToken[]
  auditLogs                AuditLog[]
  wishlists                Wishlist[]
  reviews                  Review[]
  returns                  Return[]
  loyaltyPoints            LoyaltyPoints[]
  loyaltyTransactions      LoyaltyTransaction[]
  featureToggles           StoreFeature[]          @relation("FeatureToggledBy")
  pushSubscriptions        PushSubscription[]      @relation("UserPushSubscriptions")
  onesignalSubscriptions   OneSignalSubscription[] @relation("UserOneSignalSubscriptions")
  abandonedCarts           AbandonedCart[]         @relation("AbandonedCartCustomer")
  triggeredPaymentEvents   PaymentEvent[]
  triggeredAffiliateEvents AffiliateEvent[]        @relation("AffiliateEventTriggeredBy")
  staffMemberships         StoreStaff[]            @relation("StaffUser")

  // Composite unique (storeId, email) — one customer account per email per
  // store. Admins (storeId NULL) are not subject to this constraint thanks
  // to Postgres treating NULLs as distinct, so we add a partial unique
  // index in the migration to keep admin emails globally unique.
  //
  // ⚠️ MIGRATION GUARD: the partial unique `users_admin_email_key`
  // (`UNIQUE ON users(email) WHERE store_id IS NULL`) is NOT
  // representable in Prisma's `@@unique` syntax, so `prisma migrate dev`
  // will offer to drop it on every diff against this schema. NEVER
  // accept that drop — duplicate global admin emails break login
  // (AuthService.login uses findFirst, gets non-deterministic row).
  // The reassert migration `20260430030000_reassert_admin_email_unique`
  // re-creates it idempotently on every `migrate deploy`.
  @@unique([storeId, email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

enum UserRole {
  customer
  store_admin
  super_admin
  staff
}

enum UserStatus {
  active
  inactive
  suspended
}

model RefreshToken {
  id            String    @id @default(uuid())
  token         String    @unique
  userId        String    @map("user_id")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  // Reuse-detection fields. On rotate we keep the old row (with
  // replacedById set) instead of deleting it so a replay of the same
  // refresh token is recognisable as a stolen-token signal. See
  // AuthService.refreshTokens — any lookup hitting a row with
  // revokedAt!=NULL revokes every token for that user.
  replacedById  String?   @map("replaced_by_id")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String                @id @default(uuid())
  token     String                @unique
  userId    String                @map("user_id")
  type      VerificationTokenType @default(email)
  expiresAt DateTime              @map("expires_at")
  usedAt    DateTime?             @map("used_at")
  createdAt DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([type])
  @@map("verification_tokens")
}

enum VerificationTokenType {
  email
  password_reset
  two_factor
}

// ==========================================
// Store (Multi-tenant)
// ==========================================

model Store {
  id                    String      @id @default(uuid())
  name                  String
  nameAr                String?     @map("name_ar")
  slug                  String      @unique
  domain                String?     @unique
  // Frontend hosting provider for this store's custom domain: 'vercel' (default,
  // null) or 'cloudflare' (Cloudflare-for-SaaS). null = use the DOMAIN_PROVIDER env.
  domainProvider        String?     @map("domain_provider")
  // Resend email-sender state (platform-managed under a single Resend account)
  emailSenderLocalPart  String      @default("noreply") @map("email_sender_local_part")
  emailDomainId         String?     @map("email_domain_id")
  emailDomainStatus     String?     @map("email_domain_status")
  emailDomainVerifiedAt DateTime?   @map("email_domain_verified_at")
  ownerId               String      @map("owner_id")
  status                StoreStatus @default(active)
  plan                  StorePlan   @default(starter)
  logo                  String?
  logoAr                String?     @map("logo_ar")
  favicon               String?
  // Hero customization
  heroTitle             String?     @map("hero_title")
  heroTitleAr           String?     @map("hero_title_ar")
  heroSubtitle          String?     @map("hero_subtitle")
  heroSubtitleAr        String?     @map("hero_subtitle_ar")
  heroCtaText           String?     @map("hero_cta_text")
  heroCtaTextAr         String?     @map("hero_cta_text_ar")
  heroCtaLink           String?     @map("hero_cta_link")
  heroImage             String?     @map("hero_image")
  // Cover image shown on the storefront's Best Sellers virtual
  // category tile. Optional — when null the storefront falls back to
  // the text-only treatment.
  bestSellersImage      String?     @map("best_sellers_image")
  // Per-store typography overrides — see TypographySettings type in
  // @force/shared. JSON because the shape will keep evolving (more
  // zones, line-height/letter-spacing, etc.) and we don't want a
  // column-add migration each time.
  typography            Json?       @map("typography")
  description           String?
  descriptionAr         String?     @map("description_ar")
  currency              String      @default("KWD")
  timezone              String      @default("Asia/Kuwait")
  settings              Json        @default("{}")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  deletedAt             DateTime?   @map("deleted_at") // Soft delete support

  // Template & Theme
  template       StoreTemplate @default(modern)
  theme          Json          @default("{}") // StoreTheme JSON
  layoutSettings Json          @default("{}") @map("layout_settings") // StoreLayoutSettings JSON — empty object means "use packaged defaults" (the Pecannbee flow)

  // Social Links
  socialLinks Json @default("{}") @map("social_links") // StoreSocialLinks JSON

  // Contact Information
  email         String?
  phone         String?
  phoneAr       String? @map("phone_ar")
  whatsapp      String?
  address       String?
  addressAr     String? @map("address_ar")
  // Used by WhatsApp bot "Locations & Hours" branch (Phase D.6 / Wave 2A)
  businessHours String? @map("business_hours") // free-text, e.g. "Sat–Thu 9am–10pm"
  googleMapsUrl String? @map("google_maps_url") // full Maps URL for the store location

  // Announcement Bar
  announcementBar Json? @map("announcement_bar") // AnnouncementBar JSON

  // SEO
  metaTitle              String? @map("meta_title")
  metaTitleAr            String? @map("meta_title_ar")
  metaDescription        String? @map("meta_description")
  metaDescriptionAr      String? @map("meta_description_ar")
  // AEO — conversational answer-engine copy. Written by bulk-ai-meta-aeo
  // sweep. Storefront coalesces at render time: AEO > SEO > null.
  metaDescriptionAeo     String? @map("meta_description_aeo")
  metaDescriptionAeoAr   String? @map("meta_description_aeo_ar")
  ogImage                String? @map("og_image")
  twitterHandle          String? @map("twitter_handle")
  googleSiteVerification String? @map("google_site_verification")

  // Marketing Pixels & Analytics
  marketingPixels    Json    @default("{}") @map("marketing_pixels") // MarketingPixels JSON
  // Individual pixel IDs for quick access
  metaPixelId        String? @map("meta_pixel_id") // Facebook/Meta Pixel
  tiktokPixelId      String? @map("tiktok_pixel_id") // TikTok Pixel
  snapchatPixelId    String? @map("snapchat_pixel_id") // Snapchat Pixel
  googleAnalyticsId  String? @map("google_analytics_id") // GA4 Measurement ID
  googleTagManagerId String? @map("google_tag_manager_id") // GTM Container ID
  googleAdsId        String? @map("google_ads_id") // Google Ads Conversion ID
  twitterPixelId     String? @map("twitter_pixel_id") // Twitter/X Pixel
  pinterestTagId     String? @map("pinterest_tag_id") // Pinterest Tag

  // Tax Settings
  taxEnabled         Boolean  @default(false) @map("tax_enabled")
  taxIncludedInPrice Boolean  @default(false) @map("tax_included_in_price") // Prices include tax
  defaultTaxRate     Decimal? @map("default_tax_rate") @db.Decimal(5, 2) // Default tax percentage

  // Loyalty Program Settings
  loyaltyEnabled  Boolean @default(false) @map("loyalty_enabled")
  loyaltySettings Json    @default("{}") @map("loyalty_settings") // LoyaltySettings JSON

  // PWA Settings
  pwaEnabled  Boolean @default(false) @map("pwa_enabled")
  pwaSettings Json    @default("{}") @map("pwa_settings") // PWASettings JSON

  // Blog (Bucket E1, 2026-05-17) — opt-in per store. When false the
  // /blog routes return 404 and BlogCarousel hides on the homepage.
  blogEnabled Boolean @default(false) @map("blog_enabled")

  // Store Locations / Branches — opt-in per store. When false the
  // /locations routes return 404 and the locations admin page is hidden.
  locationsEnabled Boolean @default(false) @map("locations_enabled")

  // Force AI WhatsApp Business Platform integration (opt-in per store)
  // wbsApiKey is encrypted via AES-GCM using apps/api/src/services/encryption.service.ts
  // wbsTemplates shape: { orderPaid?, orderShipped?, orderDelivered? }
  //   each entry: { name: string, languageCode: string, channels?: { whatsapp: boolean, email: boolean } }
  //   channels defaults: { whatsapp: true, email: true } when absent (backward-compatible)
  wbsEnabled                Boolean @default(false) @map("wbs_enabled")
  wbsClientId               String? @map("wbs_client_id")
  wbsApiKey                 String? @map("wbs_api_key")
  wbsTemplates              Json?   @map("wbs_templates")
  /// Phase 7 opt-in (2026-05-22): when true, generate templates with a
  /// HEADER IMAGE component pinned to Store.logo. Customer sees the store
  /// logo at the top of every order-update WhatsApp message. Defaults
  /// false because uploading + maintaining the Meta header_handle adds
  /// complexity per template re-submission.
  wbsTemplateUseLogoHeader  Boolean @default(false) @map("wbs_template_use_logo_header")
  /// Customer-DM ordering via WhatsApp (2026-05-23): when true, WBS
  /// state machine is enabled for this store — customers who DM the
  /// store's WhatsApp number can order directly. Stored here so FWB
  /// can gate the feature per-store and push the flag to WBS.
  /// Default OFF — merchant must opt in explicitly.
  waCustomerOrderingEnabled Boolean @default(false) @map("wa_customer_ordering_enabled")
  /// Phase 2 bot intelligence (2026-05-24): per-store WhatsApp bot copy overrides.
  /// Shape: Record<string, { en?: string; ar?: string }> keyed by state/purpose.
  /// e.g. { greeting: { en: "Hi!", ar: "مرحبا!" }, ask_category: { ar: "أي فئة؟" } }
  /// Absent keys fall back to canonical defaults in WBS botCopyDefaults.js.
  /// Supports {storeName}, {customerName}, {items}, {total}, {currency} placeholder vars.
  botCopy                   Json?   @map("bot_copy")

  // GEO (Generative Engine Optimization) — LLM-search visibility fields.
  // Written by bulk-ai-geo Inngest sweep. Merchantscan edit via admin.
  /// LLMs.txt content for this store — served at /<slug>/llms.txt by the storefront.
  llmsTxt   String? @map("llms_txt")
  /// Structured brand facts: { foundedYear?, location?, categories[], certifications?, languages[], contact? }
  aboutJson Json?   @map("about_json")

  // Accounting Settings (Batch 1)
  accountingEnabled    Boolean @default(true) @map("accounting_enabled")
  defaultTaxRateBps    Int     @default(0) @map("default_tax_rate_bps")
  fiscalYearStartMonth Int     @default(1) @map("fiscal_year_start_month")

  // Accounting Settings (Batch 2)
  expenseTwoStepApproval Boolean @default(false) @map("expense_two_step_approval")

  // Accounting Settings (Batch 3)
  aiFeaturesEnabled Boolean @default(true) @map("ai_features_enabled")
  aiBulkThrottleMs  Int     @default(2500) @map("ai_bulk_throttle_ms")

  // Accounting Settings (Batch 4 — Insights)
  aiNarrationEnabled Boolean @default(true) @map("ai_narration_enabled")
  insightsRollupCron String  @default("daily") @map("insights_rollup_cron")

  // WhatsApp Native Catalog Bot (Phase A, 2026-05-25)
  // bot_mode controls which state machine branch WBS activates:
  //   legacy_chat                    — original category/product list bot (default)
  //   native_catalog                 — Meta Commerce Catalog send + pre-catalog greeting flow
  //   native_catalog_with_gemini_agent — native_catalog + Gemini AI agent on Agent path
  // Flip via Admin → WhatsApp → Bot Mode dropdown. No automatic cutover on existing stores.
  botMode         String  @default("legacy_chat") @map("bot_mode")
  /// Service menu configuration (JSON). Shape:
  /// { orderNow: bool, subscriptionBoxes: bool, locationsHours: bool, chatWithAgent: bool,
  ///   labels: { en: { orderNow?, subscriptionBoxes?, locationsHours?, chatWithAgent? },
  ///              ar: { ... } } }
  /// Absent = WBS uses canonical defaults.
  botServiceMenu  Json?   @map("bot_service_menu")
  /// FB Commerce Catalog ID (per-merchant, obtained from Meta Business Manager)
  metaCatalogId   String? @map("meta_catalog_id")
  /// FB Business Manager ID
  metaBusinessId  String? @map("meta_business_id")
  /// Long-lived User Access Token for the Meta Catalog API, encrypted via
  /// CREDENTIAL_ENCRYPTION_KEY (same pattern as wbsApiKey). NEVER returned plain.
  metaAccessToken String? @map("meta_access_token")

  // Relations
  owner                    User                       @relation(fields: [ownerId], references: [id])
  // Customer accounts that authenticate against this store. Distinct from
  // `customers` (which is the per-store order-history record).
  customerUsers            User[]                     @relation("StoreCustomers")
  products                 Product[]
  categories               Category[]
  orders                   Order[]
  carts                    Cart[]
  customers                Customer[]
  paymentConfigs           PaymentConfig[]
  coupons                  Coupon[]
  shippingZones            ShippingZone[]
  shippingAreaRates        ShippingAreaRate[]
  taxRates                 TaxRate[]
  loyaltyPoints            LoyaltyPoints[]
  loyaltyTransactions      LoyaltyTransaction[]
  wishlists                Wishlist[]
  newsletters              NewsletterSubscriber[]
  reviews                  Review[]
  returns                  Return[]
  inventoryHistory         InventoryHistory[]
  tags                     Tag[]
  auditLogs                AuditLog[]
  features                 StoreFeature[]
  notificationConfigs      NotificationConfig[]
  notificationEventConfigs NotificationEventConfig[]
  pushSubscriptions        PushSubscription[]
  notificationLogs         NotificationLog[]
  abandonedCarts           AbandonedCart[]
  abandonedCartConfig      AbandonedCartConfig?
  productRelations         ProductRelation[]
  frequentlyBoughtTogether FrequentlyBoughtTogether[]
  aiRecommendations        AiRecommendation[]
  shippingCarrierConfigs   ShippingCarrierConfig[]
  shipments                Shipment[]
  affiliates               Affiliate[]
  affiliateReferrals       AffiliateReferral[]
  affiliatePayouts         AffiliatePayout[]
  affiliateConfig          AffiliateConfig?
  affiliateEvents          AffiliateEvent[]
  pages                    StorePage[]
  bulkImportJobs           BulkImportJob[]
  aiUsage                  AiUsage[]
  bulkAiJobs               BulkAiJob[]
  faqs                     StoreFaq[]
  howtos                   StoreHowto[]
  blogPosts                BlogPost[]
  locations                StoreLocation[]
  accounts                 Account[]
  journalEntries           JournalEntry[]
  sequences                Sequence[]
  suppliers                Supplier[]
  purchaseOrders           PurchaseOrder[]
  stockAdjustments         StockAdjustment[]
  reorderRules             ReorderRule[]
  backorderLines           BackorderLine[]
  expenses                 Expense[]
  fxRateEntries            FxRateEntry[]
  reorderSuggestions       ReorderSuggestion[]
  deadstockFlags           DeadStockFlag[]
  profitAnomalies          ProfitAnomaly[]
  customerCohortSnapshots  CustomerCohortSnapshot[]
  funnelSnapshots          FunnelSnapshot[]
  customerRfmSnapshots     CustomerRfmSnapshot[]
  productDailyViews        ProductDailyView[]
  whatsAppTemplates        WhatsAppTemplate[]
  paymentEvents            PaymentEvent[]
  webhookEvents            WebhookEvent[]
  bankStatements           BankStatement[]
  bankTransactions         BankTransaction[]
  warehouses               Warehouse[]
  warehouseStock           WarehouseStock[]
  countSessions            CountSession[]
  staffMembers             StoreStaff[]               @relation("StoreStaffMembers")

  @@index([ownerId])
  @@index([status])
  @@index([plan])
  @@index([createdAt])
  @@map("stores")
}

// ==========================================
// Staff Accounts (store-scoped team members)
// ==========================================

/**
 * Links a `staff`-role user to a specific store.
 * A staff user can only access stores they are members of.
 * The owning store_admin (or super_admin) adds/removes rows here.
 */
model StoreStaff {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation("StoreStaffMembers", fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation("StaffUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId])
  @@map("store_staff")
}

// ==========================================
// Blog Posts (Bucket E1, 2026-05-17)
// ==========================================
//
// Per-store blog. Opt-in via `Store.blogEnabled`. Content is stored as
// plain text with `\n\n` paragraph separators — rendered server-side
// via `paragraph-render.ts` which escapes every text node, so no
// client-side sanitizer dep is required. Future rich-text content
// will land via a contentBlocks JSON column mirroring StorePage.
//
// `publishedAt` is set when isPublished flips to true; serves as the
// canonical date both for sorting and for the OG/Article published_time
// SEO field on the public detail page.
model BlogPost {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  slug        String
  title       String
  titleAr     String?   @map("title_ar")
  excerpt     String?
  excerptAr   String?   @map("excerpt_ar")
  content     String
  contentAr   String?   @map("content_ar")
  coverImage  String?   @map("cover_image")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId, isPublished, publishedAt])
  @@map("blog_posts")
}

// Per-store physical locations / branches. Opt-in via `Store.locationsEnabled`.
// When false the /locations route returns 404. Content is bilingual (EN/AR).
// Positions within a store are set by the `position` field (0-indexed).
model StoreLocation {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  name         String
  nameAr       String?  @map("name_ar")
  country      String // e.g. "Kuwait" | "U.A.E."
  countryAr    String?  @map("country_ar")
  address      String
  addressAr    String?  @map("address_ar")
  phone        String? // tel: target, e.g. "+96522209079"
  whatsapp     String? // wa.me number, digits only or +<intl>
  mapsUrl      String?  @map("maps_url") // Google Maps "search" link (button target)
  mapsEmbedUrl String?  @map("maps_embed_url") // optional ...&output=embed iframe src
  hours        String?
  hoursAr      String?  @map("hours_ar")
  isPublished  Boolean  @default(true) @map("is_published")
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, isPublished, position])
  @@map("store_locations")
}

// ==========================================
// Store Pages CMS (about / privacy / terms / shipping / faq / custom)
// ==========================================
//
// Per-store editable long-form content. Each row is one page identified by
// a slug. Content is stored as a structured block array (JSONB) — one
// array per locale — and the API renders it to XSS-safe HTML for the
// storefront. The storefront uses pre-rendered HTML directly (no
// client-side renderer).
//
// Visibility model:
//   - row missing            → storefront falls back to legacy hardcoded copy
//   - row present, off       → storefront renders "Page unavailable" (NO fallback)
//   - row present, on, empty → storefront falls back to legacy hardcoded copy
//   - row present, on, full  → storefront renders the page
//
// The hard-off case means merchants can take a page completely offline
// without it silently reverting to the platform's default text.

model StorePage {
  id              String   @id @default(uuid())
  storeId         String   @map("store_id")
  slug            String // about | privacy | terms | shipping | faq | <custom>
  title           String?
  titleAr         String?  @map("title_ar")
  contentBlocks   Json?    @map("content_blocks") // Block[] (English) — see pages.service.ts
  contentBlocksAr Json?    @map("content_blocks_ar") // Block[] (Arabic)
  coverImage      String?  @map("cover_image") // optional R2 URL for header image
  isPublished     Boolean  @default(true) @map("is_published")
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("store_pages")
}

model Customer {
  id               String    @id @default(uuid())
  storeId          String    @map("store_id")
  email            String
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  phone            String?
  notes            String?
  totalOrders      Int       @default(0) @map("total_orders")
  totalSpent       Int       @default(0) @map("total_spent")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  /// Sticky language for the WhatsApp bot — 'en' | 'ar' | null (not yet set).
  /// Persisted when the customer taps a language button in the bot flow.
  preferredLocale  String?   @map("preferred_locale")
  /// When the customer last picked a language. Used to decide whether to
  /// skip the language picker on return visits within 30 days.
  lastLocaleChoice DateTime? @map("last_locale_choice")

  store     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]

  @@unique([storeId, email])
  @@index([storeId])
  @@index([email])
  @@index([createdAt])
  @@map("customers")
}

/// Saved delivery addresses for a customer. Created during the WhatsApp
/// native catalog bot checkout flow when the customer types a new address.
/// The first address is automatically set as default (isDefault=true).
model CustomerAddress {
  id             String   @id @default(uuid())
  customerId     String   @map("customer_id")
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label          String?
  street         String
  block          String?
  area           String
  governorate    String?
  buildingNumber String?  @map("building_number")
  notes          String?
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@map("customer_addresses")
}

enum StoreStatus {
  active
  inactive
  suspended
}

enum StorePlan {
  free
  starter
  professional
  enterprise
}

enum StoreTemplate {
  modern
  classic
  minimal
  bold
  elegant
}

// ==========================================
// Products & Categories
// ==========================================

model Category {
  id                   String    @id @default(uuid())
  storeId              String    @map("store_id")
  name                 String
  nameAr               String?   @map("name_ar")
  slug                 String
  description          String?
  descriptionAr        String?   @map("description_ar")
  image                String?
  parentId             String?   @map("parent_id")
  position             Int       @default(0)
  isActive             Boolean   @default(true) @map("is_active")
  // Whether this category appears as a CARD in the homepage category strip.
  // Default true (visible). When false it's hidden from the homepage strip
  // ONLY — its collection page, nav, and product filters are unaffected.
  showOnHomeStrip      Boolean   @default(true) @map("show_on_home_strip")
  // SEO meta — set per-category in admin or via the AI bulk sweep.
  metaTitle            String?   @map("meta_title")
  metaTitleAr          String?   @map("meta_title_ar")
  metaDescription      String?   @map("meta_description")
  metaDescriptionAr    String?   @map("meta_description_ar")
  // AEO — conversational answer-engine copy. Written by bulk-ai-meta-aeo
  // sweep. Storefront coalesces at render time: AEO > SEO > null.
  metaDescriptionAeo   String?   @map("meta_description_aeo")
  metaDescriptionAeoAr String?   @map("meta_description_aeo_ar")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at") // Soft delete support

  // Relations
  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[]        @relation("CategoryHierarchy")
  products ProductCategory[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id                   String        @id @default(uuid())
  storeId              String        @map("store_id")
  name                 String
  nameAr               String?       @map("name_ar")
  slug                 String
  description          String?
  descriptionAr        String?       @map("description_ar")
  price                Int // Price in fils (1 KWD = 1000 fils)
  compareAtPrice       Int?          @map("compare_at_price")
  costPrice            Int?          @map("cost_price")
  sku                  String?
  barcode              String?
  inventory            Int           @default(0)
  lowStockThreshold    Int           @default(5) @map("low_stock_threshold")
  trackInventory       Boolean       @default(true) @map("track_inventory")
  weight               Float?
  dimensions           Json? // { length, width, height }
  status               ProductStatus @default(draft)
  featured             Boolean       @default(false)
  isNew                Boolean       @default(false) @map("is_new")
  // Merchant-set display position within the New Arrivals carousel.
  // 0 = unordered (falls back to createdAt desc). Set via the reorder admin page.
  newArrivalPosition   Int           @default(0) @map("new_arrival_position")
  // Manually curated by the store admin — drives the storefront's
  // "Best Sellers" carousel. Independent of actual order data so a merchant
  // can stage products at launch before any sales data exists.
  isBestSeller         Boolean       @default(false) @map("is_best_seller")
  // Merchant-set display position within the Best Sellers carousel.
  // 0 = unordered (falls back to createdAt desc). Set via the reorder admin page.
  bestSellerPosition   Int           @default(0) @map("best_seller_position")
  viewCount            Int           @default(0) @map("view_count")
  metaTitle            String?       @map("meta_title")
  metaTitleAr          String?       @map("meta_title_ar")
  metaDescription      String?       @map("meta_description")
  metaDescriptionAr    String?       @map("meta_description_ar")
  // AEO — conversational answer-engine copy. Written by bulk-ai-meta-aeo
  // sweep. Storefront coalesces at render time: AEO > SEO > null.
  metaDescriptionAeo   String?       @map("meta_description_aeo")
  metaDescriptionAeoAr String?       @map("meta_description_aeo_ar")
  // GEO — LLM citation copy. Written by bulk-ai-citation-copy sweep.
  // Format: "Definitive first sentence. Key specs bullet block."
  citationCopy         String?       @map("citation_copy")
  citationCopyAr       String?       @map("citation_copy_ar")
  // Per-field AI provenance: { "<field>": "ai" | "human" }. Absent key =
  // never set. Drives the AI-first autofill override guarantee — the engine
  // never overwrites a field marked "human". See @force/shared
  // AI_AUTOFILL_FIELDS / fieldsNeedingRefresh.
  aiFieldSources       Json          @default("{}") @map("ai_field_sources")
  aiBalanceBackup      Json?         @default("{}") @map("ai_balance_backup")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  deletedAt            DateTime?     @map("deleted_at") // Soft delete support
  allowBackorder       Boolean       @default(false) @map("allow_backorder")
  lastCostUpdateAt     DateTime?     @map("last_cost_update_at")
  // Discount input columns — the admin enters a REGULAR (RRP) price plus a
  // discount, and the service derives price/compareAtPrice from them.
  // percentage: value is basis points (percent×100; e.g. 12.5% → 1250, range 0–10000).
  // fixed:      value is fils (1 KWD = 1000 fils).
  // When null the product has no admin-authored discount (legacy or no discount).
  discountType         DiscountType? @map("discount_type")
  discountValue        Int?          @map("discount_value")

  // Variants
  hasVariants Boolean @default(false) @map("has_variants")

  // Relations
  store                Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  images               ProductImage[]
  categories           ProductCategory[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  tags                 ProductTag[]
  wishlists            WishlistItem[]
  reviews              Review[]
  returnItems          ReturnItem[]
  inventoryHistory     InventoryHistory[]
  options              ProductOption[]
  variants             ProductVariant[]
  relationsAsSource    ProductRelation[]          @relation("ProductRelationSource")
  relationsAsTarget    ProductRelation[]          @relation("ProductRelationTarget")
  fbtAsProduct1        FrequentlyBoughtTogether[] @relation("FBTProduct1")
  fbtAsProduct2        FrequentlyBoughtTogether[] @relation("FBTProduct2")
  aiRecsAsSource       AiRecommendation[]         @relation("AiRecSource")
  aiRecsAsTarget       AiRecommendation[]         @relation("AiRecTarget")
  faqs                 ProductFaq[]
  purchaseOrderItems   PurchaseOrderItem[]
  stockAdjustmentItems StockAdjustmentItem[]
  reorderRules         ReorderRule[]
  backorderLines       BackorderLine[]
  reorderSuggestions   ReorderSuggestion[]
  deadstockFlags       DeadStockFlag[]
  warehouseStock       WarehouseStock[]
  countLines           CountLine[]
  dailyViews           ProductDailyView[]

  @@unique([storeId, slug])
  @@unique([storeId, sku]) // Prevent duplicate SKUs within a store (null values are excluded)
  @@index([storeId])
  @@index([status])
  @@index([featured])
  @@index([price])
  @@index([createdAt])
  @@index([storeId, status]) // Composite: products by store and status
  // Composite for the storefront "best seller" strip — created in
  // 20260426010000_add_product_is_best_seller. Without this entry the
  // schema doesn't know about the index and `prisma migrate dev` will
  // try to drop it on every diff.
  @@index([storeId, isBestSeller])
  // Carousel position indexes — filtered on the flag so only flagged rows
  // participate (matches the partial indexes in migration 20260622150000).
  @@index([storeId, isNew, newArrivalPosition])
  @@index([storeId, isBestSeller, bestSellerPosition])
  // Storefront list query: store-scoped, soft-delete-aware, newest-first.
  // Created in 20260501030000_perf_indexes.
  @@index([storeId, deletedAt, createdAt(sort: Desc)])
  // Barcode lookup index — barcode scan resolves within a store scope.
  // Added 2026-06-15 for inventory.barcode Enterprise feature.
  @@index([storeId, barcode])
  @@map("products")
}

enum ProductStatus {
  draft
  active
  archived
}

// Discount type for the admin-authored discount input (stored alongside
// discountValue on the Product model). The service derives price /
// compareAtPrice from these two columns at save time.
enum DiscountType {
  percentage // value is basis points (percent×100; 12.5% → 1250)
  fixed // value is fils (1 KWD = 1000 fils)
}

// ==========================================
// Inventory Management
// ==========================================

model InventoryHistory {
  id            String              @id @default(uuid())
  productId     String              @map("product_id")
  storeId       String              @map("store_id")
  type          InventoryChangeType
  quantity      Int // Change amount (positive or negative)
  previousStock Int                 @map("previous_stock")
  newStock      Int                 @map("new_stock")
  reason        String?
  reference     String? // Order ID, adjustment ID, etc.
  createdBy     String?             @map("created_by") // User ID who made the change
  createdAt     DateTime            @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([storeId])
  @@index([createdAt])
  @@map("inventory_history")
}

enum InventoryChangeType {
  manual_add // Manual stock increase
  manual_remove // Manual stock decrease
  sale // Sold via order
  return_stock // Returned to stock
  adjustment // Inventory count adjustment
  damage // Damaged goods
  transfer_in // Transferred from another location
  transfer_out // Transferred to another location
  initial // Initial stock setup
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductCategory {
  productId  String @map("product_id")
  categoryId String @map("category_id")
  position   Int    @default(0) @map("position")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, position])
  @@map("product_categories")
}

model Tag {
  id       String       @id @default(uuid())
  storeId  String       @map("store_id")
  name     String
  products ProductTag[]

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, name])
  @@index([storeId])
  @@map("tags")
}

model ProductTag {
  productId String @map("product_id")
  tagId     String @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

// ==========================================
// Product Variants
// ==========================================

// Option types like "Size", "Color"
model ProductOption {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  name      String // e.g., "Size", "Color"
  nameAr    String?  @map("name_ar")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

// Option values like "Small", "Red"
model ProductOptionValue {
  id        String   @id @default(uuid())
  optionId  String   @map("option_id")
  value     String // e.g., "Small", "Red"
  valueAr   String?  @map("value_ar")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  option   ProductOption          @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants ProductVariantOption[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

// A specific variant combining options (e.g., "Size: Large, Color: Red")
model ProductVariant {
  id             String   @id @default(uuid())
  productId      String   @map("product_id")
  title          String // Generated from option values: "Large / Red"
  titleAr        String?  @map("title_ar")
  sku            String?
  barcode        String?
  price          Int? // Override price (null = use product price)
  compareAtPrice Int?     @map("compare_at_price")
  costPrice      Int?     @map("cost_price")
  inventory      Int      @default(0)
  weight         Float?
  imageUrl       String?  @map("image_url")
  position       Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  allowBackorder Boolean  @default(false) @map("allow_backorder")

  product              Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  options              ProductVariantOption[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  stockAdjustmentItems StockAdjustmentItem[]
  reorderRules         ReorderRule[]
  backorderLines       BackorderLine[]
  reorderSuggestions   ReorderSuggestion[]
  deadstockFlags       DeadStockFlag[]
  warehouseStock       WarehouseStock[]
  countLines           CountLine[]

  @@index([productId])
  @@index([sku])
  // Barcode lookup — scan resolves to a variant within a product.
  @@index([productId, barcode])
  @@map("product_variants")
}

// Junction table linking variants to their option values
model ProductVariantOption {
  variantId String @map("variant_id")
  valueId   String @map("value_id")

  variant ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value   ProductOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([variantId, valueId])
  @@map("product_variant_options")
}

// ==========================================
// Cart
// ==========================================

model Cart {
  id             String   @id @default(uuid())
  storeId        String   @map("store_id")
  customerId     String?  @map("customer_id")
  sessionId      String   @map("session_id")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer      User?          @relation(fields: [customerId], references: [id])
  items         CartItem[]
  abandonedCart AbandonedCart?

  @@unique([storeId, sessionId])
  @@index([storeId])
  @@index([customerId])
  @@index([sessionId])
  @@index([updatedAt])
  @@index([lastActivityAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  variantId String?  @map("variant_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  // Uniqueness is enforced by two PARTIAL unique indexes created in migration
  // 20260622000000_cart_item_null_variant_unique.sql — one WHERE variant_id IS NULL
  // (cart_id, product_id) and one WHERE variant_id IS NOT NULL
  // (cart_id, product_id, variant_id). A combined @@unique here would generate a
  // single index that Postgres treats as non-enforcing when variant_id is NULL,
  // which is the bug this migration fixes. Prisma drift-check is satisfied because
  // the raw migration drops the old index and replaces it; no @@unique means Prisma
  // will not try to recreate the old combined index.
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// ==========================================
// Orders
// ==========================================

model Order {
  id                    String             @id @default(uuid())
  storeId               String             @map("store_id")
  customerId            String?            @map("customer_id")
  orderNumber           String             @unique @map("order_number")
  status                OrderStatus        @default(pending)
  paymentStatus         OrderPaymentStatus @default(unpaid) @map("payment_status")
  subtotal              Int
  tax                   Int                @default(0)
  shipping              Int                @default(0)
  discount              Int                @default(0)
  total                 Int
  // Extra out-of-catalog amount used by merchant-initiated payment
  // links — a custom service fee, deposit, or quote that doesn't map
  // to a Product. Baked into `total` at order creation; rendered as
  // a synthetic line in admin order detail. extraAmountNote captures
  // what the charge is for ("Photography deposit", "Rush fee", etc.).
  extraAmount           Int                @default(0) @map("extra_amount")
  extraAmountNote       String?            @map("extra_amount_note")
  currency              String             @default("KWD")
  couponCode            String?            @map("coupon_code")
  couponDiscount        Int                @default(0) @map("coupon_discount")
  // Loyalty redemption applied at checkout. loyaltyPointsRedeemed is the
  // number of points the customer spent on this order (NULL = none redeemed
  // / pre-feature order); loyaltyDiscount is the resulting discount amount in
  // FILS that was folded into `discount` + `total`. Both are written
  // atomically with LoyaltyService.redeemPoints inside the order-create
  // transaction, and read by reverseRedeemedPointsFromOrder on refund/cancel.
  loyaltyPointsRedeemed Int?               @map("loyalty_points_redeemed")
  loyaltyDiscount       Int                @default(0) @map("loyalty_discount")
  notes                 String?
  customerNotes         String?            @map("customer_notes")
  shippingAddress       Json               @map("shipping_address")
  billingAddress        Json               @map("billing_address")
  shippedAt             DateTime?          @map("shipped_at")
  deliveredAt           DateTime?          @map("delivered_at")
  reviewRequestSentAt   DateTime?          @map("review_request_sent_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  deletedAt             DateTime?          @map("deleted_at") // Soft delete support

  // Buyer's UI locale at checkout time ('en' | 'ar'). Used to send
  // transactional emails in the customer's language regardless of the
  // store's defaultLanguage setting. NULL for pre-feature orders —
  // email service falls back to store.settings.defaultLanguage.
  locale String?

  // Customer SMS marketing consent captured at checkout. When true the
  // customer has explicitly opted in to receiving promotional SMS messages
  // (e.g. offers, campaigns). Transactional notifications (order shipped,
  // delivered, cancelled, refunded) are unaffected by this flag.
  // Defaults to false — never opt customers in silently.
  smsOptIn Boolean @default(false) @map("sms_opt_in")

  // Webhook idempotency - prevents duplicate processing
  idempotencyKey     String?   @unique @map("idempotency_key")
  webhookProcessedAt DateTime? @map("webhook_processed_at")

  // Stuck-payment merchant alert dedupe. Set when the stuck-payment sweep
  // (Inngest cron) has pushed the merchant a "payment pending — follow up"
  // alert for this order so it never fires twice. NULL = not yet alerted.
  // Only relevant to online-payment orders left status=pending /
  // paymentStatus=unpaid past STUCK_PAYMENT_MINUTES.
  stuckPaymentAlertedAt DateTime? @map("stuck_payment_alerted_at")

  // order/created fanout dedupe. The order/created event can be enqueued by
  // BOTH the customer-return "confirm" path AND the payment webhook consumer
  // for the same paid order (and Inngest delivers at-least-once). The
  // order-created fn atomically claims this stamp (UPDATE ... WHERE NULL) and
  // skips the whole fanout if already claimed, so the "new order" email + admin
  // OneSignal push fire EXACTLY once per order regardless of how many times the
  // event is enqueued. NULL = not yet notified.
  orderCreatedNotifiedAt DateTime? @map("order_created_notified_at")

  // Enterprise: payment-gateway abandonment capture. Set by the Inngest
  // payment-abandonment-sweep cron when the order has a Payment row with a
  // paymentUrl (customer reached the gateway) but paymentStatus is still
  // unpaid past the configured threshold. NULL = not a gateway abandoner
  // (or not yet evaluated). Used to power the retargeting UI under
  // /stores/:id/payment-abandonments (Enterprise-only, feature key:
  // payment_abandonment). See migration 20260622130000.
  paymentGatewayAbandonedAt DateTime? @map("payment_gateway_abandoned_at")

  // Relations
  store               Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer            User?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            Payment[]
  reviews             Review[]
  returns             Return[]
  loyaltyTransactions LoyaltyTransaction[]
  shipment            Shipment?
  affiliateReferrals  AffiliateReferral[]

  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([storeId, customerId]) // Composite: customer orders in a store
  @@index([storeId, status]) // Composite: orders by store and status
  // Admin orders list — newest first within a store. Created in
  // 20260501030000_perf_indexes.
  @@index([storeId, createdAt(sort: Desc)])
  // Payment-gateway abandoners list (Enterprise).
  // Added 20260622130000.
  @@index([storeId, paymentGatewayAbandonedAt])
  @@map("orders")
}

enum OrderPaymentStatus {
  unpaid
  paid
  failed
  refunded
  disputed
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  refunded
}

model OrderItem {
  id                String  @id @default(uuid())
  orderId           String  @map("order_id")
  productId         String  @map("product_id")
  variantId         String? @map("variant_id")
  productName       String  @map("product_name")
  variantName       String? @map("variant_name") // e.g., "Large / Red"
  sku               String?
  quantity          Int
  price             Int
  // Cost-of-goods snapshot at sale time. Stored in fils, same scale as
  // `price`. Snapshotted because the product's cost may change later but
  // the order's profit must reflect what it cost on the day it shipped.
  // Nullable for orders placed before this column existed.
  costPrice         Int?    @map("cost_price")
  total             Int
  costPriceDeferred Boolean @default(false) @map("cost_price_deferred")

  // Scan-to-pick fulfilment state. pickedQty tracks how many units of this
  // line have been physically scanned/picked. Default 0 so existing rows are
  // unaffected. pickedAt is set when pickedQty reaches quantity.
  pickedQty Int       @default(0) @map("picked_qty")
  pickedAt  DateTime? @map("picked_at")

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  returnItems    ReturnItem[]
  backorderLines BackorderLine[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String        @map("order_id")
  provider       String        @default("tap") // tap, myfatoorah, hesabe, upayments
  method         String? // knet, visa, mastercard, apple_pay, etc.
  status         PaymentStatus @default(pending)
  amount         Int
  currency       String        @default("KWD")
  transactionId  String?       @map("transaction_id")
  invoiceId      String?       @map("invoice_id")
  paymentUrl     String?       @map("payment_url")
  refundId       String?       @map("refund_id")
  refundedAmount Int           @default(0) @map("refunded_amount")
  failureReason  String?       @map("failure_reason")
  paidAt         DateTime?     @map("paid_at")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events PaymentEvent[]

  @@index([orderId])
  @@index([transactionId])
  @@index([invoiceId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

/// Append-only log of every state transition + webhook receipt for a
/// Payment row. Closes the audit gap left by the in-place updates on
/// `payments.status`. Written from `payment-event.service.ts` at every
/// Payment mutation site + every provider webhook handler — never
/// updated, never deleted (rollups + retention are done separately).
///
/// Query examples:
///   - Lifecycle of a single payment:
///       SELECT * FROM payment_events WHERE payment_id = $1 ORDER BY occurred_at;
///   - All webhook-driven completes today:
///       SELECT * FROM payment_events
///       WHERE event_type='webhook' AND to_status='completed' AND occurred_at >= now()::date;
///   - Reconciliation gap (Tap settled vs we received):
///       compare `provider_payload->>'settlement_id'` to your bank statement
model PaymentEvent {
  id                String         @id @default(uuid())
  paymentId         String         @map("payment_id")
  /// Denormalized so we can scope by store without joining payments → orders.
  storeId           String         @map("store_id")
  /// Denormalized for convenience in audit queries.
  orderId           String         @map("order_id")
  /// 'created' | 'status_change' | 'webhook' | 'refund' | 'admin_action' | 'reconciliation'
  /// Free-form to avoid migration churn when we add a new event type.
  eventType         String         @map("event_type")
  /// Null on the very first event ('created').
  fromStatus        PaymentStatus? @map("from_status")
  /// Null when an event was informational (e.g. webhook received but no
  /// state change — duplicate, signature replay, etc.).
  toStatus          PaymentStatus? @map("to_status")
  /// Provider name when the event is webhook-driven: 'tap' | 'myfatoorah' | 'hesabe' | 'upayments'.
  provider          String?
  /// Raw provider POST body when event_type='webhook'. Lets us replay
  /// a dispute 6+ months later even if metadata on Payment has been
  /// overwritten by a later event.
  providerPayload   Json?          @map("provider_payload")
  /// Free-form details: idempotency key, signature hash, refund reason,
  /// admin notes, reconciliation diff — whatever the writer wants
  /// preserved without bloating the columns. Always non-null (default {}).
  details           Json           @default("{}")
  /// User who triggered the event (admin refund, customer cancel, etc.).
  /// Null for webhook + system events.
  triggeredByUserId String?        @map("triggered_by_user_id")
  /// Time the event actually occurred (provider timestamp if known,
  /// else server clock). Indexed for time-range queries.
  occurredAt        DateTime       @default(now()) @map("occurred_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  triggeredBy User?   @relation(fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  @@index([paymentId, occurredAt])
  @@index([storeId, occurredAt(sort: Desc)])
  @@index([orderId, occurredAt])
  @@index([eventType])
  @@index([provider, occurredAt])
  @@map("payment_events")
}

/// Transactional inbox for inbound payment-provider webhooks.
///
/// Why this exists: PaymentService.handleWebhook does a long chain of DB
/// mutations (payment.update + recordPaymentEvent + applyRefundEffects +
/// order.update) inside a tenant-scoped interactive $transaction. Running that
/// INLINE in the webhook request held connections on the shared basePrisma pool
/// that also serves auth/login — a provider webhook storm could starve auth
/// (P2024). See feedback-db-pool-starvation-webhook-storm-starves-auth.md.
///
/// The webhook route now: verify signature presence -> idempotency check ->
/// persist a row here (durable) -> inngest.send -> 200. The
/// payment-webhook-process Inngest function consumes it and runs the heavy
/// mutation OFF the request path. This row is the durable record so nothing is
/// lost if Inngest is briefly unavailable (the route also falls back to inline
/// processing on a send failure).
///
/// NOT an RLS-scoped table: it is written/read cross-tenant (the route resolves
/// storeId BY querying payments, and the consumer must read this row BEFORE it
/// can enter tenant context). Writes/reads use withRlsBypass, exactly like the
/// existing checkIdempotency / resolveStoreIdFromWebhookPayload helpers.
model WebhookEvent {
  id String @id @default(uuid())

  /// 'tap' | 'myfatoorah' | 'hesabe' | 'upayments'
  provider String

  /// Same idempotency key the route derives from the provider transaction id
  /// (generateIdempotencyKey). UNIQUE so a duplicate provider delivery upserts
  /// onto the same inbox row instead of creating a second one.
  idempotencyKey String @unique @map("idempotency_key")

  /// Resolved upfront from the matching Payment row. Null for the platform-only
  /// path (no per-store payment matched) — the consumer then uses withRlsBypass.
  storeId String? @map("store_id")

  /// Parsed JSON payload (for business logic / debugging).
  payload Json

  /// Exact raw bytes of the request body. handleWebhook re-verifies the HMAC
  /// signature against THIS in the consumer, so the cryptographic check is
  /// preserved off the request path.
  rawBody String @map("raw_body")

  /// The signature header the provider sent. Re-checked by handleWebhook.
  signature String

  /// received | processing | processed | failed
  status String @default("received")

  /// Increments each time the consumer attempts processing (Inngest retries).
  attempts Int @default(0)

  /// Last error string when status='failed' / a retry threw. Null otherwise.
  lastError String? @map("last_error")

  /// Result of a successful process, for audit / replay diagnostics.
  resultOrderId String? @map("result_order_id")
  resultStatus  String? @map("result_status")

  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  /// Optional back-relation; storeId is nullable (platform path).
  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@index([provider, receivedAt])
  @@index([storeId, receivedAt(sort: Desc)])
  @@map("webhook_events")
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  cancelled
  expired
  refunded
  partially_refunded
  disputed
  cod_pending
}

