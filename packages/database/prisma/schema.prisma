// ==========================================
// Wishlist
// ==========================================

model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  storeId   String   @map("store_id")
  name      String   @default("My Wishlist")
  isPublic  Boolean  @default(false) @map("is_public")
