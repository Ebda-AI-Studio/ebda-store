// ==========================================
// Storefront View Ingest — Product Daily Views
// ==========================================
//
// One aggregate row per (store, product, calendar day in Cairo time).
// Populated by the public ingest endpoint POST /api/v1/public/:storeId/views.
// The nightly analytics rollup reads these to populate FunnelSnapshot.productViews.
//
// Design: aggregate not event-source — one counter per day, not a row per hit.
// Keeps the table bounded (stores × products × days_retained rows max).
//
// RLS: SELECT, INSERT, UPDATE policies in migration 20260622100000_product_daily_views.

/// One row per store per calendar month: what that merchant actually used.
///
/// Exists because every usage number was a POINT IN TIME — you could ask "how
/// many products does this store have" but never "how fast is it growing", so
/// plan-tier ceilings had to be guessed rather than derived. This is the
/// history that makes them defensible.
///
/// Append-only and idempotent on (storeId, periodStart): the monthly cron
/// upserts, so a re-run or a manual backfill overwrites cleanly rather than
/// duplicating. Values are captured for a CLOSED month, so they never move.
model StoreUsageSnapshot {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  /// First day of the month this snapshot covers, UTC (a closed month).
  periodStart DateTime @map("period_start") @db.Date
  capturedAt  DateTime @default(now()) @map("captured_at")

  // ── Catalog (drives storage + admin effort) ───────────────────────────
  products       Int @default(0)
  productsActive Int @default(0) @map("products_active")
  variants       Int @default(0)
  images         Int @default(0)
  categories     Int @default(0)

  // ── Commerce (drives value, and support load) ─────────────────────────
  orders      Int    @default(0)
  /// NET revenue in piastres: paid AND not cancelled/refunded. Gross 'paid' alone
  /// over-counts — production has paid+refunded and paid+cancelled orders.
  /// BigInt (#1057, migration 20260925120000): a monthly SUM(orders.total) can
  /// exceed the 2^31-1 ceiling of Int for a high-volume store; the writer
  /// (store-usage-snapshot.ts) already computes this as a SQL bigint via
  /// $queryRaw and was silently truncating it down to Number before this.
  revenueFils BigInt @default(0) @map("revenue_fils")
  customers   Int    @default(0)

  // ── Traffic ───────────────────────────────────────────────────────────
  /// Carts with NO items. A cart is created per storefront session, so on a
  /// normal browsing store this approximates unique visitors. Kept separate
  /// from cartsWithItems because the ratio differs wildly by store flow —
  /// 2026-08: demo-store 2687 empty / 135 with items (classic browsing), while
  /// demo-shop was 93 / 1111 (carts arrive pre-filled via a different flow).
  /// A single "carts" number would have meant two different things.
  sessionsProxy  Int    @default(0) @map("sessions_proxy")
  cartsWithItems Int    @default(0) @map("carts_with_items")
  /// Summed product-detail views for the month (product_daily_views).
  /// BigInt (#1057/#1062) — same overflow reasoning as revenueFils below.
  productViews   BigInt @default(0) @map("product_views")

  // ── AI (the one cost that is already attributed per store) ────────────
  aiCalls         Int    @default(0) @map("ai_calls")
  /// Calls that actually hit the provider (cached_hit = false).
  aiBillableCalls Int    @default(0) @map("ai_billable_calls")
  /// BigInt (#1057) — a busy store's monthly token SUM can exceed Int32.
  aiTokensIn      BigInt @default(0) @map("ai_tokens_in")
  aiTokensOut     BigInt @default(0) @map("ai_tokens_out")
  /// Spend in micros. NULL-costed rows contribute 0 here, so aiUnpricedCalls
  /// must be read alongside it — see lib/ai-pricing.ts. BigInt (#1057): micros
  /// inflate the numeric range fast (1_000_000 micros per currency unit,
  /// already multiplied up), so this is the first of these five likely to
  /// overflow Int in practice.
  aiCostMicros    BigInt @default(0) @map("ai_cost_micros")
  aiUnpricedCalls Int    @default(0) @map("ai_unpriced_calls")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, periodStart])
  @@index([periodStart(sort: Desc)])
  @@map("store_usage_snapshots")
}

model ProductDailyView {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  productId String   @map("product_id")
  date      DateTime @db.Date
  count     Int      @default(0)

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId, date])
  @@index([storeId, date(sort: Desc)])
  @@index([productId, date(sort: Desc)])
  @@map("product_daily_views")
}

// QR-1: scans of a merchant's printed QR codes. Aggregate-not-event (mirrors ProductDailyView):
// one counter row per store/Cairo day/code. No user, session, IP or user agent is stored.
// `kind` = store | product | category | whatsapp; `ref` = product/category id ('' for store and
// whatsapp). Written only by the storefront scan beacon for a code that resolved to a real
// entity (bounded by the catalogue). Viewer: admin /stores/[id]/qr. Retention 400 days.
// Store delete cascades.
model QrScanDaily {
  id      String   @id @default(uuid())
  storeId String   @map("store_id")
  date    DateTime @db.Date
  kind    String   @db.VarChar(12)
  ref     String   @default("") @db.VarChar(64)
  count   Int      @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date, kind, ref])
  @@index([storeId, date(sort: Desc)])
  @@map("qr_scan_daily")
}

// Customer Intelligence CI-2: a finding from the cross-store aggregates (Ruling CI-9). PLATFORM table, no
// store_id: it is built only from cohort cells that passed the k-thresholds and holds no store, order or
// buyer identifier. A super-admin accepts or dismisses it before it may change any default. Viewer:
// admin /platform/ci-insights. Erasure: nothing personal.
model CiInsight {
  id        String    @id @default(uuid())
  dedupeKey String    @unique @map("dedupe_key") @db.VarChar(160)
  metric    String    @db.VarChar(40)
  cohort    String    @db.VarChar(120)
  finding   String    @db.VarChar(400)
  findingAr String    @map("finding_ar") @db.VarChar(400)
  evidence  Json
  model     String    @default("rules-v1") @db.VarChar(40)
  status    String    @default("new") @db.VarChar(12)
  asOf      DateTime  @map("as_of") @db.Date
  decidedAt DateTime? @map("decided_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt(sort: Desc)])
  @@map("ci_insights")
}

// Customer Intelligence CI-3: every hint a merchant was shown, with the n behind it and (later) what
// happened, so calibration (predicted band vs actual return rate) is a weekly query. One row per
// (order, feature). Carries no buyer key and no phone. Viewer: admin /stores/[id]/customer-intelligence.
// Order delete and store delete cascade. Retention 400 days (data-retention job).
model CiHintLog {
  id            String    @id @default(uuid())
  storeId       String    @map("store_id")
  orderId       String    @map("order_id")
  feature       String    @db.VarChar(24)
  band          String    @db.VarChar(16)
  source        String    @db.VarChar(8)
  n             Int       @default(0)
  predictedRate Float?    @map("predicted_rate")
  outcome       String?   @db.VarChar(12)
  outcomeAt     DateTime? @map("outcome_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, feature])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([feature, outcome, createdAt])
  @@map("ci_hint_logs")
}

/// Per-store auto-gate (Ruling CI-13): a row means THIS store's hints for `feature` are paused because
/// its own calibration was off by more than 10 points. Written only by the weekly calibration job in
/// the store's own scope; never read across stores and never touches the platform gate.
model CiStoreGate {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  feature       String   @db.VarChar(24)
  band          String   @db.VarChar(16)
  predictedRate Float    @map("predicted_rate")
  actualRate    Float    @map("actual_rate")
  resolved      Int
  closedAt      DateTime @default(now()) @map("closed_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, feature])
  @@map("ci_store_gates")
}

// Answer Engine Insights (AEO) — Google Search Console daily metrics.
// Aggregate-not-event (mirrors ProductDailyView): one row per store/date,
// upserted idempotently by the GSC ingestion cron.
model GscDailyMetric {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  date        DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0) @map("avg_position")
  topQueries  Json     @default("[]") @map("top_queries")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@index([storeId, date(sort: Desc)])
  @@map("gsc_daily_metrics")
}

// ==========================================
// Barcode Scanning — Cycle-count Sessions
// ==========================================
//
// A CountSession is an open or closed inventory count/audit session.
// The admin opens a session, scans products and enters counted quantities
// (CountLine rows), then closes and optionally reconciles variances into
// a StockAdjustment (type=cycle_count). The reconcile path reuses the
// existing postAdjustment service so GL journal posting is automatic.
//
// RLS: same store_id pattern (see migration 20260615000000_barcode_scanning).

enum CountSessionStatus {
  open
  closed
  reconciled
}

model CountSession {
  id           String             @id @default(uuid())
  storeId      String             @map("store_id")
  status       CountSessionStatus @default(open)
  note         String?
  createdBy    String?            @map("created_by")
  closedAt     DateTime?          @map("closed_at")
  reconciledAt DateTime?          @map("reconciled_at")
  /// Linked StockAdjustment (type=cycle_count) created at reconcile time.
  adjustmentId String?            @unique @map("adjustment_id")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  store Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lines CountLine[]

  @@index([storeId, status])
  @@index([storeId, createdAt(sort: Desc)])
  @@map("count_sessions")
}

model CountLine {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  productId  String   @map("product_id")
  variantId  String?  @map("variant_id")
  /// Counted quantity entered by the operator during the scan.
  countedQty Int      @map("counted_qty")
  /// System quantity snapshotted at the time the line was submitted.
  systemQty  Int      @map("system_qty")
  /// Positive = more stock found; negative = stock missing.
  variance   Int
  scannedAt  DateTime @default(now()) @map("scanned_at")

  session CountSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  /// One count line per product/variant per session (last scan wins via upsert).
  @@unique([sessionId, productId, variantId])
  @@index([sessionId])
  @@index([productId])
  @@index([variantId])
  @@map("count_lines")
}

// ==========================================
// Bank Reconciliation (Enterprise)
// ==========================================

enum BankStatementStatus {
  pending
  reconciling
  reconciled
}

enum BankTransactionDirection {
  debit
  credit
}

enum BankMatchStatus {
  unmatched
  auto_matched
  manual_matched
  ignored
}

model BankStatement {
  id          String              @id @default(uuid())
  storeId     String              @map("store_id")
  glAccountId String              @map("gl_account_id")
  fileName    String              @map("file_name")
  importedAt  DateTime            @default(now()) @map("imported_at")
  periodStart DateTime?           @map("period_start")
  periodEnd   DateTime?           @map("period_end")
  status      BankStatementStatus @default(pending)
  createdAt   DateTime            @default(now()) @map("created_at")

  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  glAccount    Account           @relation("BankStatementAccount", fields: [glAccountId], references: [id], onDelete: Restrict)
  transactions BankTransaction[]

  @@index([storeId, status])
  @@index([storeId, importedAt(sort: Desc)])
  @@index([glAccountId])
  @@map("bank_statements")
}

model BankTransaction {
  id                    String                   @id @default(uuid())
  statementId           String                   @map("statement_id")
  storeId               String                   @map("store_id")
  date                  DateTime
  description           String
  amountFils            Int                      @map("amount_fils")
  direction             BankTransactionDirection
  externalRef           String?                  @map("external_ref")
  rowHash               String                   @map("row_hash") @db.VarChar(64)
  matchedJournalEntryId String?                  @map("matched_journal_entry_id")
  matchStatus           BankMatchStatus          @default(unmatched) @map("match_status")
  confidence            Int                      @default(0)
  createdAt             DateTime                 @default(now()) @map("created_at")

  statement           BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  store               Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  matchedJournalEntry JournalEntry? @relation("BankTxJournalMatch", fields: [matchedJournalEntryId], references: [id], onDelete: SetNull)

  @@unique([storeId, rowHash])
  @@index([statementId])
  @@index([storeId, matchStatus])
  @@index([storeId, date])
  @@index([matchedJournalEntryId])
  @@map("bank_transactions")
}

// ==========================================
// Multi-Warehouse Inventory (Enterprise)
// 2026-06-15: feat/multi-warehouse
// ==========================================

model Warehouse {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  name      String
  nameAr    String?  @map("name_ar")
  code      String // Short code e.g. "MAIN", "KWT-2"
  isDefault Boolean  @default(false) @map("is_default")
  priority  Int      @default(0) // Higher = preferred in priority routing
  lat       Float? // Optional: enables proximity routing
  lng       Float? // Optional: enables proximity routing
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  warehouseStock WarehouseStock[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([storeId, isDefault])
  @@index([storeId, priority(sort: Desc)])
  @@map("warehouses")
}

// Per-warehouse stock level for a product (or a specific variant).
// variant_id = null means the base product (no variants), or
// the product-level aggregate for a product WITH variants.
model WarehouseStock {
  id          String   @id @default(uuid())
  warehouseId String   @map("warehouse_id")
  productId   String   @map("product_id")
  variantId   String?  @map("variant_id") // null = base-product stock
  quantity    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Store FK for RLS — denormalised from warehouse to avoid a subquery in every policy.
  storeId String @map("store_id")

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId, variantId])
  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
  @@index([storeId])
  @@map("warehouse_stock")
}

// ==========================================
// Answer Engine Insights (AEO)
// 2026-07: feat/answer-engine-insights
// ==========================================
//
// Append-only rows recording whether an AI answer engine (Gemini/Perplexity/
// OpenAI) cited a store when asked a representative prompt. Written by a
// scheduled check job, read by an admin insights dashboard. No updates —
// each run inserts a new row (immutable audit trail, mirrors order_events).
//
// AnswerEngineProviderConfig is a PLATFORM-level table (no store_id) holding
// the encrypted API key + enabled toggle for Perplexity/OpenAI; Gemini uses
// the platform default key and needs no row here. Not tenant data — no RLS.

model AnswerEngineCheck {
  id                         String   @id @default(uuid())
  storeId                    String   @map("store_id")
  engine                     String // 'gemini' | 'perplexity' | 'openai'
  promptText                 String   @map("prompt_text")
  locale                     String   @default("en")
  cited                      Boolean  @default(false)
  rank                       Int?
  snippet                    String?
  citedUrls                  Json     @default("[]") @map("cited_urls")
  competitorUrls             Json     @default("[]") @map("competitor_urls")
  // Set only when a provider attempted grounded web search and it was
  // unavailable (retired model alias, rejected tool shape, quota) so it
  // fell back to an ungrounded call — a short tag like `http_429`, distinct
  // from a plain grounded=false (which also covers "grounded, cited
  // nothing"). Null for every other row, including all pre-existing ones.
  // See `gemini.provider.ts` / issue #929.
  groundingUnavailableReason String?  @map("grounding_unavailable_reason")
  runAt                      DateTime @default(now()) @map("run_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, runAt(sort: Desc)])
  @@index([storeId, engine, runAt(sort: Desc)])
  @@map("answer_engine_checks")
}

model AnswerEngineProviderConfig {
  id        String   @id @default(uuid())
  engine    String   @unique // 'perplexity' | 'openai' (gemini needs no row — uses platform key)
  apiKey    String?  @map("api_key") // encrypted
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("answer_engine_provider_configs")
}

/// Per-store, per-device credential for the MERCHANT-ADMIN MCP surface
/// (`POST /api/v1/mcp/admin/:storeSlug`). Distinct from `StoreCredential.agentApiKey`,
/// which is the BUYER surface's single per-store key.
///
/// Three deliberate differences from `StoreCredential.agentApiKey`:
///
///  1. **Hashed, never encrypted.** The buyer key is displayed back to the
///     merchant, so it must be reversible. An admin key is shown exactly once,
///     at creation, so a one-way SHA-256 is correct — and it keeps the secret
///     off every read path, which is what Ruling M5 (credential ciphertext
///     riding out on wide reads) is about.
///  2. **Many per store, each attributable to a user.** Revoking one laptop
///     must not revoke the others, and every audit row names a human.
///  3. **Three scope tiers.** A key minted for reporting cannot delete a
///     product.
model MerchantApiKey {
  id      String @id @default(uuid())
  storeId String @map("store_id")
  /// The human this key acts as. Every tool call is authorised as this user
  /// and every audit row carries them — a key is a device, not an identity.
  userId  String @map("user_id")
  /// Merchant-visible label ("pecanbee laptop"). Not a secret.
  name    String

  /// SHA-256 hex digest of the plaintext key. The plaintext is returned once,
  /// in the mint response, and never stored or logged.
  keyHash String @unique @map("key_hash")
  /// First 8 chars of the plaintext, stored so the admin UI can show
  /// `ebdam_3a9f…` next to each key. Not sufficient to authenticate.
  prefix  String

  /// One or more of: merchant:read, merchant:write, merchant:destructive.
  /// Checked per tool. An empty array authorises nothing.
  scopes String[]

  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId, revokedAt])
  // FK-only index so the User delete RI check does not sequential-scan.
  @@index([userId])
  @@map("merchant_api_keys")
}

// ==========================================
// Plans & subscriptions (SP5 task 1) — plans as DATA
// ==========================================

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  comped
}

/// A sellable (or admin-granted) plan. Global catalog: NOT store-scoped, so no
/// RLS — reads are public-safe config; writes only go through the super-admin
/// `PUT /admin/plans/:code`. Prices are NULL until Ahmad sets them (null means
/// "not set yet", never "free"). `limits` is validated by `planLimitsSchema`
/// (@ebda/shared) on every write; a null numeric limit means unlimited.
model Plan {
  id                String    @id @default(uuid())
  code              String    @unique
  nameEn            String    @map("name_en")
  nameAr            String    @map("name_ar")
  sort              Int       @default(0)
  /// Shown on the public pricing page / self-serve upgrade picker. `comped` is false.
  isPublic          Boolean   @default(true) @map("is_public")
  /// EGP piastres. NULL = not set yet.
  priceMonthlyMinor Int?      @map("price_monthly_minor")
  priceYearlyMinor  Int?      @map("price_yearly_minor")
  /// Legacy StorePlan enum tier whose PLAN_BASELINE feature set a store on this
  /// plan inherits (keeps FeatureService working while `Store.plan` is retired
  /// — follow-up). Kept in sync onto `stores.plan` by assignPlan.
  featureTier       StorePlan @default(free) @map("feature_tier")
  limits            Json
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  subscriptions StoreSubscription[]

  @@map("plans")
}

/// One row per store: which plan it is on and where it is in the billing cycle.
/// Task 3 (EGP billing) owns the provider columns and the status transitions;
/// task 1 only reads `status`/`planCode`. A store with no row resolves through
/// its legacy `Store.plan` enum (see PlanService.getEntitlements).
///
/// RLS: store-scoped, 4 explicit policies in migration
/// 20261003130000_plans_and_store_subscriptions (same shape as
/// store_usage_snapshots). NOTE for the strict-RLS sweep: this table is
/// written by system paths (provisioning, admin plan assignment, billing
/// cron) that run with no tenant context.
model StoreSubscription {
  id                 String             @id @default(uuid())
  storeId            String             @unique @map("store_id")
  planCode           String             @map("plan_code")
  status             SubscriptionStatus @default(active)
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")

  // Provider fields — nullable until task 3 (Kashier/Paymob adapter) fills them.
  provider                 String?   @map("provider")
  providerCustomerId       String?   @map("provider_customer_id")
  providerSubscriptionId   String?   @map("provider_subscription_id")
  providerPaymentMethodRef String?   @map("provider_payment_method_ref")
  /// Card display details (signup funnel, migration 20261007120000). Never the token.
  paymentMethodLast4       String?   @map("payment_method_last4")
  paymentMethodBrand       String?   @map("payment_method_brand")
  paymentMethodSavedAt     DateTime? @map("payment_method_saved_at")
  /// card | instapay (null = not chosen). See Rulings EBDA-FUNNEL-8/9.
  billingMethod            String?   @map("billing_method")
  /// Unique code the merchant writes on an InstaPay transfer.
  paymentReference         String?   @unique @map("payment_reference")

  /// First day (Cairo) of the month in which this store went OVER its monthly
  /// order cap. Orders are never blocked at checkout (see PlanLimitService);
  /// this is the flag the Billing page and the merchant notification read.
  ordersOverLimitMonth      DateTime? @map("orders_over_limit_month") @db.Date
  ordersOverLimitNotifiedAt DateTime? @map("orders_over_limit_notified_at")

  // Billing lifecycle (SP5 task 3, migration 20261003150000). `billingInterval`
  // is 'monthly' | 'yearly'. `pendingPlanCode` is a downgrade scheduled for the
  // period end. `dunningAttempts` counts failed charges for the current period
  // (0 = none); `nextRetryAt` is when the cron retries (day 3, then day 7).
  billingInterval String    @default("monthly") @map("billing_interval")
  pendingPlanCode String?   @map("pending_plan_code")
  /// Day of month (UTC, 1-31) the paid cycle started on; every renewal clamps from it (M-125). Null = derived from the period end.
  billingAnchorDay Int?     @map("billing_anchor_day")
  dunningAttempts Int       @default(0) @map("dunning_attempts")
  /// First time this subscription went past_due (WA-GRACE-1). Maintained by the
  /// store_subscriptions_past_due_since trigger on every write path; null unless status = past_due.
  pastDueSince    DateTime? @map("past_due_since") @db.Timestamptz(3)
  nextRetryAt     DateTime? @map("next_retry_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan  Plan  @relation(fields: [planCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([planCode])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([nextRetryAt])
  @@map("store_subscriptions")
}

/// Append-only billing ledger (SP5 task 3): one row per money attempt — a
/// checkout, a renewal charge, an upgrade charge or a refund. Rows are never
/// deleted and their money columns never change (DB trigger); only `status`,
/// `providerRef`, `failureReason` and `raw` move, and `succeeded` can never go
/// back to `failed` (a late "failed" webhook is a no-op). `idempotencyKey` is
/// UNIQUE: it is claimed BEFORE the provider is called, so two cron runs, two
/// retries or a replayed request can never create a second charge. `raw` holds
/// provider payloads with card tokens stripped.
///
/// Viewers: super-admin /billing-events, merchant Billing page (charges list).
/// RLS: store-scoped, same 4-policy shape as store_subscriptions; written by
/// system paths (cron, webhook) under withRlsBypass.
model BillingEvent {
  id              String    @id @default(uuid())
  storeId         String    @map("store_id")
  subscriptionId  String?   @map("subscription_id")
  /// checkout | renewal | upgrade | refund | card_setup (amount 0, nothing charged)
  type            String
  planCode        String?   @map("plan_code")
  billingInterval String?   @map("billing_interval")
  /// Renewal/retry: the `currentPeriodEnd` this charge pays for.
  forPeriodEnd    DateTime? @map("for_period_end")
  /// Dunning attempt: 0 = the day-0 charge, 1 = day 3, 2 = day 7.
  attempt         Int       @default(0)
  amountMinor     Int       @map("amount_minor")
  currency        String    @default("EGP")
  provider        String
  providerRef     String?   @map("provider_ref")
  idempotencyKey  String    @unique @map("idempotency_key")
  /// pending | succeeded | failed | refunded
  status          String    @default("pending")
  failureReason   String?   @map("failure_reason")
  /// For a refund row: the charge row it refunds.
  relatedEventId  String?   @map("related_event_id")
  raw             Json?
  /// Ebda's own VAT inside `amountMinor` (0 = no VAT line). Ruling EBDA-BILLFU-3.
  vatMinor        Int       @default(0) @map("vat_minor")
  /// VAT snapshot at charge time { netMinor, vatMinor, rateBps, mode, trn, legalName }; null = no VAT.
  vat             Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([provider, providerRef])
  @@map("billing_events")
}

/// A merchant's "I paid by InstaPay" claim (signup funnel). Never activates
/// anything by itself; a super-admin confirms it with the manual-payment action.
/// RLS: strict store policy (migration 20261007120000).
/// An InstaPay transfer screenshot and what it says (money batch A, Rulings EBDA-MONEYA-1..).
/// The payer uploads it (merchant paying Ebda = `subscription`, shopper paying a store order =
/// `order`); Gemini pre-fills the fields, the payer corrects and submits, a human approves
/// (super-admin for subscriptions, the merchant for orders). Nothing activates on a receipt alone.
/// The image lives ONLY in the private bucket (`storage_key`), never behind a URL.
model InstapayReceipt {
  id                  String    @id @default(uuid())
  storeId             String    @map("store_id")
  /// subscription | order
  kind                String
  /// subscription: the claim created on submit.
  claimId             String?   @unique @map("claim_id")
  /// order: the order (and its pending InstaPay payment) this transfer pays.
  orderId             String?   @map("order_id")
  paymentId           String?   @map("payment_id")
  storageKey          String    @map("storage_key")
  mimeType            String    @map("mime_type")
  sizeBytes           Int       @map("size_bytes")
  sha256              String
  /// pending | done | failed (failed = manual entry)
  extractionStatus    String    @default("pending") @map("extraction_status")
  /// What the AI read, verbatim after normalisation (shown to the approver next to the submitted fields).
  extracted           Json?
  confidence          Float?
  extractionError     String?   @map("extraction_error")
  /// The fields the payer submitted (pre-filled from `extracted`, correctable).
  amountMinor         Int?      @map("amount_minor")
  reference           String?
  /// Normalised reference digits. UNIQUE across every store while the receipt is live
  /// (submitted/approved); cleared on reject/void so the same transfer can be re-filed.
  referenceKey        String?   @unique @map("reference_key")
  transferredAt       DateTime? @map("transferred_at")
  payerName           String?   @map("payer_name")
  payerAddress        String?   @map("payer_address")
  payerMobile         String?   @map("payer_mobile")
  payerBank           String?   @map("payer_bank")
  receiverName        String?   @map("receiver_name")
  receiverHandle      String?   @map("receiver_handle")
  receiverMobile      String?   @map("receiver_mobile")
  note                String?
  /// What the approver expects (frozen at submit): amount in piastres and the receiver handle/mobile.
  expectedAmountMinor Int?      @map("expected_amount_minor")
  expectedReceiver    String?   @map("expected_receiver")
  /// Automatic checks for the approver (flags, never a block): AMOUNT_MISMATCH, RECEIVER_MISMATCH, ...
  flags               String[]  @default([])
  /// draft | submitted | approved | rejected | voided
  status              String    @default("draft")
  submittedAt         DateTime? @map("submitted_at")
  reviewNote          String?   @map("review_note")
  reviewedBy          String?   @map("reviewed_by")
  reviewedAt          DateTime? @map("reviewed_at")
  /// The screenshot (private R2) was deleted: on approval, or by the retention sweep. Null = the object may still exist.
  imageDeletedAt      DateTime? @map("image_deleted_at")
  /// payer / receiver / note / AI-read personal fields were scrubbed (retention sweep, or the shopper's erasure).
  personalScrubbedAt  DateTime? @map("personal_scrubbed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, orderId])
  @@index([storeId, sha256])
  @@map("instapay_receipts")
}

model ManualPaymentClaim {
  id               String    @id @default(uuid())
  storeId          String    @map("store_id")
  subscriptionId   String?   @map("subscription_id")
  planCode         String    @map("plan_code")
  billingInterval  String    @map("billing_interval")
  amountMinor      Int       @map("amount_minor")
  /// instapay | bank | cash
  method           String    @default("instapay")
  /// Our reference (store_subscriptions.payment_reference) at claim time.
  paymentReference String    @map("payment_reference")
  /// The payer's transaction reference (InstaPay txn id); unique per method.
  payerReference   String    @map("payer_reference")
  proofUrl         String?   @map("proof_url")
  /// pending | confirmed | rejected
  status           String    @default("pending")
  reviewNote       String?   @map("review_note")
  reviewedBy       String?   @map("reviewed_by")
  reviewedAt       DateTime? @map("reviewed_at")
  billingEventId   String?   @map("billing_event_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([method, payerReference])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([status])
  @@map("manual_payment_claims")
}

/// One reminder per (subscription, due date, kind): the daily job's idempotency
/// handle (signup funnel). RLS: strict store policy.
model BillingReminder {
  id             String   @id @default(uuid())
  storeId        String   @map("store_id")
  subscriptionId String   @map("subscription_id")
  dueAt          DateTime @map("due_at")
  /// d7 | d3 | d1 | d0 | suspended
  kind           String
  createdAt      DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, dueAt, kind])
  @@index([storeId])
  @@map("billing_reminders")
}

/// One row per (store, onboarding/lifecycle email kind): the idempotency handle AND the merchant-visible
/// log of the self-serve lifecycle emails (setup nudges, trial recap, first-order referral ask). The
/// Inngest function wins the INSERT before it sends, so a retry or a second run never sends the same
/// email twice. `status`: sent | skipped (the step was already done, `reason` says why) | failed
/// (enqueue threw). kind `optout` is the merchant's unsubscribe: while it exists nothing is sent.
/// Viewer: /stores/[id]/lifecycle-emails. RLS: strict store policy.
model StoreLifecycleEmail {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  /// add_products | payment_shipping | test_order | share_link | trial_recap | first_order | optout
  kind      String
  /// sent | skipped | failed
  status    String
  /// skipped / failed: why (step already done, no recipient, opted out, enqueue error code)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, kind])
  @@index([storeId, createdAt])
  @@map("store_lifecycle_emails")
}

/// Who referred a merchant (FOUNDING-1 / M-082). One row per referred store, captured when the
/// store is created from a referral link (`ref` = the referrer's store slug). Platform data: it
/// carries two store ids and nothing else, no store_id column, no RLS (same class as
/// billing_webhook_events); read and written only by the billing service and super-admin.
model BillingReferral {
  referredStoreId String   @id @map("referred_store_id")
  referrerStoreId String   @map("referrer_store_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([referrerStoreId])
  @@map("billing_referrals")
}

/// Append-only ledger of free months (FOUNDING-1 / M-082): one row per grant, whole months only
/// (integer), plus the plan price it was worth in minor units. `idempotencyKey` is UNIQUE, so a
/// replayed payment event can never grant twice; the caps (20 founding, 3 per referrer) are counted
/// under an advisory lock in grants.service. A grant is `pending` until the store has a billing
/// period to extend, then `applied` with the period end before/after. Platform data (no RLS, see
/// BillingReferral); viewer: super-admin /billing-events -> Grants.
model BillingGrant {
  id               String    @id @default(uuid())
  /// founding | referral_referrer | referral_referred
  kind             String
  /// The store that receives the free month.
  beneficiaryId    String    @map("beneficiary_id")
  /// referral kinds: the other side of the referral.
  counterpartId    String?   @map("counterpart_id")
  months           Int       @default(1)
  valueMinor       Int       @default(0) @map("value_minor")
  /// pending | applied | revoked (the qualifying payment was refunded / charged back)
  status           String    @default("pending")
  /// The qualifying payment (billing_events.id) and the store it belongs to. A referral grant to the referrer
  /// points at the REFERRED store's payment.
  sourceEventId    String?   @map("source_event_id")
  sourceStoreId    String?   @map("source_store_id")
  revokedAt        DateTime? @map("revoked_at")
  revokeReason     String?   @map("revoke_reason")
  /// Set once the free month taken back from `currentPeriodEnd` (applied grants only).
  restoredAt       DateTime? @map("restored_at")
  idempotencyKey   String    @unique @map("idempotency_key")
  periodEndBefore  DateTime? @map("period_end_before")
  periodEndAfter   DateTime? @map("period_end_after")
  appliedAt        DateTime? @map("applied_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([beneficiaryId, status])
  @@index([kind, createdAt])
  @@index([sourceEventId])
  @@index([sourceStoreId, status])
  @@map("billing_grants")
}

/// Provider webhook inbox (SP5 task 3): UNIQUE (provider, eventId) makes a
/// replayed delivery a no-op. Written in the SAME transaction as the
/// settlement it triggers, so a crash can never mark an event "seen" without
/// applying it. Infra table (no business meaning beyond dedupe) — its payloads
/// are visible per charge on /billing-events.
model BillingWebhookEvent {
  id         String   @id @default(uuid())
  provider   String
  eventId    String   @map("event_id")
  eventType  String   @map("event_type")
  /// processed | ignored
  outcome    String
  detail     String?
  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([provider, eventId])
  @@map("billing_webhook_events")
}

// ===================================}

// Visual builder: page documents (draft / published / archived revisions)
// ==========================================

// One row per saved revision of a store page's PageDefinition
// (packages/shared/src/builder). `rev` is monotonic per (store, page) and is
// the optimistic-concurrency token: a write names the rev it was based on and
// gets 409 when the page moved. At most one `draft` and one `published` row
// per page (partial unique indexes in the migration). Publishing back-writes
// stores.layout_settings through the adapter so every legacy reader keeps
// working. Strict RLS (R-EBDA-001) in the same migration.
model StorePageRevision {
  id              String    @id @default(uuid())
  storeId         String    @map("store_id")
  pageKey         String    @map("page_key")
  rev             Int
  // draft | published | archived (CHECK constraint in the migration)
  status          String
  schemaVersion   Int       @map("schema_version")
  document        Json
  docBytes        Int       @map("doc_bytes")
  baseRev         Int?      @map("base_rev")
  note            String?
  // User id of the editor. No FK: users are identity-keyed under RLS and an
  // erased user must not take a store's page history with them.
  createdBy       String?   @map("created_by")
  // Who made this revision live (publish, rollback, restore): a user id only, no FK like created_by,
  // pseudonymised on offboarding (OFFBOARD-1). The name is looked up at read time, never copied here.
  publishedBy     String?   @map("published_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  publishedAt     DateTime? @map("published_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, pageKey, rev])
  @@index([storeId, pageKey, createdAt(sort: Desc)])
  @@map("store_page_revisions")
}

/// Egypt VAT gate (ruling TAX-2). A merchant may charge VAT only once a
/// super-admin has VERIFIED its VAT registration: issuing a VAT invoice while
/// unregistered is tax evasion (Law 67/2016 Art. 68 item 8). One row per store,
/// created lazily on the first merchant write; no row = `none`.
/// UI: merchant `/stores/[id]/tax` (VAT registration card), super-admin
/// `/tax-verification` (review queue). Every transition is audit-logged.
enum TaxProfileStatus {
  none
  pending
  verified
  rejected
  revoked
}

/// Fiscal documents (ruling MONEYB-1). Each numbered type has its OWN gap-free
/// serial per store; the two `*_record` types are un-numbered archive rows
/// written when a store is deleted (ruling MONEYB-4).
enum FiscalDocType {
  /// "فاتورة ضريبية" — only for a sale priced under a VERIFIED VAT profile.
  tax_invoice
  /// Plain sales receipt — every other sale (no VAT wording).
  receipt
  /// Refund/adjustment of a tax invoice; references the invoice number + date.
  credit_note
  /// Refund of a plain receipt; references the receipt number + date.
  refund_receipt
  /// Store-deletion archive of an order that had no issued document (legacy).
  order_record
  /// Store-deletion archive of Ebda's own subscription billing row (VAT ledger).
  billing_record
}

enum TaxDocumentKind {
  tax_card
  vat_certificate
  other
}

model StoreTaxProfile {
  id                    String           @id @default(uuid())
  storeId               String           @unique @map("store_id")
  status                TaxProfileStatus @default(none)
  /// Egyptian tax registration number (TRN / RIN), digits only.
  taxRegistrationNumber String?          @map("tax_registration_number")
  /// The registered legal name of the taxpayer, as on the tax card.
  legalName             String?          @map("legal_name")
  /// When the merchant attested "I am VAT-registered with the ETA" on submit.
  attestedAt            DateTime?        @map("attested_at")
  submittedAt           DateTime?        @map("submitted_at")
  submittedBy           String?          @map("submitted_by")
  /// The super-admin who made the latest decision (approve / reject / revoke).
  reviewedBy            String?          @map("reviewed_by")
  reviewedAt            DateTime?        @map("reviewed_at")
  verifiedAt            DateTime?        @map("verified_at")
  revokedAt             DateTime?        @map("revoked_at")
  /// Reason for the latest reject or revoke, shown to the merchant.
  rejectionReason       String?          @map("rejection_reason")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  store     Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  documents StoreTaxDocument[]

  @@index([status, submittedAt])
  @@index([taxRegistrationNumber])
  @@map("store_tax_profiles")
}

/// Evidence for a tax profile (tax card / VAT registration certificate). The
/// file lives in the PRIVATE R2 bucket (`STORAGE_PRIVATE_BUCKET`) under
/// `stores/<storeId>/tax-documents/`; it has no URL at all and is streamed by
/// the API to the store's own admins and to super-admins only (ruling TAX-4).
model StoreTaxDocument {
  id         String          @id @default(uuid())
  storeId    String          @map("store_id")
  profileId  String          @map("profile_id")
  kind       TaxDocumentKind
  /// Object key in the private bucket (never a URL).
  storageKey String          @map("storage_key")
  fileName   String          @map("file_name")
  mimeType   String          @map("mime_type")
  sizeBytes  Int             @map("size_bytes")
  sha256     String
  uploadedBy String?         @map("uploaded_by")
  createdAt  DateTime        @default(now()) @map("created_at")

  store   Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  profile StoreTaxProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([profileId])
  @@map("store_tax_documents")
}

// PROVIDERS-ACTIVATION. A merchant asked Ebda to switch on a payment gateway / shipping carrier
// the catalog does not list as verified. `activated` is the per-store override the enable gates
// accept (catalog-verified OR store-activated); only a super admin sets it, and only after that
// store's own Test connection passed. One live (requested | activated) row per store + provider.
model ProviderActivationRequest {
  id            String    @id @default(uuid())
  storeId       String    @map("store_id")
  provider      String
  // requested | activated | rejected
  status        String    @default("requested")
  // The super admin's note (required on a rejection).
  note          String?
  requestedById String?   @map("requested_by_id")
  requestedAt   DateTime  @default(now()) @map("requested_at")
  decidedById   String?   @map("decided_by_id")
  decidedAt     DateTime? @map("decided_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([status, requestedAt])
  @@map("provider_activation_requests")
}

// SELF-SERVICE trust and support (A13/A14/A16): one small table for the requests a merchant files with Ebda staff.
// `kind`: support (in-product "Contact Ebda Store"), suspension (the reason a super admin gave when suspending,
// readable by the merchant), suspension_appeal, slug_claim (protected brand slug), store_cap (more stores per day).
// Staff decide; a merchant has no route that sets a decision. `store_id` is null for the two kinds filed before a
// store exists (slug_claim, store_cap); `user_id` is the requester (no FK: identity lives outside this database).
model TrustRequest {
  id          String   @id @default(uuid())
  kind        String
  storeId     String?  @map("store_id")
  userId      String?  @map("user_id")
  topic       String?
  message     String?
  pageUrl     String?  @map("page_url")
  slug        String?
  evidenceUrl String?  @map("evidence_url")
  // open | resolved | rejected
  status      String   @default("open")
  // set by the super-admin reject route; the merchant's appeal cooldown keys on it (never on updated_at)
  rejectedAt  DateTime? @map("rejected_at")
  // support requests only: claim one of 5 slots per store per UTC day through a partial UNIQUE (store_id, cap_day,
  // cap_slot); a lost race is a unique violation, so the daily cap is atomic on Postgres and D1 alike
  capDay      String?  @map("cap_day")
  capSlot     Int?     @map("cap_slot")
  // store_cap requests only: the owner's self-serve store limit granted when staff RESOLVED it (> the previous limit,
  // <= STORE_LIMIT_MAX). The owner's effective limit is the largest granted_limit among their resolved requests,
  // else MAX_SELF_SERVE_STORES_PER_OWNER (services/owner-store-limit.ts).
  grantedLimit Int?    @map("granted_limit")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, kind, createdAt(sort: Desc)])
  @@index([userId, kind, status])
  @@map("trust_requests")
}

// PROVIDERS-3: what the first merchants' real traffic proves about a provider. GLOBAL (no tenant
// data: store ids are plain strings with no FK, so deleting a store never erases the evidence).
// `provider_verifications` holds the per-provider counters and `verified_at` (set automatically
// after PROVIDER_AUTO_VERIFY_AFTER successful real operations); `provider_verification_events` is
// the append-only evidence (op, outcome, reference, error code; never a credential or a body).
model ProviderVerification {
  provider     String    @id
  kind         String
  successCount Int       @default(0) @map("success_count")
  failureCount Int       @default(0) @map("failure_count")
  // Set automatically once enough DISTINCT stores settled real LIVE operations: "ready to verify".
  readyAt      DateTime? @map("ready_at")
  // Set only by a super admin confirm (verifiedAt gates the alerts, so no auto-flip).
  verifiedAt   DateTime? @map("verified_at")
  verifiedById String?   @map("verified_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("provider_verifications")
}

model ProviderVerificationEvent {
  id        String   @id @default(uuid())
  provider  String
  // Not `storeId` on purpose: the tenant guard would class this table as store-scoped.
  sourceStoreId String @map("source_store_id")
  op        String
  ok        Boolean
  // sandbox | live, and whether it counts toward verification (live + settled + ok).
  mode      String   @default("sandbox")
  counted   Boolean  @default(false)
  ref       String?
  errorCode String?  @map("error_code")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([provider, createdAt])
  @@index([provider, counted, sourceStoreId])
  @@index([provider, sourceStoreId])
  @@map("provider_verification_events")
}

/// An ISSUED fiscal document — tax invoice, receipt, credit note, refund
/// receipt — or a store-deletion archive record (rulings MONEYB-1, MONEYB-4).
///
/// Immutable once written: a trigger (migration 20261008160000) refuses DELETE
/// before `retain_until` and every UPDATE except the cancellation and ETA
/// submission columns. `payload` is the document AS ISSUED (seller, buyer,
/// lines, totals) so a later order/store edit or a store deletion can never
/// rewrite or erase it.
///
/// NO foreign keys on `store_id` / `order_id` ON PURPOSE: deleting a store or an
/// order must leave its tax documents in place for 6 years (UTPL 206/2020
/// Art. 38/44; PDPL 151/2020 Art. 3 legal-obligation basis).
///
/// Viewers: merchant admin /stores/[id]/invoices (list + open), order detail
/// "Documents" card; super-admin /tax-archive (stores already deleted).
/// RLS: strict store policy.
model FiscalDocument {
  id                 String        @id @default(uuid())
  storeId            String        @map("store_id")
  orderId            String?       @map("order_id")
  docType            FiscalDocType @map("doc_type")
  /// Gap-free serial within (store, docType); NULL for archive records.
  serial             Int?
  /// Merchant-facing number = ETA `internalID` (e.g. INV-000042). Never the order number.
  number             String?
  /// issued | cancelled. A cancelled document keeps its number (UTPL Art. 37).
  status             String        @default("issued")
  issuedAt           DateTime      @default(now()) @map("issued_at")
  cancelledAt        DateTime?     @map("cancelled_at")
  /// Credit note / refund receipt: the document it adjusts.
  originalDocumentId String?       @map("original_document_id")
  originalNumber     String?       @map("original_number")
  originalIssuedAt   DateTime?     @map("original_issued_at")
  currency           String        @default("EGP")
  /// Net (excl. VAT), VAT and gross of the document, minor units.
  netAmount          Int           @map("net_amount")
  vatAmount          Int           @default(0) @map("vat_amount")
  totalAmount        Int           @map("total_amount")
  vatRateBps         Int?          @map("vat_rate_bps")
  sellerTrn          String?       @map("seller_trn")
  payload            Json
  /// Idempotency of a credit note / refund receipt per refund event.
  refundRef          String?       @map("refund_ref")
  /// Future ETA e-invoicing (separate from our `number`): ETA-issued uuid,
  /// submission id and status. Never used as the display number.
  etaUuid            String?       @map("eta_uuid")
  etaSubmissionId    String?       @map("eta_submission_id")
  etaStatus          String?       @map("eta_status")
  etaSubmittedAt     DateTime?     @map("eta_submitted_at")
  /// issued_at + 6 years: the trigger refuses DELETE before this.
  retainUntil        DateTime      @map("retain_until")
  createdAt          DateTime      @default(now()) @map("created_at")

  @@unique([storeId, docType, serial])
  @@unique([storeId, refundRef])
  @@index([storeId, orderId])
  @@index([storeId, issuedAt(sort: Desc)])
  @@map("fiscal_documents")
}

/// The last serial handed out per (store, document type). Bumped with one
/// `INSERT .. ON CONFLICT DO UPDATE .. RETURNING` inside the transaction that
/// writes the document, so a rolled-back sale never burns a number (gap-free).
/// No FK to stores: a deleted store's series must not restart.
/// Viewers: the serials themselves show on every document (merchant /invoices).
model FiscalDocumentCounter {
  storeId    String        @map("store_id")
  docType    FiscalDocType @map("doc_type")
  lastSerial Int           @default(0) @map("last_serial")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@id([storeId, docType])
  @@map("fiscal_document_counters")
}

// ---------------------------------------------------------------------------
// Merchant OUTGOING webhooks (docs/plans/done/2026-10-21-merchant-webhooks.md).
// Viewer: admin /stores/[id]/webhooks (endpoints + delivery log). Store delete cascades.
// ---------------------------------------------------------------------------

/// A URL a merchant registered to receive signed JSON events. `secretEnc` is the HMAC key
/// (encryption.encrypt; shown to the merchant once at create/rotate). `consecutiveFailures`
/// counts deliveries that exhausted every attempt; at the limit the endpoint disables itself.
model WebhookEndpoint {
  id                  String    @id @default(uuid())
  storeId             String    @map("store_id")
  url                 String    @db.VarChar(2048)
  description         String?   @db.VarChar(120)
  /// Subscribed event types (WEBHOOK_EVENT_TYPES in @ebda/shared).
  events              String[]
  /// Add customer name/email/phone to order payloads. Off by default (minimal PII).
  includeCustomer     Boolean   @default(false) @map("include_customer")
  secretEnc           String    @map("secret_enc")
  /// Last 4 characters of the secret, for the merchant to recognise which one is live.
  secretHint          String    @map("secret_hint") @db.VarChar(8)
  active              Boolean   @default(true)
  /// 'consecutive_failures' | 'merchant' | null.
  disabledReason      String?   @map("disabled_reason") @db.VarChar(40)
  disabledAt          DateTime? @map("disabled_at")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastSuccessAt       DateTime? @map("last_success_at")
  lastFailureAt       DateTime? @map("last_failure_at")
  createdBy           String?   @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@unique([id, storeId])
  @@index([storeId, createdAt])
  @@map("webhook_endpoints")
}

/// One event for one endpoint. `payload` is the exact JSON that is signed and sent, so a
/// resend is byte-identical (same `eventId`). UNIQUE(endpoint, dedupeKey) makes the fan-out
/// idempotent under Inngest replays. Last 50 per endpoint are kept; 30-day purge.
model WebhookDelivery {
  id              String    @id @default(uuid())
  storeId         String    @map("store_id")
  endpointId      String    @map("endpoint_id")
  /// Public event id (evt_<uuid>), the receiver's idempotency key. Stable across resends.
  eventId         String    @map("event_id") @db.VarChar(64)
  eventType       String    @map("event_type") @db.VarChar(40)
  /// null for test events and resends (no dedupe).
  dedupeKey       String?   @map("dedupe_key") @db.VarChar(160)
  payload         Json
  /// 'pending' | 'retrying' | 'success' | 'failed'
  status          String    @default("pending") @db.VarChar(12)
  attempts        Int       @default(0)
  isTest          Boolean   @default(false) @map("is_test")
  responseStatus  Int?      @map("response_status")
  /// First 200 characters of the response body at most.
  responseSnippet String?   @map("response_snippet") @db.VarChar(200)
  error           String?   @db.VarChar(200)
  durationMs      Int?      @map("duration_ms")
  nextAttemptAt   DateTime? @map("next_attempt_at")
  deliveredAt     DateTime? @map("delivered_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  store    Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId, storeId], references: [id, storeId], onDelete: Cascade)

  @@unique([endpointId, dedupeKey])
  @@index([endpointId, createdAt(sort: Desc)])
  @@index([storeId, createdAt])
  // Leading index for the composite FK (endpoint_id, store_id).
  @@index([endpointId, storeId])
  @@map("webhook_deliveries")
}

// ==========================================
// Gold-rate pricing (Phase B5, Rulings B5-12..B5-21). Docs: docs/architecture/gold-rate-pricing.md
// UI: admin /stores/[id]/gold-rates (editor, history, settings), the product edit GoldPricingCard,
// storefront GoldRateLine + PriceChangedNotice.
// ==========================================

/// Append-only history of every rate written. ebda_app may SELECT, INSERT and UPDATE (status, decided_by,
/// applied_at) only: no DELETE, no re-rating (column grants in migration 20261102000200).
model GoldRate {
  id            String    @id @default(uuid())
  storeId       String    @map("store_id")
  karat         Int       @db.SmallInt
  /// Piastres per gram, 10 000..10 000 000 (DB CHECK).
  ratePerGram   Int       @map("rate_per_gram")
  /// 'manual' | 'feed'
  source        String
  /// 'applied' | 'pending' | 'rejected'
  status        String
  /// The jump from the previous applied rate of this karat in basis points, when one was measured.
  jumpBps       Int?      @map("jump_bps")
  /// Spot per ounce, fetched-at, premium bps. Never a provider name.
  feedReference Json?     @map("feed_reference")
  createdBy     String?   @map("created_by")
  decidedBy     String?   @map("decided_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  appliedAt     DateTime? @map("applied_at") @db.Timestamptz(3)

  store   Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  current GoldRateCurrent[]

  @@index([storeId, karat, createdAt(sort: Desc)])
  @@map("gold_rates")
}

/// The one applied rate per (store, karat). Rate writes take FOR UPDATE on it, checkout takes FOR SHARE.
model GoldRateCurrent {
  storeId     String   @map("store_id")
  karat       Int      @db.SmallInt
  rateId      String   @map("rate_id")
  ratePerGram Int      @map("rate_per_gram")
  appliedAt   DateTime @map("applied_at") @db.Timestamptz(3)

  store Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rate  GoldRate @relation(fields: [rateId], references: [id], onDelete: Cascade)

  @@id([storeId, karat])
  @@index([rateId])
  @@map("gold_rates_current")
}

model GoldRateSettings {
  storeId        String   @id @map("store_id")
  enabled        Boolean  @default(false)
  feedEnabled    Boolean  @default(false) @map("feed_enabled")
  feedPremiumBps Int      @default(0) @map("feed_premium_bps")
  /// Minutes; 60..1560 (26 h is the default AND the ceiling, Ruling B5-16).
  maxAgeMinutes  Int      @default(1560) @map("max_age_minutes")
  jumpConfirmBps Int      @default(500) @map("jump_confirm_bps")
  /// Piastres: 1 | 100 | 500 | 1000.
  roundingStep   Int      @default(100) @map("rounding_step")
  showBreakdown  Boolean  @default(false) @map("show_breakdown")
  updatedBy      String?  @map("updated_by")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("gold_rate_settings")
}

// ==========================================
// Egypt ETA e-receipt connector (Ruling ETA-1; docs/plans/done/2026-10-07-egypt-vat-and-eta.md)
// ==========================================

/// One row per store: the merchant's OWN ETA credentials (client id/secret, POS pre-shared key and the optional
/// signing-bridge token) AES-256-GCM encrypted in `credentialsEnc` (encryption.service, JSON blob); never returned
/// to a browser, masked on read. Behind the per-store `eta_ereceipt` feature (off by default).
/// Store-scoped: the StoreDO table `eta_connections` (cf-schema), same columns.
model EtaConnection {
  id               String    @id @default(uuid())
  storeId          String    @unique @map("store_id")
  enabled          Boolean   @default(false)
  /// 'preprod' | 'prod'
  environment      String    @default("preprod")
  credentialsEnc   String    @map("credentials_enc")
  posSerial        String    @map("pos_serial")
  branchCode       String    @map("branch_code")
  activityCode     String    @map("activity_code")
  /// An EGS item code the merchant registered and ETA approved ("EG-<RIN>-<internal code>").
  defaultItemCode  String    @map("default_item_code")
  address          Json
  signingBridgeUrl String?   @map("signing_bridge_url")
  /// Result of the last credential check ('ok' | ETA error code); never a message from ETA.
  lastCheckStatus  String?   @map("last_check_status")
  lastCheckedAt    DateTime? @map("last_checked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("eta_connections")
}

/// One e-receipt (sale or whole-order return) and its submission state. `document` is the exact JSON that was hashed
/// into `uuid` and is re-sent unchanged on every retry (same uuid = ETA can dedupe). No FK to orders on purpose:
/// a fiscal record must outlive order anonymisation; it cascades only with the store. Store-scoped (StoreDO).
model EtaReceipt {
  id             String    @id @default(uuid())
  storeId        String    @map("store_id")
  orderId        String    @map("order_id")
  /// 'sale' | 'return'
  kind           String
  seq            Int       @default(1)
  /// Return receipts: the Return id that caused it (order/refunded `partial.refundKey`), or 'full' for a whole-order
  /// refund. Identifies one logical return across re-issues (seq grows, refundKey stays). NULL for sales.
  refundKey      String?   @map("refund_key")
  /// Sale: [{orderItemId, quantity}] aligned with document.itemData (goods lines first; fee lines have no entry).
  /// Return: { items: [{orderItemId, quantity}], refundAmount } as carried by order/refunded. Lets a partial return be
  /// built from the order's own lines.
  lineMap        Json?     @map("line_map")
  /// queued | retrying | submitted | accepted | rejected | failed | late | manual (@ebda/shared ETA_RECEIPT_STATUSES)
  status         String    @default("queued")
  environment    String
  receiptNumber  String?   @map("receipt_number")
  uuid           String?
  previousUuid   String?   @map("previous_uuid")
  document       Json?
  totalPiastres  Int?      @map("total_piastres")
  issuedAt       DateTime? @map("issued_at")
  /// issuedAt + 24 h (the SDK submission window).
  deadlineAt     DateTime? @map("deadline_at")
  submissionUuid String?   @map("submission_uuid")
  longId         String?   @map("long_id")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime? @map("next_attempt_at")
  /// Stable machine code (ETA error code or ours); never a credential or a raw ETA body.
  errorCode      String?   @map("error_code")
  errorMessage   String?   @map("error_message")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, orderId, kind, seq])
  @@index([storeId, status, nextAttemptAt])
  @@index([storeId, orderId])
  @@index([storeId, orderId, refundKey])
  @@index([status, nextAttemptAt])
  @@map("eta_receipts")
}

// Catalogue import (photos / PDFs -> reviewed draft products). Ruling CATIMP-1: one row per uploaded
// file stands in for the plan's separate `pages` table (an image is one page; a PDF is extracted whole).
// Strict RLS (store_id GUC). Retention: expires_at = created + 30 days (docs/RETENTION.md).
model CatalogImportJob {
  id            String    @id @default(uuid())
  storeId       String    @map("store_id")
  // Acting user id; no FK (identity lives outside this database). Scrubbed on user erasure.
  createdBy     String?   @map("created_by")
  status        String    @default("queued") // queued|processing|review|creating|done|failed|cancelled
  errorCode     String?   @map("error_code")
  filesTotal    Int       @default(0) @map("files_total")
  filesDone     Int       @default(0) @map("files_done")
  filesFailed   Int       @default(0) @map("files_failed")
  pagesTotal    Int       @default(0) @map("pages_total")
  itemsTotal    Int       @default(0) @map("items_total")
  draftsCreated Int       @default(0) @map("drafts_created")
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  store Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  files CatalogImportFile[]
  items CatalogImportItem[]

  @@index([storeId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("catalog_import_jobs")
}

model CatalogImportFile {
  id           String    @id @default(uuid())
  jobId        String    @map("job_id")
  storeId      String    @map("store_id")
  // Private bucket key, always under stores/<storeId>/catalog-import/<jobId>/.
  storageKey   String    @map("storage_key")
  mime         String // sniffed from the bytes, never the client's
  sizeBytes    Int       @map("size_bytes")
  sha256       String
  // Display only: control characters stripped, no path, capped. Never used as a storage key.
  originalName String    @map("original_name")
  pageCount    Int       @default(1) @map("page_count")
  status       String    @default("stored") // stored|processing|done|failed|skipped_quota
  attempts     Int       @default(0)
  errorCode    String?   @map("error_code")
  chargedPages Int @default(0) @map("charged_pages")
  itemsFound   Int       @default(0) @map("items_found")
  inputTokens  Int?      @map("input_tokens")
  outputTokens Int?      @map("output_tokens")
  model        String?
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  job   CatalogImportJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  store Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items CatalogImportItem[]

  @@index([jobId, status])
  @@index([storeId, chargedPages, startedAt])
  @@map("catalog_import_files")
}

model CatalogImportItem {
  id              String   @id @default(uuid())
  jobId           String   @map("job_id")
  fileId          String   @map("file_id")
  storeId         String   @map("store_id")
  status          String   @default("pending") // pending|accepted|rejected|created|failed
  name            String?
  nameAr          String?  @map("name_ar")
  description     String?
  descriptionAr   String?  @map("description_ar")
  priceMinor      Int?     @map("price_minor")
  compareAtMinor  Int?     @map("compare_at_minor")
  priceRaw        String?  @map("price_raw")
  sku             String?
  categoryName    String?  @map("category_name")
  categoryId      String?  @map("category_id")
  tags            String[]
  variants        Json     @default("[]")
  confidence      Float    @default(0)
  flags           String[]
  acknowledged    String[]
  sourceText      String?  @map("source_text")
  editedFields    String[] @map("edited_fields")
  productId       String?  @map("product_id")
  createErrorCode String?  @map("create_error_code")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  job      CatalogImportJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  file     CatalogImportFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  product  Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([jobId, status])
  @@index([storeId, sku])
  @@index([productId])
  @@index([categoryId])
  @@index([fileId])
  @@map("catalog_import_items")
}
