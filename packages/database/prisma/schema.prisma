// ==========================================
// Insights / BI Tier (Accounting Batch 4)
// ==========================================
//
// Three nightly snapshot tables materialized by the analytics-daily-rollup
// Inngest cron (02:00 KW). All reads from existing Order / AbandonedCart /
// Product / User data — no new operational events, no journal posting.
//
// RLS: same store_id pattern as all other tenant tables (policies in migration).

enum RfmSegment {
  vip
  loyal
  potential
  new_customer
  at_risk
  hibernating
  lost
}

model CustomerCohortSnapshot {
