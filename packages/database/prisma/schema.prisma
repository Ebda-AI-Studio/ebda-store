  productId  String  @map("product_id")
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId    String  @map("store_id")
  store      Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId    String  @map("order_id")
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId String? @map("customer_id")
  customer   User?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // The review content itself
  rating           Int // 1-5
  title            String?
  body             String    @db.Text
  language         String    @default("en") // 'en' | 'ar'
  bodyTranslated   String?   @map("body_translated") @db.Text // AI translation of body
  bodyTranslatedAt DateTime? @map("body_translated_at")

  // Verification + moderation
  verifiedPurchase Boolean @default(true) @map("verified_purchase") // always true via this flow
  status           String  @default("pending") // 'pending' | 'published' | 'rejected' | 'spam'
  rejectionReason  String? @map("rejection_reason")
  spamScore        Float?  @map("spam_score") // 0-1, AI-flagged
  spamReasons      Json?   @map("spam_reasons")

  // Merchant response (optional)
  ownerResponse   String?   @map("owner_response") @db.Text
  ownerResponseAr String?   @map("owner_response_ar") @db.Text
  ownerResponseAt DateTime? @map("owner_response_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([orderId, productId]) // one review per buyer-product pair
  @@index([productId, status])
  @@index([storeId, status])
  @@map("reviews")
}

// ==========================================
// Background jobs
// ==========================================

// Bulk product import job — queued from POST /:storeId/bulk/import,
// processed asynchronously by the Inngest `bulk-import-products`
// function so the request returns immediately and the admin can
// poll for progress instead of waiting on a long synchronous loop.
model BulkImportJob {
  id             String           @id @default(uuid())
  storeId        String           @map("store_id")
  userId         String?          @map("user_id")
  status         BulkImportStatus @default(queued)
  // Raw CSV content. Stored as text rather than referencing R2 to
  // keep the import pipeline self-contained — admin uploads are
  // small (mid-tens of MB at most) and TOAST handles it.
  csvData        String           @map("csv_data") @db.Text
  updateExisting Boolean          @default(true) @map("update_existing")
  // Progress counters — written by the Inngest function as it
  // processes rows. Polling endpoint reads these to render a
  // progress bar and final summary.
  total          Int              @default(0)
  processed      Int              @default(0)
  created        Int              @default(0)
  updated        Int              @default(0)
  failed         Int              @default(0)
  errors         Json? // Array of { row, error } once finished
  errorMessage   String?          @map("error_message") // Top-level failure reason if status=failed
  startedAt      DateTime?        @map("started_at")
  completedAt    DateTime?        @map("completed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([status])
  @@map("bulk_import_jobs")
}

enum BulkImportStatus {
  queued
  running
  completed
  failed
}

// Catalogue-wide AI sweep — translation or SEO generation across
// every product/category in a store. Started from the AI Tools admin
// page, processed by an Inngest function, polled by the same page
// for progress + final summary. The smart-skip rules from per-form
// AI buttons apply: never overwrite a filled field, never call the
// model for an entity that's already complete.
model BulkAiJob {
  id           String          @id @default(uuid())
  storeId      String          @map("store_id")
  userId       String?         @map("user_id")
  kind         BulkAiJobKind
  status       BulkAiJobStatus @default(queued)
  // Direction is meaningful only for translate jobs. `to_ar` = fill
  // empty Arabic from English source. `to_en` = the reverse.
  direction    String?         @db.Text
  total        Int             @default(0)
  processed    Int             @default(0)
  filled       Int             @default(0)
  skipped      Int             @default(0)
  failed       Int             @default(0)
  // Capped list of recent failures for surfacing to the merchant —
  // [{entityId, entityName, error}, ...]. Hard-cap to 50 so the row
  // doesn't grow unbounded on a totally-failing run.
  errors       Json?
  errorMessage String?         @map("error_message") // Top-level failure reason if status=failed
  startedAt    DateTime?       @map("started_at")
  completedAt  DateTime?       @map("completed_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([status])
  @@map("bulk_ai_jobs")
}

enum BulkAiJobKind {
  translate
  seo
  faq_aeo
  howto_aeo
  meta_aeo
  recommendations
}

enum BulkAiJobStatus {
  queued
  running
  completed
  failed
}

// Tracks every AI call made on behalf of a store so we can enforce
// per-store daily token budgets, audit usage, and bill (if/when we
// charge for it). `cachedHit=true` means the AI service returned a
// cached answer and didn't actually call the model — counted for
// observability but not against the token budget.
model AiUsage {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  feature      String // 'translate' | 'seo' | 'categorize'
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  cachedHit    Boolean  @default(false) @map("cached_hit")
  createdAt    DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([feature])
  @@map("ai_usage")
}

// ==========================================
// AEO / GEO content — FAQ + HowTo
// ==========================================

model StoreFaq {
  id             String   @id @default(cuid())
  storeId        String   @map("store_id")
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  question       String   @map("question")
  questionAr     String?  @map("question_ar")
  answer         String   @map("answer") @db.Text
  answerAr       String?  @map("answer_ar") @db.Text
  // AI-draft state — smart-skip in the Gemini bulk sweep never overwrites
  // a manually-edited entry.
  aiDrafted      Boolean  @default(false) @map("ai_drafted")
  manuallyEdited Boolean  @default(false) @map("manually_edited")
  orderIndex     Int      @default(0) @map("order_index")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([storeId, isActive, orderIndex])
  @@map("store_faqs")
}

model StoreHowto {
  id             String   @id @default(cuid())
  storeId        String   @map("store_id")
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title          String   @map("title")
  titleAr        String?  @map("title_ar")
  description    String   @map("description") @db.Text
  descriptionAr  String?  @map("description_ar") @db.Text
  // HowTo.step is an array of HowToStep — stored as JSON.
  // Format: [{ name, text, image? }, ...]
  steps          Json     @map("steps")
  // Arabic steps — same shape as steps but bilingual text values.
  stepsAr        Json?    @map("steps_ar")
  aiDrafted      Boolean  @default(false) @map("ai_drafted")
  manuallyEdited Boolean  @default(false) @map("manually_edited")
  orderIndex     Int      @default(0) @map("order_index")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([storeId, isActive, orderIndex])
  @@map("store_howtos")
}

// Per-product FAQs (e.g. "Does this ring come in size 7?") — separate
// from store-level FAQs so Product schema can include them inline.
model ProductFaq {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  question       String
  questionAr     String?  @map("question_ar")
  answer         String   @db.Text
  answerAr       String?  @map("answer_ar") @db.Text
  aiDrafted      Boolean  @default(false) @map("ai_drafted")
  manuallyEdited Boolean  @default(false) @map("manually_edited")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_faqs")
}

// ==========================================
// Accounting (Batch 1 — foundations)
// ==========================================

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum JournalEntrySource {
  order
  refund
  purchase_order
  expense
  stock_adjustment
  manual
  period_close
  opening_balance
}

enum JournalEntryStatus {
  posted
  reversed
  draft
}

model Sequence {
  // Per-store, per-kind monotonically-increasing counter. Used for entryNumber,
  // poNumber, adjustmentNumber, expenseNumber. Atomic increment via FOR UPDATE.
  storeId   String   @map("store_id")
  kind      String // 'journal' | 'po' | 'adjustment' | 'expense'
  next      Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, kind])
  @@map("sequences")
}

model Account {
  id        String      @id @default(uuid())
  storeId   String      @map("store_id")
  code      String
  nameEn    String      @map("name_en")
  nameAr    String?     @map("name_ar")
  type      AccountType
  parentId  String?     @map("parent_id")
  isSystem  Boolean     @default(false) @map("is_system")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  store              Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent             Account?        @relation("AccountTree", fields: [parentId], references: [id])
  children           Account[]       @relation("AccountTree")
  lines              JournalLine[]
  expensesByCategory Expense[]       @relation("ExpenseCategoryAccount")
  expensesPaidFrom   Expense[]       @relation("ExpensePaidFromAccount")
  purchaseOrders     PurchaseOrder[] @relation("PoApAccount")

  @@unique([storeId, code])
  @@index([storeId, type])
  @@map("accounts")
}

model JournalEntry {
  id           String             @id @default(uuid())
  storeId      String             @map("store_id")
  entryNumber  String             @map("entry_number")
  postedAt     DateTime           @map("posted_at")
  source       JournalEntrySource
  sourceId     String?            @map("source_id")
  reversedById String?            @unique @map("reversed_by_id")
  memo         String?
  memoAr       String?            @map("memo_ar")
  status       JournalEntryStatus @default(posted)
  postedBy     String?            @map("posted_by")
  createdAt    DateTime           @default(now()) @map("created_at")

  store      Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  lines      JournalLine[]
  reversedBy JournalEntry? @relation("Reversal", fields: [reversedById], references: [id])
  reverses   JournalEntry? @relation("Reversal")

  @@unique([storeId, entryNumber])
  @@index([storeId, postedAt(sort: Desc)])
  @@index([source, sourceId])
  @@index([storeId, status])
  @@map("journal_entries")
}

model JournalLine {
  id         String   @id @default(uuid())
  entryId    String   @map("entry_id")
  accountId  String   @map("account_id")
  debit      Int      @default(0)
  credit     Int      @default(0)
  currency   String   @default("KWD")
  lineMemo   String?  @map("line_memo")
  lineMemoAr String?  @map("line_memo_ar")
  refTable   String?  @map("ref_table")
  refId      String?  @map("ref_id")
  createdAt  DateTime @default(now()) @map("created_at")

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
  @@index([refTable, refId])
  @@map("journal_lines")
}

// ==========================================
// Stock + Backorders + Expenses (Batch 2)
// ==========================================

enum SupplierPaymentTerms {
  net0
  net15
  net30
  net60
  custom
}

enum PurchaseOrderStatus {
  draft
  sent
  partial
  received
  cancelled
}

enum StockAdjustmentType {
  cycle_count
  damage
  theft
  loss
  write_off
  found
  return_to_supplier
}

enum StockAdjustmentStatus {
  draft
  posted
}

enum ExpenseStatus {
  draft
  pending
  approved
  posted
  rejected
}

model Supplier {
  id              String               @id @default(uuid())
  storeId         String               @map("store_id")
  name            String
  nameAr          String?              @map("name_ar")
  contactName     String?              @map("contact_name")
  phone           String?
  email           String?
  address         Json?
  paymentTerms    SupplierPaymentTerms @default(net0) @map("payment_terms")
  customTermsDays Int?                 @map("custom_terms_days")
  defaultCurrency String               @default("KWD") @map("default_currency")
  apBalanceCached Int                  @default(0) @map("ap_balance_cached")
  isActive        Boolean              @default(true) @map("is_active")
  notes           String?
  notesAr         String?              @map("notes_ar")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchaseOrders     PurchaseOrder[]
  reorderRules       ReorderRule[]
  expenses           Expense[]
  reorderSuggestions ReorderSuggestion[]

  @@index([storeId])
  @@index([storeId, isActive])
  @@map("suppliers")
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  storeId        String              @map("store_id")
  supplierId     String              @map("supplier_id")
  poNumber       String              @map("po_number")
  status         PurchaseOrderStatus @default(draft)
  expectedDate   DateTime?           @map("expected_date")
  receivedAt     DateTime?           @map("received_at")
  subtotal       Int                 @default(0)
  taxAmount      Int                 @default(0) @map("tax_amount")
  shippingCost   Int                 @default(0) @map("shipping_cost")
  total          Int                 @default(0)
  currency       String              @default("KWD")
  apAccountId    String?             @map("ap_account_id")
  journalEntryId String?             @unique @map("journal_entry_id")
  notes          String?
  notesAr        String?             @map("notes_ar")
  createdBy      String?             @map("created_by")
  receivedBy     String?             @map("received_by")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  store     Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  apAccount Account?            @relation("PoApAccount", fields: [apAccountId], references: [id])
  items     PurchaseOrderItem[]

  @@unique([storeId, poNumber])
  @@index([storeId, status])
  @@index([supplierId])
  @@index([storeId, createdAt(sort: Desc)])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String   @id @default(uuid())
  poId        String   @map("po_id")
  productId   String   @map("product_id")
  variantId   String?  @map("variant_id")
  qty         Int
  qtyReceived Int      @default(0) @map("qty_received")
  unitCost    Int      @map("unit_cost")
  total       Int
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  po                  PurchaseOrder   @relation(fields: [poId], references: [id], onDelete: Cascade)
  product             Product         @relation(fields: [productId], references: [id])
  variant             ProductVariant? @relation(fields: [variantId], references: [id])
  backordersFulfilled BackorderLine[]

  @@index([poId])
  @@index([productId])
  @@map("purchase_order_items")
}

model StockAdjustment {
  id               String                @id @default(uuid())
  storeId          String                @map("store_id")
  adjustmentNumber String                @map("adjustment_number")
  type             StockAdjustmentType
  status           StockAdjustmentStatus @default(draft)
  reason           String?
  reasonAr         String?               @map("reason_ar")
  evidenceUrl      String?               @map("evidence_url")
  totalValueImpact Int                   @default(0) @map("total_value_impact")
  postedAt         DateTime?             @map("posted_at")
  postedBy         String?               @map("posted_by")
  journalEntryId   String?               @unique @map("journal_entry_id")
  createdBy        String?               @map("created_by")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  store Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items StockAdjustmentItem[]

  @@unique([storeId, adjustmentNumber])
  @@index([storeId, status])
  @@index([storeId, postedAt(sort: Desc)])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id           String   @id @default(uuid())
  adjustmentId String   @map("adjustment_id")
  productId    String   @map("product_id")
  variantId    String?  @map("variant_id")
  previousQty  Int      @map("previous_qty")
  newQty       Int      @map("new_qty")
  deltaQty     Int      @map("delta_qty")
  unitCost     Int      @map("unit_cost")
  createdAt    DateTime @default(now()) @map("created_at")

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])
  variant    ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([adjustmentId])
  @@index([productId])
  @@map("stock_adjustment_items")
}

model ReorderRule {
  id                  String   @id @default(uuid())
  storeId             String   @map("store_id")
  productId           String   @map("product_id")
  variantId           String?  @map("variant_id")
  minQty              Int      @map("min_qty")
  reorderQty          Int      @map("reorder_qty")
  leadTimeDays        Int      @default(7) @map("lead_time_days")
  safetyStockDays     Int      @default(7) @map("safety_stock_days")
  preferredSupplierId String?  @map("preferred_supplier_id")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  store             Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  preferredSupplier Supplier?       @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)

  @@unique([storeId, productId, variantId])
  @@index([storeId])
  @@map("reorder_rules")
}

model BackorderLine {
  id                  String    @id @default(uuid())
  storeId             String    @map("store_id")
  orderItemId         String    @map("order_item_id")
  productId           String    @map("product_id")
  variantId           String?   @map("variant_id")
  qty                 Int
  qtyFulfilled        Int       @default(0) @map("qty_fulfilled")
  fulfilledByPoItemId String?   @map("fulfilled_by_po_item_id")
  fulfilledAt         DateTime? @map("fulfilled_at")
  cancelledAt         DateTime? @map("cancelled_at")
  cancelledReason     String?   @map("cancelled_reason")
  createdAt           DateTime  @default(now()) @map("created_at")

  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItem     OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product       Product            @relation(fields: [productId], references: [id])
  variant       ProductVariant?    @relation(fields: [variantId], references: [id])
  fulfilledByPo PurchaseOrderItem? @relation(fields: [fulfilledByPoItemId], references: [id], onDelete: SetNull)

  @@index([storeId, fulfilledAt])
  @@index([productId])
  @@index([orderItemId])
  @@map("backorder_lines")
}

model Expense {
  id                   String        @id @default(uuid())
  storeId              String        @map("store_id")
  expenseNumber        String        @map("expense_number")
  supplierId           String?       @map("supplier_id")
  expenseAccountId     String        @map("expense_account_id")
  paidFromAccountId    String        @map("paid_from_account_id")
  amount               Int
  taxAmount            Int           @default(0) @map("tax_amount")
  total                Int
  currency             String        @default("KWD")
  expenseDate          DateTime      @map("expense_date")
  status               ExpenseStatus @default(draft)
  receiptImageUrl      String?       @map("receipt_image_url")
  ocrJson              Json?         @map("ocr_json")
  categoryAiConfidence Float?        @map("category_ai_confidence")
  ocrModelVersion      String?       @map("ocr_model_version")
  ocrProcessedAt       DateTime?     @map("ocr_processed_at")
  approvedBy           String?       @map("approved_by")
  approvedAt           DateTime?     @map("approved_at")
  journalEntryId       String?       @unique @map("journal_entry_id")
  postedAt             DateTime?     @map("posted_at")
  notes                String?
  notesAr              String?       @map("notes_ar")
  createdBy            String?       @map("created_by")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  store           Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  expenseAccount  Account   @relation("ExpenseCategoryAccount", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  paidFromAccount Account   @relation("ExpensePaidFromAccount", fields: [paidFromAccountId], references: [id], onDelete: Restrict)

  @@unique([storeId, expenseNumber])
  @@index([storeId, status])
  @@index([storeId, expenseDate(sort: Desc)])
  @@map("expenses")
}

// ==========================================
// Smart layer (Batch 3) — advisory tables, soft-deletable
// ==========================================

enum ReorderSuggestionStatus {
  open
  accepted
  dismissed
  expired
}

enum DeadStockFlagStatus {
  open
  accepted_clearance
  dismissed
  expired
}

enum AnomalyScope {
  store
  category
  product
}

enum AnomalyMetric {
  margin_drop
  cost_spike
  revenue_drop
  refund_spike
}

enum AnomalySeverity {
  warning
  p0
}

model ReorderSuggestion {
  id           String                  @id @default(uuid())
  storeId      String                  @map("store_id")
  productId    String                  @map("product_id")
  variantId    String?                 @map("variant_id")
  suggestedQty Int                     @map("suggested_qty")
  velocity7d   Float                   @map("velocity_7d")
  velocity28d  Float                   @map("velocity_28d")
  onHand       Int                     @map("on_hand")
  onOrder      Int                     @map("on_order")
  openBacklog  Int                     @map("open_backlog")
  urgencyDays  Int                     @map("urgency_days")
  supplierId   String?                 @map("supplier_id")
  reasoningEn  String                  @map("reasoning_en")
  reasoningAr  String?                 @map("reasoning_ar")
  status       ReorderSuggestionStatus @default(open)
  dismissedBy  String?                 @map("dismissed_by")
  dismissedAt  DateTime?               @map("dismissed_at")
  poId         String?                 @map("po_id")
  scannedAt    DateTime                @default(now()) @map("scanned_at")

  store    Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  supplier Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([storeId, productId, variantId, scannedAt])
  @@index([storeId, status, scannedAt(sort: Desc)])
  @@map("reorder_suggestions")
}

model DeadStockFlag {
  id                   String              @id @default(uuid())
  storeId              String              @map("store_id")
  productId            String              @map("product_id")
  variantId            String?             @map("variant_id")
  daysSinceSale        Int                 @map("days_since_sale")
  stockOnHand          Int                 @map("stock_on_hand")
  stockValueFils       Int                 @map("stock_value_fils")
  suggestedDiscountBps Int                 @map("suggested_discount_bps")
  clearanceCopyEn      String              @map("clearance_copy_en")
  clearanceCopyAr      String?             @map("clearance_copy_ar")
  status               DeadStockFlagStatus @default(open)
  couponCode           String?             @map("coupon_code")
  dismissedBy          String?             @map("dismissed_by")
  dismissedAt          DateTime?           @map("dismissed_at")
  scannedAt            DateTime            @default(now()) @map("scanned_at")

  store   Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId, variantId, scannedAt])
  @@index([storeId, status])
  @@map("deadstock_flags")
}

model ProfitAnomaly {
  id             String          @id @default(uuid())
  storeId        String          @map("store_id")
  scope          AnomalyScope
  scopeId        String?         @map("scope_id")
  metric         AnomalyMetric
  current7d      Float           @map("current_7d")
  baseline28d    Float           @map("baseline_28d")
  deltaPercent   Float           @map("delta_percent")
  severity       AnomalySeverity
  explanationEn  String          @map("explanation_en")
  explanationAr  String?         @map("explanation_ar")
  acknowledged   Boolean         @default(false)
  acknowledgedBy String?         @map("acknowledged_by")
  acknowledgedAt DateTime?       @map("acknowledged_at")
  detectedAt     DateTime        @default(now()) @map("detected_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, severity, detectedAt(sort: Desc)])
  @@index([storeId, acknowledged])
  @@map("profit_anomalies")
}

// ==========================================
// Insights / BI Tier (Accounting Batch 4)
// ==========================================
//
// Three nightly snapshot tables materialized by the analytics-daily-rollup
// Inngest cron (02:00 KW). All reads from existing Order / AbandonedCart /
// Product / User data — no new operational events, no journal posting.
//
// RLS: same store_id pattern as all other tenant tables (policies in migration).

enum RfmSegment {
  vip
  loyal
  potential
  new_customer
  at_risk
  hibernating
  lost
}

model CustomerCohortSnapshot {
  id              String   @id @default(uuid())
  storeId         String   @map("store_id")
  cohortMonth     String   @map("cohort_month") // 'YYYY-MM'
  periodOffset    Int      @map("period_offset")
  customersTotal  Int      @map("customers_total")
  customersActive Int      @map("customers_active")
  ordersInPeriod  Int      @map("orders_in_period")
  revenueInPeriod Int      @map("revenue_in_period")
  computedAt      DateTime @default(now()) @map("computed_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, cohortMonth, periodOffset])
  @@index([storeId, cohortMonth])
  @@map("customer_cohort_snapshots")
}

model FunnelSnapshot {
  id               String   @id @default(uuid())
  storeId          String   @map("store_id")
  periodDate       DateTime @map("period_date")
  productViews     Int      @map("product_views")
  cartsCreated     Int      @map("carts_created")
  cartItemsAdded   Int      @map("cart_items_added")
  checkoutsStarted Int      @map("checkouts_started")
  ordersCompleted  Int      @map("orders_completed")
  ordersAbandoned  Int      @map("orders_abandoned")
  revenueFils      Int      @map("revenue_fils")
  computedAt       DateTime @default(now()) @map("computed_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, periodDate])
  @@index([storeId, periodDate(sort: Desc)])
  @@map("funnel_snapshots")
}

model CustomerRfmSnapshot {
  id              String      @id @default(uuid())
  storeId         String      @map("store_id")
  customerId      String      @map("customer_id")
  isGuest         Boolean     @default(false) @map("is_guest")
  recencyDays     Int         @map("recency_days")
  frequencyOrders Int         @map("frequency_orders")
  monetaryFils    Int         @map("monetary_fils")
  rfmScore        Int         @map("rfm_score")
  segment         RfmSegment
  previousSegment RfmSegment? @map("previous_segment")
  computedAt      DateTime    @default(now()) @map("computed_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, customerId])
  @@index([storeId, segment])
  @@index([storeId, rfmScore(sort: Desc)])
  @@map("customer_rfm_snapshots")
}

/// Phase 7: FWB-driven WhatsApp template management.
/// One row per (storeId, sourceKey, language). Status updates land via
/// the WBS bridge callback at POST /api/v1/wa-bridge/templates/status.
/// The 6 canonical sourceKeys are defined in apps/api/src/lib/wa-templates/definitions.ts;
/// new sourceKeys can be added without a schema change.
model WhatsAppTemplate {
  id              String    @id @default(uuid())
  storeId         String    @map("store_id")
  sourceKey       String    @map("source_key") @db.VarChar(64)
  language        String    @db.VarChar(8)
  metaName        String    @map("meta_name") @db.VarChar(255)
  category        String    @db.VarChar(32)
  body            String    @db.Text
  status          String    @default("draft") @db.VarChar(32)
  rejectionReason String?   @map("rejection_reason") @db.Text
  metaTemplateId  String?   @map("meta_template_id") @db.VarChar(255)
  lastSyncedAt    DateTime? @map("last_synced_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, sourceKey, language])
  @@index([storeId, status])
  @@map("whatsapp_templates")
}
