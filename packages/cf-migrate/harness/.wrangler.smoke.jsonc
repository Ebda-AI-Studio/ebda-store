{
  // Local rehearsal only. Run: npx wrangler dev -c packages/cf-migrate/harness/.wrangler.smoke.jsonc --persist-to <dir> --var CUTOVER_IMPORT_SECRET:<24+ chars>
  "name": "ebda-cutover-rehearsal",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": false }],
  "durable_objects": { "bindings": [{ "name": "STORE_DO", "class_name": "StoreDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StoreDO"] }],
  "d1_databases": [
    {
      "binding": "PLATFORM",
      "database_name": "ebda-platform",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../cf-schema/migrations/platform",
    },
  ],
}
