{
  "name": "@ebda/shared",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./src/types/index.ts"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./src/utils/index.ts"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.js",
      "default": "./src/constants/index.ts"
    },
    "./brand": {
      "types": "./src/brand/index.ts",
      "default": "./src/brand/index.ts"
    },
    "./wa-me-messages": {
      "types": "./src/whatsapp/wa-me-messages.ts",
      "default": "./src/whatsapp/wa-me-messages.ts"
    },
    "./legal": {
      "types": "./src/legal/index.ts",
      "default": "./src/legal/index.ts"
    },
    "./plan-limits": {
      "types": "./src/schemas/plan-limits.ts",
      "default": "./src/schemas/plan-limits.ts"
    },
    "./tracking": {
      "types": "./src/tracking/index.ts",
      "default": "./src/tracking/index.ts"
    },
    "./tracking-browser": {
      "types": "./src/tracking/browser.ts",
      "default": "./src/tracking/browser.ts"
    },
    "./qr": {
      "types": "./src/qr/index.ts",
      "require": "./dist/qr/index.js",
      "default": "./src/qr/index.ts"
    },
    "./qr/schema": {
      "types": "./src/qr/schema.ts",
      "require": "./dist/qr/schema.js",
      "default": "./src/qr/schema.ts"
    },
    "./qr/links": {
      "types": "./src/qr/links.ts",
      "require": "./dist/qr/links.js",
      "default": "./src/qr/links.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "qr": "0.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.0.0"
  }
}
