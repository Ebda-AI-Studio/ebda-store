      "action": "tap-add-without-options"
    },
    { "id": "pdp-added", "path": "/products/linen-abaya", "action": "pick-options-and-add" },
    { "id": "cart", "path": "/cart", "action": "two-lines" },
    { "id": "cart-edit", "path": "/cart", "action": "increase-quantity" },
    { "id": "cart-remove", "path": "/cart", "action": "remove-line-with-undo" },
    { "id": "checkout-shipping", "path": "/checkout", "action": "empty" },
    { "id": "checkout-shipping-errors", "path": "/checkout", "action": "submit-empty" },
    { "id": "checkout-payment", "path": "/checkout", "action": "fill-and-continue" },
    {
      "id": "checkout-coupon-failed",
      "path": "/checkout",
