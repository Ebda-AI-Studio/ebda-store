// LOCAL ONLY (vitest-pool-workers + `wrangler dev --local`). NEVER deployed: Ruling INFRA-PREVIEW-1 forbids
// preview/staging workers, DOs, D1s, queues or buckets before launch. The same StoreDO code ships inside
// the production `ebda-api` worker (apps/api/src/cf/store-do), reachable only for one flagged demo store.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ebda-store-do-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [{ "name": "STORE_DO", "class_name": "StoreDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StoreDO"] }],
  "r2_buckets": [{ "binding": "STORE_BACKUPS", "bucket_name": "local-only-never-created" }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // Flag: empty = the DO backend serves nobody. The demo store id is set at deploy time (Task 0.4).
  "vars": { "STORE_DO_ENABLED_IDS": "" },
}
