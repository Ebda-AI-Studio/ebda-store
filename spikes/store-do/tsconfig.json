{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
    "lib": ["ES2022"]
  },
  "include": ["src", "orm", "test", "*.d.ts"],
  "exclude": ["orm/rejected/prisma-gen", "node_modules"]
}
