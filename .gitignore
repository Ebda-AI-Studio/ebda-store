# Local Worker secrets (apps/api/.dev.vars.example is the committed template)
.dev.vars

# wrangler dry-run output (apps/api cf:dry-run)
dist-cf/

# Generated deployment binding IDs; committed fallback stays local-only.
apps/api/.wrangler.deploy.jsonc
