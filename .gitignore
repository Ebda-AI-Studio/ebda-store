# Local env/file backups (e.g. .env.prebackup from reset/migration scripts) — never commit.
# .env.bak-* covers dated hand-made backups (e.g. .env.bak-20260808, which holds PROD creds).
*.prebackup
.env.bak*
# Row backups written by one-off data scripts before they write (hold prod rows).
scripts/backups/

# runtime / test artifacts (never commit — added 2026-06-08)
dump.rdb
*.rdb
/reports/
/blob-report/
.playwright/

# OpenNext / Cloudflare build artifacts — keep these ignored (build outputs, not source)
.open-next/
.wrangler/

# NOTE: apps/*/open-next.config.ts and apps/*/wrangler.jsonc are now COMMITTED
# (secret-clean — zero vars, routes only) so CF Workers Builds (Git-connected deploys)
# can read them directly from the repo. Only the build OUTPUT dirs above stay ignored.

# per-session subagent-driven-development scratch
.superpowers/

# Session-local handoff artifacts written by the agent OS (never committed).
# Sibling of handoff.md, which .prettierignore already exempts.
.handoff/

# Ebda static sites / status worker
apps/docs/.generated/
apps/status/.gate/
apps/status/dist/
