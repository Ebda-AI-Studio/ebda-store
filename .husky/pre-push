#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-push CI gate (active while GitHub Actions billing is suspended).
# Runs lint + typecheck + unit tests locally; blocks the push on failure.
# Also runs the existing DB backup on main (non-blocking, preserved).

set -e

# pre-push gets '<local ref> <local sha> <remote ref> <remote sha>' lines on stdin; capture before anything else reads it.
PUSH_REFS=""
[ -t 0 ] || PUSH_REFS=$(cat)

current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# DB backup -- only on main, non-blocking (preserved from original hook)
if [ "$current_branch" = "main" ]; then
  if [ -x scripts/backup-db.sh ]; then
    echo "-> pre-push: capturing local Neon dump before pushing to main"
    if ! bash scripts/backup-db.sh; then
      echo "! pre-push: local backup FAILED -- pushing anyway. NO snapshot covers this push:"
      echo "  neon-snapshot.yml's push trigger was retired 2026-06-08. Cover is the nightly"
      echo "  db-backup.yml (R2) + Neon PITR. Read the error above; do not ignore it."
    fi
  else
    echo "! pre-push: scripts/backup-db.sh not executable; skipping local DB backup"
  fi
fi

echo "-> Ebda pre-push CI gate: cheap checks + affected lint/typecheck/related tests, full gate when the planner cannot narrow (one at a time, host-wide)"

# Worktrees created by new-task-worktree.sh have no node_modules of their own, so
# every command below exits 127 ("command not found") and husky aborts the push
# with no usable explanation. That silently stranded 8 agent worktrees / 16 real
# commits for ~4 weeks (audit 2026-07-20) — the work wasn't abandoned, it was
# unpushable. Fail loudly with the fix on main; skip advisorily off main, where
# CI is still the real gate.
if [ ! -d node_modules ]; then
  if [ "$current_branch" = "main" ]; then
    echo "! pre-push: node_modules missing — cannot run the gate on main."
    echo "  Run 'npm ci' here, or push from a checkout that has dependencies installed."
    exit 1
  fi
  echo "! pre-push: node_modules missing (likely a fresh worktree) — SKIPPING the local gate."
  echo "  CI still gates this branch on the PR. To run it locally: npm ci"
  exit 0
fi

# The whole heavy gate (cheap checks first, then lockfile, prisma, build, lint, typecheck, unit tests) runs inside ONE
# hold of the host lock: ONE worktree's gate at a time on this Mac. It queues and never skips (2026-10-25: load 30
# because tsc/prettier/lint from several worktrees ran in parallel outside the lock). Same file as the manual rule
# `lockf -k ~/.claude/locks/heavy-test.lock <cmd>`. The advisory AI/blast-radius steps below run AFTER the lock is released.
bash scripts/ci/host-lock.sh bash scripts/ci/pre-push-gate.sh

# --- Blast-radius + AI review: ALSO run locally before push (still run in CI too) ---
# Corrected 2026-09-02 (adversarial audit): this used to claim blast-radius.yml /
# scoped-audit.yml / ai-review.yml "moved OUT of CI" — false, verified all three still
# trigger on `pull_request` in .github/workflows/. They run TWICE per PR: once here
# (advisory, local) and once in CI (none of the three are required branch-protection
# checks). This local pass is a fast local preview, not a CI replacement. Advisory +
# non-blocking. Skip: SKIP_AI_GATE=1.
if [ "${SKIP_AI_GATE:-0}" != "1" ] && [ "$current_branch" != "main" ]; then
  git fetch origin main -q 2>/dev/null || true
  RANGE="origin/main...HEAD"

  echo "-> AI-OS gate: blast-radius (graphify dependents of this diff, advisory)..."
  if [ -x scripts/blast-radius.sh ]; then
    bash scripts/blast-radius.sh ebda "$RANGE" . || echo "! blast-radius advisory failed (non-blocking)"
  else
    echo "! scripts/blast-radius.sh missing; skipping blast-radius"
  fi

  # AI review (advisory, never blocks, never silent): reviews only the commits being pushed (remote ref..HEAD), in chunks under
  # a size cap, Opus for chunks touching critical paths (money, auth/identity, secrets, consent/erasure, tenancy, migrations,
  # CI/hooks), Sonnet otherwise (AI_REVIEW_MODEL=opus|sonnet forces one). Unreviewed files get a LOUD warning + a log.
  # Logic lives in scripts/ci/pre-push-ai-review.sh.
  review_range="$RANGE"
  push_line=$(printf '%s\n' "$PUSH_REFS" | awk -v b="refs/heads/$current_branch" '$3==b {print; exit}')
  if [ -n "$push_line" ]; then
    local_sha=$(printf '%s' "$push_line" | awk '{print $2}')
    remote_sha=$(printf '%s' "$push_line" | awk '{print $4}')
    case "$remote_sha" in *[!0]*) [ -n "$remote_sha" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null && review_range="$remote_sha..$local_sha" ;; esac
    # New branch (remote sha all zeros) or unknown remote sha: commits not already on origin/main.
    [ "$review_range" = "$RANGE" ] && review_range="origin/main..$local_sha"
  fi
  bash scripts/ci/pre-push-ai-review.sh "$review_range" "$current_branch" || echo "! AI review script errored (non-blocking)"
fi

echo "OK pre-push CI gate passed -- push proceeding"
