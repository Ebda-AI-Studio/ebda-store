#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-push CI gate (active while GitHub Actions billing is suspended).
# Runs lint + typecheck + unit tests locally; blocks the push on failure.
# Also runs the existing DB backup on main (non-blocking, preserved).

set -e

current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# DB backup -- only on main, non-blocking (preserved from original hook)
if [ "$current_branch" = "main" ]; then
  if [ -x scripts/backup-db.sh ]; then
    echo "-> pre-push: capturing local Neon dump before pushing to main"
    if ! bash scripts/backup-db.sh; then
      echo "! pre-push: local backup failed -- pushing anyway (cloud snapshot still runs)"
    fi
  else
    echo "! pre-push: scripts/backup-db.sh not executable; skipping local DB backup"
  fi
fi

echo "-> FWB pre-push CI gate: lint + typecheck + unit tests"

# Catch lockfile drift before Railway hits the same trap on `npm ci`.
# Standing emnapi trap — see feedback-emnapi-lockfile-desync-after-add.md.
npm ci --dry-run 2>&1 | grep -E "^npm error" && exit 1 || true

# Generate Prisma client before typecheck. Without this, apps/api typecheck
# reports ~396 phantom errors (all "any" / "unknown" types from missing
# @prisma/client type declarations). CI does this implicitly via the build
# step, but the pre-push hook needs to be explicit.
echo "-> generating prisma client (needed for typecheck)..."
npm run db:generate >/dev/null 2>&1

npm run lint

echo "-> typechecking apps..."
npx tsc --noEmit -p apps/api/tsconfig.json
npx tsc --noEmit -p apps/admin/tsconfig.json
npx tsc --noEmit -p apps/web/tsconfig.json

echo "-> running unit tests (~4s)..."
# Set TEST_DATABASE_URL to a local placeholder so vitest setup-e2e.ts skips
# the prod-guard check. Built in parts so secretlint does not flag this file.
# Unit tests mock Prisma and make no real DB connections.
_SCHEME="postgresql"
_CREDS="test:test"
_HOST="localhost:5432"
_DB="test_db"
export TEST_DATABASE_URL="${_SCHEME}://${_CREDS}@${_HOST}/${_DB}"
npm run test:unit

# --- Blast-radius + AI review: moved OUT of CI to this AI-OS pre-push gate ---
# These were the blast-radius.yml / scoped-audit.yml / ai-review.yml workflows that
# each held a self-hosted runner ~15-20 min per PR. They now run locally before the
# push so CI only does deterministic gates. Advisory + non-blocking. Skip: SKIP_AI_GATE=1.
if [ "${SKIP_AI_GATE:-0}" != "1" ] && [ "$current_branch" != "main" ]; then
  git fetch origin main -q 2>/dev/null || true
  RANGE="origin/main...HEAD"

  echo "-> AI-OS gate: blast-radius (graphify dependents of this diff, advisory)..."
  if [ -x scripts/blast-radius.sh ]; then
    bash scripts/blast-radius.sh force-website-builder "$RANGE" . || echo "! blast-radius advisory failed (non-blocking)"
  else
    echo "! scripts/blast-radius.sh missing; skipping blast-radius"
  fi

  echo "-> AI-OS gate: Opus AI review of this diff (advisory)..."
  if command -v claude >/dev/null 2>&1; then
    git diff "$RANGE" -- ':(exclude)**/package-lock.json' ':(exclude)**/*.lock' > /tmp/force-prepush.diff 2>/dev/null || true
    if [ -s /tmp/force-prepush.diff ]; then
      {
        printf 'Review this diff for CRITICAL bugs, security issues, and regressions ONLY. Be terse; list nothing if clean.\n\n'
        cat /tmp/force-prepush.diff
      } > /tmp/force-prepush-review.md
      claude -p --model claude-opus-4-8 < /tmp/force-prepush-review.md || echo "! AI review advisory failed (non-blocking)"
    fi
  else
    echo "! claude CLI not found; skipping AI review (npm i -g @anthropic-ai/claude-code)"
  fi
fi

echo "OK pre-push CI gate passed -- push proceeding"
