#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-push gate, MAC-LIGHT-1: light. Runs only the fast checks (action pins, gitleaks on the push range, prettier on
# changed files) via scripts/ci/pre-push-gate.sh; lint/typecheck/tests run in GitHub CI.
# Also runs the existing DB backup on main (non-blocking, preserved).

set -e

# pre-push gets '<local ref> <local sha> <remote ref> <remote sha>' lines on stdin; capture before anything else reads it.
PUSH_REFS=""
[ -t 0 ] || PUSH_REFS=$(cat)

current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# DB backup -- only on main, non-blocking (preserved from original hook)
if [ "$current_branch" = "main" ]; then
  if [ -x scripts/backup-db.sh ]; then
    echo "-> pre-push: capturing local Neon dump before pushing to main"
    if ! bash scripts/backup-db.sh; then
      echo "! pre-push: local backup FAILED -- pushing anyway. NO snapshot covers this push:"
      echo "  neon-snapshot.yml's push trigger was retired 2026-06-08. Cover is the nightly"
      echo "  cf-backup.yml (R2) + D1 Time Travel / StoreDO PITR. Read the error above; do not ignore it."
    fi
  else
    echo "! pre-push: scripts/backup-db.sh not executable; skipping local DB backup"
  fi
fi

echo "-> Ebda pre-push light gate (MAC-LIGHT-1): secret scan + format only; CI runs lint/typecheck/tests"

# Worktrees created by new-task-worktree.sh have no node_modules of their own, so
# every command below exits 127 ("command not found") and husky aborts the push
# with no usable explanation. That silently stranded 8 agent worktrees / 16 real
# commits for ~4 weeks (audit 2026-07-20) — the work wasn't abandoned, it was
# unpushable. Fail loudly with the fix on main; skip advisorily off main, where
# CI is still the real gate.
if [ ! -d node_modules ]; then
  if [ "$current_branch" = "main" ]; then
    echo "! pre-push: node_modules missing — cannot run the gate on main."
    echo "  Run 'npm ci' here, or push from a checkout that has dependencies installed."
    exit 1
  fi
  echo "! pre-push: node_modules missing (likely a fresh worktree) — SKIPPING the local gate."
  echo "  CI still gates this branch on the PR. To run it locally: npm ci"
  exit 0
fi

# The whole heavy gate (cheap checks first, then lockfile, prisma, build, lint, typecheck, unit tests) runs inside ONE
# hold of the host lock: ONE worktree's gate at a time on this Mac. It queues and never skips (2026-10-25: load 30
# because tsc/prettier/lint from several worktrees ran in parallel outside the lock). Same file as the manual rule
# `lockf -k ~/.claude/locks/heavy-test.lock <cmd>`. The advisory AI/blast-radius steps below run AFTER the lock is released.
bash scripts/ci/host-lock.sh bash scripts/ci/pre-push-gate.sh

# Local blast-radius + AI review REMOVED (Ahmad 2026-11-05, Ruling PREPUSH-AI-OFF-1): both run in CI on every PR
# (blast-radius.yml, ai-review.yml); the local copies only duplicated them and queued every push 30-60 min.

echo "OK pre-push CI gate passed -- push proceeding"
