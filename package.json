{
  "name": "force-website-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Force Media E-Commerce Website Builder Platform - A multi-tenant SaaS e-commerce solution",
  "author": "Force Media <contact@forcemediakw.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/ForceAI-KW/force-website-builder",
  "repository": {
    "type": "git",
    "url": "https://github.com/ForceAI-KW/force-website-builder.git"
  },
  "bugs": {
    "url": "https://github.com/ForceAI-KW/force-website-builder/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:orders": "npm run dev -w apps/orders",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build:admin": "npm run build -w apps/admin",
    "build:orders": "npm run build -w apps/orders",
    "start": "npm run start --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "TEST_DATABASE_URL=sqlite://placeholder vitest run tests/unit/contract-wbs-bridge.test.ts",
    "test:e2e": "vitest run tests/e2e",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=junit --outputFile=test-results.xml",
    "test:ui": "vitest --ui",
    "test:smoke": "playwright test",
    "test:smoke:install": "playwright install --with-deps chromium",
    "test:smoke:report": "playwright show-report",
    "test:load": "bash loadtests/run.sh lens-n-medium-traffic",
    "ai:eval": "tsx tests/ai-eval/live.eval.ts",
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/database/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/admin/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/orders/tsconfig.json",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "db:generate": "npm run generate -w packages/database",
    "db:migrate": "npm run migrate -w packages/database",
    "db:push": "npm run push -w packages/database",
    "db:seed": "npm run seed -w packages/database",
    "db:studio": "npm run studio -w packages/database",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "deploy": "npm run build && pm2 reload ecosystem.config.js --env production",
    "prepare": "husky || true",
    "commitlint": "commitlint --edit",
    "secrets": "secretlint --maskSecrets '**/*'",
    "audit:strict": "npm audit --audit-level=low"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "1.60.0",
    "@secretlint/secretlint-rule-preset-recommend": "^12.0.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^20.10.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.8.4",
    "prisma": "^6.19.3",
    "secretlint": "^12.0.0",
    "supertest": "^7.2.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.0.18",
    "zod": "^3.22.4"
  },
  "lint-staged": {
    "*": [
      "secretlint"
    ],
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.6",
    "postcss": "^8.5.10",
    "protobufjs": "8.6.3",
    "ws": "^8.20.1",
    "tmp": "0.2.7",
    "uuid": "^11.1.1",
    "js-yaml": "4.3.0",
    "nodemailer": "9.0.1",
    "dompurify": "3.4.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.35.3",
    "fast-uri": "^3.1.4",
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "glob": {
      "brace-expansion": "^1.1.16"
    },
    "rimraf": {
      "brace-expansion": "^2.1.2"
    },
    "readdir-glob": {
      "brace-expansion": "^2.1.2"
    },
    "exceljs": {
      "uuid": "^11.1.1",
      "tmp": "0.2.7"
    },
    "next": {
      "postcss": "^8.5.10"
    },
    "@lhci/cli": {
      "uuid": "^11.1.1",
      "tmp": "0.2.7",
      "inquirer": ">=9.3.7",
      "external-editor": ">=3.1.0",
      "qs": ">=6.13.0",
      "typed-rest-client": ">=2.1.0"
    }
  },
  "dependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@prisma/client": "^6.19.3"
  },
  "optionalDependencies": {
    "@parcel/watcher-linux-x64-glibc": "^2.5.6",
    "@parcel/watcher-linux-x64-musl": "^2.5.6"
  }
}
