{
  "name": "ebda-store",
  "version": "1.0.0",
  "private": true,
  "description": "Ebda Store by Ebda AI Studio — self-serve e-commerce platform for Egypt",
  "author": "Ebda AI Studio <ahlan@ebda.app>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/Whisky-11/ebda-store",
  "repository": {
    "type": "git",
    "url": "https://github.com/Whisky-11/ebda-store.git"
  },
  "bugs": {
    "url": "https://github.com/Whisky-11/ebda-store/issues"
  },
  "engines": {
    "node": ">=20.3.0",
    "npm": ">=9.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:orders": "npm run dev -w apps/orders",
    "dev:marketing": "npm run dev -w apps/marketing",
    "dev:status": "npm run dev -w apps/status",
    "test:status": "npm run test -w apps/status",
    "test:accounts": "npm run test -w apps/accounts",
    "test:repo-workers": "npm run cf:test -w packages/repo",
    "test:api-workers": "npm run cf:test -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build:admin": "npm run build -w apps/admin",
    "build:orders": "npm run build -w apps/orders",
    "build:marketing": "npm run build -w apps/marketing",
    "build:docs": "npm run build -w apps/docs",
    "build:help": "npm run build -w apps/help",
    "build:status": "npm run build -w apps/status",
    "build:accounts": "npm run build -w apps/accounts",
    "start": "npm run start --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "vitest run",
    "test:card-overflow": "node scripts/visual/measure-card-overflow.mjs",
    "test:fixed-bars": "node scripts/visual/measure-fixed-bars.mjs",
    "test:defence-mutations": "node scripts/defence-mutation-record.mjs",
    "check:clear-on-empty": "node scripts/check-update-payload-clear.mjs",
    "check:admin-i18n": "node scripts/check-admin-i18n-literals.mjs",
    "test:unit": "vitest run tests/unit",
    "ai:cost:baseline": "tsx scripts/ai-cost-baseline.ts",
    "test:e2e": "vitest run tests/e2e",
    "editor:matrix": "EDITOR_MATRIX_WRITE=1 vitest run tests/unit/editor-matrix.test.ts tests/unit/visual-editor-parity.test.ts",
    "editor:matrix:check": "vitest run tests/unit/editor-matrix.test.ts tests/unit/visual-editor-parity.test.ts tests/unit/editor-audit-manifest.test.ts tests/unit/editor-audit-classify.test.ts",
    "test:editor-live": "playwright test -c playwright.editor-live.config.ts",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=junit --outputFile=test-results.xml",
    "test:ui": "vitest --ui",
    "test:smoke": "playwright test",
    "test:smoke:install": "playwright install --with-deps chromium",
    "test:smoke:report": "playwright show-report",
    "test:load": "bash loadtests/run.sh lens-n-medium-traffic",
    "ai:eval": "tsx tests/ai-eval/live.eval.ts",
    "search:eval": "tsx tests/search-eval/run.ts",
    "cf:erasure-registry": "node scripts/cf/gen-erasure-registry.mjs",
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/database/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p packages/cf-schema/tsconfig.json && tsc --noEmit -p packages/repo/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/admin/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/orders/tsconfig.json && tsc --noEmit -p apps/marketing/tsconfig.json && tsc --noEmit -p apps/status/tsconfig.json && tsc --noEmit -p apps/accounts/tsconfig.json && tsc --noEmit -p tests/search-eval/tsconfig.json",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "db:generate": "npm run generate -w packages/database",
    "db:migrate": "npm run migrate -w packages/database",
    "db:push": "npm run push -w packages/database",
    "db:seed": "npm run seed -w packages/database",
    "db:studio": "npm run studio -w packages/database",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "deploy": "npm run build && pm2 reload ecosystem.config.js --env production",
    "prepare": "husky || true",
    "commitlint": "commitlint --edit",
    "secrets": "secretlint --maskSecrets '**/*'",
    "audit:strict": "npm audit --audit-level=low",
    "check:zap-review-dates": "node scripts/check-zap-review-dates.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "1.60.0",
    "@resvg/resvg-js": "^2.6.2",
    "@secretlint/secretlint-rule-preset-recommend": "^12.0.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.10.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "path-to-regexp": "^6.3.0",
    "prettier": "3.8.4",
    "prisma": "^6.19.3",
    "secretlint": "^12.0.0",
    "supertest": "^7.2.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.12",
    "zod": "^4.6.7",
    "zxing-wasm": "^3.1.6"
  },
  "lint-staged": {
    "*": [
      "secretlint"
    ],
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.6",
    "postcss": "^8.5.23",
    "protobufjs": "8.7.1",
    "@hono/node-server": "^2.0.5",
    "brace-expansion": "5.0.12",
    "ws": "^8.20.1",
    "@grpc/grpc-js": "^1.14.5",
    "tmp": "0.2.7",
    "uuid": "^11.1.1",
    "js-yaml": "4.3.2",
    "nodemailer": "10.2.1",
    "dompurify": "3.4.17",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.35.3",
    "fast-uri": "3.1.9",
    "miniflare": {
      "undici": "7.30.1"
    },
    "chromium-bidi": {
      "zod": "4.6.7"
    },
    "inngest": {
      "zod": "4.6.7"
    },
    "@cloudflare/vitest-pool-workers": {
      "zod": "4.6.7"
    },
    "nanoid": "3.3.18",
    "magicast": "0.5.5",
    "hono": "4.13.14",
    "ip-address": "10.7.5",
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "rimraf": {
      "brace-expansion": "5.0.12"
    },
    "readdir-glob": {
      "brace-expansion": "5.0.12"
    },
    "exceljs": {
      "uuid": "^11.1.1",
      "tmp": "0.2.7"
    },
    "next": {
      "postcss": "^8.5.23"
    },
    "@lhci/cli": {
      "lighthouse": "13.5.0"
    },
    "minimatch": "^11.0.4",
    "deepmerge-ts": "^8.0.0",
    "qs": "6.16.2",
    "wrangler": "4.116.0",
    "basic-ftp": "6.2.2",
    "systeminformation": "5.33.18",
    "postcss-selector-parser": "7.1.6",
    "@lhci/utils": {
      "lighthouse": "13.5.0"
    },
    "glob@9.3.5": "^14.0.3",
    "glob@^12.0.0": "^14.0.3",
    "glob@^13.0.6": "^14.0.3",
    "glob@11.1.0": "^14.0.3",
    "glob@^10.3.7": "^14.0.3"
  },
  "dependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@prisma/client": "^6.19.3"
  },
  "optionalDependencies": {
    "@parcel/watcher-linux-x64-glibc": "^2.5.6",
    "@parcel/watcher-linux-x64-musl": "^2.5.6"
  }
}
