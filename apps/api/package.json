{
  "name": "@ebda/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf dist node_modules",
    "cf:dev": "node ../../scripts/cf-api-local-config.mjs && wrangler dev --config .wrangler.local.jsonc",
    "cf:dev:ai": "wrangler dev",
    "cf:dry-run": "wrangler deploy --dry-run --outdir dist-cf",
    "cf:test": "npm run cf:dry-run && vitest run --config vitest.workers.config.mts",
    "cf:test:do": "vitest run --config vitest.workers-do.config.mts",
    "cf:exit-test": "node scripts/stage1-exit-test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1039.0",
    "@aws-sdk/s3-request-presigner": "^3.1039.0",
    "@axiomhq/pino": "^1.6.1",
    "@cantoo/pdf-lib": "2.11.1",
    "@ebda/database": "*",
    "@ebda/shared": "*",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/client": "^6.19.3",
    "@sentry/cloudflare": "^10.53.1",
    "@sentry/node": "^10.51.0",
    "@sentry/profiling-node": "^10.51.0",
    "@simplewebauthn/server": "^14.0.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.4.1",
    "fflate": "0.8.3",
    "helmet": "^8.1.0",
    "imapflow": "^1.3.3",
    "ioredis": "^5.8.2",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "otplib": "^12.0.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.6.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.0.0",
    "wrangler": "4.116.0"
  }
}
