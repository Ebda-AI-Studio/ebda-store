// The Ebda API on Cloudflare Workers (R-EBDA-001, docs/ebda/design/cloudflare-backend.md).
// Express runs through `httpServerHandler` (`cloudflare:node`, nodejs_compat); each request
// leases a pooled Prisma client (packages/database/src/client-pool.ts) and its own pg
// connections over Hyperdrive. NO SECRETS HERE: local secrets live in
// `.dev.vars` (see `.dev.vars.example`), deployed ones in `wrangler secret put`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ebda-api",
  "main": "src/worker.ts",
  "routes": [
    { "pattern": "api.ebda.app", "custom_domain": true },
    { "pattern": "api.ebda.app/*", "zone_name": "ebda.app" },
  ],
  // Pinned to what the pinned wrangler's workerd supports (4.116.0 rejects 2026-09-01).
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // Minified bundle (Ruling BUNDLE-BUDGET-4). `upload_source_maps` keeps Workers Observability stack
  // traces readable; wrangler keeps function/class names (keep_names default).
  "minify": true,
  // No `__name(fn, "name")` wrapper per function/class (Ruling BUNDLE-BUDGET-5): -243 KB. Nothing in first-party code reads
  // `fn.name` / `constructor.name` (grepped); DO and entrypoint exports keep their export names; stack traces never used it.
  "keep_names": false,
  "upload_source_maps": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Workers Trace Events Logpush (G7); the job to R2 is created by scripts/ops/cf-logs-setup.sh
  "logpush": true,
  // Queue-run background jobs (src/lib/jobs) hold one database context for a whole sweep; the default
  // 30 s of CPU is too tight for the retention/export ones. A cap, billed only on use.
  "limits": { "cpu_ms": 120000 },
  // NO Smart Placement (tried 2026-10-22, PR #136, reverted): it placed the Worker at EWR
  // (`cf-placement: remote-EWR`) and API KV-hit calls got slower (median 1.2 s -> 2.3 s, n=6).
  // The serial Frankfurt/DO hops are the cost; fix them by removing hops, not by moving the Worker.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Hyperdrive in front of Neon. QUERY CACHING MUST STAY OFF: a cached read is keyed on SQL text
  // and parameters, not on the tenant GUC, so caching could serve one store's rows to another
  // (design section 3). It is a property of the Hyperdrive CONFIG, not of this file: create it with
  // `scripts/cf-hyperdrive-create.sh` (`--caching-disabled`). `localConnectionString` is
  // `wrangler dev` / tests only: the local API role (`ebda_app`, NOBYPASSRLS) through pgbouncer
  // in transaction mode, which is what Hyperdrive's pooler looks like to the Worker. The password is
  // the repo-wide fake dev one (`ci-only-app-pw`, the CI role step and tests/integration/rls-*.test.ts):
  // roles are cluster-wide, so a different one here would be reset by the next test run.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Placeholder: replace with the id `wrangler hyperdrive create` prints, per environment.
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://ebda_app:ci-only-app-pw@127.0.0.1:6433/ebda_s1",
    },
  ],

  // Public caches (store / product payloads). Placeholder ids: `wrangler kv namespace create`.
  "kv_namespaces": [{ "binding": "KV_CACHE", "id": "00000000000000000000000000000000" }],

  "durable_objects": {
    "bindings": [
      // Token denylist, token versions, MFA / lockout counters, auth rate limits.
      { "name": "AUTH_STATE", "class_name": "AuthState" },
      // One per store: admin realtime over hibernating WebSockets.
      { "name": "STORE_REALTIME", "class_name": "StoreRealtime" },
      // One per store: the SQLite store (Ruling INFRA-CF-1, Phase 0 spike). Reachable only for a store whose D1
      // stores.storage_backend is 'do' (lib/store-backend.ts, Ruling CF-BACKEND-1); no request header selects it.
      { "name": "STORE_DO", "class_name": "StoreDO" },
      // Concurrency leases and debounce for background jobs (G5, src/cf/job-gate.ts): one per function + key.
      { "name": "JOB_GATE", "class_name": "JobGate" },
      // One per store: its recurring jobs as an alarm (G5, src/cf/store-schedule.ts).
      { "name": "STORE_SCHEDULE", "class_name": "StoreSchedule" },
    ],
  },
  // StoreDO nightly backups (Ruling INFRA-CF-1 Phase 0): the EXISTING private bucket, prefix store-do-backups/.
  // No new bucket (Ruling INFRA-PREVIEW-1).
  "r2_buckets": [
    { "binding": "STORE_BACKUPS", "bucket_name": "ebda-private" },
    // Customer Intelligence (CI-1): the source of truth for commerce outcomes. PRIVATE, 24-month
    // lifecycle on outcomes/ (scripts/ops/ci-r2-lifecycle.sh). Create it before the first deploy.
    { "binding": "CI_BUCKET", "bucket_name": "ebda-ci" },
  ],
  // Product vectors of the stores on their Durable Object (Ruling CF-VEC-1): 1024 dims, cosine, namespace = store id, created
  // in the the Whisky 11 / personal Cloudflare account. The DO product indexer and the storefront vector leg use it; without it a
  // DO store falls back to keyword search. A store on Postgres keeps halfvec (`product_embeddings`).
  "vectorize": [{ "binding": "PRODUCT_VECTORS", "index_name": "ebda-product-vectors" }],
  // Customer Intelligence dashboards: one point per outcome, no buyer key, no order id (lib/ci/sink.ts).
  "analytics_engine_datasets": [{ "binding": "CI_OUTCOMES", "dataset": "ebda_commerce_outcomes" }],

  // Storefront cache purge (POST /api/revalidate on ebda-web) over a Service Binding, not a
  // public hostname: no host to keep pointed at the storefront wildcard, no public hop
  // (Ruling HOST-STORE-1; store.ebda.app is the merchant app now). See lib/revalidate-storefront.ts.
  "services": [
    { "binding": "STOREFRONT", "service": "ebda-web" },
    // The shared identity service (Rulings ID-1/ID-2): JWKS over fetch, isRevoked/getAccountState/... over RPC.
    { "binding": "ACCOUNTS", "service": "ebda-accounts", "entrypoint": "Accounts" },
  ],

  // Outbound email (G6, Ruling INFRA-CF-1): Cloudflare Email Service, sender domain ebda.app
  // (onboarded 2026-10-24; DKIM/SPF live on cf-bounce.ebda.app). No API key. services/mail-transport.ts.
  "send_email": [{ "name": "EMAIL" }],

  // Workers AI: search embeddings only (@cf/baai/bge-m3, apps/api/src/lib/search/embedding-provider.ts).
  // No id; billed per input token to the account the Worker deploys to (Whisky, 69188202...). AI
  // bindings always run remotely, so the workerd smoke (wrangler dev --local) boots a copy WITHOUT
  // this line (scripts/ci/workerd-smoke.mjs `stripAiBinding`). Semantic search itself stays off
  // until SEARCH_SEMANTIC_ENABLED=true (docs/ENVIRONMENT.md).
  "ai": { "binding": "AI" },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AuthState", "StoreRealtime"] },
    { "tag": "v2", "new_sqlite_classes": ["StoreDO"] },
    { "tag": "v3", "new_sqlite_classes": ["JobGate"] },
    { "tag": "v4", "new_sqlite_classes": ["StoreSchedule"] },
  ],

  // Background jobs (G5, src/lib/jobs): one Workflow class runs every multi-step job, one instance
  // per run. The binding creates instances (src/lib/jobs/start.ts).
  "workflows": [{ "name": "ebda-jobs", "binding": "JOBS_WORKFLOW", "class_name": "JobWorkflow" }],

  "queues": {
    "producers": [
      // Store -> Ebda WhatsApp events (contract 2026-10-24; lib/wa/events.ts). Ebda WhatsApp consumes it.
      { "binding": "WA_EVENTS_QUEUE", "queue": "ebda-wa-events" },
      { "binding": "JOBS_QUEUE", "queue": "ebda-jobs" },
      // Customer Intelligence capture (lib/ci/port.ts): validated commerce_outcomes envelopes.
      { "binding": "CI_EVENTS_QUEUE", "queue": "ebda-ci-events" },
      { "binding": "EMAIL_QUEUE", "queue": "ebda-email" },
      { "binding": "SMS_QUEUE", "queue": "ebda-sms" },
    ],
    "consumers": [
      // At-least-once with retries, then the dead-letter queue. The DLQ consumers park the
      // message where the super-admin replay pages read it.
      {
        "queue": "ebda-email",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 3,
        "retry_delay": 5,
        "dead_letter_queue": "ebda-email-dlq",
      },
      {
        "queue": "ebda-sms",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 3,
        "retry_delay": 5,
        "dead_letter_queue": "ebda-sms-dlq",
      },
      { "queue": "ebda-email-dlq", "max_batch_size": 10, "max_retries": 2 },
      // WhatsApp -> Store events (COD outcomes, erasure races): lib/wa/store-events-consumer.ts.
      {
        "queue": "ebda-store-events",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "retry_delay": 5,
        "dead_letter_queue": "ebda-store-events-dlq",
      },
      { "queue": "ebda-store-events-dlq", "max_batch_size": 10, "max_retries": 2 },
      // Background jobs with at most one step. The job's own `retries` (max 6 in the map) decide when
      // a run fails for good, so the platform limit sits above it and only a crash loop reaches the DLQ.
      {
        "queue": "ebda-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "max_concurrency": 10,
        "dead_letter_queue": "ebda-jobs-dlq",
      },
      { "queue": "ebda-jobs-dlq", "max_batch_size": 1, "max_retries": 2 },
      // Customer Intelligence sink (lib/ci/sink.ts): R2 + Analytics Engine. 25 per batch keeps the
      // Analytics Engine writes of one invocation small; an unreadable event retries into the DLQ (pages).
      {
        "queue": "ebda-ci-events",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 5,
        "dead_letter_queue": "ebda-ci-events-dlq",
      },
      { "queue": "ebda-ci-events-dlq", "max_batch_size": 10, "max_retries": 2 },
      { "queue": "ebda-sms-dlq", "max_batch_size": 10, "max_retries": 2 },
    ],
  },

  // Coarse per-IP flood guard in front of Express (Workers Rate Limiting binding; approximate,
  // per location). Auth limits (5 / 15 min per IP + email) are exact, on the AuthState DO.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 1200, "period": 60 } },
    // Anonymous public reads only (middleware/public-read-limit.ts): same numbers as the exact
    // Durable Object limiters (publicLimiter 300/min/IP, publicTenantLimiter 6000/min/tenant),
    // but counted per location. Authenticated requests and every write keep the exact DO limiters.
    {
      "name": "PUBLIC_IP_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "PUBLIC_TENANT_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 6000, "period": 60 },
    },
  ],

  // Scheduled work that used to be setInterval loops (index.ts, Node only): see src/cf/cron.ts.
  "triggers": {
    // The four legacy loops (src/cf/cron.ts CRON_SCHEDULE) plus every former Inngest schedule, now
    // Cloudflare (G5, src/lib/jobs/schedule.ts: a Cairo-time cron appears twice, winter and summer
    // UTC, and is guarded by the real local time). tests/unit/jobs-schedule.test.ts pins this list
    // to the code. Budget rule: nothing under 30 minutes except the pre-existing */15 cart sweep.
    "crons": [
      "*/15 * * * *",
      "*/30 * * * *",
      "0 * * * *",
      "0 */12 * * *",
      "0 */4 * * *",
      "0 */6 * * *",
      "0 0 * * *",
      "0 2 * * MON",
      "0 2 1 * *",
      "0 22 * * *",
      "0 23 * * *",
      "0 3 * * *",
      "0 3 * * SUN",
      "0 3 1 * *",
      "0 4 * * *",
      "0 4 * * SUN",
      "0 7 * * *",
      "17 * * * *",
      "17 */6 * * *",
      "30 22 * * *",
      "30 23 * * *",
      "30 3 * * *",
      "30 3 1 * *",
      "30 4 * * *",
      "41 */12 * * *",
      "45 4 * * *",
      "5 */6 * * *",
      "7 * * * *",
      "7,37 * * * *",
    ],
  },

  // Node-only packages replaced by Workers-native code or stubbed (see src/cf/stubs/*).
  "alias": {
    "ioredis": "./src/cf/stubs/ioredis.ts",
    // Rulings BUNDLE-BUDGET-5/6. exceljs resolves to a build of its own `lib/` source (scripts/ci/gen-exceljs-workers.mjs) that
    // leaves crypto/events/buffer/util/stream to nodejs_compat instead of the browserify copies the dist files embed (-390 KB).
    "exceljs": "./src/cf/stubs/exceljs-workers.cjs",
    // mime-db cut to the fields mime-types reads (extensions, charset, source), regenerated by scripts/ci/gen-mime-db-slim.mjs
    // and pinned to the installed mime-db by tests/unit/ops/api-bundle-slimming.test.ts (-72 KB).
    "mime-db": "./src/cf/stubs/mime-db.json",
    "socket.io": "./src/cf/stubs/socket-io.ts",
    "@socket.io/redis-adapter": "./src/cf/stubs/socket-io-redis-adapter.ts",
    "rate-limit-redis": "./src/cf/stubs/rate-limit-redis.ts",
    "imapflow": "./src/cf/stubs/imapflow.ts",
    "@sentry/node": "./src/cf/stubs/sentry-node.ts",
    "@sentry/profiling-node": "./src/cf/stubs/sentry-profiling-node.ts",
    "swagger-jsdoc": "./src/cf/stubs/swagger.ts",
    "swagger-ui-express": "./src/cf/stubs/swagger.ts",
    "compression": "./src/cf/stubs/compression.ts",
    "pino": "./src/cf/stubs/pino.ts",
    "iconv-lite": "./src/cf/stubs/iconv-lite.ts",
    "multer": "./src/cf/stubs/multer-formdata.ts",
    // Workspace packages bundle from SOURCE (ESM), not their CommonJS dist: from dist, esbuild emits one
    // `__toESM(require_dist())` per import site (451 in this Worker), each copying every export of the
    // package, and nothing tree-shakes. Measured 2026-10-22: startup CPU 164 -> 90 ms (scripts/ci/worker-startup-budget.mjs).
    "@ebda/shared": "../../packages/shared/src/index.ts",
    "@ebda/database": "../../packages/database/src/index.ts",
    // StoreDO sources (apps/api/src/cf/repo-modules.d.ts explains why these names are not the package names).
    "@ebda-src/repo": "../../packages/repo/src/index.ts",
    "@ebda-src/cf-schema": "../../packages/cf-schema/src/store/migrations.generated.ts",
    "@ebda-src/prisma-meta": "../../packages/cf-schema/generated/prisma-meta.json",
  },

  // Non-secret configuration. BUILD_COMMIT_SHA is overridden per deploy
  // (`wrangler deploy --var BUILD_COMMIT_SHA:$GITHUB_SHA`); /health reports it. Local
  // development overrides these (NODE_ENV=development, localhost URLs) in `.dev.vars`.
  "vars": {
    "NODE_ENV": "production",
    "APP_VERSION": "1.0.0",
    "BUILD_COMMIT_SHA": "",
    "WEB_URL": "https://store.ebda.app",
    "ADMIN_URL": "https://store.ebda.app",
    "API_URL": "https://api.ebda.app",
    "TRUST_PROXY_HOPS": "1",
    // STORE_DO_ENABLED_IDS is deliberately NOT set (Ruling CF-R6B-1): which stores are on the Durable Object is the D1 `stores.storage_backend`
    // column, read live by every consumer (lib/store-backend.ts backendFor / doStoreIdList). The env list is only the local / test fallback.
    // Which alarm-ready jobs fire as StoreSchedule alarms (src/lib/jobs/alarm-flag.ts): comma list or "all". Alarms are armed ONLY for
    // stores served by their Durable Object (src/lib/jobs/store-schedule.ts, Ruling CF-JOBS-1); every Postgres store keeps the global
    // cron. With JOBS_ON_DO unset no store is a DO store, so "all" arms nothing today.
    "JOBS_CF_ALARMS": "all",
    // "1" = background jobs follow each store's D1 backend flag (stores.storage_backend): DO stores get alarms, their unported jobs are
    // refused with an alert, sweeps skip them (src/lib/jobs/do-guard.ts). Flipped together with the flag at the cutover; "" = every store on Postgres.
    "JOBS_ON_DO": "",
    // "1" = cutover write freeze (docs/runbooks/cutover-cf.md 5.1): HTTP writes answer 503 AND crons, queue consumers, Workflows and
    // DO alarms stand still (parked, never dropped; src/lib/jobs/freeze.ts). Anything else = off.
    "WRITES_FROZEN": "",
    // Public image (not a secret): Ebda's InstaPay QR on the merchant pay screen.
    "EBDA_INSTAPAY_QR_URL": "https://media.ebda.app/platform/instapay-qr.jpg",
    // Semantic search: ON since 2026-10-29 (Ruling SEARCH-SEMANTIC-ON-1). Kill switch (docs/ENVIRONMENT.md "Semantic search"), flipped ONLY here, by a PR
    // + cf-api-deploy.yml, so the post-deploy /health probe sees the boot check; never as a secret
    // (cf-api-deploy refuses that) or from the dashboard (a new version with no probe, no rollback).
    "SEARCH_SEMANTIC_ENABLED": "true",
  },
}
