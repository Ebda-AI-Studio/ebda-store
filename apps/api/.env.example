# Resend API key — single platform-wide account. All merchant custom domains
# get added to it as verified senders. Free tier: 100/day, 3k/mo.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Public origin Inngest Cloud calls to reach our serve endpoint (scheme+host
# only — servePath is added by the app). REQUIRED in production: without it the
# SDK infers its URL from the self-register PUT's Host header (127.0.0.1) and
# registers an unreachable localhost URL, so enqueued jobs never run.
INNGEST_SERVE_HOST=https://store-api.forcemediakw.com

# PostHog personal API key — enables server-side Right-to-Erasure
# propagation (GDPR Art. 17 / Kuwait Law 13/2023 Art. 17) so a customer
# erase request also deletes their PostHog person. Distinct from the
# storefront's public NEXT_PUBLIC_POSTHOG_KEY — this one needs person:write
# scope and must never reach the browser. Optional: unset = the deletion
# call warns once and no-ops rather than failing. See docs/privacy/data-map.md.
POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxxxxxxxxxx
POSTHOG_PROJECT_ID=12345
POSTHOG_HOST=https://eu.posthog.com
