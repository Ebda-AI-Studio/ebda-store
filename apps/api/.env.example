
# PostHog personal API key — enables server-side Right-to-Erasure
# propagation (GDPR Art. 17 and applicable GCC data-protection law — see
# docs/privacy/data-map.md) so a customer
# erase request also deletes their PostHog person. Distinct from the
# storefront's public NEXT_PUBLIC_POSTHOG_KEY — this one needs person:write
# scope and must never reach the browser. REQUIRED for PostHog erasure
# propagation to actually happen: unset = every erasure's PostHog-deletion
# step fails loud (logged + dead-lettered via alerts-failure-watch, not a
# silent no-op) rather than faking success. See docs/privacy/data-map.md.
POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxxxxxxxxxx
POSTHOG_PROJECT_ID=12345
POSTHOG_HOST=https://eu.posthog.com
# Set to true ONLY once posthog.identify(userId) is wired at login. Until then
# PostHog holds no person keyed by our userId, so a missing credential is a
# documented no-op rather than a hard erasure failure (it used to alert P1 on
# every erasure, up to 200 per retention-cron run).
POSTHOG_ERASURE_REQUIRED=false

# Signs the guest-safe order-status link in the COD WhatsApp message (>= 32 chars). Worker secret in production; the API refuses to boot without it once the WhatsApp queue is bound. Ruling WA-COD-V2-2.
ORDER_STATUS_LINK_SECRET=dev-only-order-status-link-secret-0123456789
