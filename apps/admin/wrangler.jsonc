{
  "name": "ebda-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "routes": [
    {
      "pattern": "store.ebda.app",
      "custom_domain": true,
    },
    {
      "pattern": "store.ebda.app/*",
      "zone_name": "ebda.app",
    },
  ],
  "observability": { "enabled": true },
}
