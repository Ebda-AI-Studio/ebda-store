# Security headers for Workers-asset-layer responses (favicon, security.txt,
# icons...) which bypass next.config headers(). ZAP 10035/10021. The _headers
# file itself is never served (Workers Static Assets convention).
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Static fallback CSP for assets that can carry script (an SVG opened directly). Page responses get the
# nonce CSP from src/middleware.ts instead; NOT set via next.config headers(): OpenNext lets config
# headers win over middleware headers (or emits both), which would break the nonce policy on Workers.
# Deliberately not on /*: sw.js is a worker and need importScripts/fetch.
/*.svg
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; object-src 'none'; frame-ancestors 'none'
/icons/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; object-src 'none'; frame-ancestors 'none'

# SEO-4: content-hashed build output never changes under the same URL (staleness class: NEVER-changes).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
