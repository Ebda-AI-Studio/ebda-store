# Security headers for the static export (Workers Static Assets serves these;
# the file itself is never served). Mirrors apps/web + apps/orders.
# CSP (S6, 2026-11-12 audit): the live header had no default-src/script-src. This is a STATIC export, so a per-request
# nonce is impossible (the nonce CSP of apps/web|admin|orders needs a server) and Next's inline bootstrap/flight
# scripts differ per page (hundreds of hashes would blow Cloudflare's 2000-char _headers line limit). Residual,
# documented: script-src keeps 'unsafe-inline' (no unsafe-eval, no remote script host, no inline event attributes),
# so an HTML-injection bug could still run inline script; there is no user-generated HTML on this site.
# CSP: form-action lets the /contact enquiry form post to the API origin and nowhere else (Ruling CONTACT-FORM-1).
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; media-src 'self' blob:; connect-src 'self' https://api.ebda.app; worker-src 'self' blob:; frame-src 'none'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://api.ebda.app
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/search-index.*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# SEO-4: content-hashed build output never changes under the same URL (staleness class: NEVER-changes).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Un-hashed marketing images: BOUNDED-stale, 1 day fresh + 7 days stale-while-revalidate (a replaced
# image shows within a day; none carries price, stock or permissions).
/devices/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/looks/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/demo/*
