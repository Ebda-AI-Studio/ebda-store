// Static-assets-only Worker for the marketing site. `next build` (output: 'export')
// writes ./out; Cloudflare serves it directly — no OpenNext, no server code.
// RSC (LANG-SWITCH-1, measured 2026-11-19): there is no server, so a request carrying `RSC: 1` to an HTML url gets that HTML (harmless: Next then
// falls back to a full load). The client router never does that in a static export: it fetches per-segment flight files at their OWN urls
// (`/en/__next._tree.txt`, `/__next.<seg>.txt`, text/plain), so RSC and HTML can never share an edge-cache key. Adding a `main` script or leaving
// `output: export` breaks that; tests/unit/marketing-lang-switch.test.tsx pins it. The language switch is a plain <a> (Header.tsx).
// Deploy wiring is intentionally NOT in CI yet (SP9 part 1 builds the site only).
{
  "name": "ebda-marketing",
  "compatibility_date": "2025-08-16",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "routes": [
    { "pattern": "ebda.app", "custom_domain": true },
    // M-072: the storefront owns a `*/*` zone route for merchant custom domains; this explicit apex route out-ranks it.
    { "pattern": "ebda.app/*", "zone_name": "ebda.app" },
  ],
  // Assets-only: static hits run no script and are not logged; this keeps config parity with the others (G7).
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "logpush": true,
}
