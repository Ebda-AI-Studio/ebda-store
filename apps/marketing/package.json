{
  "name": "@ebda/marketing",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build && tsx scripts/service-lines-postbuild.ts && node scripts/build-search.mjs",
    "build:preview": "EBDA_SERVICE_LINES=preview npm run build",
    "build:services-on": "EBDA_SERVICE_LINES=on npm run build",
    "start": "node ../../packages/site-kit/src/gates/serve-static.mjs out 3005",
    "lint": "eslint src scripts --ext .ts,.tsx,.mjs",
    "lint:fix": "eslint src scripts --ext .ts,.tsx,.mjs --fix",
    "og": "node scripts/make-og.mjs",
    "site-nav-js": "tsx scripts/site-nav-js.ts",
    "lastmod": "tsx scripts/lastmod.tsx",
    "story-frames": "node scripts/story-frames/make.mjs",
    "looks": "python3 scripts/looks/export.py",
    "demo-credits": "node scripts/demo-credits.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:a11y": "node scripts/a11y-check.mjs",
    "check:search": "node scripts/search-check.mjs",
    "check:lighthouse": "node scripts/lighthouse-check.mjs",
    "check": "npm run build && npm run check:a11y && npm run check:search",
    "clean": "rm -rf .next out node_modules",
    "qr": "tsx scripts/3d/make-qr.ts",
    "llms-full": "tsx scripts/make-llms-full.ts",
    "stills": "node scripts/3d/make-stills.mjs",
    "check:perf": "node ../../scripts/ci/marketing-perf-budget.mjs --out out && node ../../scripts/ci/marketing-css-route-coverage.mjs --out out"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@ebda/site-kit": "*",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^16.1.1",
    "@playwright/test": "1.60.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.59.1",
    "wrangler": "4.116.0"
  }
}
