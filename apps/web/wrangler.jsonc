// ⚠️  REGENERATED AT DEPLOY TIME — EDITING THIS FILE CHANGES NOTHING IN PROD.
//
// `.github/workflows/cf-web-deploy.yml` runs `scripts/cf-setup-local.sh web` BEFORE
// the build and it OVERWRITES this file unconditionally, so any binding added
// here alone never reaches the worker. The live bindings (confirmed against the
// Cloudflare API on 2026-09-02) are NEXT_TAG_CACHE_DO_SHARDED,
// NEXT_CACHE_DO_QUEUE, NEXT_INC_CACHE_R2_BUCKET, WORKER_SELF_REFERENCE and
// ASSETS — the generator's OPENNEXT_CACHE=true branch.
//
// To change what actually deploys, edit scripts/cf-setup-local.sh.

{
  "name": "ebda-web",
  // Custom worker entry (NOT the raw OpenNext output) — wraps the generated
  // fetch handler with @sentry/cloudflare so SSR/RSC errors are captured on
  // this target. See apps/web/sentry-worker-entry.ts for the why + sources.
  "main": "sentry-worker-entry.ts",
  // 2025-08-16+ is REQUIRED by Sentry's Cloudflare SDK (needs `https.request`
  // to transmit events) — bumped from 2025-03-25 specifically for this.
  // https://docs.sentry.io/platforms/javascript/guides/cloudflare/frameworks/nextjs/
  "compatibility_date": "2025-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "ebda-web-isr-cache" }],
  // Launch traffic: Workers Logs head-sample 10% (cost). Logpush below is the full archive; Sentry catches 100% of errors.
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "logpush": true,
  "routes": [
    // Store subdomains only — the apex belongs to ebda-marketing (scripts/cf-routes.cjs).
    { "pattern": "*.ebda.app/*", "zone_name": "ebda.app" },
  ],
}
