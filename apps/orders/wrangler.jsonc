{
  "name": "ebda-orders",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "routes": [
    { "pattern": "orders.ebda.app", "custom_domain": true },
    { "pattern": "orders.ebda.app/*", "zone_name": "ebda.app" },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Workers Trace Events Logpush (G7); the job to R2 is created by scripts/ops/cf-logs-setup.sh
  "logpush": true,
}
