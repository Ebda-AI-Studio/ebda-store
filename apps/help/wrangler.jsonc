// Static-assets-only Worker for help.ebda.app. `npm run build -w apps/help` writes ./out; Cloudflare serves it
// directly (no server code).
{
  "name": "ebda-help",
  "compatibility_date": "2025-08-16",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  // The route is what beats the storefront wildcard (*.ebda.app/*), which runs BEFORE custom domains (cf-routes.cjs).
  "routes": [
    { "pattern": "help.ebda.app", "custom_domain": true },
    { "pattern": "help.ebda.app/*", "zone_name": "ebda.app" },
  ],
}
