// accounts.ebda.app: the shared Ebda AI Studio identity service (Ruling ID-1/ID-2). Its OWN Worker + D1.
// Secrets (wrangler secret put): JWT_PRIVATE_JWK, MFA_KEY, CLIENT_SECRET_PEPPER (integrator client secrets; 32+ random bytes, base64; without it the client endpoints answer 503). No preview environment exists or will (INFRA-PREVIEW-1).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ebda-accounts",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // MFA key rotation job (re-seals TOTP secrets onto the current key; a no-op when none are left).
  "triggers": { "crons": ["23 * * * *"] },
  // /health reports the running version: the deployment id from this binding and the commit from BUILD_COMMIT_SHA, which the
  // deploy workflow overrides per deploy (`wrangler deploy --var BUILD_COMMIT_SHA:$GITHUB_SHA`).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Workers Trace Events Logpush (G7); the job to R2 is created by scripts/ops/cf-logs-setup.sh
  "logpush": true,
  // The zone route is REQUIRED beside the custom domain: zone routes run before custom domains, so without
  // `accounts.ebda.app/*` the storefront wildcard (`*.ebda.app/*`) answers this host (as it did help/docs/status, 2026-10-24).
  "routes": [
    { "pattern": "accounts.ebda.app", "custom_domain": true },
    // M-072: out-ranks the storefront's `*/*` and `*.ebda.app/*` zone routes (cf-routes.cjs).
    { "pattern": "accounts.ebda.app/*", "zone_name": "ebda.app" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ebda-identity",
      "database_id": "9119dcf4-2aad-435f-ae2c-31ebcba7eeb5",
      "migrations_dir": "migrations",
    },
  ],
  // ebda-api exports both entrypoints (apps/api/src/cf/identity-rpc.ts): mail goes through the Store pipeline and
  // `stores[]` is computed from the Store directory at token time (so there is no second membership table to keep in step).
  "services": [
    { "binding": "STORE_DIRECTORY", "service": "ebda-api", "entrypoint": "StoreDirectory" },
    { "binding": "MAILER", "service": "ebda-api", "entrypoint": "IdentityMailer" },
    // One-time codes over WhatsApp (Ruling ID-WA-OTP-1): the ebda-wa Worker's `WhatsAppOtp` entrypoint. ebda-wa must already be deployed with it
    // (a binding to a missing Worker/entrypoint fails THIS deploy). Absent at runtime = the channel is off and the email path is untouched.
    { "binding": "WHATSAPP_OTP", "service": "ebda-wa", "entrypoint": "WhatsAppOtp" },
  ],
  "vars": {
    "ISSUER": "https://accounts.ebda.app",
    "ALLOWED_ORIGINS": "https://store.ebda.app,https://orders.ebda.app,https://wa.ebda.app",
    "PASSKEY_ORIGINS": "https://store.ebda.app,https://orders.ebda.app",
    "BUILD_COMMIT_SHA": "",
    // Verified 2026-10-25: no production secret is sealed in a legacy format (0 users with a TOTP), so legacy v1/v2 are refused from day one.
    "MFA_REJECT_LEGACY": "true",
    "PRODUCTS": "store,whatsapp,crm,erp",
    // Least privilege: a browser origin may only obtain tokens for ITS product audience (an XSS on one product cannot mint another's).
    "ORIGIN_PRODUCTS": "https://store.ebda.app=store,https://orders.ebda.app=store,https://wa.ebda.app=whatsapp",
  },
}
