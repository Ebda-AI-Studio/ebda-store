# Security headers for the static export (Workers Static Assets serves these;
# the file itself is never served). Mirrors apps/web + apps/orders.
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# SEO-4: content-hashed build output never changes under the same URL (staleness class: NEVER-changes).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
