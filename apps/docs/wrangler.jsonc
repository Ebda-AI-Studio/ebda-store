// Static-assets-only Worker for docs.ebda.app. `npm run build -w apps/docs` writes ./out; Cloudflare serves it
// directly (no server code).
{
  "name": "ebda-docs",
  "compatibility_date": "2025-08-16",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Workers Trace Events Logpush (G7); the job to R2 is created by scripts/ops/cf-logs-setup.sh
  "logpush": true,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  // The route is what beats the storefront wildcard (*.ebda.app/*), which runs BEFORE custom domains (cf-routes.cjs).
  "routes": [
    { "pattern": "docs.ebda.app", "custom_domain": true },
    { "pattern": "docs.ebda.app/*", "zone_name": "ebda.app" },
  ],
}
