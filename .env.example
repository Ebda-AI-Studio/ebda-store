# Force Website Builder - Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# Application
# ===========================================
NODE_ENV=development

# ===========================================
# Database (Supabase PostgreSQL)
# Get your connection string from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/database
# ===========================================
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT.supabase.co:5432/postgres?schema=public

# Supabase API (for client-side features)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://localhost:6379
# For Docker Compose with password: redis://:yourpassword@localhost:6379
REDIS_PASSWORD=changeme

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ===========================================
# Encryption
# ===========================================
ENCRYPTION_KEY=your-32-character-encryption-key

# ===========================================
# API Server
# ===========================================
API_PORT=4000
API_HOST=localhost
API_URL=http://localhost:4000

# ===========================================
# Frontend URLs
# ===========================================
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ===========================================
# Kuwait Payment Providers
# Stripe doesn't work in Kuwait!
# Supported: Tap, MyFatoorah, Hesabe, UPayments
# ===========================================

# Payment Settings
PAYMENT_TEST_MODE=true
DEFAULT_PAYMENT_PROVIDER=tap
DEFAULT_CURRENCY=KWD

# Tap Payments (https://tap.company)
TAP_API_KEY=sk_test_...
TAP_SECRET_KEY=
TAP_WEBHOOK_SECRET=

# MyFatoorah (https://myfatoorah.com)
MYFATOORAH_API_KEY=
MYFATOORAH_TEST_MODE=true
MYFATOORAH_COUNTRY_CODE=KWT

# Hesabe (https://hesabe.com)
HESABE_API_KEY=
HESABE_SECRET_KEY=ivKey:encryptionKey
HESABE_MERCHANT_ID=
HESABE_WEBHOOK_SECRET=

# UPayments (https://upayments.com)
UPAYMENTS_API_KEY=
UPAYMENTS_SECRET_KEY=
UPAYMENTS_MERCHANT_ID=
UPAYMENTS_WEBHOOK_SECRET=

# ===========================================
# Storage (S3-compatible: AWS S3, MinIO, R2)
# ===========================================
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=uploads
STORAGE_PUBLIC_URL=http://localhost:9000/uploads

# ===========================================
# Email (SMTP)
# ===========================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key
SMTP_FROM_NAME=Force Media
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# Vercel (Custom Domain Provisioning)
# Required for automatic domain provisioning when creating stores
# Get your token from: https://vercel.com/account/tokens
# ===========================================
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ===========================================
# Logging & Monitoring
# ===========================================
LOG_LEVEL=debug

# Sentry Error Monitoring (https://sentry.io)
SENTRY_DSN=
SENTRY_DEBUG=false

# ===========================================
# Public API URL (used by admin and web frontends)
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:4000

# ===========================================
# Prisma Direct Connection (for migrations)
# Some hosted databases require a direct (non-pooled) connection for migrations
# ===========================================
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT.supabase.co:5432/postgres

# ===========================================
# Admin Notification
# Email address that receives contact form submissions
# ===========================================
ADMIN_EMAIL=admin@forcemedia.com

# ===========================================
# Backup
# ===========================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=
