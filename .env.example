# Ebda - Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# Application
# ===========================================
NODE_ENV=development

# ===========================================
# Database (Neon PostgreSQL — serverless)
# Get connection string from: https://console.neon.tech/app/projects/<id>/connection-details
#
# DATABASE_URL should use the connection POOLER (port 5432 with -pooler suffix).
# This is used for all application queries via Prisma at runtime.
#
# DIRECT_URL should use the DIRECT connection (no -pooler suffix).
# This is used for migrations and interactive transactions that cannot go through pgBouncer.
#
# SSL: sslmode=verify-full required to pin TLS verification. pg v9+ silently demotes
# sslmode=require to weaker semantics — verify-full is the only durable setting.
# Surfaced by the 2026-05-22 audit (P2-A02 cryptographic failures).
# ===========================================
# Format (do not use <...> placeholders as literal values — replace them):
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
# Example (Neon pooler):
#   DATABASE_URL=postgresql://neondb_owner:xxxx@ep-foo-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL=REPLACE_ME_WITH_NEON_POOLER_URL_WITH_sslmode_verify_full
# Max ms a store-scoped response waits for its request COMMIT before answering
# 503 COMMIT_TIMEOUT (optional, default 10000 — see docs/ENVIRONMENT.md).
REQUEST_COMMIT_TIMEOUT_MS=10000

# ===========================================
# Test / Integration Test Database
# Points at the Neon "preview" branch (ep-spring-dew-a1nn6819) which is the
# dedicated staging DB for integration tests. NEVER set this to the prod URL.
#
# Resolution order in tests/setup-e2e.ts:
#   1. TEST_DATABASE_URL  ← set this
#   2. DATABASE_URL (only when it doesn't contain the prod host fragment)
#   3. Local placeholder — warns but doesn't block pure-unit CI
#
# The prod-host guard (ep-falling-meadow-a1uq2yil) throws immediately if the
# resolved URL points at prod, preventing accidental pollution.
# ===========================================
# Format: same as DATABASE_URL but pointing at the ep-spring-dew-a1nn6819 preview branch.
# Get the exact connection string from https://console.neon.tech (select the "preview" branch).
TEST_DATABASE_URL=REPLACE_ME_WITH_NEON_PREVIEW_BRANCH_POOLER_URL

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Optional: names the email-barcode PNGs in R2; empty = derived from ENCRYPTION_KEY (never JWT_SECRET).
# BARCODE_KEY_SECRET=
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ===========================================
# Encryption
# Also the root of the HKDF keys that MAC the SMS opt-out, campaign
# unsubscribe and review links (apps/api/src/lib/derived-secret.ts). Required.
# ===========================================
ENCRYPTION_KEY=your-32-character-encryption-key

# ===========================================
# API Server
# ===========================================
API_PORT=4000
API_HOST=localhost
API_URL=http://localhost:4000

# ===========================================
# Frontend URLs
# ===========================================
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Orders PWA (focus-mode order app) — runs on port 3002 in dev.
ORDERS_URL=http://localhost:3002

# ===========================================
# Egypt Payment Providers (Paymob, Kashier, Fawry)
# Each merchant brings their OWN keys: they are saved per store in the admin
# (Settings > Payments), encrypted at rest. There are no platform-level gateway
# keys, so nothing to put here but these three switches.
# ===========================================

# Payment Settings
PAYMENT_TEST_MODE=true
DEFAULT_PAYMENT_PROVIDER=paymob
DEFAULT_CURRENCY=EGP

# Local gateway stubs only (never set in a real deploy; honoured only outside
# production, or with PAYMENT_PROVIDER_STUB=1): PAYMOB_BASE_URL, KASHIER_BASE_URL,
# FAWRY_BASE_URL point an adapter at a stub instead of the real gateway.
# PAYMOB_CHECKOUT_URL does the same for Paymob's hosted checkout page (eg.checkout.paymob.com).
# PAYMENT_PROVIDERS_ALLOW_UNVERIFIED is no longer read (Ruling PROVIDERS-3: every catalog provider
# CHECKOUT_UNCONFIRMED_PROVIDERS=geidea:<storeId> (comma list; geidea:* = all stores) offers a gateway Ebda cannot yet
# confirm to buyers at checkout. Empty by default (Ruling GEIDEA-2).
# connects; the connection check is the gate). PROVIDER_AUTO_VERIFY_AFTER=3 is the number of
# successful real operations after which an unverified provider is flagged verified.
# SANDBOX_<PROVIDER>_<FIELD> (e.g. SANDBOX_KASHIER_SECRETKEY): sandbox credentials read ONLY by
# scripts/provider-sandbox-check.mjs (never by the API). Do not commit real values.
# Shipping carriers: BOSTA_BASE_URL, SHIPBLU_BASE_URL, MYLERZ_BASE_URL, ARAMEX_BASE_URL point an
# adapter at a local stub (honoured only outside production, or with CARRIER_STUB=1). Never a
# per-merchant setting. Same SANDBOX_<CARRIER>_<FIELD> convention for the carrier sandbox check.

# Order-payment lifecycle automations (Inngest crons)
# STUCK_ORDER_NOTIFY_MINUTES — order/created fanout safety net (5-min sweep). How
#   long a PAID order may sit with no order/created fanout (orderCreatedNotifiedAt
#   null) before the sweep re-sends order/created (recovers confirmation email +
#   admin push + WhatsApp + CAPI + accounting journal). P1-alerts past 3× this. Default 10.
STUCK_ORDER_NOTIFY_MINUTES=10
# REFUND_REVERSAL_STUCK_MINUTES — the same safety net for the order/refunded
#   fanout. applyRefundEffects only ENQUEUES the event; if it is enqueued but
#   never consumed (Inngest outage / worker down / dropped mid-deploy) the order
#   reads cancelled, the customer is refunded, and the stock NEVER comes back —
#   silently. How long a cancelled/refunded order may sit with refundReversedAt
#   null before the 5-min sweep re-sends order/refunded. P1-alerts past 3×. Default 10.
REFUND_REVERSAL_STUCK_MINUTES=10
# REFUND_REVERSAL_MAX_AGE_MINUTES — recency FLOOR for that sweep. refundReversedAt
#   is null for every order cancelled before the column existed, so without a lower
#   bound the first tick would re-fire reversals across the whole order history.
#   The migration also backfills pre-existing rows. Default 720 (12h).
REFUND_REVERSAL_MAX_AGE_MINUTES=720
# ORDER_STATUS_FANOUT_STUCK_MINUTES — the same safety net for the order/status-changed
# fanout (emails, dispatch, affiliate commission, loyalty award): a transition
# requested this long ago and never claimed by the fanout is re-sent.
ORDER_STATUS_FANOUT_STUCK_MINUTES=10
# ORDER_STATUS_FANOUT_MAX_AGE_MINUTES — recency FLOOR for that sweep.
ORDER_STATUS_FANOUT_MAX_AGE_MINUTES=720
# STUCK_PAYMENT_MINUTES — how long an ONLINE order may sit pending/unpaid before
#   the 15-min stuck-payment sweep pushes the merchant a "Payment pending —
#   follow up" alert so they can contact the customer. Default 60.
STUCK_PAYMENT_MINUTES=60
# AUTO_CANCEL_UNPAID_DAYS — how old a pending/unpaid order must be before the
#   daily cron auto-cancels it (no refund — never paid). Default 2 (matches the
#   payment-link 2-day validity).
AUTO_CANCEL_UNPAID_DAYS=2
# AUTO_CANCEL_RECONCILE_THROTTLE_MS — the auto-cancel sweep asks the payment
#   provider whether each order was actually paid BEFORE cancelling it (a lost
#   webhook + a customer who never returned to the success page would otherwise
#   get a paid order cancelled). This paces those provider calls so a 500-order
#   backlog isn't a 500-request burst. Default 250. Set 0 to disable pacing.
AUTO_CANCEL_RECONCILE_THROTTLE_MS=250
# OPEN_UNPAID_HOLD_CAP — stock-hold abuse fix: rejects a NEW cod/instapay order
#   once the same phone or canonical email has this many open unpaid holds.
#   Admission is atomic with stock reservation. Full-wallet orders are exempt.
OPEN_UNPAID_HOLD_CAP=2
# IP cap applies alongside contact identity; higher for shared mobile-network IPs.
# Default is OPEN_UNPAID_HOLD_CAP * 4 (8 with the default identity cap).
OPEN_UNPAID_HOLD_IP_CAP=8
# OPEN_UNPAID_GATEWAY_HOLD_CAP — same cap for every other payment-method label
# (gateway checkouts retry after a failed card, so it is looser). IP cap = 4x.
OPEN_UNPAID_GATEWAY_HOLD_CAP=5
# AI_MODEL_RATES — JSON map of model id -> price per MILLION tokens, in your
#   billing currency. Turns token usage into money on every ai_usage row, which
#   is what makes per-store AI margin a number. No built-in defaults on purpose:
#   an unconfigured model records cost_micros = NULL (unpriced), which is NOT the
#   same as 0 (a genuinely free cached hit). Verify prices against the provider.
# TRUST_PROXY_HOPS — number of proxies in front of the API (Express trust proxy).
#   Railway only = 1 (default). Cloudflare + Railway = 2.
#   Do NOT set 2 until the API is proxied AND the naked *.up.railway.app host
#   is no longer publicly reachable — otherwise X-Forwarded-For becomes
#   spoofable and every IP-keyed rate limiter can be bypassed.
# TRUST_PROXY_HOPS=1

# AI_MODEL_RATES={"gemini-flash-lite-latest":{"in":0.10,"out":0.40}}

# ===========================================
# Storage (S3-compatible: AWS S3, MinIO, R2)
# ===========================================
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=uploads
STORAGE_PUBLIC_URL=http://localhost:9000/uploads
# PRIVATE bucket for PII (merchant tax documents), no public access. Ebda: ebda-private.
# Empty or equal to STORAGE_BUCKET = tax-document upload refused (fail closed).
STORAGE_PRIVATE_BUCKET=uploads-private

# ===========================================
# Email (SMTP)
# ===========================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key
SMTP_FROM_NAME=Ebda
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# Logging & Monitoring
# ===========================================
LOG_LEVEL=debug

# Sentry Error Monitoring (https://sentry.io)
# Four projects, one per app: api / web / admin / orders.
SENTRY_DSN=
SENTRY_DEBUG=false
# Client-side DSNs for the three Next.js frontends (Vercel envs + the
# cf-deploy.yml GitHub repo variable of the same name for the Cloudflare build).
NEXT_PUBLIC_SENTRY_DSN_WEB=
NEXT_PUBLIC_SENTRY_DSN_ADMIN=
NEXT_PUBLIC_SENTRY_DSN_ORDERS=
# Build-time source-map upload + release creation (web/admin/orders next.config.js
# withSentryConfig). Optional — the Sentry bundler plugin no-ops the upload
# (warns, doesn't fail the build) when SENTRY_AUTH_TOKEN is unset.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ===========================================
# Public API URL (used by admin and web frontends)
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:4000

# ===========================================
# Prisma Direct Connection (for migrations and interactive transactions)
# Must use the DIRECT connection (port 5432), NOT the pooler.
# SSL is required for production connections to Supabase.
# ===========================================
# Same format as DATABASE_URL but using the NON-pooler hostname (no -pooler suffix).
# Example: ep-foo.eu-central-1.aws.neon.tech (NOT ep-foo-pooler.eu-central-1.aws.neon.tech)
DIRECT_URL=REPLACE_ME_WITH_NEON_DIRECT_URL_WITH_sslmode_verify_full

# ===========================================
# Google Gemini AI (translation, SEO, categorization)
# Free tier on `gemini-flash-lite-latest` is ~30 RPM, ~1k req/day.
# AI_DAILY_REQUEST_CAP / AI_MONTHLY_REQUEST_CAP enforce a hard global
# stop so a single bulk sweep can't blow through Google's free quota
# and brick AI features for the rest of the day. Cache hits don't
# count. Raise after enabling Google billing.
# ===========================================
GOOGLE_GENERATIVE_AI_KEY=
# Failover keys (separate Google Cloud projects = separate quotas). Tried in order
# GEMINI_API_KEY, GEMINI_API_KEY_2, GEMINI_API_KEY_3 ... on a 429 / RESOURCE_EXHAUSTED.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-flash-lite-latest
AI_BULK_THROTTLE_MS=2500
# Production ruling PLANS-1: platform-wide 1800/day + 54000/month (2 Gemini keys); store base slice 150/day (top-ups fill up to 50%).
AI_DAILY_REQUEST_CAP=1800
AI_MONTHLY_REQUEST_CAP=54000

# ===========================================
# Semantic search (Workers AI bge-m3 embeddings) — see docs/ENVIRONMENT.md.
# The Worker uses its AI binding; the REST pair is a Node-dev fallback only
# (set both or neither). SEARCH_SEMANTIC_ENABLED=true with no provider fails boot.
# ===========================================
# SEARCH_SEMANTIC_ENABLED=false
# SEARCH_EMBED_STORE_DAILY_CAP=3000
# SEARCH_EMBED_GLOBAL_DAILY_CAP=20000
# SEARCH_EMBED_THROTTLE_MS=200
# SEARCH_VECTOR_MAX_DISTANCE=0.55
# Storefront query embeds per Cairo day (all stores / per store); 0 stops them (Ruling SEARCH-T12-3).
# SEARCH_QUERY_EMBED_GLOBAL_DAILY_CAP=10000
# SEARCH_QUERY_EMBED_STORE_DAILY_CAP=1000
# Query embeds per client IP per minute (CGNAT-sized; 0 = none).
# SEARCH_EMBED_PER_SEARCHER_PER_MIN=60
# CF_AI_ACCOUNT_ID=
# CF_AI_API_TOKEN=

# ===========================================
# Email campaigns (D2) — optional, defaults shown. See docs/ENVIRONMENT.md.
# CAMPAIGN_UNSUBSCRIBE_SECRET, when empty, uses a key derived from ENCRYPTION_KEY
# (lib/derived-secret.ts), never JWT_SECRET (issue 2424).
# ===========================================
CAMPAIGN_DAILY_SEND_CAP=1000
CAMPAIGN_SEND_THROTTLE_MS=1000
CAMPAIGN_PLATFORM_SEND_INTERVAL_MS=1000
# Wall-clock budget for one campaign batch step (keep well under Cloudflare's 100s).
CAMPAIGN_BATCH_WALL_BUDGET_MS=60000
CAMPAIGN_UNSUBSCRIBE_SECRET=

# ===========================================
# Rate limiting — optional, defaults shown. See docs/ENVIRONMENT.md.
# RATE_LIMIT_SHARED=0 puts every limiter on per-process counting (kill switch).
# ===========================================
RATE_LIMIT_SHARED=
RATE_LIMIT_429_ALERT_PER_MIN=300

# ===========================================
# WhatsApp (Meta Cloud API)
# ===========================================
WHATSAPP_VERIFY_TOKEN=

# ===========================================
# Web Push Notifications (VAPID)
# Generate keys with: npx web-push generate-vapid-keys
# ===========================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ahlan@ebda.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ===========================================
# OneSignal Push Notifications
# OneSignal locks each app to one origin, so each frontend gets its OWN app:
#   storefront (ebda.app), admin (store.ebda.app),
#   orders PWA (orders.ebda.app).
# ===========================================
# Storefront broadcasts + legacy admin fallback
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
NEXT_PUBLIC_ONESIGNAL_APP_ID=
# Admin PWA order alerts
ONESIGNAL_ADMIN_APP_ID=
ONESIGNAL_ADMIN_REST_API_KEY=
NEXT_PUBLIC_ONESIGNAL_APP_ID_ADMIN=
# Orders PWA new-order alerts (separate app — no fallback to admin app)
ONESIGNAL_ORDERS_APP_ID=
ONESIGNAL_ORDERS_REST_API_KEY=
NEXT_PUBLIC_ONESIGNAL_ORDERS_APP_ID=

# ===========================================
# Backup
# ===========================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=

# ---- Ebda subscription billing + signup funnel (docs/ENVIRONMENT.md) ----
# BILLING_PROVIDER=stub            # stub (local only) | kashier | none (InstaPay only, on purpose); unset in production = P1 at boot
# KASHIER_MERCHANT_ID=
# KASHIER_SECRET_KEY=
# KASHIER_API_KEY=
# BILLING_TRIAL_CARD_MODE=         # card_on_file | pay_at_trial_end ; unset = follow the provider
# EBDA_INSTAPAY_HANDLE=            # unset = InstaPay option not offered
# EBDA_INSTAPAY_MOBILE=            # optional: the SAME InstaPay account's mobile (any Egyptian format); a receipt to the handle OR the mobile is the right payee
# EBDA_SUPPORT_WHATSAPP=           # Egyptian mobile for wa.me links; unset = no link
# EBDA_INSTAPAY_QR_URL=            # https URL of Ebda's InstaPay QR image; unset = no QR shown
# EBDA_SUPPORT_EMAIL=              # support email shown when WhatsApp is unset; default ahlan@ebda.app

# Signs the guest-safe order-status link in the COD WhatsApp message (>= 32 chars). Worker secret in production; the API refuses to boot without it once the WhatsApp queue is bound. Ruling WA-COD-V2-2.
ORDER_STATUS_LINK_SECRET=dev-only-order-status-link-secret-0123456789
