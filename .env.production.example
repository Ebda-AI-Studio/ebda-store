# ===========================================
# Ebda Store - Production Environment
# ===========================================
# Copy this file and fill in your production values

# -----------------
# General
# -----------------
NODE_ENV=production

# -----------------
# Database (Neon PostgreSQL - serverless)
# -----------------
# Get from: https://console.neon.tech -> your project -> Connection Details.
# DATABASE_URL = POOLED (-pooler host); DIRECT_URL = direct host (migrations / interactive tx).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# -----------------
# API Server (Railway)
# -----------------
API_PORT=4000
API_HOST=0.0.0.0

# -----------------
# Frontend URLs (Vercel) - REQUIRED. WEB_URL/ADMIN_URL gate CORS in prod.
# -----------------
WEB_URL=https://store.yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
API_URL=https://api.yourdomain.com
# Optional: our Cloudflare workers.dev account subdomain; trusts ebda-{web,admin,orders}.<subdomain>.workers.dev preview origins in CORS. Unset = none trusted.
CF_WORKERS_DEV_SUBDOMAIN=

# -----------------
# Authentication
# -----------------
# Generate with: openssl rand -base64 64
JWT_SECRET=your-production-jwt-secret-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# -----------------
# Encryption
# -----------------
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=your-32-character-encryption-key

# -----------------
# Payment Gateways
# -----------------
PAYMENT_TEST_MODE=false
DEFAULT_PAYMENT_PROVIDER=paymob
DEFAULT_CURRENCY=EGP

# Paymob, Kashier and Fawry keys are NOT environment variables: each merchant saves their own
# in the admin (Settings > Payments), encrypted at rest with ENCRYPTION_KEY.

# -----------------
# Email (Production SMTP)
# -----------------
# Recommended: Resend, SendGrid, or AWS SES
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_YOUR_API_KEY
SMTP_FROM_NAME=Ebda
SMTP_FROM_EMAIL=noreply@yourdomain.com

# -----------------
# File Storage (Cloudflare R2)
# -----------------
STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=YOUR_R2_ACCESS_KEY
STORAGE_SECRET_KEY=YOUR_R2_SECRET_KEY
STORAGE_BUCKET=ebda-uploads
STORAGE_PUBLIC_URL=https://cdn.yourdomain.com

# -----------------
# Redis Cache (Optional - Railway Redis)
# -----------------
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_HOST.railway.internal:6379

# -----------------
# Monitoring
# -----------------
SENTRY_DSN=https://YOUR_KEY@sentry.io/YOUR_PROJECT
SENTRY_DEBUG=false
LOG_LEVEL=info

# -----------------
# Public API URL (used by admin and web frontends)
# -----------------
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# -----------------
# WhatsApp (Meta Cloud API)
# -----------------
WHATSAPP_VERIFY_TOKEN=

# -----------------
# Web Push Notifications (VAPID)
# Generate keys with: npx web-push generate-vapid-keys
# -----------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@ebda.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# -----------------
# AI (Google Gemini) - translate / SEO / categorize. Missing => AI routes error.
# Get from: https://aistudio.google.com/app/apikey
# -----------------
GOOGLE_GENERATIVE_AI_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# -----------------
# Push (OneSignal) - admin new-order alerts + storefront broadcasts.
# ONESIGNAL_ADMIN_* is a dedicated admin app; without it admin push falls back
# to the storefront app and won't deliver (origin mismatch).
# -----------------
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_ADMIN_APP_ID=
ONESIGNAL_ADMIN_REST_API_KEY=
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# -----------------
# Ops alerting (Telegram) - P0 / CI / budget alerts to your ops chat.
# -----------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# AI OS brain mirror of every alert (Ruling ESC-AIOS-1); unset = no mirror
EBDA_OS_INGEST_TOKEN=
EBDA_OS_BRAIN_URL=https://os.ebda.app
# Guards the external alert webhook bridge. MUST be set in prod - when unset the
# bridge fails OPEN (accepts any anonymous POST and can spam the alert channel).
ALERTS_WEBHOOK_TOKEN=

# -----------------
# Error monitoring (Sentry) - the Next.js apps need their OWN public DSNs in
# ADDITION to the API SENTRY_DSN above, or storefront/admin errors go unmonitored.
# -----------------
NEXT_PUBLIC_SENTRY_DSN_WEB=
NEXT_PUBLIC_SENTRY_DSN_ADMIN=


# -----------------
# Backup
# -----------------
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
